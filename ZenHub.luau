-- Scope: select Gate cards and progress Gate votes only. No unit/macro/joiner ownership.
local BossRushCore = assert(loadstring([========================[-- BossRush prompt/gate core only. No combat, Macro control, replay or auto-join.
-- Dependency-injected intent/ack state machine. No Roblox globals,
-- networking, scheduler, timers, persistence or native protocol guesses live here.
local BossRush = {}
local Controller = {}
Controller.__index = Controller

local function copy(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return seen[value] end
    local result = {} seen[value] = result
    for key, child in pairs(value) do result[copy(key, seen)] = copy(child, seen) end
    return result
end
local function integer(value, fallback, minimum, maximum)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return fallback end
    return math.clamp(math.floor(value), minimum, maximum)
end
local function identity(value) return type(value) == "string" and value ~= "" end
local function contains(values, wanted)
    if type(values) ~= "table" then return false end
    if values[wanted] == true then return true end
    for _, value in ipairs(values) do if value == wanted then return true end end
    return false
end
local function ranks(values)
    local result = {}
    if type(values) == "table" then
        for index, value in ipairs(values) do
            if type(value) == "string" and not result[value] then result[value] = #values - index + 1 end
        end
    end
    return result
end
local function settings(config)
    config = type(config) == "table" and config or {}
    return {
        AutoCards = config.AutoCards == true,
        AutoGates = config.AutoGates == true,
        AutoStart = config.AutoStart == true,
        AutoEnter = config.AutoEnter == true,
        AutoContinue = config.AutoContinue == true,
        TargetGates = integer(config.TargetGates, 2, 2, 6),
        ElementPriority = config.ElementPriority,
        TypePriority = config.TypePriority,
        CardPriority = config.CardPriority,
        OwnerConflict = config.OwnerConflict == true,
    }
end

-- Pure ranking. Only distinct, legal offered candidates can be selected. When
-- a catalog is supplied an absent ID is never accepted. No reroll is issued.
function BossRush.RankCards(prompt, config, catalog)
    if type(prompt) ~= "table" or type(prompt.Cards) ~= "table" then return nil, "invalid-card-prompt" end
    local amount = prompt.SelectionAmount
    if type(amount) ~= "number" or amount % 1 ~= 0 or amount < 1 then return nil, "unknown-selection-amount" end
    config = settings(config)
    local elementRank, typeRank, cardRank = ranks(config.ElementPriority), ranks(config.TypePriority), ranks(config.CardPriority)
    local candidates, seen, seenIndices = {}, {}, {}
    for index, candidate in ipairs(prompt.Cards) do
        local id = type(candidate) == "table" and candidate.Id or candidate
        local definition
        if type(catalog) == "table" then definition = catalog[id]
        elseif type(candidate) == "table" then definition = candidate end
        local allowed = identity(id) and not seen[id] and (type(catalog) ~= "table" or type(definition) == "table")
        allowed = allowed and (type(candidate) ~= "table" or candidate.Eligible ~= false)
        allowed = allowed and (prompt.AllowedIds == nil or contains(prompt.AllowedIds, id))
        if allowed then
            seen[id] = true
            local element = definition and definition.Element or ""
            local kind = definition and (definition.Kind or definition.CardType) or nil
            if not kind and identity(element) then kind = id:match("^BossRush" .. element .. "(.+)$") end
            local sourceIndex = type(candidate) == "table" and candidate.Index or index
            if type(sourceIndex) == "number" and sourceIndex >= 1 and sourceIndex <= #prompt.Cards and sourceIndex % 1 == 0 and not seenIndices[sourceIndex] then
                seenIndices[sourceIndex] = true
                table.insert(candidates, { Id = id, Index = sourceIndex, Element = element, Kind = kind,
                    CardRank = cardRank[id] or 0, ElementRank = elementRank[element] or 0, TypeRank = typeRank[kind] or 0 })
            end
        end
    end
    table.sort(candidates, function(a, b)
        if a.ElementRank ~= b.ElementRank then return a.ElementRank > b.ElementRank end
        if a.TypeRank ~= b.TypeRank then return a.TypeRank > b.TypeRank end
        if a.CardRank ~= b.CardRank then return a.CardRank > b.CardRank end
        return a.Index < b.Index
    end)
    if #candidates < amount then return nil, "insufficient-legal-candidates" end
    local selected = {}
    for i = 1, amount do selected[i] = candidates[i] end
    return selected
end

function BossRush.new(adapter, options)
    assert(type(adapter) == "table", "BossRush.new requires an adapter")
    options = type(options) == "table" and options or {}
    return setmetatable({
        Adapter = adapter, Catalog = options.CardCatalog,
        Running = true, Busy = false, Generation = 1, Serial = 0,
        State = "disabled", Reason = nil, ScopeKey = nil, RoundKey = nil,
        Pending = nil, Attempts = {}, Confirmed = {}, StopReason = nil,
    }, Controller)
end

function Controller:_status(state, reason)
    self.State, self.Reason = state, reason
    return self:GetStatus()
end
function Controller:GetStatus()
    local pending = self.Pending
    return {
        State = self.State, Reason = self.Reason, Running = self.Running, Generation = self.Generation,
        ScopeKey = self.ScopeKey, RoundKey = self.RoundKey,
        Pending = pending and { Token = pending.Token, Kind = pending.Kind, Key = pending.Key, Sent = pending.Sent,
            Outcome = pending.Outcome, Payload = copy(pending.Payload), Generation = pending.Generation } or nil,
        Intent = copy(self.LastIntent), StopReason = self.StopReason,
    }
end
function Controller:_releasePending(reason, confirmed)
    local pending = self.Pending
    if not pending then return end
    self.Pending = nil
    if confirmed then self.Confirmed[pending.Key] = true end
    if type(self.Adapter.Release) == "function" then
        pcall(self.Adapter.Release, self.Adapter, pending.Lease or pending.Token, reason)
    end
end
function Controller:Stop(reason)
    self.Running = false self.Generation += 1 self.StopReason = reason or "manual"
    -- A sent/unknown native intent retains its reservation. Stop is not proof
    -- of cancellation, and old callbacks can no longer settle this generation.
    if self.Pending and not self.Pending.Sent then self:_releasePending("stopped-before-send", false) end
    return self:_status("stopped", self.StopReason)
end
function Controller:Resume()
    self.Running = true self.Generation += 1 self.StopReason = nil
    return self:_status(self.Pending and "pending-unknown" or "ready", self.Pending and "observation-required-after-resume" or nil)
end

function Controller:_settle(token, generation, result)
    local pending = self.Pending
    if not self.Running or self.Generation ~= generation or not pending or pending.Token ~= token then return false end
    if type(result) ~= "table" then pending.Outcome = "unknown" return false end
    local status = result.Status
    if status == "confirmed" then
        self:_releasePending("confirmed", true)
        self.State, self.Reason = "confirmed", nil
        return true
    elseif status == "rejected" then
        self:_releasePending("rejected", false)
        self.State, self.Reason = "rejected", result.Reason or "native-rejected"
        return true
    end
    pending.Outcome = status == "submitted" and "submitted" or "unknown"
    return false
end

function Controller:_reconcile(observation)
    local p = self.Pending
    if not p then return end
    if contains(observation.ConfirmedOperations, p.Token) then self:_releasePending("observed-ack", true) return end
    if contains(observation.RejectedOperations, p.Token) then self:_releasePending("observed-rejection", false) return end
    if identity(observation.ScopeKey) and observation.ScopeKey ~= p.ScopeKey then self:_releasePending("scope-left", false) return end
    if identity(observation.RoundKey) and observation.RoundKey ~= p.RoundKey then self:_releasePending("round-left", false) return end
    if observation.ScopeKey ~= p.ScopeKey or observation.RoundKey ~= p.RoundKey then return end
    local confirmed = false
    if p.Kind == "StartGame" then confirmed = p.BeforeActive == false and observation.Active == true
    elseif p.Kind == "StartGate" then confirmed = observation.Phase == "GateFight" and observation.ActiveGateId == p.Payload.GateId
    elseif p.Kind == "RespondGateVote" then
        confirmed = contains(observation.ResolvedGateVoteIds, p.Payload.PromptId)
            or (type(observation.GateVotePrompt) == "table" and observation.GateVotePrompt.Id == p.Payload.PromptId and observation.GateVotePrompt.Resolved == true)
    elseif p.Kind == "SelectCards" then
        confirmed = contains(observation.ResolvedPromptIds, p.Payload.PromptId)
            or (type(observation.Prompt) == "table" and observation.Prompt.Id == p.Payload.PromptId and observation.Prompt.Resolved == true)
    end
    if confirmed then self:_releasePending("native-state-confirmed", true) end
end

function Controller:_admission(kind, payload, observation, generation)
    if not self.Running or self.Generation ~= generation then return false, "stopped" end
    local config, latest = self.LatestConfig, self.LatestObservation
    if type(config) ~= "table" or type(latest) ~= "table" then return false, "waiting-observation" end
    if kind == "SelectCards" and not config.AutoCards or kind ~= "SelectCards" and not config.AutoGates then return false, "disabled" end
    if latest.Manual == true and kind ~= "SelectCards" then return false, "manual" end
    if kind == "StartGame" and not config.AutoStart then return false, "manual-start" end
    if kind == "StartGate" and not config.AutoEnter then return false, "auto-enter-disabled" end
    if kind == "RespondGateVote" and not config.AutoContinue then return false, "auto-continue-disabled" end
    if config.OwnerConflict or latest.OwnerConflict == true then return false, "waiting-owner-conflict" end
    if latest.ScopeKey ~= observation.ScopeKey or latest.RoundKey ~= observation.RoundKey or latest.StageKey ~= observation.StageKey then return false, "waiting-observation" end
    if kind ~= "SelectCards" and latest.MacroBusy ~= false then return false, "waiting-macro-transition" end
    if kind == "SelectCards" then
        local prompt = latest.Prompt
        if type(prompt) ~= "table" or prompt.Id ~= payload.PromptId or prompt.Resolved == true then return false, "waiting-card-prompt" end
    elseif kind == "RespondGateVote" then
        local prompt = latest.GateVotePrompt
        if type(prompt) ~= "table" or prompt.Id ~= payload.PromptId or prompt.Resolved == true
            or prompt.CompletedGates ~= payload.CompletedGates then return false, "waiting-gate-vote" end
        local wanted = prompt.CompletedGates >= config.TargetGates and "FightBoss" or "Continue"
        if wanted ~= payload.Choice or wanted == "FightBoss" and prompt.CanFightBoss ~= true
            or wanted == "Continue" and prompt.CanContinue ~= true then return false, "waiting-gate-vote" end
    elseif kind == "StartGame" then
        if latest.StartPromptId ~= payload.PromptId or latest.Active ~= false and latest.StartPromptVerified ~= true then return false, "waiting-observation" end
    elseif kind == "StartGate" then
        if type(latest.CompletedGates) ~= "number" or latest.CompletedGates < 0 or latest.CompletedGates % 1 ~= 0
            or latest.CompletedGates >= config.TargetGates then return false, "waiting-gate-vote" end
        local eligible = false
        for _, gate in ipairs(latest.AvailableGates or {}) do
            if gate.Id == payload.GateId and gate.Eligible == true and gate.Cleared ~= true then eligible = true break end
        end
        if not eligible then return false, "waiting-gate" end
    end
    return true
end

function Controller:_issue(kind, payload, observation, config, domain)
    if self.Pending then return self:_status("pending-unknown", "awaiting-native-confirmation") end
    local context = { ScopeKey = observation.ScopeKey, RoundKey = observation.RoundKey, StageKey = observation.StageKey }
    -- Prompt and physical Gate identities survive a transient stage-label
    -- change. Do not let that change re-enable an already submitted response.
    local key = table.concat({ context.ScopeKey, context.RoundKey, kind,
        tostring(payload.GateId or payload.PromptId or "") }, "|")
    if self.Confirmed[key] then return self:_status("waiting-state-change", "operation-already-confirmed") end
    if (self.Attempts[key] or 0) >= 1 then return self:_status("retry-exhausted", "same-prompt-or-stage-will-not-resubmit") end
    if type(self.Adapter.Supports) ~= "function" or type(self.Adapter.Dispatch) ~= "function" then
        return self:_status("waiting-native-interface", kind)
    end
    local generation = self.Generation
    local admitted, admissionState = self:_admission(kind, payload, context, generation)
    if not admitted then return self:_status(admissionState, "native-admission-revoked") end
    local supportedOK, supported = pcall(self.Adapter.Supports, self.Adapter, kind, observation)
    admitted, admissionState = self:_admission(kind, payload, context, generation)
    if not admitted then return self:_status(admissionState, "native-admission-revoked") end
    if not supportedOK or supported ~= true then return self:_status("waiting-native-interface", kind) end
    self.Serial += 1
    local token = type(self.Adapter.NextToken)=="function" and self.Adapter:NextToken(context.ScopeKey,self.Generation)
        or context.ScopeKey .. ":" .. tostring(self.Generation) .. ":" .. tostring(self.Serial)
    local intent = { Token = token, Kind = kind, Domain = domain or "transition", Payload = copy(payload),
        ScopeKey = context.ScopeKey, RoundKey = context.RoundKey, StageKey = context.StageKey, Generation = self.Generation }
    local pending = { Token = token, Key = key, Kind = kind, Payload = copy(payload), ScopeKey = context.ScopeKey,
        RoundKey = context.RoundKey, Generation = generation, BeforeActive = observation.Active, Sent = false, Outcome = "reserved" }
    self.Pending = pending -- reserve before any adapter call that could re-enter/yield
    if type(self.Adapter.TryReserve) == "function" then
        local ok, lease = pcall(self.Adapter.TryReserve, self.Adapter, intent.Domain, token, copy(intent))
        if not ok or lease == nil or lease == false then
            if self.Pending == pending then self.Pending = nil end
            return self:_status("waiting-owner", ok and "domain-owned" or "reservation-error")
        end
        pending.Lease = lease
    end
    if not self.Running or self.Generation ~= generation or self.Pending ~= pending then
        if type(self.Adapter.Release) == "function" then pcall(self.Adapter.Release, self.Adapter, pending.Lease or token, "stopped-before-send") end
        return self:GetStatus()
    end
    admitted, admissionState = self:_admission(kind, payload, context, generation)
    if not admitted then
        self:_releasePending("admission-revoked-before-send", false)
        return self:_status(admissionState, "native-admission-revoked")
    end
    self.Attempts[key] = (self.Attempts[key] or 0) + 1
    self.LastIntent, pending.Sent, pending.Outcome = copy(intent), true, "unknown"
    local ok, result = pcall(self.Adapter.Dispatch, self.Adapter, copy(intent), function(outcome)
        return self:_settle(token, generation, outcome)
    end)
    if self.Generation ~= generation or not self.Running then return self:GetStatus() end
    if not ok then
        if self.Pending == pending then pending.Outcome = "unknown" end
        return self:_status("pending-unknown", "native-dispatch-threw-outcome-unknown")
    end
    -- A synchronous callback may have already settled; never recreate it.
    if self.Pending == pending then self:_settle(token, generation, result) end
    if self.Pending then return self:_status("pending-unknown", "awaiting-native-confirmation") end
    return self:GetStatus()
end

-- Gate transitions only observe MacroBusy; this Module never calls Macro,
-- changes Macro toggles, places/upgrades units, or takes combat ownership.
function Controller:_tick(observation, config)
    observation = type(observation) == "table" and observation or {}
    config = settings(config)
    if not self.Running then return self:_status("stopped", self.StopReason) end
    self:_reconcile(observation)
    if config.OwnerConflict or observation.OwnerConflict == true then
        return self:_status("waiting-owner-conflict", self.Pending and "unknown-reservation-retained" or "another-operation-owns-context")
    end
    if not config.AutoCards and not config.AutoGates or observation.Manual == true and not config.AutoCards then
        return self:_status(self.Pending and "pending-paused" or (observation.Manual and "manual" or "disabled"), self.Pending and "unknown-reservation-retained" or nil)
    end
    if not identity(observation.ScopeKey) or not identity(observation.RoundKey) then return self:_status("waiting-observation", "scope-or-round-unknown") end
    if self.ScopeKey ~= observation.ScopeKey or self.RoundKey ~= observation.RoundKey then
        self.ScopeKey, self.RoundKey = observation.ScopeKey, observation.RoundKey
        self.Attempts, self.Confirmed = {}, {}
    end
    if observation.InGame ~= true or observation.Mode ~= "BossRush" then return self:_status("not-boss-rush", nil) end
    if not identity(observation.MapId) or not identity(observation.StageKey) then return self:_status("waiting-observation", "map-or-stage-unknown") end
    if self.Pending then return self:_status("pending-unknown", "awaiting-native-confirmation") end

    -- An actual unresolved prompt is authoritative; no phase-name guessing is
    -- needed to select a card. Disabled card automation does not dismiss it.
    local prompt = observation.Prompt
    if type(prompt) == "table" and identity(prompt.Id) and prompt.Resolved ~= true then
        if not config.AutoCards then return self:_status("manual-card-prompt", "auto-cards-disabled") end
        local selected, reason = BossRush.RankCards(prompt, config, self.Catalog)
        if not selected then return self:_status("waiting-card-prompt", reason) end
        local ids, indices = {}, {}
        for i, entry in ipairs(selected) do ids[i], indices[i] = entry.Id, entry.Index end
        return self:_issue("SelectCards", { PromptId = prompt.Id, Ids = ids, Indices = indices, SelectionAmount = #selected }, observation, config, "prompt")
    end
    -- Manual setup protects movement and battle transitions, not the separate
    -- card switch. Actual recording disables AutoCards at its permission source.
    if observation.Manual == true then return self:_status("manual", "transitions-paused") end
    if not config.AutoGates then return self:_status("observing", "auto-gates-disabled") end
    if observation.MacroBusy ~= false then
        return self:_status("waiting-macro-transition", observation.MacroBusy == true and "macro-action-in-flight" or "macro-activity-unknown")
    end

    local vote = observation.GateVotePrompt
    if type(vote) == "table" and identity(vote.Id) and vote.Resolved ~= true then
        if not config.AutoContinue then return self:_status("manual-gate-vote", "auto-continue-disabled") end
        local cleared = vote.CompletedGates
        if type(cleared) ~= "number" or cleared < 0 or cleared % 1 ~= 0 then return self:_status("waiting-observation", "confirmed-gate-count-unknown") end
        if cleared >= config.TargetGates then
            if vote.CanFightBoss ~= true then return self:_status("waiting-boss-unlock", "target-reached-no-extra-gate") end
            return self:_issue("RespondGateVote", { PromptId = vote.Id, Choice = "FightBoss", CompletedGates = cleared }, observation, config, "transition")
        end
        if vote.CanContinue ~= true then return self:_status("waiting-gate-vote", "continue-not-confirmed-available") end
        return self:_issue("RespondGateVote", { PromptId = vote.Id, Choice = "Continue", CompletedGates = cleared }, observation, config, "transition")
    end
    if observation.Phase == "Ready" and identity(observation.StartPromptId) then
