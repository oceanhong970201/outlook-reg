function Controller:IsGameReady()
    local active = statePath(currentGameState(), "Active")
    if active == true then return true end
    local currentState = statePath(currentGameState(), "CurrentGameState")
    return currentState == "InProgress" and Fusion.peek(Shared.IsInGame) == true
end

function Controller:TryAutoStart()
    if self:ResolveContext().BossRushPhase or statePath(currentGameState(), "Parameters", "Gamemode")=="BossRush" then return false,"Boss Rush start is owned by its explicit Auto Start toggle"end
    local catalogStartOperation=self.CatalogExpected
    if not self:CheckCatalogAction(catalogStartOperation)then return false,"Macro context changed"end
    local infernalStartOperation=self.InfernalExpected
    if not self:CheckInfernalAction(infernalStartOperation)then return false,"Infernal Macro context changed"end
    local wave, gameTime = currentClock()
    if wave > 0 or gameTime > 0 then return false, "already started" end
    local now = os.clock()
    if self.LastStartVoteAt > 0 and now - self.LastStartVoteAt < 2 then return false, "vote cooldown" end
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false, "player GUI is unavailable" end
    for _, descendant in ipairs(playerGui:GetDescendants()) do
        if descendant:IsA("TextLabel") and descendant.Visible and descendant.Text == "Start Game" then
            local button = descendant.Parent
            while button and not button:IsA("GuiButton") do button = button.Parent end
            if button then
                local fired = false
                withGameIdentity(function()
                    if not self:CheckInfernalAction(infernalStartOperation)or not self:CheckCatalogAction(catalogStartOperation)then return end
                    local fireSignal = firesignal or fire_signal
                    if type(fireSignal) == "function" then
                        fireSignal(button.Activated)
                        fired = true
                    elseif type(getconnections) == "function" then
                        for _, connection in ipairs(getconnections(button.Activated)) do
                            if connection.Enabled ~= false and type(connection.Function) == "function" then
                                if infernalStartOperation or catalogStartOperation then
                                    local callback=connection.Function
                                    task.spawn(function()if self:CheckInfernalAction(infernalStartOperation)and self:CheckCatalogAction(catalogStartOperation)then callback()end end)
                                else task.spawn(connection.Function)end
                                fired = true
                            end
                        end
                    end
                end)
                if fired then
                    self.LastStartVoteAt = now
                    self.StartVoteAttempts += 1
                    pushLog("info", "start vote submitted", self.StartVoteAttempts)
                    return true
                end
            end
        end
    end
    return false, "start vote prompt not found"
end

function Controller:NotifyMacroStart(selected, context)
    if type(selected) ~= "string" or selected == "" or type(context) ~= "table" then return false end
    local key = table.concat({ selected, tostring(context.GameId), tostring(context.RoundSerial), tostring(context.Gamemode), tostring(context.MapName), tostring(context.ActName) }, "|")
    if not self.PendingPlayNotice and self.LastNotifiedPlaybackKey == key then return false end
    local description = "Playing: " .. selected
    local details = table.concat({ tostring(context.Gamemode or ""), tostring(context.DisplayName or context.MapName or ""), tostring(context.ActName or "") }, " • ")
    if details:gsub("[%s•]", "") ~= "" then description ..= "\n" .. details end
    local gui = Environment.__AnimeExpeditionsGuiController
    local library = type(gui) == "table" and gui.Library or nil
    local notified = false
    if type(library) == "table" and type(library.Notify) == "function" then
        notified = pcall(function()
            library:Notify({ Title = "Play Macro", Description = description, Time = 4, Icon = "list-video" })
        end)
    else
        notified = pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Play Macro", Text = description, Duration = 4 })
        end)
    end
    if notified then
        self.PendingPlayNotice = false
        self.LastNotifiedPlaybackKey = key
        pushLog("info", "macro notification", selected)
    end
    return notified
end

local function getGamePlayerReplica()
    return Nodes.GET_GAME_PLAYER_REPLICA:InvokeSelf()
end

local function fireGamePlayer(actionName, ...)
    local arguments = table.pack(...)
    local catalogOperation=Controller.CatalogExpected
    local infernalOperation=Controller.InfernalExpected
    local bossOperation=Controller.BossExpected
    return withGameIdentity(function()
        assert(Controller:CheckBossRushAction(bossOperation),"Boss Rush scene changed before native action")
        assert(Controller:CheckInfernalAction(infernalOperation),"Infernal Macro context changed before native action")
        assert(Controller:CheckCatalogAction(catalogOperation),"Macro context changed before replica lookup")
        local replica = getGamePlayerReplica()
        assert(replica, "game player replica is unavailable")
        assert(Controller:CheckCatalogAction(catalogOperation),"Macro context changed during replica lookup")
        assert(Controller:CheckInfernalAction(infernalOperation),"Infernal Macro context changed during native replica lookup")
        assert(Controller:CheckBossRushAction(bossOperation),"Boss Rush scene changed during replica lookup")
        replica:FireServer(actionName, table.unpack(arguments, 1, arguments.n))
        return true
    end)
end

local function parseTime(raw)
    if type(raw) == "number" then return 0, raw end
    local wave, seconds = tostring(raw or ""):match("^%s*(%-?%d+)%s+([%d%.%-]+)%s*$")
    if wave then return tonumber(wave) or 0, tonumber(seconds) or 0 end
    return 0, tonumber(raw) or 0
end

local function formatTime()
    local wave, seconds = currentClock()
    return string.format("%d %.6f", wave, seconds)
end

local function parseCFrame(raw)
    if typeof(raw) == "CFrame" then return raw end
    if type(raw) == "table" then
        local numbers = raw.Components or raw
        if #numbers >= 12 then return CFrame.new(table.unpack(numbers, 1, 12)) end
        if #numbers >= 3 then return CFrame.new(numbers[1], numbers[2], numbers[3]) end
    end
    local numbers = {}
    for token in tostring(raw or ""):gmatch("[-+]?%d*%.?%d+[eE]?[-+]?%d*") do
        table.insert(numbers, tonumber(token))
    end
    if #numbers >= 12 then return CFrame.new(table.unpack(numbers, 1, 12)) end
    if #numbers >= 3 then return CFrame.new(numbers[1], numbers[2], numbers[3]) end
    return nil
end

local function formatCFrame(value)
    if typeof(value) ~= "CFrame" then return tostring(value) end
    local components = table.pack(value:GetComponents())
    local strings = {}
    for index = 1, components.n do strings[index] = tostring(components[index]) end
    return table.concat(strings, ", ")
end

local function hotbarEntries()
    local playerData = stateValue(Dependencies.PlayerData) or {}
    local unitData = statePath(playerData, "UnitData") or {}
    local slots = statePath(Dependencies.HotbarState, "Slots") or {}
    local result = {}
    for index = 1, 6 do
        local slot = stateValue(slots[tostring(index)]) or {}
        local unitId = statePath(slot, "ID")
        local unit = unitId and stateValue(unitData[unitId]) or nil
        local asset = unit and statePath(unit, "Asset") or nil
        result[index] = {
            Slot = index,
            UnitId = unitId,
            Asset = asset,
            DisplayName = displayNameForAsset(asset),
            Trait = unit and statePath(unit, "Trait") or nil,
            Level = unit and statePath(unit, "Level") or nil,
            StatPotential = unit and statePath(unit, "StatPotential") or nil,
            Equipment = unit and statePath(unit, "Equipment") or nil,
            EquipmentData = unit and statePath(unit, "EquipmentData") or nil,
        }
    end
    return result
end

local function slotForDisplayName(displayName)
    for _, entry in ipairs(hotbarEntries()) do
        if entry.DisplayName == displayName or entry.Asset == displayName then return entry.Slot end
    end
    return nil
end

local function liveUnitEntries()
    local units = stateValue(Dependencies.GameUnits) or {}
    local models = stateValue(Dependencies.GameUnitModels) or {}
    local result = {}
    for replicaId, modelState in pairs(models) do
        local model = stateValue(modelState)
        local data = stateValue(units[model] or units[replicaId]) or {}
        local owner = statePath(data, "Owner")
        if owner == nil or owner == LocalPlayer then
            local asset = statePath(data, "Asset") or statePath(data, "Unit", "Asset") or statePath(data, "UnitData", "Asset")
            table.insert(result, {
                Id = tostring(replicaId),
                Model = model,
                Data = data,
                Asset = asset,
                DisplayName = displayNameForAsset(asset),
            })
        end
    end
    table.sort(result, function(a, b)
        local an, bn = tonumber(a.Id), tonumber(b.Id)
        if an and bn then return an < bn end
        return a.Id < b.Id
    end)
    return result
end

local function splitUnitLabel(label)
    local name, ordinal = tostring(label or ""):match("^(.-)%s+%-%s+(%d+)$")
    return name or tostring(label or ""), tonumber(ordinal) or 1
end

function Controller:ResolveUnitId(label)
    local liveUnits = liveUnitEntries()
    local liveIds = {}
    for _, unit in ipairs(liveUnits) do liveIds[unit.Id] = true end
    local cachedId = self.LiveUnitIds[label]
    if cachedId then
        for _, unit in ipairs(liveUnits) do
            if unit.Id == tostring(cachedId) then return unit.Id end
        end
        self.LiveUnitIds[label] = nil
    end
    local reservedIds = {}
    for otherLabel, unitId in pairs(self.LiveUnitIds) do
        unitId = tostring(unitId)
        if otherLabel ~= label and liveIds[unitId] then reservedIds[unitId] = true end
    end
    local displayName, ordinal = splitUnitLabel(label)
    local placementAction
    local seenPlacements = 0
    for _, action in ipairs(self.LoadedMacro and self.LoadedMacro.Actions or {}) do
        if action.Type == "PlaceUnit" and action.Unit == displayName then
            seenPlacements += 1
            if seenPlacements == ordinal then placementAction = action break end
        end
    end
    local placementCFrame = placementAction and parseCFrame(placementAction.Pos or placementAction.CFrame) or nil
    local closestUnit, closestDistance
    local seen = 0
    for _, unit in ipairs(liveUnits) do
        if unit.DisplayName == displayName or unit.Asset == displayName then
            seen += 1
            if not reservedIds[unit.Id] and placementCFrame and typeof(unit.Model) == "Instance" then
                local distance = (unit.Model:GetPivot().Position - placementCFrame.Position).Magnitude
                if not closestDistance or distance < closestDistance then closestUnit, closestDistance = unit, distance end
            end
            if seen == ordinal and not reservedIds[unit.Id] then
                self.LiveUnitIds[label] = unit.Id
                if not placementCFrame then return unit.Id end
            end
        end
    end
    if closestUnit then
        self.LiveUnitIds[label] = closestUnit.Id
        return closestUnit.Id
    end
    return nil
end

local function unitLabelFromId(unitId)
    local target = tostring(unitId)
    if Controller.RecordUnitLabels[target] then return Controller.RecordUnitLabels[target] end
    local liveUnits = liveUnitEntries()
    local targetUnit
    for _, unit in ipairs(liveUnits) do
        if unit.Id == target then
            targetUnit = unit
            break
        end
    end
    if not targetUnit then return nil end

    local assignedLabels = {}
    for _, label in pairs(Controller.RecordUnitLabels) do assignedLabels[label] = true end
    local targetPosition = targetUnit.Model and targetUnit.Model:GetPivot().Position or nil
    local closestLabel, closestDistance
    for _, action in ipairs(Controller.RecordData and Controller.RecordData.Actions or {}) do
        if action.Type == "PlaceUnit" and action.Unit == targetUnit.DisplayName and action.Label and not assignedLabels[action.Label] then
            local recordedCFrame = parseCFrame(action.Pos)
            local distance = targetPosition and recordedCFrame and (targetPosition - recordedCFrame.Position).Magnitude or math.huge
            if not closestDistance or distance < closestDistance then
                closestLabel, closestDistance = action.Label, distance
            end
        end
    end
    if closestLabel then
        Controller.RecordUnitLabels[target] = closestLabel
        return closestLabel
    end

    for _, unit in ipairs(liveUnits) do
        if unit.Id == target then
            local ordinal = 0
            for _, candidate in ipairs(liveUnits) do
                if candidate.DisplayName == unit.DisplayName then ordinal += 1 end
                if candidate.Id == target then break end
            end
            local label = string.format("%s - %d", unit.DisplayName or unit.Asset or "Unit", math.max(1, ordinal))
            Controller.RecordUnitLabels[target] = label
            return label
        end
    end
    return nil
end

local function requiredUnits(actions)
    local result, seen = {}, {}
    for _, action in ipairs(actions or {}) do
        if action.Type == "PlaceUnit" and type(action.Unit) == "string" and not seen[action.Unit] then
            seen[action.Unit] = true
            table.insert(result, action.Unit)
        end
    end
    return result
end

-- CATALOG_RUNTIME_BEGIN
local function catalogMode(mode)
    return ({UnitTrial="Trial",Tower="TowerOfGod"})[mode] or mode
end
local function catalogControls()
    local gui=Environment.__AnimeExpeditionsGuiController
    return type(gui)=="table" and gui.Spec or {},gui
end
function Controller:IsCatalogKey(key)
    local spec=catalogControls()
    for _,binding in ipairs(spec.macroCatalogBindings or{})do if binding.Key==key then return true end end
    return false
end
function Controller:ResolveCatalogSelector(context)
    local spec=catalogControls()
    local bindings=spec.macroCatalogBindings
    if type(bindings)~="table" then return nil,false end
    local mode=catalogMode(context.Gamemode)
    if mode=="BossRush" and context.BossRushPhase~="Gates" and context.BossRushPhase~="Boss"then return nil,true end
    local rift=context.RiftName
    local hasRift=type(rift)=="string" and rift~=""
    local found,covered,score=nil,false,-1
    for _,binding in ipairs(bindings) do
        local c=binding.Context
        if type(c)=="table" then
            local sameMode=catalogMode(c.Gamemode)==mode
            if sameMode or hasRift then covered=true end
            local matches=hasRift and c.RiftName==rift or (not hasRift and c.RiftName==nil and sameMode)
            if mode=="Trial" and not hasRift and (type(context.TrialUnit)~="string" or context.TrialUnit=="") then matches=false end
            if mode=="Portal" and not hasRift and c.PortalAsset==nil and type(context.PortalAsset)=="string" and context.PortalAsset~="" then matches=false end
            if mode=="BossRush" and (c.BossRushPhase or "Gates")~=context.BossRushPhase then matches=false end
            local rank=0
            for _,field in ipairs({"MapName","ActName","TrialUnit","PortalAsset","RiftName","BossRushPhase"})do
                if c[field]~=nil then rank+=1 if c[field]~=context[field] then matches=false end end
            end
            if matches then
                local control
                for _,page in ipairs(spec.pages or{})do if page.name=="Macro"then for _,section in ipairs(page.sections or{})do
                    for _,candidate in ipairs(section.controls or{})do if candidate.key==binding.Key then
                        if control then return nil,true end
                        control=candidate
                    end end
                end end end
                if not control or control.type~="dropdown"then return nil,true end
                if control.key:sub(1,13)=="AE-MACRO-MAP-"then
                    if type(control.macroContext)~="table"then return nil,true end
                    for _,field in ipairs({"Gamemode","MapName","ActName","TrialUnit","PortalAsset","RiftName","BossRushPhase"})do
                        if control.macroContext[field]~=c[field]then return nil,true end
                    end
                end
                if rank>score then found,score=binding.Key,rank
                elseif rank==score and found~=binding.Key then return nil,true end
            end
        end
    end
    return found,covered or hasRift
end
function Controller:CatalogSelectorInfo(context)
    local key,covered=self:ResolveCatalogSelector(context)
    local spec=catalogControls()
    for _,page in ipairs(spec.pages or{})do if page.name=="Macro"then for _,section in ipairs(page.sections or{})do
        for _,control in ipairs(section.controls or{})do if control.key==key then return control,covered end end
    end end end
    return nil,covered
end
function Controller:CheckCatalogFile(macro,context)
    if type(macro)~="table" or macro.InvalidContext then return false,"Malformed Macro context"end
    local recorded=macro.Context
    if type(recorded)~="table"then
        if context.RiftName and context.RiftName~=""then return false,"Record a dedicated Rift Macro before assigning it"end
        return true
    end
    if context.RiftName and context.RiftName~=""then
        for _,field in ipairs({"Gamemode","MapName","ActName","Difficulty"})do
            if type(recorded[field])~="string"or recorded[field]==""then return false,"Record the full Rift stage context before playback"end
        end
    end
    -- Story selectors are per map, not per Act. Keep other scene identities strict.
    local shareStoryAct=false
    if catalogMode(context.Gamemode)=="Story" and catalogMode(recorded.Gamemode)=="Story"
        and type(context.MapName)=="string" and recorded.MapName==context.MapName
        and not context.RiftName and not recorded.RiftName
        and type(context.ActName)=="string" and context.ActName:match("^Act [1-5]$")
        and type(recorded.ActName)=="string" and recorded.ActName:match("^Act [1-5]$")then
        local key=self:ResolveSelectorKey(context)
        local spec=catalogControls()
        for _,binding in ipairs(spec.macroCatalogBindings or{})do
            local c=binding.Context
            if binding.Key==key and type(c)=="table" and c.Gamemode=="Story"
                and c.MapName==context.MapName and c.ActName==nil and c.RiftName==nil then
                shareStoryAct=true break
            end
        end
    end
    for _,field in ipairs({"Gamemode","MapName","ActName","Difficulty","TrialUnit","PortalAsset","RiftName"})do
        local a,b=recorded[field],context[field]
        if field=="Gamemode"then a,b=catalogMode(a),catalogMode(b)end
        if a~=nil and a~=b and not(field=="ActName" and shareStoryAct)then return false,"Recorded "..field.." does not match this stage"end
    end
    if context.RiftName and context.RiftName~="" and recorded.RiftName~=context.RiftName then return false,"Rift context is not recorded"end
    return true
end
function Controller:CheckCatalogAction(expected)
    expected=expected or self.CatalogExpected
    if not expected then return true end
    if self.CatalogExpected~=expected or not ownsMacroAccount()or Environment[STATE_KEY]~=self
        or not self.Running or not self.Playing or self.Recording or value(FEATURE.Play,false)~=true then return false end
    local selected,current=self:ResolveSelectedMacro()
    if selected~=expected.Macro or self:ResolveSelectorKey(current)~=expected.Key then return false end
    for _,field in ipairs({"Gamemode","MapName","ActName","Difficulty","TrialUnit","PortalAsset","RiftName","GameId","NativeRound","RoundSerial"})do
        if current[field]~=expected.Context[field]then return false end
    end
    return true
end
function Controller:CatalogMappingChanged(key)
    if self.RefreshingCatalogOptions then return end
    if self:ResolveSelectorKey(self:ResolveContext())~=key then return end
    self.CatalogExpected=nil
    if self.Busy or self.ActiveOperations>0 then self.CatalogResetPending=true
    else self:ResetPlayback("catalog-selection-changed")end
end
-- CATALOG_RUNTIME_END

local function selectorForContext(gamemode, displayName, actName)
    if type(gamemode) ~= "string" or type(displayName) ~= "string" then return nil, nil end
    actName = type(actName) == "string" and actName or "Act 1"
    if gamemode == "Raid" then return "Select Raid Macro", displayName .. " (" .. actName .. ")" end
    if gamemode == "Challenge" then return "Select Challenge Macro", displayName end
    if gamemode == "Expedition" then return "Select Expedition Macro", displayName end
    if gamemode == "Infinite" then return "Select Infinite Macro", displayName end
    if gamemode == "Mastery" then return "Select Mastery Macro", displayName end
    if gamemode == "Story" then return "Select Story Macro", displayName end
    if gamemode == "InfernalCult" then return "Select Infernal Cult Macro", displayName end
    if gamemode == "TowerOfGod" or gamemode == "Tower" then return "Select Tower Macro", "Tower - " .. displayName end
    if gamemode == "Portal" then return "Select Portal Macro", displayName end
    if gamemode == "UnitTrial" or gamemode == "Trial" then return "Select Unit Trial Macro", displayName end
    if gamemode == "Event" then return "[EVENT] Select Event Macro", displayName end
    return nil, nil
end

-- BOSSRUSH_MACRO_PHASES_BEGIN
-- The native Boss Rush adapter owns discovery. Read fresh values before every
-- scene-sensitive operation, never infer readiness from Wave=0 or GUI text.
function Controller:ReadBossRushContext()
    local boss=Environment.__AnimeExpeditionsBossRush
    local reader=type(boss)=="table" and boss.ReadMacroContext
    if type(reader)~="function"then return nil end
    local ok,c=pcall(reader,boss)
    if not ok or type(c)~="table"or(c.Phase~="Gates"and c.Phase~="Boss")
        or type(c.RunId)~="string"or c.RunId==""then return nil end
    return c
end
function Controller:BossRushPlaybackAllowed(context)
    return type(context)=="table" and (context.BossRushPhase=="Gates"or context.BossRushPhase=="Boss")
        and type(context.BossRushRunId)=="string" and context.BossRushRunId~=""
        and ownsMacroAccount()and Environment[STATE_KEY]==self and self.Running and self.Playing
        and not self.Recording and value(FEATURE.Play,false)==true and value(FEATURE.Record,false)~=true
        and value("AE-BOSSRUSH-MANUAL",false)~=true
end
-- Recover only the historical all-Gates-cleared preparation recording whose
-- phase was mislabelled before native Boss release detection was corrected.
-- Work on a deep copy: imported/recorded JSON and the decoder input stay pristine.
function Controller:NormalizeBossRushFile(macro,context,selected)
    if context.BossRushPhase~="Boss"then return macro end
    local c=type(macro)=="table"and macro.Context
    if type(c)=="table"and c.BossRushPhase=="Boss"then return macro end
    local reason="Record a dedicated Boss Macro; this file is not eligible for safe legacy recovery"
    if type(macro)~="table"or macro.InvalidContext or type(c)~="table"
        or c.Gamemode~="BossRush"or c.MapName~="BeniBossRush"
        or c.BossRushPhase~="Gates"or c.BossRushGateIndex~=6
        or c.BossRushPlacementReady~=false or c.BossRushGateId~=nil
        or context.Gamemode~="BossRush"or context.MapName~=c.MapName
        or context.BossRushPlacementReady~=true then return nil,reason end
    local gateKey="AE-MACRO-MAP-BossRush-BeniBossRush"
    local bossKey=gateKey.."-Boss"
    if type(selected)~="string"or selected==""or self:ResolveSelectorKey(context)~=bossKey
        or value(bossKey,nil)~=selected or value(gateKey,nil)==selected then
        return nil,"Legacy Boss recovery requires a distinct, explicitly assigned Boss Macro"
    end
    if type(macro.Actions)~="table"or #macro.Actions==0 then return nil,reason end
    local stamp,placements=nil,0
    for _,action in ipairs(macro.Actions)do
        if type(action)~="table"or action.BossRushGateIndex~=6 or type(action.Time)~="string"then return nil,reason end
        if stamp==nil then stamp=action.Time elseif stamp~=action.Time then
            return nil,"Legacy recovery only supports the identical frozen preparation timestamps; record a fresh Boss Macro"
        end
        if action.Type=="PlaceUnit"then placements+=1 end
    end
    local wave,time=stamp:match("^%s*(%d+)%s+([%d%.]+)%s*$")
    wave,time=tonumber(wave),tonumber(time)
    if wave~=11 or not time or time<=0 or time==math.huge or placements<1 then return nil,reason end
    local boss=Environment.__AnimeExpeditionsBossRush
    if type(boss)~="table"or type(boss.ValidateBossMacroPlacements)~="function"then
        return nil,"Native Boss placement validation is unavailable; original Macro was not changed"
    end
    local ok,valid,why=pcall(boss.ValidateBossMacroPlacements,boss,macro)
    if not ok or valid~=true then return nil,tostring(why or "Legacy placements are not verified in the native Boss region")end
    local fresh=self:ResolveContext()
    if not self:BossRushPlaybackAllowed(fresh)or fresh.BossRushPhase~="Boss"
        or fresh.BossRushPlacementReady~=true or fresh.BossRushRunId~=context.BossRushRunId
        or fresh.GameId~=context.GameId or fresh.NativeRound~=context.NativeRound
        or Environment.__AnimeExpeditionsBossRush~=boss or self:ResolveSelectorKey(fresh)~=bossKey
        or value(bossKey,nil)~=selected or value(gateKey,nil)==selected then
        return nil,"Boss scene changed during legacy validation; no Macro action was sent"
    end
    local function copy(value,seen)
        if type(value)~="table"then return value end
        seen=seen or{};if seen[value]then return seen[value]end
        local out={};seen[value]=out;for key,item in pairs(value)do out[copy(key,seen)]=copy(item,seen)end
        return out
    end
    local normalized=copy(macro)
    normalized.BossRushRecovery={Reason="all-gates-cleared-preparation",OriginalContext=copy(c),OriginalTime=stamp}
    normalized.Context.BossRushPhase="Boss"
    normalized.Context.BossRushGateIndex=nil
    normalized.Context.BossRushPlacementReady=true
    for _,action in ipairs(normalized.Actions)do action.BossRushGateIndex=nil;action.Time="0 0"end
    return normalized
end

function Controller:CheckBossRushFile(macro,context)
    if type(macro)~="table"or macro.InvalidContext then return false,"Malformed Boss Rush Macro"end
    local c=macro.Context
    if context.BossRushPhase=="Boss" and (type(c)~="table"or c.BossRushPhase~="Boss")then
        return false,"Record and assign a separate Boss-phase Macro; Gate recordings are not reused"
    end
    if type(c)=="table"and c.BossRushPhase~=nil and c.BossRushPhase~=context.BossRushPhase then
        return false,"Recorded Boss Rush phase does not match"
    end
    return true
end
function Controller:CheckBossRushAction(expected)
    expected=expected or self.BossExpected
    local current=self:ResolveContext()
    if current.Gamemode~="BossRush"and not current.BossRushPhase and not expected then return true end
    if not expected or self.BossExpected~=expected or not self:BossRushPlaybackAllowed(current)
        or current.BossRushPlacementReady~=true then return false end
    local selected=self:ResolveSelectedMacro()
    if selected~=expected.Macro then return false end
    for _,field in ipairs({"BossRushPhase","BossRushRunId","BossRushGateId","GameId","NativeRound"})do
        if current[field]~=expected.Context[field]then return false end
    end
    return true
end
-- BOSSRUSH_MACRO_PHASES_END

function Controller:ResolveContext()
    local parameters = statePath(currentGameState(), "Parameters") or {}
    local gamemode = statePath(parameters, "Gamemode")
    local mapName = statePath(parameters, "MapName")
    local actName = statePath(parameters, "ActName") or "Act 1"
    local displayName = mapName
    if type(mapName) == "string" then
        local ok, resolved = pcall(function() return Information.Maps:GetMapDisplayName(mapName) end)
        if ok and type(resolved) == "string" and resolved ~= "" then displayName = resolved end
    end
    local selectorSection, selectorTitle = selectorForContext(gamemode, displayName, actName)
    local boss=self:ReadBossRushContext()
    if boss then gamemode="BossRush" mapName=boss.MapName or "BeniBossRush" displayName="District 7" end
    return {
        BossRushPhase=boss and boss.Phase,
        BossRushRunId=boss and boss.RunId,
        BossRushGateId=boss and boss.GateId,
        BossRushGateIndex=boss and boss.GateIndex,
        BossRushPlacementReady=boss and boss.PlacementReady==true,
        Gamemode = gamemode,
        MapName = mapName,
        DisplayName = displayName,
        ActName = actName,
        Difficulty = statePath(parameters, "Difficulty"),
        TrialUnit = statePath(parameters, "TrialUnit"),
        PortalAsset = statePath(parameters, "PortalData", "Asset"),
        RiftName = statePath(parameters, "RiftName"),
        SelectorSection = selectorSection,
        SelectorTitle = selectorTitle,
        GameId = currentGameId(),
        RoundSerial = self.RoundSerial,
        NativeRound = statePath(currentGameState(), "GameIncrement"),
    }
end

function Controller:ObserveRoundTransition()
    local context=self:ResolveContext()
    if context.Gamemode=="BossRush"then
        -- Gate sub-rounds retain units; contextKey changes only for a new run/phase.
        self.LastObservedWave=nil self.LastObservedGameState=nil
        return false
    end
    local wave = currentClock()
    local gameState = statePath(currentGameState(), "CurrentGameState")
    local restarted = self.LastObservedWave ~= nil and wave < self.LastObservedWave
    restarted = restarted or (self.LastObservedGameState ~= nil and self.LastObservedGameState ~= "InProgress" and gameState == "InProgress")
    if restarted then
        self.RoundSerial += 1
        self.ContextKey = nil
        self.CompletedGameId = nil
        self.PlaybackIndex = 1
        self.ActionAttempts = 0
        self.ExecutedActions = 0
        self.SkippedActions = 0
        self.PendingPlayNotice = true
        table.clear(self.LiveUnitIds)
        pushLog("info", "new round detected", self.RoundSerial)
    end
    self.LastObservedWave = wave
    self.LastObservedGameState = gameState
    return restarted
end

local function findControlKey(sectionName, title)
    local gui = Environment.__AnimeExpeditionsGuiController
    local pages = type(gui) == "table" and type(gui.Spec) == "table" and gui.Spec.pages or {}
    for _, page in ipairs(pages) do
        if page.name == "Macro" then
            for _, section in ipairs(page.sections or {}) do
                if section.name == sectionName then
                    for _, control in ipairs(section.controls or {}) do
                        if control.title == title then return control.key end
                    end
                end
            end
        end
    end
    return nil
end

local INFERNAL_SECTION="Select Infernal Cult Macro"
local INFERNAL_PLAY="AE-INFERNAL-MACRO-PLAY"
local INFERNAL_PREFIX="AE-INFERNAL-MACRO-MAP-"
function Controller:ResolveInfernalSelector(context)
    if type(context)~="table"or context.Gamemode~="InfernalCult"or context.Difficulty~="Hard"or context.ActName~="Act 1"
        or type(context.MapName)~="string"or not context.MapName:match("^[%w_%-]+$")then return nil end
    local gui=Environment.__AnimeExpeditionsGuiController
    local matches={}
    for _,page in ipairs(type(gui)=="table"and gui.Spec and gui.Spec.pages or{})do
        if page.name=="Macro"then for _,section in ipairs(page.sections or{})do
            if section.name==INFERNAL_SECTION then for _,control in ipairs(section.controls or{})do
                if control.type=="dropdown"and control.infernalMapId==context.MapName
                    and control.key==INFERNAL_PREFIX..context.MapName then matches[#matches+1]=control.key end
            end end
        end end
    end
    if #matches==1 then return matches[1]end
    return nil
end
function Controller:InfernalPlaybackAllowed(context,selected)
    if not ownsMacroAccount()or Environment[STATE_KEY]~=self or not self.Running or self.Recording
        or not self.Playing or value(FEATURE.Play,false)~=true or value(INFERNAL_PLAY,false)~=true then return false end
    local round=type(context)=="table"and context.NativeRound
    if type(round)~="number"or round~=round or round<0 or round==math.huge or round%1~=0 then return false end
    local key=self:ResolveInfernalSelector(context)
    return key~=nil and type(selected)=="string"and selected~=""and value(key,nil)==selected
end
function Controller:CheckInfernalFile(macro,context)
    if type(macro)~="table"or macro.InvalidContext==true then return false,"Malformed recorded Macro context"end
    local recorded=type(macro)=="table"and macro.Context
    -- Newly recorded files contain exact context. Legacy files with no context
    -- remain usable only by explicit per-map assignment, never by a fallback.
    if type(recorded)~="table"then return true end
    for _,key in ipairs({"Gamemode","MapName","Difficulty","ActName"})do
        if recorded[key]~=nil and recorded[key]~=context[key]then return false,"Recorded "..key.." does not match this Infernal Cult stage"end
    end
    return true
end
function Controller:CheckInfernalAction(operationExpected)
    local expected=operationExpected or self.InfernalExpected
    if not expected then return true end
    if operationExpected and self.InfernalExpected~=operationExpected then return false end
    local selected,current=self:ResolveSelectedMacro()
    if not self:InfernalPlaybackAllowed(current,selected)or selected~=expected.Macro
        or current.MapName~=expected.MapName or current.GameId~=expected.GameId
        or current.RoundSerial~=expected.RoundSerial or current.NativeRound~=expected.NativeRound then return false end
    return true
end
function Controller:RefreshInfernalMacroStatus()
    local selected,context=self:ResolveSelectedMacro()
    local text="Infernal Cult Macro: "..(value(INFERNAL_PLAY,false)==true and "enabled"or "off")
    if context.Gamemode=="InfernalCult"then
        text..="\nStage: "..tostring(context.DisplayName or context.MapName).." ["..tostring(context.MapName).."]"
        if not self:ResolveInfernalSelector(context)then text..="\nUnsupported or unconfigured map/stage; playback is blocked."
        elseif type(selected)~="string"or selected==""then text..="\nNo Macro assigned to this map."
        elseif not findMacroPath(selected)then text..="\nMissing Macro file: "..selected
        else text..="\nMapped Macro: "..selected end
        if self.Recording then text..="\nRecording; playback paused."
        elseif value(FEATURE.Play,false)~=true then text..="\nTurn on the main Play Macro switch to play."
        else text..="\nPlayback: "..tostring(self.Status)end
    else text..="\nAssign a separate Macro below for each map. Selection follows the actual stage, not the lobby rotation timer."end
    local gui=Environment.__AnimeExpeditionsGuiController
    local label=gui and gui.Controls and gui.Controls["AE-INFERNAL-MACRO-STATUS"]
    if label and type(label.SetText)=="function"and text~=self.InfernalLabel then pcall(label.SetText,label,text)self.InfernalLabel=text end
end
function Controller:InfernalMappingChanged(mapId)
    if self.RefreshingInfernalOptions then return end
    local c=self:ResolveContext()
    if c.Gamemode=="InfernalCult"and c.MapName==mapId then
        if self.Busy or self.ActiveOperations>0 then self.InfernalResetPending=true
        else self:ResetPlayback("infernal-map-selection-changed")end
    end
    self:RefreshInfernalMacroStatus()
end

function Controller:ResolveSelectorKey(context)
    context = context or self:ResolveContext()
    if context.Gamemode=="InfernalCult"then return self:ResolveInfernalSelector(context)end
    local catalogKey,covered=self:ResolveCatalogSelector(context)
    if covered then return catalogKey end
    local sectionName = context.SelectorSection
    local title = context.SelectorTitle
    if not sectionName then
        sectionName, title = selectorForContext(context.Gamemode, context.DisplayName or context.MapName, context.ActName)
    end
    if not sectionName or not title then return nil end
    return findControlKey(sectionName, title)
end

function Controller:ResolveSelectedMacro()
    local context = self:ResolveContext()
    local selected
    local key = self:ResolveSelectorKey(context)
    if key then selected = value(key, nil) end
    return selected, context
end

function Controller:LoadMacro(name)
    local path = findMacroPath(name)
    if not path then return nil, "macro not found: " .. tostring(name) end
    return readMacroFile(path)
end

function Controller:RefreshMacroOptions()
    local names = listMacroNames()
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) == "table" then
        for _, page in ipairs(gui.Spec and gui.Spec.pages or {}) do
            if page.name == "Macro" then
                for _, section in ipairs(page.sections or {}) do
                    for _, spec in ipairs(section.controls or {}) do
                        local control = gui.Controls and gui.Controls[spec.key]
                        if spec.type == "dropdown" and type(control) == "table" and type(control.SetValues) == "function" then
                            if spec.infernalMapId or spec.macroContext or self:IsCatalogKey(spec.key)then
                                local saved=value(spec.key,nil)
                                local options=table.clone(names)
                                if type(saved)=="string"and saved~=""and not table.find(options,saved)then table.insert(options,saved)end
                                self.RefreshingInfernalOptions=true self.RefreshingCatalogOptions=true
                                pcall(function()
                                    control:SetValues(options)
                                    if type(control.SetValue)=="function"then control:SetValue(saved)end
                                end)
                                uiState()[spec.key]=saved
                                self.RefreshingInfernalOptions=false self.RefreshingCatalogOptions=false
                            else pcall(function() control:SetValues(names) end)end
                        end
                    end
                end
            end
        end
    end
    return names
end

function Controller:SetManagedMacro(name)
    self.ManagedMacro = name
    uiState()[FEATURE.Select] = name
    self:RefreshMacroOptions()
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) == "table" then pcall(function() gui:SetValue(FEATURE.Select, name) end) end
    return name
end

function Controller:CreateMacro(name)
    name = safeMacroName(name)
    if name == "" then return false, "macro name is empty" end
    local data = { Version = 2, Name = name, Context = self:ResolveContext(), Actions = {} }
    local path = writeOwnMacro(name, data)
    self:SetManagedMacro(name)
    pushLog("success", "macro created", path)
    return true, path
end

function Controller:DeleteSelectedMacro()
    if not ownsMacroAccount() then return false, "macro account is no longer active" end
    local name = value(FEATURE.Select, self.ManagedMacro)
    local path = name and findMacroPath(name) or nil
    if not path then return false, "selected macro was not found" end
    assert(type(delfile) == "function", "delfile is unavailable")
    delfile(path)
    self:SetManagedMacro(nil)
    pushLog("success", "macro deleted", name)
    return true
end

function Controller:ImportMacro(input)
    if type(input) ~= "string" or input == "" then return false, "macro import is empty" end
    local raw = input
    if input:match("^https?://") then raw = game:HttpGet(input)
    elseif input == macroPath(NOUSIGI_MACRO_FOLDER, safeMacroName(basename(input))) then
        -- Explicit read-only import, never an implicit account-settings migration.
        if type(readfile) ~= "function" then return false, "readfile is unavailable" end
        raw = readfile(input)
    end
    local decoded = HttpService:JSONDecode(raw)
    local actions = sortedMacroActions(decoded)
    if #actions == 0 then return false, "imported macro has no actions" end
    local name = safeMacroName(decoded.Name)
    if name == "" then name = "Imported_" .. os.date("%Y%m%d_%H%M%S") end
    local data = { Version = 2, Name = name, Context = decoded.Context, Actions = actions }
    local path = writeOwnMacro(name, data)
    self:SetManagedMacro(name)
    pushLog("success", "macro imported", path)
    return true, path
end

function Controller:ExportSelected()
    local name = value(FEATURE.Select, self.ManagedMacro)
    local path = name and findMacroPath(name) or nil
    if not path then return false, "selected macro was not found" end
    local raw = readfile(path)
    assert(type(setclipboard) == "function", "setclipboard is unavailable")
    setclipboard(raw)
    pushLog("success", "macro JSON copied", name)
    return true, raw
end

function Controller:SendSelectedToWebhook()
    if self.MacroWebhookSending then return false, "A Macro file upload is already in progress" end
    self.MacroWebhookSending = true
    -- This button does not share Macro.Busy: uploading must not pause playback.
    local ok, sent, detail = pcall(function()
        local secrets = Environment.__AnimeExpeditionsWebhookSecrets
        local webhook = type(secrets) == "table" and secrets["NUI-0594"] or nil
        if type(webhook) ~= "string" or webhook == "" then webhook = Environment.AnimeExpeditionsMacroWebhook end
        if type(webhook) ~= "string" or webhook == "" then return false, "Webhook URL is empty" end
        local name = value(FEATURE.Select, self.ManagedMacro)
        local path = name and findMacroPath(name) or nil
        if not path then return false, "Selected Macro was not found" end
        local requestFunction = type(request) == "function" and request
            or type(http_request) == "function" and http_request
            or type(syn) == "table" and type(syn.request) == "function" and syn.request
        if type(requestFunction) ~= "function" then return false, "HTTP request is unavailable" end
        local readable, contents = pcall(readfile, path)
        if not readable or type(contents) ~= "string" or contents == "" then return false, "Cannot read the selected Macro JSON file" end
        local valid, decoded = pcall(HttpService.JSONDecode, HttpService, contents)
        if not valid or type(decoded) ~= "table" then return false, "Selected Macro file contains invalid JSON" end
        local filename = safeMacroName(name)
        if filename == "" then filename = "macro" end
        filename = filename .. ".json"
        local payload = HttpService:JSONEncode({
            content = "Macro: " .. filename,
            allowed_mentions = { parse = {} },
            attachments = { { id = 0, filename = filename } },
        })
        local seed = "----AEMacroFile" .. HttpService:GenerateGUID(false):gsub("[^%w]", "")
        local boundary
        for index = 1, 16 do
            local candidate = seed .. tostring(index)
            if not contents:find(candidate, 1, true) and not payload:find(candidate, 1, true) then boundary = candidate break end
        end
        if not boundary then return false, "Could not build a safe file upload boundary" end
        -- Preserve the original UTF-8 JSON bytes, not normalized playback data.
        local body = table.concat({
            "--" .. boundary .. "\r\n",
            'Content-Disposition: form-data; name="payload_json"\r\n',
            "Content-Type: application/json\r\n\r\n", payload, "\r\n",
            "--" .. boundary .. "\r\n",
            'Content-Disposition: form-data; name="files[0]"; filename="' .. filename .. '"\r\n',
            "Content-Type: application/json\r\n\r\n", contents, "\r\n",
            "--" .. boundary .. "--\r\n",
        })
        local delivered, response = pcall(requestFunction, {
            Url = webhook, Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
        if not delivered then return false, "Macro file upload failed or timed out; delivery is unconfirmed. Check the channel before retrying" end
        local status = tonumber(type(response) == "table" and (response.StatusCode or response.Status)) or 0
        if status < 200 or status >= 300 or status ~= status then
            if status == 413 then return false, "Macro JSON exceeds the webhook attachment size limit" end
            if status == 429 then return false, "Webhook rate limited the upload; retry manually later" end
            return false, "Webhook returned " .. tostring(status) .. "; Macro file upload was not confirmed"
        end
        pushLog("success", "Macro JSON file uploaded", filename)
        return true, status
    end)
    self.MacroWebhookSending = false
    -- Executor error messages can include secret webhook URLs or local paths.
    if not ok then return false, "Could not prepare or send the Macro JSON attachment" end
    return sent, detail
end

function Controller:CheckUnits(macro)
    macro = macro or self.LoadedMacro
    if not macro then
        local name = value(FEATURE.Select, self.ManagedMacro)
        local loaded, failure = self:LoadMacro(name)
        if not loaded then return false, failure end
        macro = loaded
    end
    local available = {}
    for _, entry in ipairs(hotbarEntries()) do
        if entry.DisplayName then available[entry.DisplayName] = (available[entry.DisplayName] or 0) + 1 end
    end
    local missing = {}
    for _, unitName in ipairs(requiredUnits(macro.Actions)) do
        if not available[unitName] then table.insert(missing, unitName) end
    end
    local result = { Ready = #missing == 0, Required = requiredUnits(macro.Actions), Missing = missing, Hotbar = hotbarEntries() }
    self.LastUnitCheck = result
    pushLog(result.Ready and "success" or "warning", result.Ready and "macro units ready" or "macro units missing", table.concat(missing, ", "))
    return result.Ready, result
end

local function inventoryCandidatesByDisplay()
    local playerData = stateValue(Dependencies.PlayerData) or {}
    local unitData = statePath(playerData, "UnitData") or {}
    local result = {}
    for unitId, unitState in pairs(unitData) do
        local unit = stateValue(unitState) or {}
        local asset = statePath(unit, "Asset")
        local displayName = displayNameForAsset(asset)
        if displayName then
            result[displayName] = result[displayName] or {}
            table.insert(result[displayName], { Id = tostring(unitId), Level = tonumber(statePath(unit, "Level")) or 0 })
        end
    end
    for _, entries in pairs(result) do table.sort(entries, function(a, b) return a.Level > b.Level end) end
    return result
end

function Controller:BeginOperation()
    self.ActiveOperations += 1
    self.Busy = true
end

function Controller:EndOperation()
    self.ActiveOperations = math.max(0, self.ActiveOperations - 1)
    self.Busy = self.ActiveOperations > 0
end

function Controller:_EquipUnits(macro)
    macro = macro or self.LoadedMacro
    if not macro then
        local name = value(FEATURE.Select, self.ManagedMacro)
        local loaded, failure = self:LoadMacro(name)
        if not loaded then return false, failure end
        macro = loaded
    end
    local needed = requiredUnits(macro.Actions)
    if #needed > 6 then return false, "macro requires more than six unique units" end
    local candidates = inventoryCandidatesByDisplay()
    local missing = {}
    for _, unitName in ipairs(needed) do if not candidates[unitName] or not candidates[unitName][1] then table.insert(missing, unitName) end end
    if #missing > 0 then return false, "missing inventory units: " .. table.concat(missing, ", ") end
    if Config.DryRun then return true, { DryRun = true, Required = needed } end
    local originalHotbar = hotbarEntries()
    local function restoreOriginalHotbar()
        withGameIdentity(function() Actions.UnequipAll(false) end)
        task.wait(Config.ActionSettleSeconds)
        for slot, entry in ipairs(originalHotbar) do
            if entry.UnitId then
                withGameIdentity(function() Actions.EquipUnit(entry.UnitId, tostring(slot)) end)
                task.wait(Config.ActionSettleSeconds)
            end
        end
        local restoredHotbar = hotbarEntries()
        for slot, entry in ipairs(originalHotbar) do
            if restoredHotbar[slot].UnitId ~= entry.UnitId then
                return false, "slot " .. tostring(slot) .. " did not restore"
            end
        end
        return true, originalHotbar
    end
    local mutationOk, ready, result = xpcall(function()
        withGameIdentity(function() Actions.UnequipAll(false) end)
        task.wait(Config.ActionSettleSeconds)
        for slot, unitName in ipairs(needed) do
            withGameIdentity(function() Actions.EquipUnit(candidates[unitName][1].Id, tostring(slot)) end)
            task.wait(Config.ActionSettleSeconds)
        end
        return self:CheckUnits(macro)
    end, debug.traceback)
    if mutationOk and ready then return true, result end
    local restoreCallOk, restoreOk, restoreFailure = pcall(restoreOriginalHotbar)
    task.wait(Config.ActionSettleSeconds)
    local rollbackSuffix = ""
    if not restoreCallOk then
        rollbackSuffix = "; rollback failed: " .. tostring(restoreOk)
    elseif not restoreOk then
        rollbackSuffix = "; rollback verification failed: " .. tostring(restoreFailure)
    end
    if not mutationOk then
        return false, tostring(ready) .. rollbackSuffix
    end
    local missingAfterEquip = type(result) == "table" and result.Missing or {}
    return false, "hotbar verification failed: " .. table.concat(missingAfterEquip, ", ") .. rollbackSuffix
end

function Controller:EquipUnits(macro)
    self:BeginOperation()
    local packed = table.pack(xpcall(function() return self:_EquipUnits(macro) end, debug.traceback))
    self:EndOperation()
    if not packed[1] then return false, packed[2] end
    return table.unpack(packed, 2, packed.n)
end

local function sortedScalarKeys(source)
    local keys = {}
    for key in pairs(type(source) == "table" and source or {}) do
        if type(key) == "string" or type(key) == "number" then table.insert(keys, key) end
    end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    return keys
end

local function formatRollValues(raw, depth)
    local current = stateValue(raw)
    if type(current) == "number" or type(current) == "string" or type(current) == "boolean" then return tostring(current) end
    if type(current) ~= "table" or (depth or 0) >= 4 then return "?" end
    local entries = {}
    for _, key in ipairs(sortedScalarKeys(current)) do
        table.insert(entries, tostring(key) .. "=" .. formatRollValues(current[key], (depth or 0) + 1))
    end
    return "{" .. table.concat(entries, ", ") .. "}"
end

local function hotbarEquipmentLines(entry)
    local references = type(entry.Equipment) == "table" and entry.Equipment or {}
    local embedded = type(entry.EquipmentData) == "table" and entry.EquipmentData or {}
    local inventory = statePath(Dependencies.PlayerData, "EquipmentData") or {}
    local slots = next(references) ~= nil and references or embedded
    local lines = {}
    for index, slot in ipairs(sortedScalarKeys(slots)) do
        local reference = stateValue(references[slot])
        local equipment = stateValue(embedded[slot])
        if type(equipment) ~= "table" and reference ~= nil then equipment = stateValue(embedded[reference] or inventory[reference]) end
        local label = tonumber(slot) or index
        if type(equipment) == "table" then
            local asset = statePath(equipment, "Asset")
            local parts = { "Equipment " .. tostring(label) .. ": " .. tostring(displayNameForAsset(asset) or "Unknown") }
            -- These native roll containers contain Stats.{Type,Value} and Passives/Abilities.{Type,Values}.
            -- Preserve their actual leaf names instead of inventing stat names or exposing inventory IDs.
            for _, kind in ipairs({ "Stats", "Passives", "Abilities" }) do
                local rolls = statePath(equipment, kind)
                if type(rolls) == "table" and next(rolls) ~= nil then table.insert(parts, kind .. " " .. formatRollValues(rolls)) end
            end
            table.insert(lines, "   " .. table.concat(parts, " | "))
        else
            table.insert(lines, "   Equipment " .. tostring(label) .. ": unavailable")
        end
    end
    return lines
end

function Controller:CopyHotbarStats()
    local lines = { "Anime Expeditions hotbar" }
    for _, entry in ipairs(hotbarEntries()) do
        table.insert(lines, string.format("%d. %s | Lv.%s | %s", entry.Slot, entry.DisplayName or "Empty", tostring(entry.Level or "-"), tostring(entry.Trait or "No Trait")))
        if entry.Asset then
            local potentials = {}
            for _, stat in ipairs({ "Damage", "SPA", "Range" }) do
                local grade = statePath(entry.StatPotential, stat, "Potential")
                local roll = statePath(entry.StatPotential, stat, "Range")
                table.insert(potentials, stat .. ": " .. tostring(grade or "?") .. " (roll " .. tostring(roll == nil and "?" or roll) .. ")")
            end
            table.insert(lines, "   " .. table.concat(potentials, " | "))
            for _, line in ipairs(hotbarEquipmentLines(entry)) do table.insert(lines, line) end
        end
    end
    local text = table.concat(lines, "\n")
    assert(type(setclipboard) == "function", "setclipboard is unavailable")
    setclipboard(text)
    pushLog("success", "hotbar copied", #lines - 1)
    return true, text
end

function Controller:IsActionDue(action)
    if action.BossRushGateIndex~=nil then
        local c=self:ResolveContext()
        if type(action.BossRushGateIndex)~="number"or action.BossRushGateIndex<0 or action.BossRushGateIndex%1~=0
            or c.BossRushPhase~="Gates"or type(c.BossRushGateIndex)~="number"or c.BossRushGateIndex<action.BossRushGateIndex then return false end
    end
    local targetWave, targetTime = parseTime(action.Time)
    local wave, gameTime = currentClock()
    if value(FEATURE.IgnoreTiming, true) and action.Type ~= "UseAbility" and not (value(FEATURE.RespectSellTiming, true) and action.Type == "SellUnit") then
        return wave >= targetWave
    end
    return wave > targetWave or (wave == targetWave and gameTime >= targetTime)
end

local function waitForUnit(label, timeoutSeconds)
    local deadline = os.clock() + timeoutSeconds
    repeat
        if not Controller:CheckBossRushAction()then return nil end
        local id = Controller:ResolveUnitId(label)
        if id then return id end
        task.wait(Config.PollSeconds)
    until os.clock() >= deadline or not Controller.Playing
    return nil
end

function Controller:ExecuteAction(action)
    if not self:CheckBossRushAction()then return false,"Boss Rush is waiting for its active placement scene"end
    if not self:CheckCatalogAction()then return false,"Macro context changed before action"end
    if not self:CheckInfernalAction()then return false,"Infernal Macro context changed before action"end
    if action.Type == "PlaceUnit" then
        local slot = tonumber(action.Slot) or slotForDisplayName(action.Unit)
        if not slot then return false, "unit is not equipped: " .. tostring(action.Unit) end
        local placement = parseCFrame(action.Pos or action.CFrame)
        if not placement then return false, "invalid placement CFrame" end
        local ordinal = 0
        for index = 1, self.PlaybackIndex do
            local prior = self.LoadedMacro.Actions[index]
            if prior.Type == "PlaceUnit" and prior.Unit == action.Unit then ordinal += 1 end
        end
        local label = action.Label or string.format("%s - %d", action.Unit, ordinal)
        if self.BossExpected then
            -- A completed placement can replicate after a transition/cancel. Do
            -- not send a duplicate for a retained, already bound Gate unit.
            local existing=self.LiveUnitIds[label] and self:ResolveUnitId(label)
            if existing then return true,existing end
        end
        if Config.DryRun then
            self.LiveUnitIds[label] = "dry-run:" .. label
            return true, "dry-run"
        end
        fireGamePlayer(action.Phantom == true and "PlaceGamePhantom" or "PlaceGameUnit", slot, placement)
        local id = waitForUnit(label, Config.PlacementTimeoutSeconds)
        if not id then return false, "placed unit was not replicated: " .. label end
        self.LiveUnitIds[label] = id
        return true, id
    end

    local targetId = self:ResolveUnitId(action.Pos or action.UnitRef)
    if action.Type ~= "Response" and not targetId then return false, "target unit was not resolved: " .. tostring(action.Pos) end
    if Config.DryRun then return true, "dry-run" end
    if action.Type == "UpgradeUnit" then
        fireGamePlayer("UpgradeGameUnit", targetId, tonumber(action.Amount))
    elseif action.Type == "SellUnit" then
        fireGamePlayer("SellGameUnit", targetId)
        self.LiveUnitIds[action.Pos or action.UnitRef] = nil
    elseif action.Type == "ChangePriority" then
        fireGamePlayer("ChangeGameUnitPriority", targetId, action.Prio)
    elseif action.Type == "ToggleAutoUpgrade" then
        fireGamePlayer("ChangeGameUnitAutoUpgradePriority", targetId, action.Prio)
    elseif action.Type == "DisableAutoUpgrade" then
        fireGamePlayer("DisableGameUnitAutoUpgrade", targetId)
    elseif action.Type == "UseAbility" then
        fireGamePlayer("ActivateUnitAbility", targetId, action.Abi)
    elseif action.Type == "ToggleAutoAbility" then
        fireGamePlayer("ToggleAutoAbility", targetId, action.Abi)
    elseif action.Type == "Response" then
        fireGamePlayer("Response", action.Pos)
    else
        return false, "unsupported macro action: " .. tostring(action.Type)
    end
    task.wait(Config.ActionSettleSeconds)
    return true, targetId
end

function Controller:ResetPlayback(reason)
    self.LoadedMacro = nil
    self.LoadedMacroName = nil
    self.PlaybackIndex = 1
    self.ActionAttempts = 0
    self.ExecutedActions = 0
    self.SkippedActions = 0
    self.CompletedGameId = nil
    table.clear(self.LiveUnitIds)
    self.Status = reason or "reset"
end

function Controller:Play()
    self.Playing = true
    self.PendingPlayNotice = true
    self.Status = "waiting-game"
    return true
end

function Controller:StopPlayback(reason)
    self.Playing = false
    self.Busy = false
    self.Replaying = false
    self.Status = reason or "playback-stopped"
    return true
end

function Controller:RunOnce()
    self:RefreshInfernalMacroStatus()
    if not self.Running then return false, "stopped" end
    if self.Recording then self.Status = "recording" return false, "recording" end
    if not self.Playing then self.Status = "idle" return false, "playback disabled" end
    if self.Busy then return false, "busy" end

    if self.CatalogResetPending then self.CatalogResetPending=nil self:ResetPlayback("catalog-selection-changed")end
    if self.InfernalResetPending then self.InfernalResetPending=nil self:ResetPlayback("infernal-map-selection-changed")end
    self:ObserveRoundTransition()

    local selected, context = self:ResolveSelectedMacro()
    self.SelectedMacro = selected
    self.InfernalExpected=nil
    self.CatalogExpected=nil
    self.BossExpected=nil
    local isBossRush=context.Gamemode=="BossRush"
    if isBossRush and not self:BossRushPlaybackAllowed(context)then self.Status="waiting-bossrush-playback" return false,"Boss Rush manual/recording mode or native phase is not ready"end
    if isBossRush and context.BossRushPlacementReady~=true then self.Status="waiting-bossrush-gate" return false,"Waiting for confirmed local Gate membership / active Boss scene"end
    local catalogControl=self:CatalogSelectorInfo(context)
    local guardedCatalog=catalogControl~=nil
    if context.Gamemode=="InfernalCult"and not self:InfernalPlaybackAllowed(context,selected)then
        self.Status="waiting-infernal-macro"
        return false,"Enable Infernal playback and assign a Macro for the actual map; no fallback is used"
    end
    if type(context.Gamemode) ~= "string" or type(context.MapName) ~= "string" then
        self.Status = "waiting-context"
        return false, "game context is not ready"
    end
    if type(selected) ~= "string" or selected == "" then
        self.Status = isBossRush and "waiting-bossrush-macro"or guardedCatalog and "waiting-catalog-macro"or "fallback-autoplay"
        return false, "no macro selected"
    end
    if not findMacroPath(selected) then
        self.Status = isBossRush and "waiting-bossrush-macro-file"or context.Gamemode=="InfernalCult"and "waiting-infernal-macro-file"or "fallback-autoplay"
        self.LastError = "macro not found: " .. selected
        return false, self.LastError
    end

    local contextKey = table.concat({ tostring(context.Gamemode), tostring(context.MapName), tostring(context.ActName), tostring(context.GameId), tostring(context.RoundSerial),tostring(context.Difficulty),tostring(context.TrialUnit),tostring(context.PortalAsset),tostring(context.RiftName),tostring(context.NativeRound) }, "|")
    if isBossRush then contextKey=table.concat({"BossRush",tostring(context.BossRushRunId),tostring(context.BossRushPhase)},"|")end
    if self.LoadedMacroName ~= selected or self.ContextKey ~= contextKey then
        local macro, failure = self:LoadMacro(selected)
        if not macro then self.Status = "load-error" self.LastError = failure return false, failure end
        if isBossRush then
            macro,failure=self:NormalizeBossRushFile(macro,context,selected)
            if not macro then self.Status="bossrush-macro-context-mismatch"self.LastError=failure return false,failure end
        end
        if context.Gamemode=="InfernalCult"then
            local matches,reason=self:CheckInfernalFile(macro,context)
            if not matches then self.Status="infernal-macro-context-mismatch" self.LastError=reason return false,reason end
        end
        if guardedCatalog then local matches,reason=self:CheckCatalogFile(macro,context) if not matches then self.Status="catalog-context-mismatch" self.LastError=reason return false,reason end end
        if isBossRush then local matches,reason=self:CheckBossRushFile(macro,context)if not matches then self.Status="bossrush-macro-context-mismatch"self.LastError=reason return false,reason end end
        self.LoadedMacro = macro
        self.LoadedMacroName = selected
        self.ContextKey = contextKey
        if isBossRush then self.ExecutedActions=0 self.SkippedActions=0 end
        self.PlaybackIndex = 1
        self.ActionAttempts = 0
        self.CompletedGameId = nil
        self.PendingPlayNotice = true
        table.clear(self.LiveUnitIds)
        self.Status = "loaded"
        pushLog("info", "macro loaded", selected .. " (" .. tostring(#macro.Actions) .. " actions)")
    end

    if guardedCatalog then local matches,reason=self:CheckCatalogFile(self.LoadedMacro,context) if not matches then self.Status="catalog-context-mismatch" return false,reason end
        self.CatalogExpected={Key=catalogControl.key,Macro=selected,Context=context}
    end
    if isBossRush then
        local matches,reason=self:CheckBossRushFile(self.LoadedMacro,context)
        if not matches then self.Status="bossrush-macro-context-mismatch"return false,reason end
        self.BossExpected={Macro=selected,Context=context}
    end
    if not self:IsGameReady() then
        self.Status = "waiting-game"
        if context.Gamemode~="InfernalCult"and value(FEATURE.AutoEquip, true) and self.PreparedMacroName ~= selected then
            local equipped, detail = self:CheckUnits(self.LoadedMacro)
            if not equipped then equipped, detail = self:EquipUnits(self.LoadedMacro) end
            if equipped then self.PreparedMacroName = selected else self.LastError = tostring(detail) end
        end
        return false, "game is not active"
    end

    if context.Gamemode=="InfernalCult"then
        local valid,reason=self:CheckInfernalFile(self.LoadedMacro,context)
        if not valid then self.Status="infernal-macro-context-mismatch" return false,reason end
        self.InfernalExpected={Macro=selected,MapName=context.MapName,GameId=context.GameId,RoundSerial=context.RoundSerial,NativeRound=context.NativeRound}
    end
    self:NotifyMacroStart(selected, context)
    self:TryAutoStart()

    if self.CompletedGameId == contextKey then self.Status = "completed" return false, "macro already completed" end
    local action = self.LoadedMacro.Actions[self.PlaybackIndex]
    if not action then
        self.CompletedGameId = contextKey
        self.Status = "completed"
        pushLog("success", "macro completed", selected)
        return true, "completed"
    end
    if not self:IsActionDue(action) then self.Status = "waiting-timeline" return false, action.Time end

    self:BeginOperation()
    self.Replaying = true
    self.LastAction = action
    local ok, result, detail = xpcall(function()
        local actionOk, actionResult = self:ExecuteAction(action)
        return actionOk, actionResult
    end, debug.traceback)
    self.Replaying = false
    self:EndOperation()
    if not ok then result, detail = false, result end
    if isBossRush and not self:CheckBossRushAction()then
        self.Status="waiting-bossrush-transition"self.LastError=tostring(detail or "Boss Rush scene changed")
        return false,self.LastError
    end
    if result then
        self.ExecutedActions += 1
        self.PlaybackIndex += 1
        self.ActionAttempts = 0
        self.LastError = nil
        self.Status = "playing"
        return true, detail
    end

    if isBossRush and not self:CheckBossRushAction()then
        self.Status="waiting-bossrush-transition"self.LastError=tostring(detail)
        return false,self.LastError
    end
    self.ActionAttempts += 1
    self.LastError = tostring(detail)
    local retryLimit = math.max(0, math.floor(tonumber(value(FEATURE.RetryLimit, 1)) or 1))
    if retryLimit > 0 and self.ActionAttempts > retryLimit then
        self.SkippedActions += 1
        self.PlaybackIndex += 1
        self.ActionAttempts = 0
        self.Status = "action-skipped"
        pushLog("warning", "macro action skipped", self.LastError)
    else
        self.Status = "retrying"
    end
    return false, self.LastError
end

local RECORDABLE = {
    PlaceGameUnit = true,
    PlaceGamePhantom = true,
    UpgradeGameUnit = true,
    SellGameUnit = true,
    ChangeGameUnitPriority = true,
    ChangeGameUnitAutoUpgradePriority = true,
    DisableGameUnitAutoUpgrade = true,
    ActivateUnitAbility = true,
    ToggleAutoAbility = true,
}

function Controller:BuildRecordedAction(actionName, arguments)
    if not RECORDABLE[actionName] then return nil end
    local context=self:ResolveContext()
    local recordingContext=self.RecordData and self.RecordData.Context
    if type(recordingContext)=="table"and recordingContext.BossRushPhase and context.BossRushPhase~=recordingContext.BossRushPhase then
        self.LastError="Boss Rush phase changed; stop recording and create a separate Gate/Boss Macro"
        return nil
    end
    local action = { Time = formatTime() }
    if context.BossRushPhase=="Gates"and type(context.BossRushGateIndex)=="number"then action.BossRushGateIndex=context.BossRushGateIndex end
    if actionName == "PlaceGameUnit" or actionName == "PlaceGamePhantom" then
        action.Type = "PlaceUnit"
        action.Unit = hotbarEntries()[tonumber(arguments[1]) or 0] and hotbarEntries()[tonumber(arguments[1]) or 0].DisplayName or tostring(arguments[1])
        action.Pos = formatCFrame(arguments[2])
        action.Phantom = actionName == "PlaceGamePhantom" or nil
        action.__PlacementOrdinal = (self.RecordPlacementCounts[action.Unit] or 0) + 1
        action.Label = string.format("%s - %d", action.Unit, action.__PlacementOrdinal)
    else
        action.Pos = unitLabelFromId(arguments[1])
        if not action.Pos then return nil end
        if actionName == "UpgradeGameUnit" then action.Type, action.Amount = "UpgradeUnit", arguments[2]
        elseif actionName == "SellGameUnit" then action.Type = "SellUnit"
        elseif actionName == "ChangeGameUnitPriority" then action.Type, action.Prio = "ChangePriority", arguments[2]
        elseif actionName == "ChangeGameUnitAutoUpgradePriority" then action.Type, action.Prio = "ToggleAutoUpgrade", arguments[2]
        elseif actionName == "DisableGameUnitAutoUpgrade" then action.Type = "DisableAutoUpgrade"
        elseif actionName == "ActivateUnitAbility" then action.Type, action.Abi = "UseAbility", arguments[2]
        elseif actionName == "ToggleAutoAbility" then action.Type, action.Abi = "ToggleAutoAbility", arguments[2]
        end
    end
    return action.Type and action or nil
end

function Controller:AppendRecordedAction(action)
    if not action or not self.RecordData or not self.RecordName then return false end
    local placementOrdinal = action.__PlacementOrdinal
    action.__PlacementOrdinal = nil
    table.insert(self.RecordData.Actions, action)
    local written, failure = pcall(writeOwnMacro, self.RecordName, self.RecordData)
    if not written then
        table.remove(self.RecordData.Actions)
        action.__PlacementOrdinal = placementOrdinal
        error(failure, 0)
    end
    if placementOrdinal then
        self.RecordPlacementCounts[action.Unit] = math.max(self.RecordPlacementCounts[action.Unit] or 0, placementOrdinal)
    end
    pushLog("record", action.Type, action.Pos or action.Unit)
    return true
end

function Controller:RecordRemote(actionName, arguments)
    if not self.Recording or self.Replaying then return false end
    return self:AppendRecordedAction(self:BuildRecordedAction(actionName, arguments))
end

function Controller:InstallRecorderHook()
    if self.RecordHookTarget then return true end
    if type(hookfunction) ~= "function" then return false, "hookfunction is unavailable" end
    local replica = getGamePlayerReplica()
    if not replica or type(replica.FireServer) ~= "function" then return false, "game player replica is unavailable" end
    local target = replica.FireServer
    local original
    local ok, failure = pcall(function()
        original = hookfunction(target, function(selfReplica, actionName, ...)
            local arguments = table.pack(...)
            local shouldRecord = selfReplica == Controller.RecordReplica and Controller.Recording and not Controller.Replaying
            local recordedAction
            local captureFailure
            if shouldRecord then
                local captured, result = pcall(function() return Controller:BuildRecordedAction(actionName, arguments) end)
                if captured then recordedAction = result else captureFailure = result end
            end
            local returned = table.pack(original(selfReplica, actionName, table.unpack(arguments, 1, arguments.n)))
            if captureFailure then
                Controller.LastError = tostring(captureFailure)
                pushLog("error", "record capture failed", captureFailure)
            end
            if recordedAction then
                local recorded, recordFailure = pcall(function() Controller:AppendRecordedAction(recordedAction) end)
                if not recorded then Controller.LastError = tostring(recordFailure) pushLog("error", "record failed", recordFailure) end
            end
            return table.unpack(returned, 1, returned.n)
        end)
    end)
    if not ok then return false, tostring(failure) end
    self.RecordReplica = replica
    self.RecordHookTarget = target
    self.OriginalFireServer = original
    return true
end

function Controller:RemoveRecorderHook()
    if self.RecordHookTarget and self.OriginalFireServer and type(hookfunction) == "function" then
        pcall(hookfunction, self.RecordHookTarget, self.OriginalFireServer)
    end
    self.RecordReplica = nil
    self.RecordHookTarget = nil
    self.OriginalFireServer = nil
end

function Controller:StartRecording(requestedName)
    if self.Recording then return false, "already recording" end
    local hookReady, hookFailure = self:InstallRecorderHook()
    if not hookReady then return false, hookFailure end
    self:StopPlayback("recording")
    local name = safeMacroName(requestedName)
    if name == "" then name = "Recorded_" .. os.date("%Y%m%d_%H%M%S") end
    self.RecordName = name
    table.clear(self.RecordPlacementCounts)
    table.clear(self.RecordUnitLabels)
    self.RecordData = { Version = 2, Name = name, Context = self:ResolveContext(), Actions = {} }
    local written, path = pcall(writeOwnMacro, name, self.RecordData)
    if not written then
        self:RemoveRecorderHook()
        self.RecordName = nil
        self.RecordData = nil
        return false, tostring(path)
    end
    self.Recording = true
    self:SetManagedMacro(name)
    uiState()[FEATURE.Play] = false
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) == "table" then pcall(function() gui:SetValue(FEATURE.Play, false) end) end
    self.Status = "recording"
    pushLog("info", "recording started", path)
    return true, name
end

function Controller:StopRecording(reason)
    if not self.Recording then return false, "not recording" end
    self.Recording = false
    self:RemoveRecorderHook()
    if self.RecordData and self.RecordName then writeOwnMacro(self.RecordName, self.RecordData) end
    uiState()[FEATURE.Record] = false
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) == "table" then pcall(function() gui:SetValue(FEATURE.Record, false) end) end
    self.Status = reason or "recording-stopped"
    pushLog("success", "recording stopped", self.RecordName)
    return true, self.RecordName
end

local function invokeAndLog(name, callback)
    local ok, success, result = xpcall(callback, debug.traceback)
    if not ok then Controller.LastError = tostring(success) pushLog("error", name, success) return false, success end
    if not success then Controller.LastError = tostring(result) pushLog("warning", name, result) return false, result end
    return true, result
end

function Controller:UnbindGui()
    if type(self.BoundHandlers) ~= "table" then return end
    for id, installed in pairs(self.InstalledHandlers) do
        if self.BoundHandlers[id] == installed then self.BoundHandlers[id] = self.PreviousHandlers[id] end
    end
    self.BoundHandlers = nil
    table.clear(self.InstalledHandlers)
    table.clear(self.PreviousHandlers)
end

function Controller:ExportReloadState()
    local liveUnitIds = {}
    for label, unitId in pairs(self.LiveUnitIds) do liveUnitIds[label] = unitId end
    return {
        Version = self.Version,
        UserId = MACRO_USER_ID,
        SelectedMacro = self.SelectedMacro,
        ManagedMacro = self.ManagedMacro,
        LoadedMacro = self.LoadedMacro,
        LoadedMacroName = self.LoadedMacroName,
        ContextKey = self.ContextKey,
        PlaybackIndex = self.PlaybackIndex,
        ActionAttempts = self.ActionAttempts,
        ExecutedActions = self.ExecutedActions,
        SkippedActions = self.SkippedActions,
        CompletedGameId = self.CompletedGameId,
        LastStartVoteAt = self.LastStartVoteAt,
        StartVoteAttempts = self.StartVoteAttempts,
        PreparedMacroName = self.PreparedMacroName,
        LastError = self.LastError,
        LastAction = self.LastAction,
        Status = self.Status,
        PendingPlayNotice = self.PendingPlayNotice,
        LastNotifiedPlaybackKey = self.LastNotifiedPlaybackKey,
        RoundSerial = self.RoundSerial,
        LastObservedWave = self.LastObservedWave,
        LastObservedGameState = self.LastObservedGameState,
        LiveUnitIds = liveUnitIds,
    }
end

function Controller:PrepareReloadState(timeoutSeconds)
    local quiesced, failure = self:Quiesce(timeoutSeconds, false)
    if not quiesced then return nil, failure end
    return self:ExportReloadState()
end

function Controller:Quiesce(timeoutSeconds, cancelPlayback)
    self.Running = false
    self.LoopGeneration += 1
    if cancelPlayback then self.Playing = false end
    local deadline = os.clock() + math.max(0.1, tonumber(timeoutSeconds) or (Config.PlacementTimeoutSeconds + Config.ActionSettleSeconds + 1))
    while self.ActiveOperations > 0 and os.clock() < deadline do task.wait(0.05) end
    if self.ActiveOperations > 0 then return false, "macro operation did not quiesce before shutdown" end
    self.LoopAlive = false
    return true
end

function Controller:BindGui()
    self:UnbindGui()
    local handlers = Environment.AnimeExpeditionsFeatureHandlers
    if type(handlers) ~= "table" then handlers = {} Environment.AnimeExpeditionsFeatureHandlers = handlers end
    local function install(id, callback)
        local previousHandler = handlers[id]
        local installed = function(...)
            if type(previousHandler) == "function" then
                local ok, failure = pcall(previousHandler, ...)
                if not ok then warn("[AE Macro] previous handler failed", id, failure) end
            end
            if Environment[STATE_KEY] == Controller then callback(...) end
        end
        self.PreviousHandlers[id] = previousHandler
        self.InstalledHandlers[id] = installed
        handlers[id] = installed
    end
    install(FEATURE.Play, function(enabled) if enabled then self:Play() else self:StopPlayback("toggle-disabled") end end)
    install(INFERNAL_PLAY,function()self:RefreshInfernalMacroStatus()end)
    install(FEATURE.Record, function(enabled)
        if enabled then
            local started = invokeAndLog("start recording", function() return self:StartRecording(value(FEATURE.Create, "")) end)
            if not started then
                local gui = Environment.__AnimeExpeditionsGuiController
                if type(gui) == "table" then pcall(function() gui:SetValue(FEATURE.Record, false) end) end
            end
        else
            if self.Recording then invokeAndLog("stop recording", function() return self:StopRecording("toggle-disabled") end) end
        end
    end)
    install(FEATURE.Create, function(name) if tostring(name or "") ~= "" then invokeAndLog("create macro", function() return self:CreateMacro(name) end) end end)
    install(FEATURE.Delete, function() invokeAndLog("delete macro", function() return self:DeleteSelectedMacro() end) end)
    install(FEATURE.Select, function(name) self.ManagedMacro = name end)
    install(FEATURE.Import, function(input) if tostring(input or "") ~= "" then invokeAndLog("import macro", function() return self:ImportMacro(input) end) end end)
    install(FEATURE.CopyJson, function() invokeAndLog("export macro", function() return self:ExportSelected() end) end)
    install(FEATURE.SendWebhook, function() invokeAndLog("send macro", function() return self:SendSelectedToWebhook() end) end)
    install(FEATURE.CheckUnits, function() invokeAndLog("check units", function() return self:CheckUnits() end) end)
    install(FEATURE.EquipUnits, function() invokeAndLog("equip units", function() return self:EquipUnits() end) end)
    install(FEATURE.CopyHotbar, function() invokeAndLog("copy hotbar", function() return self:CopyHotbarStats() end) end)
    local gui = Environment.__AnimeExpeditionsGuiController
    for _, page in ipairs(type(gui) == "table" and gui.Spec and gui.Spec.pages or {}) do
        if page.name == "Macro" then
            for _, section in ipairs(page.sections or {}) do
                if section.name:find("Select ", 1, true) then
                    for _, control in ipairs(section.controls or {}) do
                        if control.type == "dropdown" and control.key ~= FEATURE.Select then
                            if control.infernalMapId then
                                local mapId=control.infernalMapId
                                install(control.key,function()self:InfernalMappingChanged(mapId)end)
                            elseif control.macroContext or self:IsCatalogKey(control.key)then local key=control.key install(key,function()self:CatalogMappingChanged(key)end)
                            else install(control.key, function() self:ResetPlayback("context-selection-changed") end)end
                        end
                    end
                end
            end
        end
    end
    self.BoundHandlers = handlers
    self:RefreshMacroOptions()
    self.Playing = value(FEATURE.Play, true) == true
    return true
end

function Controller:GetStatus()
    local selected, context = self:ResolveSelectedMacro()
    return {
        Version = self.Version,
        Running = self.Running,
        Playing = self.Playing,
        Recording = self.Recording,
        Replaying = self.Replaying,
        Busy = self.Busy,
        Status = self.Status,
        SelectedMacro = selected,
        ManagedMacro = value(FEATURE.Select, self.ManagedMacro),
        Context = context,
        LoadedMacroName = self.LoadedMacroName,
        ActionCount = self.LoadedMacro and #self.LoadedMacro.Actions or 0,
        PlaybackIndex = self.PlaybackIndex,
        ExecutedActions = self.ExecutedActions,
        SkippedActions = self.SkippedActions,
        LastError = self.LastError,
        LastAction = self.LastAction,
        LastUnitCheck = self.LastUnitCheck,
        DryRun = Config.DryRun,
    }
end

function Controller:Start()
    if self.LoopAlive then return false, "already running" end
    self.Running = Config.Enabled
    if not self.Running then self.Status = "disabled" return false, "disabled" end
    self.LoopGeneration += 1
    local generation = self.LoopGeneration
    self.LoopAlive = true
    task.spawn(function()
        while self.Running and self.LoopGeneration == generation do
            local ok, failure = xpcall(function() self:RunOnce() end, debug.traceback)
            if not ok then self.LastError = tostring(failure) self.Status = "loop-error" pushLog("error", "macro loop failed", failure) end
            task.wait(Config.PollSeconds)
        end
        if self.LoopGeneration == generation then self.LoopAlive = false end
    end)
    pushLog("info", "macro loop started", Config.DryRun and "dry-run" or "live")
    return true, generation
end

function Controller:Stop(reason)
    if self.Recording then pcall(function() self:StopRecording(reason or "stopped") end) end
    self:RemoveRecorderHook()
    self:UnbindGui()
    local quiesced, failure = self:Quiesce(nil, true)
    self.Busy = self.ActiveOperations > 0
    if quiesced then self.Replaying = false end
    if not quiesced then
        self.Status = "stop-timeout"
        self.LastError = failure
        pushLog("error", "macro stop timed out", failure)
        return false, failure
    end
    self.Status = "stopped"
    self.StopReason = reason or "manual"
    if Environment[STATE_KEY] == self then Environment[STATE_KEY] = nil end
    pushLog("info", "macro stopped", self.StopReason)
    return true
end

Controller:BindGui()
Controller:Start()
return Controller
