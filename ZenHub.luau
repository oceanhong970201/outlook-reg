    local ok, errorMessage = pcall(function()
        local user = game:GetService("VirtualUser")
        if not eligible() then return end
        user:CaptureController()
        -- CaptureController may yield inside the native implementation. A stopped,
        -- disabled or replaced owner must not issue a late ClickButton2 afterward.
        if not eligible() then return end
        user:ClickButton2(Vector2.new(0, 0))
        if not eligible() then return end
        completed = true
    end)
    -- Do not task.cancel native calls, including on Stop/reload or soft deadlines.
    -- A forever-pending call intentionally blocks further native admissions.
    if state.Pending == pulse then state.Pending = nil end
    if not ok then
        self.AntiAfkState, self.AntiAfkError = "error", tostring(errorMessage)
        return false, errorMessage
    end
    if not completed then self.AntiAfkState = "disabled" return false, "disabled" end
    self.AntiAfkPulses += 1
    self.AntiAfkState, self.AntiAfkError = "idle", nil
    return true, nil
