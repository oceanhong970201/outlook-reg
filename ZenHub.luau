local function storedValue(control)
    if control.transient then return control.default end
    local value = control.sensitive and Secrets[control.key] or State.Values[control.key]
    -- Display the blank input without turning an absent saved mention into @everyone.
    if control.key == WEBHOOK_MENTION_KEY and Secrets[WEBHOOK_MENTION_KEY] == nil then return control.default end
    if control.key == "NUI-0054" and control.type == "dropdown" and control.multi then
        local selected, labels, labelToId = {}, {}, {}
        for key, child in pairs(type(value) == "table" and value or {}) do
            if type(key) == "number" then selected[tostring(child)] = true elseif child == true then selected[tostring(key)] = true end
        end
        for _, label in ipairs(control.options) do
            local id = label:match("^([^\r\n]+)")
            labelToId[label] = id
            if selected[id] or selected[label] then labels[label] = true end
        end
        Controller.TrainingOptionIds = labelToId
        return labels -- Display defaults only; do not erase persisted UUIDs.
    end
    if control.type == "toggle" then
        if type(value) ~= "boolean" then
            value = control.default == true
        end
    elseif control.type == "slider" then
        value = math.clamp(tonumber(value) or tonumber(control.default) or control.min, control.min, control.max)
    elseif control.type == "dropdown" then
        if control.multi then
            value = selectionArray(value ~= nil and value or control.default, control.options)
        elseif control.dynamicOptions and type(value) == "string" then
            value = value
        elseif not table.find(control.options, value) then
            value = table.find(control.options, control.default) and control.default or nil
        end
    elseif control.type == "priority-list" then
        value = normalizedPriorityOrder(value ~= nil and value or control.default, control.options)
    elseif value == nil then
        value = control.default
    end
    if control.sensitive then Secrets[control.key] = value else State.Values[control.key] = value end
    return value
end

local function addPriorityList(group, control)
    local order = normalizedPriorityOrder(storedValue(control), control.options)
    State.Values[control.key] = order
    local selected = order[1]
    if previousPresentation and previousPresentation.Selections and table.find(order, previousPresentation.Selections[control.key]) then
        selected = previousPresentation.Selections[control.key]
    end
    local focusEditor
    Controller.PrioritySelections[control.key] = selected
    -- Captured numeric prefixes are stable saved identities, not current ranks.
    local function displayPriority(item)
        local name = tostring(item or ""):gsub("<.->", ""):gsub("^%s*[%d%.]+%.%s*", "")
        local index = table.find(order, item)
        return index and tostring(index) .. ". " .. name or name
    end
    local function summary()
        local labels = {}
        for _, item in ipairs(order) do table.insert(labels, displayPriority(item)) end
        return control.title .. " (1 = first priority): " .. table.concat(labels, " > ")
    end
    local tooltip = "1 = first priority. Select an item, then move it up or down."
    local label = group:AddLabel({ Text = summary(), DoesWrap = true })
    local dropdown = group:AddDropdown(control.key .. "_editor", {
        Text = control.title,
        Values = cloneArray(order),
        Default = selected,
        Multi = false,
        Searchable = #control.options > 8,
        Tooltip = tooltip,
        FormatDisplayValue = displayPriority,
        FormatListValue = displayPriority,
    })
    dropdown:OnChanged(function(value)
        Controller.PrioritySelections[control.key] = value
        if focusEditor then focusEditor:Refresh() end
    end)
    local function refresh()
        -- SetValues rebuilds both menu rows and the selected display, preserving
        -- canonical selection because every original option remains available.
        dropdown:SetValues(cloneArray(order))
        label:SetText(summary())
        if focusEditor then focusEditor:Refresh() end
    end
    local function move(delta)
        local item = Controller.PrioritySelections[control.key]
        local index = table.find(order, item)
        local target = index and math.clamp(index + delta, 1, #order) or nil
        if index and target and index ~= target then
            order[index], order[target] = order[target], order[index]
            refresh()
            dispatch(control, cloneArray(order))
        end
    end
    local upButton = group:AddButton({ Text = "Move selected up", Func = function() move(-1) end, Tooltip = tooltip })
    local downButton = group:AddButton({ Text = "Move selected down", Func = function() move(1) end, Tooltip = tooltip })
    Controller.Controls[control.key .. "_editor"] = dropdown
    Controller.Controls[control.key] = {
        SetValue = function(_, value)
            order = normalizedPriorityOrder(value, control.options)
            State.Values[control.key] = cloneArray(order)
            local item = Controller.PrioritySelections[control.key]
            if not table.find(order, item) then item = order[1] end
            refresh()
            Controller.PrioritySelections[control.key] = item
            dropdown:SetValue(item)
            dispatch(control, cloneArray(order))
        end,
    }
    if Controller.PriorityEditorModule then
        focusEditor = Controller.PriorityEditorModule.Mount({
            Library = Library, Group = group, Control = control, Dropdown = dropdown,
            Summary = label, UpButton = upButton, DownButton = downButton,
            GetOrder = function() return cloneArray(order) end,
            GetSelected = function() return Controller.PrioritySelections[control.key] end,
            Select = function(item) dropdown:SetValue(item) end,
            MoveUp = function() move(-1) end, MoveDown = function() move(1) end,
        })
        Controller.PriorityEditors[control.key] = focusEditor
    end
end

local function addControl(group, control)
    Controller.ControlSpecs[control.key] = control
    if control.type == "toggle" then
        local element = group:AddToggle(control.key, {
            Text = control.title,
            Default = storedValue(control) == true,
            Tooltip = control.description,
        })
        element:OnChanged(function(value) dispatch(control, value) end)
        Controller.Controls[control.key] = element
    elseif control.type == "text-input" then
        local element = group:AddInput(control.key, {
            Text = control.title,
            Default = tostring(storedValue(control) or ""),
            Finished = true,
            ClearTextOnFocus = false,
            Password = control.sensitive == true,
            Tooltip = control.description,
        })
        element:OnChanged(function(value) dispatch(control, value) end)
        Controller.Controls[control.key] = element
    elseif control.type == "dropdown" then
        local default = storedValue(control)
        local dropdownValues = cloneArray(control.options)
        if control.dynamicOptions and type(default) == "string" and not table.find(dropdownValues, default) then
            table.insert(dropdownValues, default)
        end
        local element = group:AddDropdown(control.key, {
            Text = control.title,
            Values = dropdownValues,
            Default = default,
            Multi = control.multi,
            AllowNull = true,
            Searchable = #dropdownValues > 8,
            MaxVisibleDropdownItems = math.min(14, math.max(6, #dropdownValues)),
            Tooltip = control.description,
        })
        element:OnChanged(function(value) dispatch(control, value) end)
        Controller.Controls[control.key] = element
    elseif control.type == "slider" then
        local element = group:AddSlider(control.key, {
            Text = control.title,
            Default = tonumber(storedValue(control)) or 0,
            Min = control.min,
            Max = control.max,
            Rounding = control.rounding,
            Tooltip = control.description,
        })
        element:OnChanged(function(value) dispatch(control, value) end)
        Controller.Controls[control.key] = element
    elseif control.type == "button" then
        Controller.Controls[control.key] = group:AddButton({
            Text = control.title,
            Tooltip = control.description,
            Func = function() dispatch(control, true) end,
        })
    elseif control.type == "priority-list" then
        addPriorityList(group, control)
    else
        Controller.Controls[control.key] = group:AddLabel({ Text = control.title, DoesWrap = true })
    end
end

local function addSectionNode(page, tab, parent, node, rootIndex)
    local container
    if parent then
        assert(type(parent.AddSubGroupbox) == "function", "Patched Obsidian AddSubGroupbox is unavailable")
        container = parent:AddSubGroupbox({
            Name = node.name,
            Collapsed = true,
            Indent = 8,
        })
    else
        container = tab:AddGroupbox({
            Side = "Left",
            Name = node.name,
            Collapsed = node.defaultExpanded ~= true and rootIndex > 1,
        })
    end

    Controller.Sections[page.name .. "/" .. table.concat(node.path, "/")] = container
    local priorCollapsed = previousPresentation.Collapsed[page.name .. "/" .. table.concat(node.path, "/")]
    if node.defaultExpanded == true and type(container.SetCollapsed) == "function" then
        container:SetCollapsed(false) -- Keep the global joiner switch visible on each GUI load.
    elseif type(priorCollapsed) == "boolean" and type(container.SetCollapsed) == "function" then container:SetCollapsed(priorCollapsed) end
    local section = node.sectionIndex and page.sections[node.sectionIndex] or nil
    for _, control in ipairs(section and section.controls or {}) do addControl(container, control) end
    for _, child in ipairs(node.children or {}) do addSectionNode(page, tab, container, child, rootIndex) end
end

local pageDescriptions = { Lobby = "Collect, train and manage your expedition", Joiner = "Set your priorities. Choose your next adventure.", Game = "Fine-tune your in-game automation", Macro = "Record, organize and replay your strategies", Webhook = "Your results, delivered clearly", Settings = "Configuration, interface and recovery preferences" }
for _, page in ipairs(Spec.pages) do
    local tab = Window:AddTab({
        Name = page.name,
        Description = pageDescriptions[page.name] or page.name,
        Icon = page.name == "Settings" and "settings" or page.name == "Lobby" and "house" or (page.name == "Macro" and "list-video" or (page.name == "Game" and "gamepad-2" or (page.name == "Webhook" and "webhook" or "log-in"))),
    })
    Controller.Tabs[page.name] = tab
    do -- A layout: all native sections retained in a full-width settings lane.
        -- A single full-width settings lane gives the priority board room for
        -- a real ordered list and focused editor; native scrolling/search remain.
        local nativeRefreshSides = tab.RefreshSides
        function tab:RefreshSides()
            nativeRefreshSides(self)
            local left, right = self.Sides[1], self.Sides[2]
            left.Size = UDim2.new(1, 0, left.Size.Y.Scale, left.Size.Y.Offset)
            right.Visible = false
        end
        tab:RefreshSides()
    end
    for rootIndex, node in ipairs(page.tree) do addSectionNode(page, tab, nil, node, rootIndex) end
end

