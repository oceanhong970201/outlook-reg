function Controller:RunOnce(force)
    if self.ActiveOperations > 0 then return false, "busy" end
    self.ActiveOperations += 1
    local packed = table.pack(xpcall(function() return self:_RunOnce(force) end, debug.traceback))
    self.ActiveOperations = math.max(0, self.ActiveOperations - 1)
    if not packed[1] then self.Busy = false self.LastError = tostring(packed[2]) pushLog("error", "solver operation failed", self.LastError) return false, self.LastError end
