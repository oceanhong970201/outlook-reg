function Controller:Resolve(possibleUnits, hints)
    local mapped = mappedAnswer(copyStringArray(possibleUnits), copyStringArray(hints))
    if mapped then return mapped.Unit, 1000000 end
    if Config.MappingOnly or Config.UseAISolver then return nil, 0 end
    return resolveCandidateFromHints(
