function Adapter:_eligible(replica)
    local d = replica and replica.Data
    local p = d and d.Parameters
    if type(d) ~= "table" or type(p) ~= "table" or d.Result ~= nil then return false end
    if not containsPlayer(d.Players, self.Player) then return false end
    if type(d.Responses) ~= "table" or d.Responses[self.Player] ~= nil then return false end
    if p.EndTime ~= nil and (type(p.EndTime) ~= "number" or p.EndTime <= self:_now()) then return false end
