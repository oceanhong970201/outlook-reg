        tried[unit] = nil
        book.Records[expectedKey] = record
        ledger.BlockedQuestion, ledger.BlockedReason = oldBlock, oldReason
        persistState()
        self.Busy = false
        return false, cancelled() and "stopped before submission"
            or not reservationSaved and "mapping reservation could not be saved" or "attempt changed before submission"
    end
