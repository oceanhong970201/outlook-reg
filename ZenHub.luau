                        if not heli.Landed then heli.Reason=remaining>0 and "native-helicopter-arriving" or "native-helicopter-inactive"
                        elseif not out.Host then heli.Reason="native-helicopter-host-only"
                        elseif not out.Victory then heli.Reason="native-helicopter-victory-unconfirmed"
                        elseif not finite(rd.MaxPlayers or 1) or (rd.MaxPlayers or 1)%1~=0
                            or (rd.MaxPlayers or 1)<1 or #rd.Players>=(rd.MaxPlayers or 1) then
                            heli.Reason="native-helicopter-full-or-capacity-unconfirmed"
                        else heli.Ready=true heli.Reason="native-helicopter-landed-host-ready" end
                    end
