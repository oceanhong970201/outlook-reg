            if not path(Information, "Events", "ShenronEvent") or not path(Dependencies.EventData, "ShenronEvent") then
                self:Mark("NUI-0036", "event-unavailable", "Dragon's Wish/Shenron event is not present in native event information and replica")
            else self:Mark("NUI-0036", "unsupported-protocol", "Native wishing-orb pickup identity/eligibility protocol has not been verified; generic CollectPickup is not guessed") end
        end
        self:Mark("NUI-0058", "information", "Static information label; no game action")
    end, debug.traceback)
    self.Busy = false
    self.Status = ok and (self.Issued and "action-dispatched" or "watching") or "error"
