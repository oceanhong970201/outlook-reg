local getIdentity = getthreadidentity or get_thread_identity
local setIdentity = setthreadidentity or set_thread_identity

local function withGameIdentity(callback)
    local originalIdentity = type(getIdentity) == "function" and getIdentity() or nil
    if type(setIdentity) == "function" and originalIdentity ~= nil and originalIdentity ~= 2 then
        setIdentity(2)
    end
    local packed = table.pack(xpcall(callback, debug.traceback))
    if type(setIdentity) == "function" and originalIdentity ~= nil and originalIdentity ~= 2 then
        pcall(setIdentity, originalIdentity)
    end
    if not packed[1] then error(packed[2], 0) end
    return table.unpack(packed, 2, packed.n)
end

