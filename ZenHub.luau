    if (self.PlanAttempts[planKey] or 0) >= (plan.Operation and 1 or Config.MaxAttemptsPerPlan) then
        self.Busy = false
        self.Status = "retry-exhausted"
        self.NextAttemptAt = os.clock() + Config.SubmissionCooldownSeconds
        return false, "join plan retry limit reached; change configuration or re-enter lobby to retry"
    end
    self.PlanAttempts[planKey] = (self.PlanAttempts[planKey] or 0) + 1

    self.Status = "submitting"
    local generation = self.LoopGeneration
    local ok, result = xpcall(function() return submitPlan(plan, generation) end, debug.traceback)
    if self.LoopGeneration ~= generation or not self.Running then
        return false, "cancelled"
    end
    self.Busy = false
    self.NextAttemptAt = os.clock() + Config.SubmissionCooldownSeconds
    if not ok then
        self.Status = "error"
        self.LastError = tostring(result)
        pushLog("error", "join submission failed", self.LastError)
        return false, self.LastError
    end

    self.Submissions += 1
    self.Status = "submitted"
    self.LastSubmission = { Time = os.time(), Name = plan.Name, Result = result, QueueData = plan.QueueData }
    if plan.Operation then self.PendingOperation = plan.Operation
    else self.PendingSubmission = planKey self.ActiveBossKey = plan.BossKey end
    self.LastError = nil
    pushLog("success", "join submitted", plan.Name)
    return true, self.LastSubmission
end

