getInfernalRuntime=function()
    if infernalRuntime then return infernalRuntime end
    Environment.__AnimeExpeditionsInfernalJoinLedgers=Environment.__AnimeExpeditionsInfernalJoinLedgers or{}
    local ledgers=Environment.__AnimeExpeditionsInfernalJoinLedgers
    local scope=tostring(LocalPlayer.UserId)..":"..tostring(game.PlaceId)..":"..tostring(game.JobId)
    ledgers[scope]=ledgers[scope]or{}
    infernalRuntime=InfernalJoin.new({Read=readInfernalState,Ledger=ledgers[scope],Owner=Controller,
        Sanitize=sanitizeQueueData,Actions=function()return rawget(Actions,"PartySetQueueData"),rawget(Actions,"PartyStartGame")end,
        Clock=os.clock,Sleep=task.wait,AckTimeout=Config.TeamConfirmSeconds,SettleSeconds=Config.QueueSettleSeconds,
        Check=function(plan,generation)
            if Environment[STATE_KEY]~=Controller or Players.LocalPlayer~=LocalPlayer or not Controller.Running
                or Controller.LoopGeneration~=generation or not isInLobby()or value(FEATURE.Disable,false)then error("Infernal join cancelled",0)end
            local macro=Environment.__AnimeExpeditionsMacro
            if type(macro)=="table"and(macro.Recording==true or macro.Busy==true or(tonumber(macro.ActiveOperations)or 0)>0)then error("Macro is busy; Infernal entry paused",0)end
            if Controller.PendingSubmission then error("Another Joiner is awaiting entry confirmation",0)end
            local bossScope=tostring(LocalPlayer.UserId)..":"..tostring(game.PlaceId)..":"..tostring(game.JobId)
            local bosses=Environment.__AnimeExpeditionsBossRushJoinLedgers
            if bosses and bosses[bossScope]and bosses[bossScope].Pending then error("Boss Rush join already pending",0)end
            if plan.OneShot then
                if Controller.InfernalManualRequest~=plan then error("Manual Infernal request no longer owns submission",0)end
            else assertCurrentPlan(plan,generation)end
        end})
    return infernalRuntime
end
function Controller:RefreshInfernalStatus()
    local ok,q,reason,seed=pcall(function()return getInfernalRuntime():Build()end)
    local snap=infernalRuntime and infernalRuntime.LastSnapshot or{}
    local detail=reason
    if not ok then detail=tostring(q)end
    local info={MapName=snap.MapName,Photos=snap.Photos or 0,QuestActive=snap.QuestActive,MapUnlocked=snap.MapUnlocked,
        Seed=seed or snap.Seed,Ready=ok and q~=nil,Reason=detail}
    if infernalRuntime and infernalRuntime.Ledger.Pending then info.Ready=false info.Reason="Waiting for native entry confirmation"end
    self.FeatureStates[FEATURE.InfernalAutoJoin]=info
    local display=info.MapName or"Unknown"
    local mapInfo=type(info.MapName)=="string"and Information.Maps.MapPreviewData and Information.Maps.MapPreviewData[info.MapName]
    if type(mapInfo)=="table"then display=mapInfo.DisplayName or display end
    local remaining=type(snap.Now)=="number"and type(snap.Seed)=="number"and math.max(0,math.floor(snap.Seed+1800-snap.Now))or 0
    local text="Infernal Cult: "..display.." • Hard • Act 1\nTorn Photos: "..tostring(info.Photos).."/16 • Rotation: "..string.format("%02d:%02d",math.floor(remaining/60),remaining%60)
    if self.InfernalMessage then text..="\n"..self.InfernalMessage elseif info.Reason then text..="\n"..info.Reason else text..="\nReady to join. Combat start and unit placement remain manual."end
    local gui=Environment.__AnimeExpeditionsGuiController
    local label=gui and gui.Controls and gui.Controls["AE-INFERNAL-STATUS"]
    if label and type(label.SetText)=="function"and text~=self.InfernalLabel then pcall(label.SetText,label,text)self.InfernalLabel=text end
    return info
end
function Controller:JoinInfernalOnce()
    if self.Busy or not self.Running or Environment[STATE_KEY]~=self then return false,"Joiner is busy or stopped"end
    self.Busy=true
    local generation=self.LoopGeneration
    local ok,result=pcall(function()
        local worker=getInfernalRuntime()
        local blocked,why=worker:Observe()
        if blocked then error(why,0)end
        local q,reason=worker:Build()
        if not q then error(reason,0)end
        local plan={Name="Infernal Cult Joiner",Toggle=FEATURE.InfernalAutoJoin,QueueData=q,Matchmaking=false,TeamSlot=0,OneShot=true}
        self.InfernalManualRequest=plan
