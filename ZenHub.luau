local function buildTidalQueue()
    local event = (Information.Events or {}).Summer2026Event
    local queueData = type(event) == "table" and event.QueueData or nil
    if type(queueData) ~= "table" then
        return nil, "Tidal Siege native Summer2026Event QueueData is unavailable"
    end
    -- Use the event's native Coral Kingdom payload without changing its registry.
    return sanitizeQueueData(table.clone(queueData))
end

local function buildRaidQueue()
    local mapName = resolveMapName("Raid", value(FEATURE.RaidMap, "Snowy Castle"))
    if not mapName then return nil, "raid map was not resolved" end
    if value(FEATURE.RaidTokenGate, false) then
        local itemData = getPlayerData().ItemData or {}
        local amount = tonumber((itemData.RaidToken or {}).Amount) or 0
        if amount >= (tonumber(value(FEATURE.RaidTokenLimit, 100)) or 100) then
            return nil, "raid token gate not satisfied"
        end
    end
    return sanitizeQueueData({ Gamemode = "Raid", MapName = mapName, ActName = value(FEATURE.RaidAct, "Act 1") })
end

local function buildExpeditionQueue()
    if value(FEATURE.ToyCapsuleTrial, false) and (tonumber(((getPlayerData().ItemData or {}).TrunksEVOItem or {}).Amount) or 0) > 0 then
        -- Native Encounters.Trunks awards TrunksEVOItem (Toy Capsule); only use
        -- the trial when the game's current ordered map registry exposes it.
        for _, trial in ipairs(Information.Maps:GetOrderedMaps("Trial") or {}) do
            if trial == "TrunksEVO" then
                return sanitizeQueueData({ Gamemode = "Trial", MapName = trial, TrialUnit = trial, ActName = "Act 1" })
            end
        end
        return nil, "Toy Capsule exists but TrunksEVO trial is not exposed by the current native map registry"
    end
    if value(FEATURE.ExpeditionFuelGate, false) then
        local amount = tonumber(((getPlayerData().ItemData or {}).ExpeditionFuel or {}).Amount) or 0
        if amount >= (tonumber(value(FEATURE.ExpeditionFuelLimit, 100)) or 100) then
            return nil, "expedition fuel gate not satisfied"
        end
    end
    local mapName = resolveMapName("Expedition", value(FEATURE.ExpeditionMap, "East Town"))
    if not mapName then return nil, "expedition map was not resolved" end
    return sanitizeQueueData({
        Gamemode = "Expedition",
        MapName = mapName,
        DifficultyLevel = math.clamp(tonumber(tostring(value(FEATURE.ExpeditionDifficulty, 1)):match("(%d+)$")) or 1, 1, 3),
    })
end

