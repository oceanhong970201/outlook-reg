        if reason == "reload" and type(runtime.PrepareReloadState) == "function" then
            local ok, state = pcall(function() return runtime:PrepareReloadState() end)
            if ok and type(state) == "table" then Environment.__AnimeExpeditionsGameWebhookReloadState = state end
        end
        pcall(function() runtime:Stop(reason or "gui-unload") end)
    end
end

local function stopOwnedJoiner(reason)
    local runtime = Controller.Joiner
    Controller.Joiner = nil
    if type(runtime) == "table" and type(runtime.Stop) == "function" then
        pcall(function() runtime:Stop(reason or "gui-unload") end)
    end
end

local function saveStateNow()
    if PREVIEW_ONLY then return false, "UI preview does not save settings" end
    if not CONFIG_PATH or not accountOwnsState() then return false, "Settings account is no longer active" end
    local secretOK, secretError = saveWebhookSecretNow()
    if not secretOK then return false, secretError end
    local savedValues = {}
    for key, savedValue in pairs(State.Values) do
        if not SensitiveKeys[key] and not (Controller.ControlSpecs[key] and Controller.ControlSpecs[key].transient) then savedValues[key] = savedValue end
    end
    return writeAccountRecord(CONFIG_PATH, { Values = savedValues, Version = State.Version, UserId = CONFIG_USER_ID }, validSettings)
end

