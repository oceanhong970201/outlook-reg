    if type(self.Ctx.ReadNetworkHealth)~="function"or type(self.Ctx.Rejoin)~="function"then
        self:Notice("Ping Freeze unavailable: no verified network activity sensor")return false
    end
    self:Notice(self.Ticket.RejoinAttempts>=1 and "Ping Freeze stopped: 1/1 attempt used this session"
        or "Ping Freeze armed; requires 120 seconds without network activity")
    return true
end
function Runtime:PollNetwork()
    if not self:Current()then return false end
    if self:Value(IDS.PingFreeze,false)~=true then self.Network=nil return false end
    if self.Ticket.RejoinAttempts>=1 then return false end
    if type(self.Ctx.ReadNetworkHealth)~="function"or type(self.Ctx.Rejoin)~="function"then
        self:Notice("Ping Freeze unavailable: no verified network activity sensor")return false
    end
    local now=self.Ctx.Clock()
    local ok,s=pcall(self.Ctx.ReadNetworkHealth)
    if not ok or type(s)~="table"or s.Ready~=true or not finite(s.ReceiveKbps)or s.ReceiveKbps<0 then
        self.Network=nil self:Notice("Ping Freeze waiting: native network activity is unavailable")return false
    end
    if s.SessionKey and s.SessionKey~=self.Session then self.Network=nil return false end
    local n=self.Network
    if not n then n={At=now,Stamp=s.ServerStamp,Ping=s.PingSeconds,Primed=false}self.Network=n end
    local progress=s.ReceiveKbps>0 or s.ServerStamp~=nil and n.Stamp~=nil and s.ServerStamp~=n.Stamp
        or finite(s.PingSeconds)and finite(n.Ping)and math.abs(s.PingSeconds-n.Ping)>0.000001
    if progress then n.At=now n.Primed=true end
    n.Stamp,n.Ping=s.ServerStamp,s.PingSeconds
    if not n.Primed or progress or s.ReceiveKbps~=0 or now-n.At<120 then return false end
    if not self:Current()or self:Value(IDS.PingFreeze,false)~=true then return false end
    -- The native adapter coordinates this reservation with existing Auto Rejoin.
    self.Ticket.RejoinAttempts+=1
    local sent,result=pcall(self.Ctx.Rejoin,"network-stalled-120-seconds")
    self:Notice(sent and result~=false and "Ping Freeze rejoin requested (1/1 this session)"
        or "Ping Freeze stopped after one attempt: "..tostring(result))
    return sent and result~=false
end
function Runtime:Sync()
    if not self:Current()or self.Batch then return false end
    local ok,err=self:ApplyKey()if not ok then self:Notice(err)end
    local mobile,why=self:ApplyMobile()if not mobile then self:Notice(why)end
    local colors,reason=self:ApplyColors()if not colors then self:Notice(reason)end
    return ok and mobile and colors
end
function Runtime:GetStatus()
    return {Running=self.Running,Status=self.Status,Queued=self.Queued,Theme=self.AppliedTheme,
        RejoinAttempts=self.Ticket.RejoinAttempts,NetworkPrimed=self.Network and self.Network.Primed==true}
end
function Runtime:Stop(reason)
    if not self.Running then return end
    self.Running=false self.Generation+=1 self.StopReason=reason
    disconnect(self.TeleportConnection)self.TeleportConnection=nil
    if self.MobileButton and type(self.MobileButton.Destroy)=="function"then self.MobileButton:Destroy()end
    local handlers=self.Ctx.Environment.AnimeExpeditionsFeatureHandlers
    for id,fn in pairs(self.Handlers)do if handlers and handlers[id]==fn then handlers[id]=self.PreviousHandlers[id]end end
    if self.Ctx.Library.ToggleKeybind==self.AppliedKey then self.Ctx.Library.ToggleKeybind=self.OriginalKey end
    if self.Ctx.Environment[KEY]==self then self.Ctx.Environment[KEY]=nil end
end
function Module.new(ctx)
    for _,name in ipairs({"GetValue","SetValue","IsCurrent","ApplyPalette","ColorFromHex","Clock"})do assert(type(ctx[name])=="function","Settings requires "..name)end
    assert(type(ctx.Environment)=="table"and type(ctx.DefaultPalette)=="table"and type(ctx.KeyCodes)=="table","Settings context incomplete")
    local old=ctx.Environment[KEY]if old and type(old.Stop)=="function"then old:Stop("reload")end
    local account=tostring(ctx.AccountId or "")assert(account:match("^%d+$"),"Settings account required")
    local session=tostring(ctx.SessionKey or "")assert(session~="","Settings session required")
    local ticket=ctx.Environment.__AnimeExpeditionsSettingsTicket
    if type(ticket)~="table"or ticket.Session~=session then ticket={Session=session,Serial=0,RejoinAttempts=0}ctx.Environment.__AnimeExpeditionsSettingsTicket=ticket end
    local self=setmetatable({Ctx=ctx,Running=true,Generation=1,Account=account,Session=session,Ticket=ticket,
        CachePath="AnimeExpeditionsClone/autoexec_"..account..".json",DefaultPalette=clone(ctx.DefaultPalette),
        OriginalKey=ctx.Library.ToggleKeybind,Handlers={},PreviousHandlers={},Status="Settings ready"},Runtime)
    ctx.Environment[KEY]=self
    local handlers=ctx.Environment.AnimeExpeditionsFeatureHandlers or{}ctx.Environment.AnimeExpeditionsFeatureHandlers=handlers
    local callbacks={
        [IDS.AutoExecute]=function()self:SyncAutoExecute()end,
        [IDS.PingFreeze]=function()self:SyncPingFreeze()end,
        [IDS.ToggleKey]=function()self:ApplyKey()end,[IDS.Mobile]=function()self:ApplyMobile()end,
        [IDS.Theme]=function()if not self.Batch then local ok,err=self:ApplyColors()if not ok then self:Notice(err)end end end,
        [IDS.ApplyColors]=function()local ok,err=self:ApplyColors()self:Notice(ok and "UI colors applied"or err)end,
        [IDS.ResetColors]=function()local ok,err=self:ResetColors()self:Notice(ok and "Default UI colors restored"or err)end,
    }
    for id,callback in pairs(callbacks)do
        self.PreviousHandlers[id]=handlers[id]
        local prior=handlers[id]
        local fn=function(...)if type(prior)=="function"then pcall(prior,...)end;if self:Current()then callback(...)end end
        self.Handlers[id]=fn handlers[id]=fn
    end
    self:Notice("Settings ready")
    self:Sync()self:SyncAutoExecute()self:SyncPingFreeze()
    if type(ctx.Delay)=="function"then
        local generation=self.Generation
        local function poll()if not self:Current()or self.Generation~=generation then return end;self:PollNetwork();ctx.Delay(5,poll)end
        ctx.Delay(5,poll)
    end
    return self
end
return Module
