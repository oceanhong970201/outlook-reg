local MONSTER_CLASH_SOURCE = [=====================================================[local MonsterClashCore = assert(loadstring([===================================================[-- Injected Monster Clash event automation. Native discovery and protocols live in the adapter.
-- Only RevealEnvy and EnterHelicopter intents exist here; no joining, unit actions or purchases.
local Module={}
local Core={};Core.__index=Core
local function id(x)return type(x)=="string"and x~=""and #x<=512 end
local function number(x)return type(x)=="number"and x==x and math.abs(x)<math.huge end
local function copy(t)if type(t)~="table"then return t end;local o={}for k,v in pairs(t)do o[k]=copy(v)end;return o end
local function entityFor(s,kind)
 if kind=="RevealEnvy"then return s.Fake end
 if kind=="EnterHelicopter"then return s.Helicopter end
end
local function portalObserved(s)
 local p=s.Helicopter
 return type(p)=="table"and p.Detected==true and id(p.Id)
end
local function incomingObserved(s)
 local p=s.Incoming
 return type(p)=="table"and p.Detected==true and id(p.Id)and number(p.AgeSeconds)and p.AgeSeconds>=0
end
local function scene(s)
 if type(s)~="table"or s.Mode~="KaijuEvent"or s.InGame~=true then return nil end
 for _,k in ipairs({"ScopeKey","GameKey","RunKey","MapKey"})do if not id(s[k])then return nil end end
 return table.concat({s.ScopeKey,s.GameKey,s.RunKey,s.MapKey},"|")
end
local function config(c)
 c=type(c)=="table"and c or{}
 return{AutoFake=c.AutoFake==true,AutoHelicopter=c.AutoHelicopter==true,
  AppearanceWaitSeconds=math.clamp(number(c.AppearanceWaitSeconds)and c.AppearanceWaitSeconds or 30,15,120)}
end
function Module.new(ctx)
 assert(type(ctx)=="table"and type(ctx.ReadState)=="function"and type(ctx.ReadConfig)=="function"and type(ctx.Dispatch)=="function","Monster Clash context required")
 local ledger=type(ctx.Ledger)=="table"and ctx.Ledger or{}
 ledger.Records=type(ledger.Records)=="table"and ledger.Records or{}
 ledger.Serial=number(ledger.Serial)and ledger.Serial or 0
 ledger.Submitted=ledger.Submitted or 0;ledger.Acknowledged=ledger.Acknowledged or 0;ledger.Rejected=ledger.Rejected or 0
