    local now = os.time()
    if not self.Running or self.Stopping or not Config.Enabled or Environment[STATE_KEY] ~= self then return false, "stopped" end
    if self.Busy or self.RetryBusy or self.AwaitingVictory then return false, "busy" end
    if type(record) ~= "table" or record.Key ~= expectedKey or self.MappingKey ~= expectedKey then return false, "stale question key" end
