                        local now=self.Workspace:GetServerTimeNow()
                        -- ReplicateRift explicitly defaults missing duration to 0.
                        -- IsActive still supplies the native boarding gate.
                        local duration=rd.ArrivalDuration
                        if duration==nil then duration=0 end
                        if not finite(rd.ArrivalStartedAt) or not finite(duration) or duration<0
                            or not finite(now) then clockKnown=false
                        else remaining=math.max(0,rd.ArrivalStartedAt+duration-now) end
                    end
