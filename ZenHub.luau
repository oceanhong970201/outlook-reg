function Join:Build()
    local s=self.Ctx.Read()
    self.LastSnapshot=s
    if s.InGame~=false then return nil,"Return to the lobby before joining Monster Clash" end
    if s.Recording~=false then return nil,"Macro recording is active or unavailable" end
    if not s.SessionReady or not s.PartyKnown then return nil,"Waiting for native session/party data" end
    if s.Matchmaking or s.MatchmakingFound then return nil,"Another matchmaking request is active" end
    local mode=s.Mode
    if s.EventAvailable~=true or type(mode)~="table" or mode.ClientCanCreateQueue~=true or mode.MapLocked~=true or mode.MaxPlayers~=4 then
        return nil,"Native Monster Clash event/queue is unavailable"
    end
    local config=mode.Config
    if type(config)~="table"or config.MapName~="KaijuEvent"or config.ActName~="Act 1"or config.Difficulty~="Hard"then return nil,"Native Monster Clash queue schema changed"end
    for field in pairs(config)do
        if field~="MapName"and field~="ActName"and field~="Difficulty"then return nil,"Unverified extra native mode configuration"end
    end
    if mode.RequiredLevel~=nil and (not finite(mode.RequiredLevel)or not finite(s.Level)or s.Level<mode.RequiredLevel)then return nil,"Monster Clash level requirement is not met"end
    local event=s.EventQueue
    if type(event)~="table"or event.Gamemode~="KaijuEvent"or event.MapName~="KaijuEvent"or event.Difficulty~="Hard"then return nil,"Native Monster Clash event queue missing"end
    local q={Gamemode=event.Gamemode,MapName=event.MapName,ActName=config.ActName,Difficulty=event.Difficulty}
    for field,v in pairs(event)do
        if field=="MaxPlayers"then if v~=4 then return nil,"Unverified party size"end
        elseif q[field]~=v then return nil,"Unverified extra queue field: "..tostring(field)end
    end
    if s.Party then
        local d=s.Party.Data
        if type(d)~="table"or d.Leader~=s.Player or d.Type~="Party"then return nil,"Only the current native party leader can join"end
        if type(d.Players)~="table"or not table.find(d.Players,s.Player)or #d.Players>4 or d.StartDisabled==true
            or d.StartDisabled~=nil and type(d.StartDisabled)~="boolean"then return nil,"Native party is not ready to start"end
    end
    local sanitized=self.Ctx.Sanitize(table.clone(q))
    if not same(sanitized,q)then return nil,"Native sanitizer changed the Monster Clash queue; entry blocked"end
    local set,start=self.Ctx.Actions()
    if type(set)~="function"or type(start)~="function"then return nil,"Registered PartySetQueueData/PartyStartGame is unavailable"end
    return q,nil,"KaijuEvent|KaijuEvent|Act 1|Hard"
end
function Join:Observe()
    local s=self.Ctx.Read()
    local p=self.Ledger.Pending
    if s.InGame==true then
        self.Ledger.SeenInGame=true
        if p and type(s.Parameters)=="table"and s.Parameters.Gamemode then
            self.Ledger.Pending=nil
            local confirmed=s.Parameters.Gamemode=="KaijuEvent"and s.Parameters.MapName==p.Queue.MapName
            return false,confirmed and "Native Monster Clash entry confirmed"or "Entered another mode; Monster Clash entry not confirmed",confirmed and "confirmed"or "other-mode"
        end
    elseif s.InGame==false and self.Ledger.SeenInGame then
        self.Ledger.SeenInGame=false self.Ledger.Pending=nil
    end
    if p and not p.Started and (p.Finished or p.Owner~=self.Ctx.Owner)and s.InGame==false and s.PartyKnown
        and p.SetReturned and (not s.Party or same(s.Party.Data and s.Party.Data.QueueData,p.Queue))then
        self.Ledger.Pending=nil
        return false,"Cancelled before entry; native queue selection reconciled"
    end
    return self.Ledger.Pending~=nil,self.Ledger.Pending and "Waiting for native entry confirmation; no repeat submission"or nil
end
function Join:Submit(plan,generation)
    if self.Ledger.Pending then error("Monster Clash entry already pending",0)end
    self.Ctx.Check(plan,generation)
    local q,reason,seed=self:Build()
    if not q or not same(q,plan.QueueData)then error(reason or "Monster Clash parameters changed",0)end
    local set,start=self.Ctx.Actions()
    local pending={Queue=table.clone(q),Seed=seed,Owner=self.Ctx.Owner,Started=false,SetInvoked=false,SetReturned=false,Finished=false}
    self.Ledger.Pending=pending
    local function validate()
        self.Ctx.Check(plan,generation)
        local fresh,why,freshSeed=self:Build()
        if not fresh or not same(fresh,q)or freshSeed~=seed then error(why or "Monster Clash parameters changed before entry",0)end
        local a,b=self.Ctx.Actions()
        if a~=set or b~=start then error("Native party actors changed",0)end
    end
    local ok,result=pcall(function()
        validate()
        pending.SetInvoked=true
        set(table.clone(q))
        pending.SetReturned=true
        local deadline=self.Ctx.Clock()+self.Ctx.AckTimeout
        repeat
            validate()
            local s=self.Ctx.Read()
            if s.PartyKnown and(not s.Party or same(s.Party.Data and s.Party.Data.QueueData,q))then break end
            if self.Ctx.Clock()>=deadline then error("Monster Clash queue acknowledgement timed out; game start blocked",0)end
            self.Ctx.Sleep(.1)
        until false
        self.Ctx.Sleep(self.Ctx.SettleSeconds)
        validate()
        local s=self.Ctx.Read()
        if not s.PartyKnown or s.Party and not same(s.Party.Data and s.Party.Data.QueueData,q)then error("Native party selector changed before entry",0)end
        pending.Started=true
        start(table.clone(q))
        return "Monster Clash entry submitted; combat start remains manual"
    end)
    pending.Finished=true
    if not ok then
        pending.Error=tostring(result)
        if not pending.SetInvoked then self.Ledger.Pending=nil end
        error(result,0)
    end
    return result
end
return Module

end)()

