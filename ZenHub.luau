function Core:_sync(s)
 local key=scene(s)
 if self.Ledger.SceneKey~=key then
  for _,r in pairs(self.Ledger.Records)do if r.SceneKey~=key and r.Status~="confirmed"and r.Status~="rejected"then r.Status="retired"end end
  self.Ledger.SceneKey=key;self.Ledger.Hold=nil;self.Ledger.IncomingWindow=nil
