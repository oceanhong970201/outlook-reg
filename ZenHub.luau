function Controller:PulseAntiAfk()
    if not current() or values()["AE-ANTI-AFK"] == false then return false, "disabled" end
    -- Keep the background idle feature active, but serialize native input across
    -- GUI reloads. A suspended native call owns its slot until it returns naturally.
    local stateKey = "__AnimeExpeditionsAntiAfkNativeState"
