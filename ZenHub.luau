    local key=self.Ctx.KeyCodes[name]
    if key==nil then return false,"Toggle key unavailable"end
    self.Ctx.Library.ToggleKeybind=key self.AppliedKey=key
    if type(self.Ctx.Window.SetFooter)=="function"then self.Ctx.Window:SetFooter(name.." to hide")end
    return true
end
function Runtime:ApplyMobile()
    local show=self:Value(IDS.Mobile,true)==true
    if show and not self.MobileButton then
        if type(self.Ctx.Library.AddDraggableButton)~="function"then return false,"Toggle button API unavailable"end
        self.MobileButton=self.Ctx.Library:AddDraggableButton("Zen Hub",function()
            if self:Current()and self:Value(IDS.Mobile,true)==true then self.Ctx.Library:Toggle()end
        end,true,false)
        if not self.MobileButton or not self.MobileButton.Button then return false,"Toggle button creation failed"end
        if self.Ctx.PositionMobile then self.Ctx.PositionMobile(self.MobileButton.Button)end
    end
    if self.MobileButton and self.MobileButton.Button then self.MobileButton.Button.Visible=show end
    return true
end
function Runtime:ApplyColors()
    local mode=self:Value(IDS.Theme,"Default")
    if mode~="Default"and mode~="Custom"then return false,"Unsupported theme; choose Default or Custom"end
    local palette=clone(self.DefaultPalette)
    if mode=="Custom"then
        for role,original in pairs(self.DefaultPalette)do
            local value=self:Value("AE-SETTINGS-COLOR-"..role,hex(original))
            local normalized=hex(value)
            if not normalized then return false,"Invalid #RRGGBB color: "..role end
            palette[role]=self.Ctx.ColorFromHex(normalized)
