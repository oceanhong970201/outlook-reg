-- The native portal processor resolves rolled modifier indices before filtering.
function Controller:PortalAccepted(portal)
    if type(portal) ~= "table" then return false end
    local info = (Information.Portals.List or {})[portal.Asset]
    if not info then return false end
    local allowed = asSet(value(FEATURE.PortalTypes, {}))
    local display = ((Information.Assets or {})[portal.Asset] or {}).DisplayName
    if not allowed[portal.Asset] and not allowed[display] then return false end
    local tier = info.Rarity == "Secret" and 6 or (tonumber(portal.Tier) or 1)
    if tier > (tonumber(value(FEATURE.PortalTierCap, 6)) or 6) then return false end
    local ignored = asSet(value(FEATURE.PortalIgnoreModifier, {}))
    for modifier in pairs(Information.Portals:GetModifiersFromData(portal) or {}) do
        if ignored[modifier] then return false end
    end
    return true, tier
end

local function buildPortalQueue()
    local selected, selectedData, bestTier
    for id, portal in pairs(getPlayerData().PortalData or {}) do
        local accepted, tier = Controller:PortalAccepted(portal)
        if accepted and (not selected or tier > bestTier or (tier == bestTier and tostring(id) < tostring(selected))) then
            selected, selectedData, bestTier = id, portal, tier
        end
    end
    if not selected then return nil, "no owned portal matches the configured filters" end
    -- PartyView accepts the same native QueueData generated by PortalProcessor.
    return Information.Portals:GetQueueData(selected, selectedData, LocalPlayer.UserId)
end

local function fingerprint(current)
    if type(current) ~= "table" then return tostring(current) end
    local keys, parts = {}, {}
    for k in pairs(current) do table.insert(keys, k) end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    for _, k in ipairs(keys) do table.insert(parts, tostring(k) .. ":" .. fingerprint(current[k])) end
    return "{" .. table.concat(parts, "|") .. "}"
end

local function bossData()
    local event = ((getPlayerData().EventData or {}).BossBountyEvent or {})
    return event, event.Boss, event.QueueData
end

local function buildBossBounty()
    local eventState = (Fusion.peek(Dependencies.EventData) or {}).BossBountyEvent
    local info = (Information.Events or {}).BossBountyEvent
    if not eventState or not info then
        Controller.FeatureStates[FEATURE.BossBounty] = { Status = "waiting-event", Reason = "BossBountyEvent is absent from current native EventData/Information.Events" }
        return nil, "BossBountyEvent is not currently available"
    end
    local _, boss, queue = bossData()
    if type(boss) ~= "table" or type(queue) ~= "table" then
        if type(info.GetRemainingProgress) ~= "function" or info:GetRemainingProgress(getPlayerData()) <= 0 then
            return nil, "waiting for available Boss Bounty progress"
        end
        return nil, nil, { EventId = "BossBountyEvent", Action = "Roll", Before = fingerprint(boss) }
    end
    local identity = table.clone(boss)
    identity.Health = nil -- boss damage is progress, not a new bounty identity
    local key = fingerprint(identity) .. fingerprint(queue)
    local rarity = ({ "Rare", "Legendary", "Secret" })[tonumber(boss.Difficulty) or 1] or "Rare"
    local rejected = not asSet(value(FEATURE.BossRarities, { "Rare", "Legendary", "Secret" }))[rarity]
    local ignoredModifiers = asSet(value(FEATURE.BossIgnoreModifier, {}))
    local ignoredElements = asSet(value(FEATURE.BossIgnoreElement, {}))
    local ignoredArchetypes = asSet(value(FEATURE.BossIgnoreArchetype, {}))
    for modifier in pairs(queue.Modifiers or {}) do if ignoredModifiers[modifier] then rejected = true end end
    for resistance, amount in pairs(queue.Resistances or {}) do
        if (tonumber(amount) or 0) > 0 and (ignoredElements[resistance] or ignoredArchetypes[resistance]) then rejected = true end
    end
    local lossLimit = tonumber(value(FEATURE.BossLossLimit, 0)) or 0
    if lossLimit > 0 and (Controller.BossLosses[key] or 0) >= lossLimit then rejected = true end
    Controller.FeatureStates[FEATURE.BossBounty] = { Status = rejected and "reroll-eligible" or "queue-eligible", Rarity = rarity, Losses = Controller.BossLosses[key] or 0 }
    if rejected then
        local price = tonumber(info.RerollCost) or 5000
        local gold = tonumber(((getPlayerData().ItemData or {}).Gold or {}).Amount) or 0
        if gold < price then
            Controller.FeatureStates[FEATURE.BossBounty].Status = "waiting-gold"
            return nil, "insufficient Gold for native bounty reroll cost"
        end
        return nil, nil, { EventId = "BossBountyEvent", Action = "Reroll", ConfirmSecret = rarity == "Secret", Before = fingerprint(boss) }, key
    end
    local sanitized, reason = sanitizeQueueData(queue)
    return sanitized, reason, nil, key
end

function Controller:ObserveBossResult()
    local result = getSessionData().GameResults
    if type(result) ~= "table" then self.HadBossResult = false return end
    if self.HadBossResult or not self.ActiveBossKey then return end
    local victory = result.Victory
    if victory == nil then victory = result.IsVictory end
    local label = tostring(result.Result or result.Status or ""):lower()
    if victory == nil and (label == "lose" or label == "defeat") then victory = false end
    if victory == nil and (label == "win" or label == "victory") then victory = true end
    if type(victory) ~= "boolean" then return end
    self.HadBossResult = true
    self.BossLosses[self.ActiveBossKey] = victory and 0 or ((self.BossLosses[self.ActiveBossKey] or 0) + 1)
end

local function challengeAvailable(challengeType, index, entry)
    local challengeHistory = (getPlayerData().ChallengeData or {})
    return Information.ChallengeInfo:IsChallengeAvailable(
        challengeHistory.ClearHistory or {},
        challengeHistory.DailyClearHistory or {},
        challengeType,
        index,
        entry.ChallengeStartTime or os.time()
    )
end

local function buildChallengeQueue(challengeType, ignoreEffectsId, ignoreMapsId)
    local challengeData = Fusion.peek(Dependencies.ChallengeData) or {}
    local ignoredEffects = asSet(value(ignoreEffectsId, {}))
    local ignoredMaps = asSet(value(ignoreMapsId, {}))
    for index, entry in ipairs(challengeData[challengeType] or {}) do
        local displayMap = Information.Maps:GetMapDisplayName(entry.MapName)
        local blocked = ignoredMaps[entry.MapName] or ignoredMaps[displayMap]
        for modifier in pairs(entry.Modifiers or {}) do
            if ignoredEffects[modifier] then blocked = true break end
        end
        local selectedRewards = asSet(value(FEATURE.RegularRewards, {}))
        if challengeType == "Regular" and next(selectedRewards) ~= nil then
            local matched = false
            local drops = Information.StageDrops:GetDrops({ Gamemode = "Challenge", ChallengeType = challengeType, ChallengeIndex = index })
            for _, drop in ipairs(drops or {}) do
                local asset = drop.Asset
                local info = (Information.Assets or {})[asset] or {}
                local display = info.DisplayName or asset
                local sprite = type(asset) == "string" and asset:match("^Sprite") ~= nil
                if selectedRewards[asset] or selectedRewards[display] or (sprite and selectedRewards.Sprite) then
                    local amount = tonumber(((getPlayerData().ItemData or {})[asset] or {}).Amount) or 0
                    if not sprite or amount < (tonumber(info.InventoryLimit) or math.huge) then matched = true break end
                end
            end
            if not matched then blocked = true end
        end
        if not blocked and challengeAvailable(challengeType, index, entry) then
            return sanitizeQueueData({
                Gamemode = "Challenge",
                ChallengeType = challengeType,
                ChallengeIndex = index,
            })
        end
    end
    return nil, string.lower(challengeType) .. " challenge unavailable or filtered"
end

function Controller:BuildRegularQueue()
    if value(FEATURE.Disable, false) then return nil, "auto joiners are disabled" end
    return buildChallengeQueue("Regular", FEATURE.RegularIgnoreEffect, FEATURE.RegularIgnoreMap)
end

local function buildTrialQueue()
    local selected = value(FEATURE.TrialName)
    if type(selected) ~= "string" or selected == "" then return nil, "trial is not selected" end
    for _, unitId in ipairs(Information.Maps:GetOrderedMaps("Trial") or {}) do
        local asset = (Information.Assets or {})[unitId] or {}
        local display = tostring(asset.DisplayName or unitId) .. "'s Trial"
        if selected == display or selected == unitId or selected == unitId .. "'s Trial" then
            return sanitizeQueueData({ Gamemode = "Trial", MapName = unitId, TrialUnit = unitId, ActName = "Act 1" })
        end
    end
    return nil, "trial selection was not resolved"
end

local function buildTowerQueue()
    local mode = value(FEATURE.TowerMode, "Normal")
    local tournamentId = mode == "Traitless" and "TowerOfGod_Traitless" or "TowerOfGod"
    local active = (((getPlayerData().TournamentData or {}).ActiveBrackets or {})[tournamentId] or {})["1"] or {}
    local floor = math.max(1, (tonumber(active.HighestScore) or 0) + 1)
    return sanitizeQueueData({ Gamemode = "TowerOfGod", Floor = floor, Mode = mode, TournamentId = tournamentId })
end

