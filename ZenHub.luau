local MonsterClashJoin=(function()
-- Monster Clash lobby entry only. No combat, Macro, quest acceptance or exchange.
local Module={}
local Join={}
Join.__index=Join
local FIELDS={Gamemode=true,MapName=true,ActName=true,Difficulty=true}
local function same(a,b)
    if type(a)~="table"or type(b)~="table"then return false end
    for k in pairs(FIELDS)do if a[k]~=b[k]then return false end end
    for k in pairs(a)do if not FIELDS[k]then return false end end
    for k in pairs(b)do if not FIELDS[k]then return false end end
    return true
end
local function finite(n)return type(n)=="number"and n==n and n~=math.huge and n~=-math.huge end
