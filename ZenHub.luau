 local incomingWindow=self.Ledger.IncomingWindow
 local pendingIncoming=incomingWindow and incomingWindow.SceneKey==key and self:_now()<incomingWindow.Deadline
 local priorHold=self.Ledger.Hold
 if s.ActiveBattle==true and not portalObserved(s)and not incomingObserved(s)then
  if priorHold and priorHold.VictorySeen then self.Ledger.Hold=nil;self.Ledger.IncomingWindow=nil
  elseif not pendingIncoming and not(priorHold and priorHold.ProofObserved)then self.Ledger.Hold=nil end
 end
 local now=self:_now()
 for _,r in pairs(self.Ledger.Records)do if r.SceneKey==key then
  local entity=entityFor(s,r.Kind)
  if type(entity)=="table"and entity.Id==r.EncounterId then
   if entity.Acknowledged==true then
    if not r.CountedAcknowledgement then self.Ledger.Acknowledged+=1;r.CountedAcknowledgement=true end
    r.Status="confirmed"
   elseif entity.Terminal==true and r.Status~="confirmed"then
