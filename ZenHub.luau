        local Groupbox = self
        local Container = Groupbox.Container

        assert(Info.Instance, "Instance must be provided.")
        assert(
            typeof(Info.Instance) == "Instance" and Info.Instance:IsA("GuiBase2d"),
            "Instance must inherit from GuiBase2d."
        )
        assert(typeof(Info.Height) == "number" and Info.Height > 0, "Height must be a number greater than 0.")

        local Passthrough = {
            Connections = {},
            Destroyed = false,

            Instance = Info.Instance,
            Height = Info.Height,
            Visible = Info.Visible,

            Type = "UIPassthrough",
        }

        local Holder = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, Info.Height),
            Visible = Passthrough.Visible,
            Parent = Container,
        })

        Passthrough.Instance.Parent = Holder

        Groupbox:Resize()

        function Passthrough:SetHeight(Height: number)
            assert(typeof(Height) == "number" and Height > 0, "Height must be a number greater than 0.")

            Passthrough.Height = Height
            Holder.Size = UDim2.new(1, 0, 0, Height)
            Groupbox:Resize()
        end

        function Passthrough:SetInstance(Instance: Instance)
            assert(Instance, "Instance must be provided.")
            assert(
                typeof(Instance) == "Instance" and Instance:IsA("GuiBase2d"),
                "Instance must inherit from GuiBase2d."
            )

            if Passthrough.Instance then
                Passthrough.Instance.Parent = nil
            end

            Passthrough.Instance = Instance
            Passthrough.Instance.Parent = Holder
        end

        function Passthrough:SetVisible(Visible: boolean)
            Passthrough.Visible = Visible

            Holder.Visible = Passthrough.Visible
            Groupbox:Resize()
        end

        Passthrough.Holder = Holder
        table.insert(Groupbox.Elements, Passthrough)

        Options[Idx] = Passthrough

        function Passthrough:Destroy()
            Passthrough.Destroyed = true

            if Passthrough.Connections then
                for _, Connection in Passthrough.Connections do
                    Connection:Disconnect()
                end
            end

            if Holder then
                Holder:Destroy()
            end

            local ElemIdx = table.find(Groupbox.Elements, Passthrough)
            if ElemIdx then
                table.remove(Groupbox.Elements, ElemIdx)
            end

            Groupbox:Resize()
            Options[Idx] = nil
        end

        return Passthrough
    end

    function Funcs:AddSubGroupbox(Info)
        if self.Destroyed then return nil end

        Info = Library:Validate(Info, Templates.SubGroupbox)
        local ParentGroupbox = self
        local Indent = math.max(0, tonumber(Info.Indent) or 8)

        local Holder = New("Frame", {
            BackgroundColor3 = "MainColor",
            Size = UDim2.new(1, -Indent, 0, 0),
            Position = UDim2.fromOffset(Indent, 0),
            LayoutOrder = 1000 + #ParentGroupbox.DependencyBoxes,
            Visible = Info.Visible ~= false,
            Parent = ParentGroupbox.Container,
        })
        table.insert(Library.Corners, New("UICorner", {
            CornerRadius = UDim.new(0, math.max(3, Library.CornerRadius - 2)),
            Parent = Holder,
        }))
        Library:AddOutline(Holder)
        New("UIListLayout", { Parent = Holder })

        local HeaderHeight = Info.Description and 48 or 34
        local Header = New("TextButton", {
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, HeaderHeight),
            Text = "",
            Parent = Holder,
        })

        local IconOffset = 0
        local BoxIcon = Library:GetCustomIcon(Info.IconName)
        if BoxIcon then
            IconOffset = 24
            local HeaderIcon = New("ImageLabel", {
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                ImageColor3 = BoxIcon.Custom and "WhiteColor" or "AccentColor",
                Position = UDim2.new(0, 10, 0.5, 0),
                Size = UDim2.fromOffset(18, 18),
                Parent = Header,
            })
            Library:ApplyLucideIcon(HeaderIcon, BoxIcon)
        end

        local Label = New("TextLabel", {
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10 + IconOffset, 0.5, Info.Description and -8 or 0),
            Size = UDim2.new(1, -(42 + IconOffset), 0, 20),
            Text = Info.Name,
            TextSize = 14,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Header,
        })

        local Description = New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10 + IconOffset, 0.5, 7),
            Size = UDim2.new(1, -(42 + IconOffset), 0, 16),
            Text = Info.Description or "",
            TextSize = 12,
            TextTransparency = 0.5,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Visible = Info.Description ~= nil,
            Parent = Header,
        })

        local CollapseArrow = New("ImageLabel", {
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundTransparency = 1,
            ImageColor3 = "WhiteColor",
            Position = UDim2.new(1, -10, 0.5, 0),
            Rotation = 180,
            Size = UDim2.fromOffset(18, 18),
            Visible = Info.DisableCollapsing ~= true,
            Parent = Header,
        })
        if ArrowIcon then
            Library:ApplyLucideIcon(CollapseArrow, ArrowIcon, 180)
        end

        local Line = Library:MakeLine(Holder, {
            LayoutOrder = 1,
            Size = UDim2.new(1, 0, 0, 1),
        })

        local Body = New("Frame", {
            BackgroundTransparency = 1,
            LayoutOrder = 2,
            Size = UDim2.fromScale(1, 0),
            Parent = Holder,
        })
        local BodyList = New("UIListLayout", {
            Padding = UDim.new(0, 8),
            Parent = Body,
        })
        New("UIPadding", {
            PaddingBottom = UDim.new(0, 7),
            PaddingLeft = UDim.new(0, 7),
            PaddingRight = UDim.new(0, 7),
            PaddingTop = UDim.new(0, 7),
            Parent = Body,
        })

        local SubGroupbox: any = {
            Type = "SubGroupbox",
            Text = Info.Name,
            Name = Info.Name,
            Description = Info.Description,
            Connections = {},
            Destroyed = false,
            Visible = Info.Visible ~= false,
            Collapsed = false,
            Holder = Holder,
            Container = Body,
            Parent = ParentGroupbox,
            Tab = ParentGroupbox.Tab,
            Elements = {},
            DependencyBoxes = {},
        }

        local ResizeTween
        local ArrowTween

        function SubGroupbox:Resize()
            if self.Destroyed then return end
            if ResizeTween then
                StopTween(ResizeTween, true)
                ResizeTween = nil
            end
            local BodyHeight = (BodyList.AbsoluteContentSize.Y / Library.DPIScale) + 14
            Body.Size = UDim2.new(1, 0, 0, BodyHeight)
            local TargetHeight = HeaderHeight + (self.Collapsed and 0 or (1 + BodyHeight))
            local TargetSize = UDim2.new(1, -Indent, 0, TargetHeight)
            Line.Visible = not self.Collapsed
            Body.Visible = not self.Collapsed
            if Library.Animations and Library.Animations.Groupbox then
                local Tween = TweenService:Create(Holder, Library.GroupboxTweenInfo or TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = TargetSize })
                ResizeTween = Tween
                Tween:Play()
            else
                Holder.Size = TargetSize
            end
            ParentGroupbox:Resize()
        end

        function SubGroupbox:SetCollapsed(Collapsed: boolean)
            if Info.DisableCollapsing == true then return end
            self.Collapsed = Collapsed == true
            if ArrowTween then StopTween(ArrowTween, true) ArrowTween = nil end
            local Rotation = self.Collapsed and 0 or 180
            if Library.Animations and Library.Animations.Groupbox then
                ArrowTween = TweenService:Create(CollapseArrow, Library.GroupboxTweenInfo or TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = Rotation })
                ArrowTween:Play()
            else
                CollapseArrow.Rotation = Rotation
            end
            self:Resize()
        end

        function SubGroupbox:ToggleCollapsed()
            self:SetCollapsed(not self.Collapsed)
        end

        function SubGroupbox:SetText(Text: string)
            self.Text = Text
            self.Name = Text
            Label.Text = Text
        end

        function SubGroupbox:SetDescription(Text: string?)
            self.Description = Text
            Description.Text = Text or ""
            Description.Visible = Text ~= nil
            HeaderHeight = Text and 48 or 34
            Header.Size = UDim2.new(1, 0, 0, HeaderHeight)
            self:Resize()
        end

        function SubGroupbox:SetVisible(Visible: boolean)
            self.Visible = Visible ~= false
            Holder.Visible = self.Visible
            ParentGroupbox:Resize()
        end

        function SubGroupbox:Show() self:SetVisible(true) end
        function SubGroupbox:Hide() self:SetVisible(false) end
        function SubGroupbox:Update() self:SetVisible(self.Visible) end

        function SubGroupbox:Destroy()
            if self.Destroyed then return end
            self.Destroyed = true
            if ResizeTween then StopTween(ResizeTween, true) end
            if ArrowTween then StopTween(ArrowTween, true) end
            for _, Connection in self.Connections do Connection:Disconnect() end
            while #self.Elements > 0 do
                local Element = self.Elements[#self.Elements]
                if Element.Destroy then Element:Destroy() end
                if self.Elements[#self.Elements] == Element then table.remove(self.Elements) end
            end
            while #self.DependencyBoxes > 0 do
                local Child = self.DependencyBoxes[#self.DependencyBoxes]
                if Child.Destroy then Child:Destroy() end
                if self.DependencyBoxes[#self.DependencyBoxes] == Child then table.remove(self.DependencyBoxes) end
            end
            local Index = table.find(ParentGroupbox.DependencyBoxes, self)
            if Index then table.remove(ParentGroupbox.DependencyBoxes, Index) end
            Holder:Destroy()
            ParentGroupbox:Resize()
        end

        table.insert(SubGroupbox.Connections, BodyList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            SubGroupbox:Resize()
        end))
        if Info.DisableCollapsing ~= true then
            table.insert(SubGroupbox.Connections, Header.MouseButton1Click:Connect(function()
                SubGroupbox:ToggleCollapsed()
            end))
        end

        setmetatable(SubGroupbox, BaseGroupbox)
        table.insert(ParentGroupbox.DependencyBoxes, SubGroupbox)
        SubGroupbox:SetCollapsed(Info.Collapsed == true)
        task.defer(function() SubGroupbox:Resize() end)
        return SubGroupbox
    end

    function Funcs:AddDependencyBox()
        if self.Destroyed then return nil end

        local Groupbox = self
        local Container = Groupbox.Container

        local DepboxContainer
        local DepboxList

        do
            DepboxContainer = New("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Visible = false,
                Parent = Container,
            })

            DepboxList = New("UIListLayout", {
                Padding = UDim.new(0, 8),
                Parent = DepboxContainer,
            })
        end

        local Depbox = {
            Connections = {},
            Destroyed = false,

            Visible = false,
            Dependencies = {},

            Holder = DepboxContainer,
            Container = DepboxContainer,

            Elements = {},
            DependencyBoxes = {}
        }

        function Depbox:Resize()
            DepboxContainer.Size = UDim2.new(1, 0, 0, DepboxList.AbsoluteContentSize.Y / Library.DPIScale)
            Groupbox:Resize()
        end

        function Depbox:Update(CancelSearch)
            for _, Dependency in Depbox.Dependencies do
                local Element = Dependency[1]
                local Value = Dependency[2]

                if Element.Disabled then
                    DepboxContainer.Visible = false
                    Depbox.Visible = false
                    return
                end

                if Element.Type == "Toggle" and Element.Value ~= Value then
                    DepboxContainer.Visible = false
                    Depbox.Visible = false
                    return
                elseif Element.Type == "Dropdown" then
                    if typeof(Element.Value) == "table" then
                        if not Element.Value[Value] then
                            DepboxContainer.Visible = false
                            Depbox.Visible = false
                            return
                        end
                    else
                        if Element.Value ~= Value then
                            DepboxContainer.Visible = false
                            Depbox.Visible = false
                            return
                        end
                    end
                end
            end

            Depbox.Visible = true
            DepboxContainer.Visible = true
            if not Library.Searching then
                task.defer(function()
                    Depbox:Resize()
                end)
            elseif not CancelSearch then
                Library:UpdateSearch(Library.SearchText)
            end
        end

        table.insert(Depbox.Connections, DepboxList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if not Depbox.Visible then
                return
            end

            Depbox:Resize()
        end))

        function Depbox:SetupDependencies(Dependencies)
            for _, Dependency in Dependencies do
                assert(typeof(Dependency) == "table", "Dependency should be a table.")
                assert(Dependency[1] ~= nil, "Dependency is missing element.")
                assert(Dependency[2] ~= nil, "Dependency is missing expected value.")
            end

            Depbox.Dependencies = Dependencies
            Depbox:Update()
        end

        table.insert(Depbox.Connections, DepboxContainer:GetPropertyChangedSignal("Visible"):Connect(function()
            Depbox:Resize()
        end))

        setmetatable(Depbox, BaseGroupbox)

        table.insert(Groupbox.DependencyBoxes, Depbox)
        table.insert(Library.DependencyBoxes, Depbox)

        function Depbox:Destroy()
            Depbox.Destroyed = true

            if Depbox.Connections then
                for _, Connection in Depbox.Connections do
                    Connection:Disconnect()
                end
            end

            for _, Element in Depbox.Elements do
                if Element.Destroy then
                    Element:Destroy()
                end
            end

            for _, SubDepbox in Depbox.DependencyBoxes do
                if SubDepbox.Destroy then
                    SubDepbox:Destroy()
                end
            end

            if DepboxContainer then
                DepboxContainer:Destroy()
            end

            local ElemIdx = table.find(Groupbox.DependencyBoxes, Depbox)
            if ElemIdx then
                table.remove(Groupbox.DependencyBoxes, ElemIdx)
            end

            local LibIdx = table.find(Library.DependencyBoxes, Depbox)
            if LibIdx then
                table.remove(Library.DependencyBoxes, LibIdx)
            end
        end

        return Depbox
    end

