local function migrateCapturedPriority()
    local state = Environment.AnimeExpeditionsUIState
    if type(state) ~= "table" or type(state.Values) ~= "table" or state.Values.__JoinerPriorityVersion == 1 then return end
    local configured = state.Values[FEATURE.Priority]
    local isLegacyDefault = type(configured) == "table" and #configured == #LEGACY_PRIORITY
    if isLegacyDefault then
        for index, label in ipairs(LEGACY_PRIORITY) do
            if configured[index] ~= label then isLegacyDefault = false break end
        end
