function Controller:BuildStageWebhookPayload(context, result)
    context = context or currentContext()
    result = result or {}
    local summary = collectRewardLines(result)
    local won = resultWon(result)
    local macro = Environment.__AnimeExpeditionsMacro
    local macroStatus = type(macro) == "table" and type(macro.GetStatus) == "function" and macro:GetStatus() or {}
    local map = type(Information.Maps) == "table" and Information.Maps[context.MapName] or nil
    local mapName = type(map) == "table" and map.DisplayName or context.DisplayName or context.MapName or "Unknown"
    mapName = tostring(mapName):gsub("(%l)(%u)", "%1 %2"):gsub("_", " ")
    local stage = shortRewardName(mapName) .. " • " .. shortRewardName(context.ActName or "-")
    local mode = shortRewardName(context.StageType or context.Gamemode or "Unknown")
    if context.Difficulty and context.Difficulty ~= "" then mode ..= " • " .. shortRewardName(context.Difficulty) end
    local fields = {
        { name = "Stage", value = stage .. "\n" .. mode, inline = false },
        { name = "Clear time", value = formatDuration(statePath(result, "TotalTime") or statePath(result, "ClearTime") or statePath(result, "Time") or context.GameTime), inline = true },
        { name = "Macro", value = shortRewardName(macroStatus.LoadedMacroName or macroStatus.SelectedMacro or "None"), inline = true },
    }
    addRewardFields(fields, summary)
    if value(FEATURE.ShowSessionData, true) == true then
        local gameState = currentGameState()
        local stats = statePath(gameState, "SessionStats") or {}
        local sessionTime = tonumber(statePath(gameState, "SessionTime")) or (os.time() - self.SessionStartedAt)
        local played = tonumber(statePath(stats, "MatchesPlayed")) or (self.Matches + 1)
        local wins = tonumber(statePath(stats, "MatchesWon")) or (self.Wins + (won and 1 or 0))
        local losses = tonumber(statePath(stats, "MatchesLost")) or (self.SessionLosses + (won and 0 or 1))
        table.insert(fields, { name = "Session", value = formatDuration(sessionTime) .. " • " .. formatAmount(played) .. " matches\nWins: " .. formatAmount(wins) .. " • Losses: " .. formatAmount(losses), inline = false })
    end
    -- The inventory acquisition message owns the ping when enabled. Keep the
    -- stage's rewards visible, but do not notify the same unit twice.
    local content, allowed = unitMention(summary.HasUnits and value(FEATURE.UnitSummonedWebhook, false) ~= true, summary.HasShinyUnits)
    return {
        content = content,
        username = "Anime Expeditions",
        embeds = {{
            title = (won and "✅ Victory" or "❌ Defeat") .. " • Stage Finished",
            description = spoilerPlayerIdentity(),
            color = won and 0x45D483 or 0xE05252,
            fields = fields,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
        allowed_mentions = allowed,
    }
end

function Controller:BuildRestartWebhookPayload(context, reason)
    local map = type(Information.Maps) == "table" and Information.Maps[context.MapName] or nil
    local mapName = type(map) == "table" and map.DisplayName or context.MapName or "Unknown"
    mapName = tostring(mapName):gsub("(%l)(%u)", "%1 %2"):gsub("_", " ")
    local mode = shortRewardName(context.StageType or context.Gamemode or "Unknown")
    if context.Difficulty and context.Difficulty ~= "" then mode ..= " • " .. shortRewardName(context.Difficulty) end
    return {
        username = "Anime Expeditions",
        embeds = {{
            title = "🔄 Restart • Stage Summary",
            description = spoilerPlayerIdentity(),
            color = 0xF4D35E,
            fields = {
                { name = "Stage", value = shortRewardName(mapName) .. " • " .. shortRewardName(context.ActName or "-") .. "\n" .. mode, inline = false },
                { name = "Elapsed time", value = formatDuration(context.GameTime), inline = true },
                { name = "Restart wave", value = formatAmount(context.Wave), inline = true },
                { name = "Reason", value = shortRewardName(reason), inline = false },
                { name = "Result", value = "Restart confirmed; not counted as a victory or defeat.", inline = false },
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
        allowed_mentions = { parse = {}, users = {} },
    }
end

function Controller:ProcessRestartWebhook()
    if self.Stopping or value(FEATURE.StageFinishedWebhook, false) ~= true then return false end
    local sent = false
    for key, event in pairs(self.PendingRestartWebhooks) do
        if not self.WebhookHandled[key] and not self.WebhookInFlight[key] and os.clock() >= (self.WebhookRetryAt[key] or 0) then
            self.WebhookInFlight[key] = true
            self.WebhookAttemptBatches[key] = (self.WebhookAttemptBatches[key] or 0) + 1
            local ok, _, retryable, disposition = self:SendWebhook(self:BuildRestartWebhookPayload(event.Context, event.Reason), "stage-restart")
            self.WebhookInFlight[key] = nil
            if disposition == "cancelled" then
                self.WebhookAttemptBatches[key] = math.max(0, self.WebhookAttemptBatches[key] - 1)
            elseif ok then
                self.WebhookHandled[key] = true
                self.PendingRestartWebhooks[key] = nil
                sent = true
            elseif retryable and self.WebhookAttemptBatches[key] < 2 then
                self.WebhookRetryAt[key] = os.clock() + 15
            else
                self.WebhookHandled[key] = "failed"
                self.PendingRestartWebhooks[key] = nil
            end
        end
    end
    return sent
end

function Controller:ProcessStageWebhook(context, result)
    if value(FEATURE.StageFinishedWebhook, false) ~= true or not result then return false end
    local restartIntent = self.RestartIntents[roundKey(context)]
    if restartIntentSuppressesResult(restartIntent) then return false end
    local key = resultKey(result, context)
    if not key or self.WebhookHandled[key] or self.WebhookInFlight[key] then return false end
    if os.clock() < (self.WebhookRetryAt[key] or 0) then return false end
    local payload = self:BuildStageWebhookPayload(context, result)
    local won = resultWon(result)
    self.WebhookInFlight[key] = true
    self.WebhookAttemptBatches[key] = (self.WebhookAttemptBatches[key] or 0) + 1
    local ok, detail, retryable, disposition = self:SendWebhook(payload, "stage-finished")
    self.WebhookInFlight[key] = nil
    if disposition == "cancelled" then
        self.WebhookAttemptBatches[key] = math.max(0, self.WebhookAttemptBatches[key] - 1)
    elseif ok then
        self.WebhookHandled[key] = true
        self.Matches += 1
        if won then self.Wins += 1 else self.SessionLosses += 1 end
    elseif retryable and self.WebhookAttemptBatches[key] < 2 then
        self.WebhookRetryAt[key] = os.clock() + 15
    else
        self.WebhookHandled[key] = "failed"
    end
    return ok, detail
end

local function inventoryUnitSnapshot(data)
    local asset = statePath(data, "UnitData", "Asset") or statePath(data, "Asset")
    if asset == nil then return nil end
    return {
        Asset = asset,
        Rarity = statePath(data, "UnitData", "Rarity") or statePath(data, "Rarity"),
        Shiny = statePath(data, "UnitData", "Shiny") == true or statePath(data, "UnitData", "IsShiny") == true
            or statePath(data, "Shiny") == true or statePath(data, "IsShiny") == true or statePath(data, "Data", "Shiny") == true,
    }
end

function Controller:DeliverSummon(key, data)
    if self.Stopping or value(FEATURE.UnitSummonedWebhook, false) ~= true then return false end
    key = tostring(key or "")
    if key == "" or self.DeliveredSummons[key] or self.SummonInFlight[key] or self.SummonFailed[key] then return false end
    if os.clock() < (self.SummonRetryAt[key] or 0) then return false end
    -- Only a persistent inventory id (or its already-observed snapshot) proves ownership.
    -- CLIENT_SUMMON_MODEL_LOADED also fires for temporary MockUnit presentations.
    data = self.PendingInventoryUnits[key]
    if not data then
        if self.SeenInventoryUnits[key] then return false end
        local units = statePath(currentPlayerData(), "UnitData")
        for id, unit in pairs(type(units) == "table" and units or {}) do
            if tostring(id) == key then data = inventoryUnitSnapshot(stateValue(unit)) break end
        end
        if not data then return false end
        self.SeenInventoryUnits[key] = true
        self.PendingInventoryUnits[key] = data
    end
    local asset = statePath(data, "UnitData", "Asset") or statePath(data, "Asset")
    local info = type(Information.Units) == "table" and Information.Units[asset] or {}
    local display = displayNameForAsset(asset)
    local rarity = statePath(data, "UnitData", "Rarity") or statePath(data, "Rarity") or info.Rarity or "Unknown"
    local shiny = statePath(data, "UnitData", "Shiny") == true or statePath(data, "Shiny") == true or statePath(data, "Data", "Shiny") == true
    local amount = 1 -- UnitData ids are persistent, non-stackable owned characters.
    if asset == nil then return false end
    local mention, allowed = unitMention(true, shiny, true)
    local payload = {
        content = mention,
        username = "Anime Expeditions",
        embeds = {{ title = "Unit Obtained", description = "+" .. formatAmount(amount) .. " " .. (shiny and "✨ " or "") .. shortRewardName(display) .. " [" .. formatAmount(ownedRewardAmount(asset, shiny, "Unit")) .. "]\nRarity: " .. shortRewardName(rarity), color = shiny and 0xF4D35E or 0x6D5DFB, timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ") }},
        allowed_mentions = allowed,
    }
    self.SummonInFlight[key] = true
    self.SummonAttemptBatches[key] = (self.SummonAttemptBatches[key] or 0) + 1
    local ok, detail, retryable, disposition = self:SendWebhook(payload, "unit-obtained")
    self.SummonInFlight[key] = nil
    if disposition == "cancelled" then
        self.SummonAttemptBatches[key] = math.max(0, self.SummonAttemptBatches[key] - 1)
    elseif ok then
        self.DeliveredSummons[key] = true
        self.PendingInventoryUnits[key] = nil
        self.SummonRetryAt[key] = nil
    elseif retryable and self.SummonAttemptBatches[key] < 2 then
        self.SummonRetryAt[key] = os.clock() + 15
    else
        self.SummonFailed[key] = true
        self.PendingInventoryUnits[key] = nil
    end
    return ok, detail
end

function Controller:HandleSummon(replica, model)
    -- The signal is a low-latency wake-up only; its replica id is not an inventory id.
    return self:ProcessSummonWebhook()
end

function Controller:ProcessSummonWebhook()
    if self.Stopping then return false, 0 end
    local units = statePath(currentPlayerData(), "UnitData")
    if type(units) ~= "table" then return false, 0 end
    if not self.InventoryPrimed then
        for id in pairs(units) do self.SeenInventoryUnits[tostring(id)] = true end
        -- UnitData can be empty or partially filled before PlayerData hydrates.
        -- Level is a native loaded-profile field and also supports an actually
        -- empty new account: its first later character is a real acquisition.
        if tonumber(statePath(currentPlayerData(), "Level")) ~= nil then self.InventoryPrimed = true end
        return false, 0
    end
    local sent = 0
    for id, unitState in pairs(units) do
        local key = tostring(id)
        if self.SeenInventoryUnits[id] then self.SeenInventoryUnits[key] = true end
        if not self.SeenInventoryUnits[key] then
            local snapshot = inventoryUnitSnapshot(stateValue(unitState))
            if value(FEATURE.UnitSummonedWebhook, false) ~= true then
                self.SeenInventoryUnits[key] = true
            elseif snapshot then
                self.SeenInventoryUnits[key] = true
                self.PendingInventoryUnits[key] = snapshot
            end
        end
    end
    for key, snapshot in pairs(self.PendingInventoryUnits) do
        if self:DeliverSummon(key, snapshot) then sent += 1 end
    end
    return sent > 0, sent
end

function Controller:_RunOnce()
    self:ObserveRoundTransition()
    local context = currentContext()
    if self.LastGameId ~= context.GameId then
        self:ClearHitAttackBinding("Game changed")
        self.LastGameId = context.GameId
        self.ResultSeenAt = nil
        self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
    end
    local result = resultData(context)
    local restartIntent = self.RestartIntents[roundKey(context)]
    if restartIntentSuppressesResult(restartIntent) then result = nil end
    context.ResultEpoch = self:ObserveResultTransition(result)
    local function process(name, callback)
        if self.Stopping then return false end
        local ok, resultValue, detail = xpcall(callback, debug.traceback)
        if not ok then self.LastError = name .. ": " .. tostring(resultValue) pushLog("error", name, resultValue) return false end
        return resultValue == true, detail
    end
    process("performance", function() return self:ProcessPerformance(context) end)
    process("skip-vote", function() return self:ProcessAutoSkip(context) end)
    process("summon-webhook", function() return self:ProcessSummonWebhook() end)
    process("restart-webhook", function() return self:ProcessRestartWebhook() end)
    local terminal = false
    if result then
        self:ClearHitAttackBinding("Game finished")
        process("stage-webhook", function() return self:ProcessStageWebhook(context, result) end)
        terminal = process("failsafe", function() return self:ProcessFailsafes(context, result) end)
        if not terminal then terminal = process("game-finished", function() return self:ProcessGameFinished(context, result) end) end
    else
        self.ResultSeenAt = nil
        terminal = process("restart", function() return self:ProcessAutoRestart(context) end)
        if not terminal then
            process("sell", function() return self:ProcessAutoSell(context) end)
            process("hit-replace", function() return self:ProcessHitReplace(context) end)
            process("rewind", function() return self:ProcessRewindLoop(context) end)
            process("smart-ability", function() return self:ProcessSmartAbility(context) end)
            process("dark-mage", function() return self:ProcessDarkMage(context) end)
        end
    end
    if not self.Stopping then self.Status = result and "result" or (context.InGame and "in-game" or "lobby") end
    return true, self.Status
end

function Controller:RunOnce()
    if not self.Running then return false, "stopped" end
    if self.Busy then return false, "busy" end
    self.ActiveOperations += 1
    self.Busy = true
    local packed = table.pack(xpcall(function() return self:_RunOnce() end, debug.traceback))
    self.ActiveOperations = math.max(0, self.ActiveOperations - 1)
    self.Busy = self.ActiveOperations > 0
    if not packed[1] then error(packed[2], 0) end
    return table.unpack(packed, 2, packed.n)
end

function Controller:UnbindGui()
    if type(self.BoundHandlers) ~= "table" then return end
    for id, installed in pairs(self.InstalledHandlers) do
        if self.BoundHandlers[id] == installed then self.BoundHandlers[id] = self.PreviousHandlers[id] end
    end
    self.BoundHandlers = nil
    table.clear(self.InstalledHandlers)
    table.clear(self.PreviousHandlers)
end

function Controller:BindGui()
    self:UnbindGui()
    local handlers = Environment.AnimeExpeditionsFeatureHandlers
    if type(handlers) ~= "table" then handlers = {} Environment.AnimeExpeditionsFeatureHandlers = handlers end
    local function install(id, callback)
        local prior = handlers[id]
        local installed = function(...)
            if type(prior) == "function" then pcall(prior, ...) end
            if Environment[STATE_KEY] == Controller then callback(...) end
        end
        self.PreviousHandlers[id] = prior
        self.InstalledHandlers[id] = installed
        handlers[id] = installed
    end
    install(FEATURE.TestWebhook, function() self:TestWebhook() end)
    install(FEATURE.SetHitPosition, function() self:SetHitReplacePosition() end)
    install(FEATURE.HitUnit, function()
        self:ClearHitAttackBinding("Selected unit changed")
        self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
    end)
    install(FEATURE.AutoHitReplace, function(enabled) if not enabled then self:ClearHitAttackBinding("Disabled") end end)
    install(FEATURE.HitDetection, function() self:ClearHitAttackBinding("Detection method changed") end)
    install(FEATURE.OpenTournament, function()
        local ok, failure = pcall(function() withGameIdentity(function() Actions.ViewTournament() end) end)
        if not ok then self.LastError = tostring(failure) end
    end)
    install(FEATURE.AbilityUnit, function() self:RefreshAbilityOptions() end)
    install(FEATURE.AbilityName, function() self:LoadCurrentAbilityProfile() end)
    for featureId in pairs(PROFILE_FIELDS) do install(featureId, function() self:SaveCurrentAbilityProfile() end) end
    self.BoundHandlers = handlers
    self:RefreshAbilityOptions()
    return true
end

