if GAME_USER_ID and type(reloadState) == "table" and reloadState.Version == 2 and reloadState.UserId == GAME_USER_ID then
    for _, field in ipairs({ "LastGameId", "RoundSerial", "LastObservedWave", "LastObservedGameState", "ResultEpoch", "LastResultKey", "ResultSeenAt", "Losses", "SessionStartedAt", "Matches", "Wins", "SessionLosses", "HitUnitId", "HitMaxedAt", "HitDpsAtMax", "LastRewindAt", "LastRewindAbility" }) do
        Controller[field] = reloadState[field] ~= nil and reloadState[field] or Controller[field]
    end
    for _, field in ipairs({ "ResultHandled", "WebhookHandled", "WebhookRetryAt", "WebhookAttemptBatches", "LossHandled", "Triggered", "LastTransitionAt", "SellRequested", "SeenInventoryUnits", "DeliveredSummons", "PendingInventoryUnits", "SummonRetryAt", "SummonAttemptBatches", "SummonFailed", "RestartIntents", "PendingRestartWebhooks", "HitPlacementByContext", "LastAbilityAt", "LastAbilityWave" }) do
        Controller[field] = copyMap(reloadState[field])
    end
    Controller.InventoryPrimed = reloadState.InventoryPrimed == true
    Controller.HadResult = reloadState.HadResult == true
    Controller.AwaitingResultClear = reloadState.AwaitingResultClear == true
    Controller.RestartResetPending = reloadState.RestartResetPending == true
    Controller.RoundHadProgress = reloadState.RoundHadProgress == true or reloadState.LastObservedGameState == "InProgress"
    if type(reloadState.LastRoundContext) == "table" then Controller.LastRoundContext = copyMap(reloadState.LastRoundContext) end
    if type(reloadState.FallbackRestartBoundary) == "table" then Controller.FallbackRestartBoundary = copyMap(reloadState.FallbackRestartBoundary) end
    if type(reloadState.PendingRoundReset) == "table" then Controller.PendingRoundReset = copyMap(reloadState.PendingRoundReset) end
end

local function pushLog(level, message, data)
    table.insert(Controller.Logs, { Time = os.time(), Level = level, Message = message, Data = data })
    while #Controller.Logs > Config.MaxLogEntries do table.remove(Controller.Logs, 1) end
    print("[AE Game]", level, message, data or "")
end

local function notify(title, description, icon)
    local gui = Environment.__AnimeExpeditionsGuiController
    local library = type(gui) == "table" and gui.Library or nil
    if type(library) == "table" and type(library.Notify) == "function" then
        return pcall(function()
            library:Notify({ Title = title, Description = description, Time = 5, Icon = icon or "bell" })
        end)
    end
    return pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = description, Duration = 5 })
    end)
end

local function currentGameState() return stateValue(Dependencies.GameState) or {} end
local function currentPlayerState() return stateValue(Dependencies.GamePlayerState) or {} end
local function currentPlayerData() return stateValue(Dependencies.PlayerData) or {} end
local function currentSessionData() return stateValue(Dependencies.SessionData) or {} end

local function currentGameId()
    return tostring(statePath(currentPlayerState(), "GameID") or statePath(currentGameState(), "ID") or game.JobId)
end

local function currentWave()
    return tonumber(statePath(currentGameState(), "Wave")) or 0
end

local function finalWave()
    local state = currentGameState()
    local parameters = statePath(state, "Parameters") or {}
    return tonumber(statePath(state, "FinalWave") or statePath(state, "MaxWave") or statePath(parameters, "FinalWave") or statePath(parameters, "MaxWave") or statePath(parameters, "Waves"))
end

local function normalizeStageType(gamemode)
    local aliases = {
        TowerOfGod = "Tower",
        Trial = "Unit Trial",
        UnitTrial = "Unit Trial",
        VillainInvasion = "Villain Invasion",
        EclipsedInfinite = "Eclipsed Infinite",
        EclipseEvent = "Eclipsed Infinite",
        GoldenHour = "Golden Hour",
        GoldenHourEvent = "Golden Hour",
    }
    return aliases[tostring(gamemode)] or tostring(gamemode or "")
end

local function currentContext()
    local state = currentGameState()
    local parameters = statePath(state, "Parameters") or {}
    local gamemode = statePath(parameters, "Gamemode") or statePath(state, "Gamemode")
    return {
        InGame = stateValue(Shared.IsInGame) == true,
        GameId = currentGameId(),
        Wave = currentWave(),
        FinalWave = finalWave(),
        CurrentState = statePath(state, "CurrentGameState"),
        Active = statePath(state, "Active") == true,
        GameTime = tonumber(statePath(state, "GameTime")) or 0,
        GameIncrement = tonumber(statePath(state, "GameIncrement")),
        Gamemode = gamemode,
        StageType = normalizeStageType(gamemode),
        MapName = statePath(parameters, "MapName"),
        ActName = statePath(parameters, "ActName"),
        Difficulty = statePath(parameters, "Difficulty"),
        RiftName = statePath(parameters, "RiftName"),
        RoundSerial = Controller.RoundSerial,
    }
end

local function roundKey(context)
    return tostring(context.GameId) .. "|" .. tostring(context.RoundSerial or 0)
end

local function terminalGameState(state)
    return state == "Lose" or state == "Lost" or state == "Defeat" or state == "Win" or state == "Victory"
end

local function sameRoundScope(a, b)
    return a and b and a.InGame and b.InGame and a.GameId == b.GameId and a.Gamemode == b.Gamemode
        and a.MapName == b.MapName and a.ActName == b.ActName and a.Difficulty == b.Difficulty
        and a.RiftName == b.RiftName
end

local function isMonsterRiftContext(context)
    return context.Gamemode == "KaijuEvent" and context.MapName == "KaijuEvent"
        and context.RiftName == "KaijuEventRift"
end

local function restartIntentSuppressesResult(intent)
    -- An in-progress restart may briefly expose a synthetic Lose result. A replay
    -- requested FROM an actual terminal result must keep that result and identity.
    return intent and os.clock() - intent.At <= 45 and not terminalGameState(intent.Context.CurrentState)
end

function Controller:ObserveRoundTransition()
    local context, prior = currentContext(), self.LastRoundContext
    local sameScope = sameRoundScope(prior, context)
    local waveReset = sameScope and context.Wave <= 2 and context.Wave < prior.Wave
    local timeReset = sameScope and context.GameTime <= 30 and context.GameTime + 1 < prior.GameTime
    local priorKey = prior and roundKey(prior)
    local intent = priorKey and self.RestartIntents[priorKey]
    if intent and os.clock() - intent.At > 45 then intent = nil end
    local boundary = self.FallbackRestartBoundary
    if not sameScope then
        boundary, self.FallbackRestartBoundary, self.PendingRoundReset = nil, nil, nil
    elseif boundary then
        if not context.Active or context.CurrentState ~= "InProgress" then boundary.SawInactive = true end
        if waveReset then boundary.SawWaveReset = true boundary.Wave = math.min(boundary.Wave, context.Wave) end
        if timeReset then boundary.SawTimeReset = true boundary.GameTime = math.min(boundary.GameTime, context.GameTime) end
        local progressed = not waveReset and not timeReset and context.Active and context.CurrentState == "InProgress"
            and ((boundary.SawTimeReset and context.Wave > boundary.Wave)
                or (boundary.SawWaveReset and context.GameTime > boundary.GameTime + 1))
        if progressed or ((waveReset or timeReset) and (intent or boundary.SawInactive)) then
            boundary, self.FallbackRestartBoundary = nil, nil
        end
    end
    -- GameIncrement can advance AT DEFEAT. It is metadata, not a restart signal.
    -- Preserve both reset observations across separate Wave/GameTime replication
    -- frames and wait for the actual active new round before changing identities.
    local pending = self.PendingRoundReset
    if not pending and not boundary and (waveReset or timeReset)
        and (self.RoundHadProgress or intent or terminalGameState(prior.CurrentState)) then
        pending = { Context = copyMap(intent and intent.Context or prior), Key = priorKey,
            Reason = intent and intent.Reason or "Round reset observed (manual or external restart)",
            HasIntent = intent ~= nil, WaveReset = false, TimeReset = false,
            SawInactive = not prior.Active or prior.CurrentState ~= "InProgress" }
        self.PendingRoundReset = pending
    end
    local restarted = false
    if pending and sameRoundScope(pending.Context, context) then
        local before = pending.Context
        pending.WaveReset = pending.WaveReset or (context.Wave <= 2 and context.Wave < before.Wave)
        pending.TimeReset = pending.TimeReset or (context.GameTime <= 30 and context.GameTime + 1 < before.GameTime)
        pending.SawInactive = pending.SawInactive or not context.Active or context.CurrentState ~= "InProgress"
        local waveReady = pending.WaveReset or (before.Wave <= 2 and (pending.HasIntent or pending.SawInactive))
        local timeReady = pending.TimeReset or (before.GameTime <= 3 and (pending.HasIntent or pending.SawInactive))
        if waveReady and timeReady and context.Active and context.CurrentState == "InProgress"
            and context.Wave <= 2 and context.GameTime <= 30 then
            local key = "restart|" .. pending.Key
            if value(FEATURE.StageFinishedWebhook, false) == true and not self.WebhookHandled[key] and not self.PendingRestartWebhooks[key] then
                self.PendingRestartWebhooks[key] = { Context = copyMap(before), Reason = pending.Reason }
            end
            self.RestartIntents[pending.Key] = nil
            self.RoundSerial += 1
            self.FallbackRestartBoundary = { Wave = context.Wave, GameTime = context.GameTime,
                SawWaveReset = pending.WaveReset, SawTimeReset = pending.TimeReset }
            self.PendingRoundReset, self.RestartResetPending = nil, false
            self.ResultSeenAt, self.AwaitingResultClear = nil, true
            self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
            restarted = true
        end
    end
    if context.Active and context.CurrentState == "InProgress" and context.InGame then self.RoundHadProgress = true
    elseif not context.InGame or (prior and not sameScope) then self.RoundHadProgress = false end
    for key, queued in pairs(self.RestartIntents) do
        if os.clock() - queued.At > 45 or not sameRoundScope(queued.Context, context) then self.RestartIntents[key] = nil end
    end
    context.RoundSerial = self.RoundSerial
    self.LastRoundContext = copyMap(context)
    self.LastObservedWave, self.LastObservedGameState = context.Wave, context.CurrentState
    return restarted
end

function Controller:QueueRestartWebhook(context, reason)
    if self.Stopping or Config.DryRun or value(FEATURE.StageFinishedWebhook, false) ~= true then return false end
    context = context or currentContext()
    if not context.InGame then return false end
    local snapshot = copyMap(context)
    snapshot.RoundSerial = snapshot.RoundSerial or self.RoundSerial
    local key = roundKey(snapshot)
    if self.RestartIntents[key] or self.WebhookHandled["restart|" .. key] then return false end
    self.RestartIntents[key] = { Context = snapshot, Reason = tostring(reason or "Restart requested"), At = os.clock() }
    -- Queue only: no HTTP in a native restart dispatch path. The next observed
    -- same-stage round reset confirms this intent; a failed request expires.
    if not self.LastRoundContext then self.LastRoundContext = copyMap(snapshot) end
    return true
end

local function selectedStage(featureId, stageType)
    local configured = value(featureId, {})
    local set = asSet(configured)
    if next(set) == nil then return false end
    return set[stageType] == true
end

local function thresholdReached(configuredWave, context)
    local target = math.max(0, tonumber(configuredWave) or 0)
    if target == 0 then
        return context.FinalWave ~= nil and context.Wave >= context.FinalWave
    end
    return context.Wave >= target
end

local function getGameReplica()
    local ok, replica = pcall(function() return Nodes.GET_GAME_REPLICA:InvokeSelf() end)
    return ok and replica or nil
end

local function getGamePlayerReplica()
    local ok, replica = pcall(function() return Nodes.GET_GAME_PLAYER_REPLICA:InvokeSelf() end)
    return ok and replica or nil
end

local function fireGameReplica(actionName, ...)
    if Config.DryRun then return true, "dry-run" end
    local arguments = table.pack(...)
    return withGameIdentity(function()
        local replica = getGameReplica()
        assert(replica and type(replica.FireServer) == "function", "game replica is unavailable")
        replica:FireServer(actionName, table.unpack(arguments, 1, arguments.n))
        return true
    end)
end

local function fireGamePlayer(actionName, ...)
    if Config.DryRun then return true, "dry-run" end
    local arguments = table.pack(...)
    local macro = Environment.__AnimeExpeditionsMacro
    local priorReplaying = type(macro) == "table" and macro.Replaying or nil
    if type(macro) == "table" then macro.Replaying = true end
    local packed = table.pack(xpcall(function()
        return withGameIdentity(function()
            local replica = getGamePlayerReplica()
            assert(replica and type(replica.FireServer) == "function", "game player replica is unavailable")
            replica:FireServer(actionName, table.unpack(arguments, 1, arguments.n))
            return true
        end)
    end, debug.traceback))
    if type(macro) == "table" then macro.Replaying = priorReplaying == true end
    if not packed[1] then error(packed[2], 0) end
    return table.unpack(packed, 2, packed.n)
end

local function displayNameForAsset(asset)
    local info = type(Information.Units) == "table" and Information.Units[asset] or nil
    if type(info) == "table" and type(info.DisplayName) == "string" then return info.DisplayName end
    local ok, display = pcall(function() return Information:GetAssetDisplayName(asset) end)
    return ok and display or asset
end

local function liveUnitEntries()
    local models = stateValue(Dependencies.GameUnitModels) or {}
    local units = stateValue(Dependencies.GameUnits) or {}
    local result = {}
    for id, modelState in pairs(models) do
        local model = stateValue(modelState)
        local unit = model and stateValue(units[model]) or nil
        if type(unit) == "table" and statePath(unit, "Owner") == LocalPlayer then
            local asset = statePath(unit, "UnitData", "Asset") or statePath(unit, "Asset")
            table.insert(result, {
                Id = tostring(id),
                Model = model,
                Data = unit,
                Asset = asset,
                DisplayName = displayNameForAsset(asset),
                Upgrade = tonumber(statePath(unit, "Upgrade")) or 0,
                MaxUpgrade = tonumber(statePath(unit, "MaxUpgrade")),
                TargetPriority = statePath(unit, "TargetPriority"),
                CFrame = statePath(unit, "CFrame"),
                IsFarm = statePath(unit, "IsFarm") == true,
                Unsellable = statePath(unit, "Unsellable") == true,
                IsPhantom = statePath(unit, "IsPhantom") == true,
                TotalDamage = tonumber(statePath(unit, "TotalDamage")) or 0,
                Abilities = statePath(unit, "Abilities"),
            })
        end
    end
    table.sort(result, function(a, b) return a.Id < b.Id end)
    return result
end

local function isFarmUnit(entry)
    if entry.IsFarm then return true end
    local info = type(Information.Units) == "table" and Information.Units[entry.Asset] or nil
    if type(info) ~= "table" then return false end
    if info.Element == "Farm" then return true end
    local upgradeInfo = type(info.UpgradeInfo) == "table" and (info.UpgradeInfo[tostring(entry.Upgrade)] or info.UpgradeInfo[entry.Upgrade]) or nil
    return type(upgradeInfo) == "table" and (upgradeInfo.HitboxType == "Farm" or tonumber(upgradeInfo.Farm) ~= nil)
end

function Controller:ClaimTransition(context, action)
    -- MONSTER_TRANSITION_GUARD_BEGIN
    local monster=Environment.__AnimeExpeditionsMonsterClash
    -- The completed helicopter destination is not another helicopter farm stage.
    -- Keep this bypass scoped to the native Rift identity, never the display name.
    if not isMonsterRiftContext(context) and type(monster)=="table"and type(monster.ShouldHoldGameTransition)=="function"then
        local ok,hold,reason=pcall(monster.ShouldHoldGameTransition,monster)
        if ok and hold==true then self.LastAction="monster-clash:waiting-helicopter"return false,reason end
    end
    -- MONSTER_TRANSITION_GUARD_END
    local now = os.clock()
    local key = roundKey(context)
    local previous = self.LastTransitionAt[key]
    if previous and now - previous.At < 5 then return false, previous.Action end
    self.LastTransitionAt[key] = { At = now, Action = action }
    return true
end

local function hotbarSlotForDisplay(displayName)
    local playerData = currentPlayerData()
    local unitData = statePath(playerData, "UnitData") or {}
    local slots = statePath(Dependencies.HotbarState, "Slots") or {}
    for index = 1, 6 do
        local slot = stateValue(slots[tostring(index)]) or {}
        local unitId = statePath(slot, "ID")
        local unit = unitId and stateValue(unitData[unitId]) or nil
        local asset = unit and statePath(unit, "Asset") or nil
        if asset and displayNameForAsset(asset) == displayName then return index, asset end
    end
    return nil
end

local function resultData(context)
    local result = statePath(currentSessionData(), "GameResults")
    if terminalGameState(context.CurrentState) then
        -- Reconcile pre-fix reload state: a terminal result is positive evidence,
        -- even if an earlier counter-only transition set this stale-result latch.
        Controller.AwaitingResultClear = false
    end
    if context.CurrentState == "InProgress" then
        if type(result) ~= "table" then Controller.AwaitingResultClear = false end
        return nil
    end
    if Controller.PendingRoundReset and not terminalGameState(context.CurrentState) then return nil end
    if Controller.AwaitingResultClear then
        if type(result) ~= "table" then Controller.AwaitingResultClear = false end
        return nil
    end
    if type(result) == "table" then return result end
    if terminalGameState(context.CurrentState) then
        return { Result = context.CurrentState, IsVictory = context.CurrentState == "Win" or context.CurrentState == "Victory", ClearTime = context.GameTime }
    end
    return nil
end

function Controller:ObserveResultTransition(result)
    if type(result) == "table" then
        if not self.HadResult then self.ResultEpoch += 1 end
        self.HadResult = true
    else
        self.HadResult = false
    end
    return self.ResultEpoch
end

local function resultKey(result, context)
    if type(result) ~= "table" then return nil end
    return roundKey(context) .. "|result|" .. tostring(context.ResultEpoch or Controller.ResultEpoch)
end

local function resultWon(result)
    if type(result) ~= "table" then return false end
    local victory = statePath(result, "Victory")
    if victory ~= nil then return victory == true end
    victory = statePath(result, "IsVictory")
    if victory ~= nil then return victory == true end
    local text = tostring(statePath(result, "Result") or statePath(result, "Status") or ""):lower()
    return text == "win" or text == "victory" or text == "cleared"
end

local function updateLabel(id, text)
    local gui = Environment.__AnimeExpeditionsGuiController
    local control = type(gui) == "table" and gui.Controls and gui.Controls[id] or nil
    if type(control) == "table" and type(control.SetText) == "function" then pcall(function() control:SetText(text) end) end
end

local function setSetting(name, desired)
    local settings = statePath(currentPlayerData(), "Settings") or {}
    local current = stateValue(settings[name])
    if current == desired then Controller.LastSettings[name] = desired return false end
    if Controller.LastSettings[name] == desired and current == nil then return false end
    if Controller.OriginalSettings[name] == nil then
        local fallback
        if type(Information.Settings) == "table" and type(Information.Settings.Default) == "table" then fallback = Information.Settings.Default[name] end
        local original = current
        if original == nil then original = fallback end
        Controller.OriginalSettings[name] = { Value = original }
    end
    if not Config.DryRun then withGameIdentity(function() Actions.ChangeSetting(name, desired) end) end
    Controller.LastSettings[name] = desired
    return true
end

local function restoreOwnedSetting(name)
    local original = Controller.OriginalSettings[name]
    if not original then return false end
    if original.Value ~= nil and not Config.DryRun then pcall(function() withGameIdentity(function() Actions.ChangeSetting(name, original.Value) end) end) end
    Controller.OriginalSettings[name] = nil
    Controller.LastSettings[name] = nil
    return true
end

local function releaseAutoSkipSetting()
    -- Disabled automation relinquishes control; it must not restore a stale value over a manual choice.
    Controller.OriginalSettings.AutoSkipWaves = nil
    Controller.LastSettings.AutoSkipWaves = nil
end

local function tidalSiegeOwnsRound()
    local tidal = Environment.__AnimeExpeditionsTidalSiege
    if type(tidal) ~= "table" or type(tidal.OwnsRound) ~= "function" then return false end
    local ok, ownsRound = pcall(tidal.OwnsRound, tidal)
    return ok and ownsRound == true
end

function Controller:ProcessAutoRestart(context)
    if tidalSiegeOwnsRound() then return false end
    if not context.InGame or context.CurrentState ~= "InProgress" or value(FEATURE.AutoRestart, false) ~= true then return false end
    if not selectedStage(FEATURE.AutoRestartStages, context.StageType) then return false end
    if not thresholdReached(value(FEATURE.RestartWave, 1), context) then return false end
    local key = "restart|" .. roundKey(context)
    if self.Triggered[key] then return false end
    if not self:ClaimTransition(context, "restart") then return false end
    self:QueueRestartWebhook(context, "Auto Restart")
    fireGameReplica("Restart")
    self.Triggered[key] = true
    self.LastAction = "auto-restart"
    return true
end

function Controller:ProcessAutoSell(context)
    if not context.InGame or context.CurrentState ~= "InProgress" then return false end
    local modes = {
        { Enabled = FEATURE.AutoSellFarm, Stages = FEATURE.AutoSellFarmStages, Wave = FEATURE.AutoSellFarmWave, FarmOnly = true, Name = "farm" },
        { Enabled = FEATURE.AutoSellUnit, Stages = FEATURE.AutoSellUnitStages, Wave = FEATURE.AutoSellUnitWave, FarmOnly = false, Name = "unit" },
    }
    local sold = 0
    local soldThisPass = {}
    for _, mode in ipairs(modes) do
        if value(mode.Enabled, false) == true and selectedStage(mode.Stages, context.StageType) and thresholdReached(value(mode.Wave, 0), context) then
            for _, unit in ipairs(liveUnitEntries()) do
                local requestKey = roundKey(context) .. "|sell|" .. unit.Id
                if not soldThisPass[unit.Id] and not self.SellRequested[requestKey] and not unit.Unsellable and not unit.IsPhantom and (not mode.FarmOnly or isFarmUnit(unit)) then
                    fireGamePlayer("SellGameUnit", unit.Id)
                    self.SellRequested[requestKey] = true
                    soldThisPass[unit.Id] = true
                    sold += 1
                end
            end
        end
    end
    if sold > 0 then self.LastAction = "auto-sell:" .. tostring(sold) end
    return sold > 0, sold
end

function Controller:ProcessAutoSkip(context)
    if context.Gamemode=="BossRush" then
        local boss=Environment.__AnimeExpeditionsBossRush
        local cfg=type(boss)=="table" and type(boss.ReadConfig)=="function" and boss:ReadConfig() or {}
        local skip=cfg.Playing==true and cfg.Manual~=true and value(FEATURE.AutoSkip,false)==true
        if selectedStage(FEATURE.AutoSkipStages,context.StageType) then
            local stopWave=math.max(0,tonumber(value(FEATURE.StopSkipWave,0)) or 0)
            if stopWave>0 and context.Wave>=stopWave then skip=false end
        end
        local changed=setSetting("AutoSkipWaves",skip)
        local voteChanged=setSetting("AutoVoteStart",false)
        return changed or voteChanged
    end
    local enabled = value(FEATURE.AutoSkip, false) == true
    -- Captured semantics: Auto Skip is global; the stage selection only scopes where Stop Skip at Wave applies.
    local changed = false
    if enabled then
        local desired = true
        if selectedStage(FEATURE.AutoSkipStages, context.StageType) then
            local stopWave = math.max(0, tonumber(value(FEATURE.StopSkipWave, 0)) or 0)
            if stopWave > 0 and context.Wave >= stopWave then desired = false end
        end
        changed = setSetting("AutoSkipWaves", desired)
    else
        releaseAutoSkipSetting()
    end
    local voteChanged = setSetting("AutoVoteStart", value(FEATURE.AutoVoteStart, false) == true)
    if changed or voteChanged then self.LastAction = "game-settings" end
    return changed or voteChanged
end

function Controller:ProcessFailsafes(context, result)
    if tidalSiegeOwnsRound() then return false end
    if not result then self.ResultSeenAt = nil return false end
    self.ResultSeenAt = self.ResultSeenAt or os.clock()
    local key = resultKey(result, context)
    local lost = not resultWon(result)
    local countLosses = value(FEATURE.ReturnLobbyLossCount, false) == true
    if not countLosses then self.Losses = 0 end
    if countLosses and lost and key and not self.LossHandled[key] and selectedStage(FEATURE.LossCountStages, context.StageType) then
        self.LossHandled[key] = true
        self.Losses += 1
    end
    if countLosses then
        local target = math.max(1, math.floor(tonumber(value(FEATURE.LossCountAmount, 1)) or 1))
        if self.Losses >= target and not self.Triggered["loss-count|" .. roundKey(context)] then
            if not self:ClaimTransition(context, "loss-count-lobby") then return false end
            fireGameReplica("Lobby")
            self.Triggered["loss-count|" .. roundKey(context)] = true
            self.Losses = 0
            return true
        end
    end
    if value(FEATURE.ReturnLobbyFailsafe, false) == true and os.clock() - self.ResultSeenAt >= Config.ResultFailsafeSeconds then
        if not self.Triggered["result-timeout|" .. roundKey(context)] then
            if not self:ClaimTransition(context, "result-timeout-lobby") then return false end
            fireGameReplica("Lobby")
            self.Triggered["result-timeout|" .. roundKey(context)] = true
            return true
        end
    end
    return false
end

function Controller:ProcessGameFinished(context, result)
    if context.Gamemode=="BossRush" then
        local boss=Environment.__AnimeExpeditionsBossRush
        local cfg=type(boss)=="table" and type(boss.ReadConfig)=="function" and boss:ReadConfig() or {}
        if cfg.Manual==true or cfg.Playing~=true then return false end
    end
    if tidalSiegeOwnsRound() then return false end
    if not result then return false end
    local key = resultKey(result, context)
    local returnFromMonsterRift = isMonsterRiftContext(context) and value(FEATURE.AutoRunJoiner, false) == true
    -- Old builds could consume a synthetic Rift result as Replay before the
    -- native RestartDisabled flag arrived. Recover that marker once, not Lobby.
    local handled = key and self.ResultHandled[key]
    if not key or (handled and not (returnFromMonsterRift and handled == "replay")) then return false end
    self.ResultSeenAt = self.ResultSeenAt or os.clock()
    if os.clock() - self.ResultSeenAt < Config.ResultActionDelaySeconds then return false end
    local action
    local ok = false
    if returnFromMonsterRift then
        -- Auto Run Joiner owns the return leg from Rift to ordinary Monster
        -- Clash. Do not let Replay/late result flags steal this transition.
        action = "joiner-lobby"
    elseif value(FEATURE.AutoNext, false) == true and statePath(result, "HasNextStage") == true then
        action = "next"
    elseif value(FEATURE.AutoReplay, false) == true and statePath(result, "RestartDisabled") ~= true then
        action = "replay"
    elseif value(FEATURE.AutoReturnLobby, false) == true then
        action = "lobby"
    elseif value(FEATURE.AutoRunJoiner, false) == true then
        action = "joiner-lobby"
    end
    if action and not self:ClaimTransition(context, action) then return false end
    if action == "next" then ok = Config.DryRun or pcall(function() withGameIdentity(function() Actions.GameNext() end) end)
    elseif action == "replay" then ok = Config.DryRun or pcall(function() self:QueueRestartWebhook(context, "Auto Replay") fireGameReplica("Restart") end)
    elseif action then ok = Config.DryRun or pcall(function() fireGameReplica("Lobby") end) end
    if action and ok then
        self.ResultHandled[key] = action
        self.LastAction = "game-finished:" .. action
        return true, action
    end
    return false
end

local function captureCFrame()
    local character = LocalPlayer and LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return root and root.CFrame or nil
end

function Controller:SetHitReplacePosition()
    local context = currentContext()
    local cframe = captureCFrame()
    if not cframe then return false, "character position is unavailable" end
    self.HitPlacementByContext[context.StageType .. "|" .. tostring(context.MapName) .. "|" .. tostring(context.ActName)] = cframe
    updateLabel(FEATURE.HitStatus, "Selected Unit: " .. tostring(value(FEATURE.HitUnit, "None")) .. "\nStatus: Position saved")
    return true, cframe
end

local function hitContextKey(context)
    return context.StageType .. "|" .. tostring(context.MapName) .. "|" .. tostring(context.ActName)
end

local function unitUpgradeInfo(asset)
    local info = type(Information.Units) == "table" and Information.Units[asset] or nil
    return type(info) == "table" and info.UpgradeInfo or nil
end

local function maxUpgrade(asset)
    local maximum = 0
    for key in pairs(unitUpgradeInfo(asset) or {}) do maximum = math.max(maximum, tonumber(key) or 0) end
    return maximum
end

local function totalBuildCost(asset)
    local total = 0
    for _, entry in pairs(unitUpgradeInfo(asset) or {}) do total += tonumber(entry.Cost) or 0 end
    return total
end

local function currentYen()
    return tonumber(statePath(currentPlayerState(), "Yen") or statePath(currentGameState(), "Yen")) or 0
end

local function findUnitById(id)
    for _, entry in ipairs(liveUnitEntries()) do if entry.Id == tostring(id) then return entry end end
    return nil
end

local function closestPlacedUnit(displayName, cframe)
    local closest, closestDistance
    for _, entry in ipairs(liveUnitEntries()) do
        if entry.DisplayName == displayName then
            local position = entry.CFrame and entry.CFrame.Position or (typeof(entry.Model) == "Instance" and entry.Model:GetPivot().Position or nil)
            local distance = position and (position - cframe.Position).Magnitude or math.huge
            if not closestDistance or distance < closestDistance then closest, closestDistance = entry, distance end
        end
    end
    return closest
end

function Controller:ClearHitAttackBinding(reason)
    local binding = self.HitReplicaBinding
    self.HitReplicaBinding = nil
    if binding then
        for _, connection in ipairs(binding.Connections) do pcall(function() connection:Disconnect() end) end
    end
    self.HitAttack = nil
    self.HitAttackCancelled = false
    self.HitDetectionStatus = reason
end

local function hitBindingCurrent(controller, binding)
    return controller.Running and not controller.Stopping and Environment[STATE_KEY] == controller
        and controller.HitReplicaBinding == binding and value(FEATURE.AutoHitReplace, false) == true
        and value(FEATURE.HitDetection, "VFX / Damage Based") == "VFX / Damage Based"
end

function Controller:AdvanceHitAttack()
    local attack = self.HitAttack
    if not attack then return false end
    local now = os.clock()
    attack.Progress += math.max(0, now - attack.LastAt) * math.max(0, attack.Rate)
    attack.LastAt = now
    return attack.Progress >= attack.Duration
end

function Controller:ObserveHitAttack(binding, skillName, origin)
    if not hitBindingCurrent(self, binding) then return false end
    if skillName == "StopVFX" or skillName == "MoveTo" then
        self.HitAttack = nil
        self.HitAttackCancelled = true
        self.HitDetectionStatus = "Attack cancelled: " .. skillName
        return false
    end
    local data = binding.Replica.Data or {}
    local currentSkill = statePath(data, "CurrentStats", "SkillName")
    if type(currentSkill) ~= "string" or skillName ~= currentSkill then return false end
    if statePath(data, "Stunned") == true then return false end
    local asset = statePath(data, "UnitData", "Asset")
    if (tonumber(statePath(data, "Upgrade")) or 0) < maxUpgrade(asset) then return false end
    local ok, skill = pcall(function() return Information:GetUnitSkillInfo(binding.Model.Name, skillName) end)
    if not ok or type(skill) ~= "table" then self.HitDetectionStatus = "Native skill metadata unavailable" return false end
    local delays = type(skill.DelayBetweenTicks) == "table" and skill.DelayBetweenTicks or { tonumber(skill.DelayBetweenTicks) or 0 }
    local duration = (tonumber(skill.DelayBeforeAttack) or 0) + (tonumber(skill.DelayAfterAttack) or 0)
    for tick = 1, math.max(0, math.floor(tonumber(skill.Ticks) or 1)) do duration += tonumber(delays[tick] or delays[#delays]) or 0 end
    if duration <= 0 then self.HitDetectionStatus = "Native skill duration unavailable" return false end
    local multiplier = (tonumber(skill.AttackSpeed) or 1) * (tonumber(statePath(data, "CurrentStats", "AttackSpeed")) or 1)
    -- ClientUnitAttack clones TimeManager with this multiplier. Native Clone uses Speed + multiplier - 1, not multiplication.
    local rate = (tonumber(statePath(data, "Speed")) or 1) + multiplier - 1
    self.HitAttack = { Duration = duration, Progress = 0, LastAt = os.clock(), Multiplier = multiplier, Rate = rate, Origin = origin, SkillName = skillName }
    self.HitAttackCancelled = false
    self.HitDetectionStatus = "Waiting for native attack duration"
    return true
end

function Controller:EnsureHitAttackBinding(entry)
    local binding = self.HitReplicaBinding
    if binding and binding.Id == entry.Id and binding.Model == entry.Model then return binding end
    self:ClearHitAttackBinding("Waiting for native unit replica")
    local node = Nodes.GET_REPLICA_FROM_UNIT_MODEL
    if not node or type(node.InvokeSelf) ~= "function" then return nil end
    local ok, replica = pcall(function() return withGameIdentity(function() return node:InvokeSelf(entry.Model) end) end)
    if not ok or type(replica) ~= "table" or not replica.OnClientEvent or type(replica.OnClientEvent.Connect) ~= "function" or type(replica.OnSet) ~= "function" then return nil end
    binding = { Id = entry.Id, Model = entry.Model, Replica = replica, Connections = {} }
    self.HitReplicaBinding = binding
    local connected, failure = pcall(function()
        withGameIdentity(function()
            table.insert(binding.Connections, replica.OnClientEvent:Connect(function(skillName)
                self:ObserveHitAttack(binding, skillName, "native-attack-event")
            end))
            table.insert(binding.Connections, replica:OnSet({ "Speed" }, function(speed)
                if not hitBindingCurrent(self, binding) then return end
                self:AdvanceHitAttack()
                if self.HitAttack then self.HitAttack.Rate = (tonumber(speed) or 1) + self.HitAttack.Multiplier - 1 end
            end))
            table.insert(binding.Connections, replica:OnSet({ "Stunned" }, function(stunned)
                if stunned and hitBindingCurrent(self, binding) then
                    self.HitAttack = nil
                    self.HitAttackCancelled = true
                    self.HitDetectionStatus = "Attack cancelled: Stunned"
                end
            end))
        end)
    end)
    if not connected then self:ClearHitAttackBinding("Native attack subscription failed") self.LastError = tostring(failure) return nil end
    return binding
end

function Controller:ProcessHitReplace(context)
    local enabled = value(FEATURE.AutoHitReplace, false) == true
    if not enabled then
        self:ClearHitAttackBinding("Disabled")
        self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
        updateLabel(FEATURE.HitStatus, "Selected Unit: " .. tostring(value(FEATURE.HitUnit, "None")) .. "\nStatus: Disabled")
        return false
    end
    local selected = value(FEATURE.HitUnit)
    local placement = self.HitPlacementByContext[hitContextKey(context)]
    if not context.InGame or context.Wave < (tonumber(value(FEATURE.HitStartWave, 1)) or 1) or type(selected) ~= "string" or not placement then
        self:ClearHitAttackBinding("Waiting for placement conditions")
        setSetting("AutoUpgradeOnPlacement", value(FEATURE.HitInactiveUpgrade, "Disabled") == "Enabled")
        updateLabel(FEATURE.HitStatus, "Selected Unit: " .. tostring(selected or "None") .. "\nStatus: Waiting")
        return false
    end
    setSetting("AutoUpgradeOnPlacement", false)
    local entry = self.HitUnitId and findUnitById(self.HitUnitId) or nil
    if entry and entry.DisplayName ~= selected then
        self:ClearHitAttackBinding("Selected unit changed")
        self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
        entry = nil
    end
    entry = entry or closestPlacedUnit(selected, placement)
    if entry then self.HitUnitId = entry.Id end
    if not entry then
        self:ClearHitAttackBinding("Waiting for placed unit")
        local slot, asset = hotbarSlotForDisplay(selected)
        if not slot then updateLabel(FEATURE.HitStatus, "Selected Unit: " .. selected .. "\nStatus: Not equipped") return false end
        fireGamePlayer("PlaceGameUnit", slot, placement)
        self.HitAsset = asset
        updateLabel(FEATURE.HitStatus, "Selected Unit: " .. selected .. "\nStatus: Placing")
        return true
    end
    local maximum = entry.MaxUpgrade or maxUpgrade(entry.Asset)
    local detection = value(FEATURE.HitDetection, "VFX / Damage Based")
    local hitBinding = detection == "VFX / Damage Based" and self:EnsureHitAttackBinding(entry) or nil
    if detection ~= "VFX / Damage Based" then self:ClearHitAttackBinding("Timing Based") end
    if entry.Upgrade < maximum then
        fireGamePlayer("UpgradeGameUnit", entry.Id)
        updateLabel(FEATURE.HitStatus, "Selected Unit: " .. selected .. "\nStatus: Upgrading " .. tostring(entry.Upgrade) .. "/" .. tostring(maximum))
        return true
    end
    self.HitMaxedAt = self.HitMaxedAt or os.clock()
    self.HitDpsAtMax = self.HitDpsAtMax or tonumber(statePath(Dependencies.GameUnitDPS, entry.Id)) or 0
    local delay = math.max(0, tonumber(value(FEATURE.HitSellDelay, 1)) or 1)
    local ready = os.clock() - self.HitMaxedAt >= delay
    if detection == "VFX / Damage Based" then
        local currentDps = tonumber(statePath(Dependencies.GameUnitDPS, entry.Id)) or 0
        if hitBinding and not self.HitAttack and not self.HitAttackCancelled and currentDps > self.HitDpsAtMax then
            self:ObserveHitAttack(hitBinding, statePath(hitBinding.Replica.Data, "CurrentStats", "SkillName"), "damage-duration-fallback")
        end
        ready = hitBinding ~= nil and self:AdvanceHitAttack()
    end
    if ready and currentYen() >= totalBuildCost(entry.Asset) then
        fireGamePlayer("SellGameUnit", entry.Id)
        self:ClearHitAttackBinding("Unit sold")
        self.HitUnitId, self.HitMaxedAt, self.HitDpsAtMax = nil, nil, nil
        updateLabel(FEATURE.HitStatus, "Selected Unit: " .. selected .. "\nStatus: Replacing")
        return true
    end
    updateLabel(FEATURE.HitStatus, "Selected Unit: " .. selected .. "\nStatus: " .. (ready and "Waiting for replacement funds" or self.HitDetectionStatus or "Waiting for hit/funds"))
    return false
end

local function findDisplayUnit(name)
    for _, entry in ipairs(liveUnitEntries()) do if entry.DisplayName == name then return entry end end
    return nil
end

local function abilityReady(unit, abilityId)
    local cooldowns = stateValue(Dependencies.Cooldowns) or {}
    local ownerKeys = { unit.Id, statePath(currentPlayerState(), "GamePlayerID"), currentGameId() }
    local sessionTime = tonumber(statePath(currentGameState(), "SessionTime")) or os.clock()
    for _, ownerKey in ipairs(ownerKeys) do
        local ownerCooldowns = ownerKey and stateValue(cooldowns[ownerKey]) or nil
        local cooldown = type(ownerCooldowns) == "table" and stateValue(ownerCooldowns[abilityId]) or nil
        if type(cooldown) == "table" then
            local startTime = tonumber(statePath(cooldown, "StartTime")) or 0
            local duration = tonumber(statePath(cooldown, "Duration")) or 0
            return sessionTime >= startTime + duration
        end
    end
    return true
end

function Controller:ProcessRewindLoop(context)
    if value(FEATURE.AutoRewind, false) ~= true or not context.InGame then
        updateLabel(FEATURE.RewindStatus, "Status: Disabled")
        return false
    end
    local delay = math.max(0.5, tonumber(value(FEATURE.RewindDelay, 12)) or 12)
    if os.clock() - self.LastRewindAt < delay then return false end
    local shadow, puppet, readyShadow, readyPuppet
    for _, entry in ipairs(liveUnitEntries()) do
        if entry.DisplayName == "Shadow (Divine)" and entry.Upgrade >= 7 then
            shadow = entry
            if not readyShadow and abilityReady(entry, "MegumiAbility1") then readyShadow = entry end
        elseif entry.DisplayName == "Puppet (Telekinetic)" and entry.Upgrade >= 8 then
            puppet = entry
            if not readyPuppet and abilityReady(entry, "GowtherAbility1") then readyPuppet = entry end
        end
    end
    if not shadow or not puppet then updateLabel(FEATURE.RewindStatus, "Status: Waiting for Puppet + Shadow unlocks") return false end
    local unit, abilityId, abilityName
    if readyShadow then
        unit, abilityId, abilityName = readyShadow, "MegumiAbility1", "Shadow Realm"
    elseif readyPuppet then
        unit, abilityId, abilityName = readyPuppet, "GowtherAbility1", "Complete Control"
    end
    if not unit then updateLabel(FEATURE.RewindStatus, "Status: Waiting for cooldown/unlock") return false end
    fireGamePlayer("ActivateUnitAbility", unit.Id, abilityId)
    self.LastRewindAbility = abilityId
    self.LastRewindAt = os.clock()
    updateLabel(FEATURE.RewindStatus, "Status: Activated " .. abilityName)
    return true
end

local function hideVisual(reason, instance)
    if typeof(instance) ~= "Instance" then return end
    local snapshot = Controller.VisualSnapshots[instance]
    if not snapshot then
        snapshot = { Reasons = {} }
        Controller.VisualSnapshots[instance] = snapshot
    end
    snapshot.Reasons[reason] = true
    if instance:IsA("BasePart") then
        if snapshot.LocalTransparencyModifier == nil then snapshot.LocalTransparencyModifier = instance.LocalTransparencyModifier end
        instance.LocalTransparencyModifier = 1
    elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") then
        if snapshot.Enabled == nil then snapshot.Enabled = instance.Enabled end
        instance.Enabled = false
    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        if snapshot.Transparency == nil then snapshot.Transparency = instance.Transparency end
        instance.Transparency = 1
    end
end

local function restoreVisuals(reason)
    for instance, snapshot in pairs(Controller.VisualSnapshots) do
        snapshot.Reasons[reason] = nil
        if next(snapshot.Reasons) == nil then
            if instance.Parent then
                if snapshot.LocalTransparencyModifier ~= nil then pcall(function() instance.LocalTransparencyModifier = snapshot.LocalTransparencyModifier end) end
                if snapshot.Enabled ~= nil then pcall(function() instance.Enabled = snapshot.Enabled end) end
                if snapshot.Transparency ~= nil then pcall(function() instance.Transparency = snapshot.Transparency end) end
            end
            Controller.VisualSnapshots[instance] = nil
        end
    end
end

local function belongsToNavigation(instance, map)
    local current = instance
    while current and current ~= map do
        local name = current.Name:lower()
        if name:find("path", 1, true) or name:find("waypoint", 1, true) or name:find("spawn", 1, true) or name:find("groundplacement", 1, true) then return true end
        current = current.Parent
    end
    return false
end

local function lowerMeshFidelity(instance)
    local ok, original = pcall(function() return instance.RenderFidelity end)
    if not ok then return end
    local changed = pcall(function() instance.RenderFidelity = Enum.RenderFidelity.Performance end)
    if changed and Controller.MeshSnapshots[instance] == nil then Controller.MeshSnapshots[instance] = original end
end

local function restoreMeshFidelity()
    for instance, original in pairs(Controller.MeshSnapshots) do
        if instance.Parent then pcall(function() instance.RenderFidelity = original end) end
        Controller.MeshSnapshots[instance] = nil
    end
end

function Controller:PauseAnimationTrack(track)
    if not self.AnimationPauseActive or not self.Running or self.Stopping or Environment[STATE_KEY] ~= self or value(FEATURE.BoostFPS, false) ~= true then return false end
    local ok, playing, speed = pcall(function() return track.IsPlaying, track.Speed end)
    if not ok or not playing or type(speed) ~= "number" then return false end
    -- A track that was already paused by somebody else is not ours to resume.
    if speed == 0 then return self.AnimationSnapshots[track] ~= nil end
    local paused, failure = pcall(function() track:AdjustSpeed(0) end)
    if not paused then self.AnimationPauseError = tostring(failure) return false end
    self.AnimationSnapshots[track] = speed
    return true
end

function Controller:PauseAnimator(animator)
    if not self.AnimationPauseActive or not self.Running or self.Stopping or Environment[STATE_KEY] ~= self or value(FEATURE.BoostFPS, false) ~= true or not animator.Parent then return false end
    if not self.AnimatorConnections[animator] then
        local connected, connection = pcall(function()
            return animator.AnimationPlayed:Connect(function(track) self:PauseAnimationTrack(track) end)
        end)
        if connected and connection then self.AnimatorConnections[animator] = connection
        elseif not connected then self.AnimationPauseError = tostring(connection) end
    end
    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok or type(tracks) ~= "table" then return false end
    for _, track in ipairs(tracks) do self:PauseAnimationTrack(track) end
    return true
end

function Controller:PruneAnimationPauses()
    for animator, connection in pairs(self.AnimatorConnections) do
        local ok, parent = pcall(function() return animator.Parent end)
        if not ok or not parent then
            pcall(function() connection:Disconnect() end)
            self.AnimatorConnections[animator] = nil
        end
    end
    for track in pairs(self.AnimationSnapshots) do
        local ok, playing = pcall(function() return track.IsPlaying end)
        if not ok or not playing then self.AnimationSnapshots[track] = nil end
    end
end

function Controller:RestorePausedAnimations()
    self.AnimationPauseActive = false
    -- Disconnect first: late AnimationPlayed callbacks cannot acquire new ownership during cleanup.
    for animator, connection in pairs(self.AnimatorConnections) do
        pcall(function() connection:Disconnect() end)
        self.AnimatorConnections[animator] = nil
    end
    for track, speed in pairs(self.AnimationSnapshots) do
        pcall(function()
            if track.IsPlaying and track.Speed == 0 then track:AdjustSpeed(speed) end
        end)
        self.AnimationSnapshots[track] = nil
    end
end

function Controller:ProcessPerformance(context)
    local boost = value(FEATURE.BoostFPS, false) == true
    if not boost then self:RestorePausedAnimations() end
    local deleteEnemies = context.InGame and value(FEATURE.DeleteEnemies, false) == true
    local deleteMap = context.InGame and value(FEATURE.DeleteMap, false) == true
    local blackScreen = value(FEATURE.BlackScreen, false) == true
    if blackScreen and not self.RenderingOwned then
        RunService:Set3dRenderingEnabled(false)
        self.RenderingOwned = true
    elseif not blackScreen and self.RenderingOwned then
        RunService:Set3dRenderingEnabled(true)
        self.RenderingOwned = false
    end
    if boost then
        self.AnimationPauseActive = self.Running and not self.Stopping
        self:PruneAnimationPauses()
        setSetting("LowDetailMode", true)
        if not self.LightingSnapshot then
            self.LightingSnapshot = { GlobalShadows = Lighting.GlobalShadows, Brightness = Lighting.Brightness, FogEnd = Lighting.FogEnd }
        end
        Lighting.GlobalShadows = false
        Lighting.Brightness = 0
        Lighting.FogEnd = 100000
        for _, instance in ipairs(workspace:GetDescendants()) do
            if instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") then hideVisual("Boost", instance) end
            if instance:IsA("MeshPart") then lowerMeshFidelity(instance) end
            if instance:IsA("Animator") then self:PauseAnimator(instance) end
        end
    elseif self.LightingSnapshot then
        Lighting.GlobalShadows = self.LightingSnapshot.GlobalShadows
        Lighting.Brightness = self.LightingSnapshot.Brightness
        Lighting.FogEnd = self.LightingSnapshot.FogEnd
        self.LightingSnapshot = nil
        restoreVisuals("Boost")
        restoreMeshFidelity()
        restoreOwnedSetting("LowDetailMode")
    end
    if deleteEnemies then
        local enemies = stateValue(Dependencies.GameEnemies) or {}
        for model in pairs(enemies) do if typeof(model) == "Instance" then for _, descendant in ipairs(model:GetDescendants()) do hideVisual("Enemies", descendant) end end end
    else
        restoreVisuals("Enemies")
    end
    if deleteMap then
        local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("GameMap")
        if map then
            for _, descendant in ipairs(map:GetDescendants()) do
                if not belongsToNavigation(descendant, map) then hideVisual("Map", descendant) end
            end
        end
    else
        restoreVisuals("Map")
    end
    return true
end

local AbilityProfiles = uiState().__SmartAbilityProfiles
if type(AbilityProfiles) ~= "table" then
    AbilityProfiles = {}
    uiState().__SmartAbilityProfiles = AbilityProfiles
end
Controller.AbilityProfiles = AbilityProfiles
Controller.AbilityOptions = {}
Controller.AbilityUnitAssets = {}
Controller.LastAbilityWave = Controller.LastAbilityWave or {}

local function abilityDisplayName(abilityId)
    local abilities = type(Dependencies.Abilities) == "table" and Dependencies.Abilities.Abilities or nil
    local info = type(abilities) == "table" and stateValue(abilities[abilityId]) or nil
    if type(info) == "table" then return info.DisplayName or info.Name or abilityId end
    return abilityId
end

local function collectAbilityOptions(asset)
    local displays, descriptors = {}, {}
    for upgradeKey, upgrade in pairs(unitUpgradeInfo(asset) or {}) do
        for _, abilityId in pairs(type(upgrade.Abilities) == "table" and upgrade.Abilities or {}) do
            if type(abilityId) == "string" then
                local display = tostring(abilityDisplayName(abilityId))
                local requiredUpgrade = tonumber(upgradeKey) or 0
                local existing = descriptors[display]
                if not existing or requiredUpgrade < existing.RequiredUpgrade then
                    descriptors[display] = { Id = abilityId, DisplayName = display, RequiredUpgrade = requiredUpgrade, Asset = asset }
                end
            end
        end
    end
    for display in pairs(descriptors) do table.insert(displays, display) end
    table.sort(displays)
    return displays, descriptors
end

function Controller:ResolveAbilitySelection(unitDisplay, abilityDisplay)
    local options = self.AbilityOptions[unitDisplay]
    return type(options) == "table" and options[abilityDisplay] or nil
end

local PROFILE_FIELDS = {
    [FEATURE.AbilityEnabled] = "Enabled",
    [FEATURE.AbilityWaitSpawns] = "WaitForSpawns",
    [FEATURE.AbilityType] = "ActivationType",
    [FEATURE.AbilityEnemy] = "EnemyType",
    [FEATURE.AbilityEvery] = "ActivateEvery",
    [FEATURE.AbilityDelay] = "Delay",
    [FEATURE.AbilityWave] = "ActivationWave",
    [FEATURE.AbilityOnlyAfter] = "OnlyAfterWave",
    [FEATURE.AbilityStartAfter] = "StartAfterWave",
}

function Controller:CurrentAbilityProfile(create)
    local unitDisplay = value(FEATURE.AbilityUnit)
    local abilityDisplay = value(FEATURE.AbilityName)
    local descriptor = self:ResolveAbilitySelection(unitDisplay, abilityDisplay)
    if not descriptor then return nil end
    local unitProfiles = AbilityProfiles[descriptor.Asset]
    if type(unitProfiles) ~= "table" and create then unitProfiles = {} AbilityProfiles[descriptor.Asset] = unitProfiles end
    local profile = type(unitProfiles) == "table" and unitProfiles[descriptor.Id] or nil
    if type(profile) ~= "table" and create then
        profile = { AbilityId = descriptor.Id, DisplayName = descriptor.DisplayName, UnitDisplay = unitDisplay, RequiredUpgrade = descriptor.RequiredUpgrade }
        unitProfiles[descriptor.Id] = profile
    end
    if type(profile) == "table" then
        profile.AbilityId = descriptor.Id
        profile.DisplayName = descriptor.DisplayName
        profile.UnitDisplay = unitDisplay
        profile.RequiredUpgrade = descriptor.RequiredUpgrade
    end
    return profile, descriptor
end

function Controller:SaveCurrentAbilityProfile()
    if self.HydratingProfile then return false end
    local profile = self:CurrentAbilityProfile(true)
    if not profile then return false end
    for featureId, field in pairs(PROFILE_FIELDS) do profile[field] = value(featureId) end
    return true
end

function Controller:LoadCurrentAbilityProfile()
    local profile = self:CurrentAbilityProfile(false)
    if not profile then return false end
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) ~= "table" then return false end
    self.ProfileHydrationGeneration = (self.ProfileHydrationGeneration or 0) + 1
    local generation = self.ProfileHydrationGeneration
    self.HydratingProfile = true
    for featureId, field in pairs(PROFILE_FIELDS) do
        if profile[field] ~= nil then pcall(function() gui:SetValue(featureId, profile[field]) end) end
    end
    task.defer(function()
        if self.ProfileHydrationGeneration == generation then self.HydratingProfile = false end
    end)
    return true
end

function Controller:RefreshAbilityOptions()
    local selected = value(FEATURE.AbilityUnit)
    if type(selected) ~= "string" or selected == "" then return {} end
    local asset
    for key, info in pairs(Information.Units or {}) do if info.DisplayName == selected then asset = key break end end
    local names, descriptors = {}, {}
    if asset then names, descriptors = collectAbilityOptions(asset) end
    self.AbilityOptions[selected] = descriptors
    self.AbilityUnitAssets[selected] = asset
    local gui = Environment.__AnimeExpeditionsGuiController
    local control = type(gui) == "table" and gui.Controls and gui.Controls[FEATURE.AbilityName] or nil
    if type(control) == "table" and type(control.SetValues) == "function" then pcall(function() control:SetValues(names) end) end
    if #names > 0 and not table.find(names, value(FEATURE.AbilityName)) and type(gui) == "table" then pcall(function() gui:SetValue(FEATURE.AbilityName, names[1]) end) end
    self:LoadCurrentAbilityProfile()
    return names
end

local function enemyEntries()
    local source = stateValue(Dependencies.GameEnemies) or {}
    local result = {}
    for model, dataState in pairs(source) do
        local data = stateValue(dataState)
        table.insert(result, { Model = typeof(model) == "Instance" and model or nil, Data = data })
    end
    return result
end

local function enemyMatches(entry, enemyType)
    if enemyType ~= "Boss" then return true end
    local data = entry.Data or {}
    return statePath(data, "IsBoss") == true or tostring(statePath(data, "EnemyType") or statePath(data, "Type") or ""):lower():find("boss", 1, true) ~= nil
end

function Controller:ProcessAbilityProfile(context, asset, abilityId, profile)
    local info = type(Information.Units) == "table" and Information.Units[asset] or nil
    local selectedUnit = profile.UnitDisplay or (type(info) == "table" and info.DisplayName) or asset
    local unit = findDisplayUnit(selectedUnit)
    if not unit or unit.Upgrade < (tonumber(profile.RequiredUpgrade) or 0) or not abilityReady(unit, abilityId) then return false end
    local activationType = profile.ActivationType or "Activate after Wave"
    local eligible = false
    if activationType == "Activate after Wave" then
        eligible = context.Wave >= (tonumber(profile.ActivationWave) or 5)
    elseif activationType == "Activate every Wave" then
        local start = tonumber(profile.StartAfterWave) or 5
        local every = math.max(1, tonumber(profile.ActivateEvery) or 5)
        eligible = context.Wave >= start and (context.Wave - start) % every == 0
    else
        local onlyAfter = tonumber(profile.OnlyAfterWave) or 0
        if context.Wave >= onlyAfter then
            local enemyType = profile.EnemyType or "Boss"
            for _, enemy in ipairs(enemyEntries()) do
                if enemyMatches(enemy, enemyType) then
                    if activationType == "Activate when Enemy existed" then eligible = true break end
                    local unitPosition = unit.CFrame and unit.CFrame.Position
                    local enemyPosition = enemy.Model and enemy.Model:GetPivot().Position
                    local range = tonumber(statePath(unit.Data, "CurrentStats", "Range")) or math.huge
                    if unitPosition and enemyPosition and (unitPosition - enemyPosition).Magnitude <= range then eligible = true break end
                end
            end
        end
    end
    if profile.WaitForSpawns == true then
        local state = currentGameState()
        local complete = statePath(state, "WaveSpawnComplete")
        if complete == nil then
            complete = statePath(state, "Intermission") == true or tonumber(statePath(state, "EnemyCount")) == 0
        end
        if complete ~= true then eligible = false end
    end
    local key = unit.Id .. "|" .. abilityId .. "|" .. tostring(context.Wave)
    if not eligible then self.AbilityEligibleSince[key] = nil return false end
    if activationType == "Activate every Wave" and self.LastAbilityWave[unit.Id .. "|" .. abilityId] == context.Wave then return false end
    self.AbilityEligibleSince[key] = self.AbilityEligibleSince[key] or os.clock()
    local delay = math.max(0, tonumber(profile.Delay) or 1)
    if os.clock() - self.AbilityEligibleSince[key] < delay then return false end
    if os.clock() - (self.LastAbilityAt[unit.Id .. "|" .. abilityId] or 0) < math.max(0.5, delay) then return false end
    fireGamePlayer("ActivateUnitAbility", unit.Id, abilityId)
    self.LastAbilityAt[unit.Id .. "|" .. abilityId] = os.clock()
    self.LastAbilityWave[unit.Id .. "|" .. abilityId] = context.Wave
    updateLabel(FEATURE.AbilityStatus, "Activated " .. tostring(profile.DisplayName or abilityId) .. " on " .. selectedUnit)
    return true
end

function Controller:ProcessSmartAbility(context)
    if value(FEATURE.SmartAbility, false) ~= true or not context.InGame then return false end
    local activated = false
    for asset, profiles in pairs(AbilityProfiles) do
        for abilityId, profile in pairs(type(profiles) == "table" and profiles or {}) do
            if type(profile) == "table" and profile.Enabled == true and self:ProcessAbilityProfile(context, asset, abilityId, profile) then activated = true end
        end
    end
    return activated
end

function Controller:ProcessDarkMage(context)
    if not context.InGame then return false end
    local changed = false
    for _, unit in ipairs(liveUnitEntries()) do
        if unit.DisplayName == "Dark Mage (Sovereign)" then
            local currentSkill = tostring(statePath(unit.Data, "CurrentSkill") or statePath(unit.Data, "SkillName") or statePath(unit.Data, "CurrentStats", "DisplayName") or "")
            local desired
            if value(FEATURE.DarkMageFinalFirst, false) == true and context.FinalWave and context.Wave >= context.FinalWave then desired = "First"
            elseif value(FEATURE.KeepLightning, false) == true and currentSkill:lower():find("lightning", 1, true) then desired = "None" end
            if desired and unit.TargetPriority ~= desired then fireGamePlayer("ChangeGameUnitPriority", unit.Id, desired) changed = true end
        end
    end
    return changed
end

local function safeString(value, fallback)
    local text = tostring(value == nil and (fallback or "-") or value)
    if #text > 1000 then text = text:sub(1, 997) .. "..." end
    return text
end

local function formatAmount(amount)
    local number = tonumber(amount)
    if not number or number ~= number or math.abs(number) == math.huge then return "?" end
    local text = number == math.floor(number) and string.format("%.0f", number) or string.format("%.2f", number):gsub("0+$", ""):gsub("%.$", "")
    local whole, fraction = text:match("^(%-?%d+)(.*)$")
    if not whole then return text end
    local sign = whole:sub(1, 1) == "-" and "-" or ""
    whole = whole:gsub("^-", ""):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return sign .. whole .. fraction
end

local function formatDuration(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    if seconds >= 3600 then return string.format("%dh %02dm %02ds", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60) end
    if seconds >= 60 then return string.format("%dm %02ds", math.floor(seconds / 60), seconds % 60) end
    return tostring(seconds) .. "s"
end

local function assetInfoCall(method, asset)
    if type(Information[method]) ~= "function" then return nil end
    local ok, result = pcall(function() return Information[method](Information, asset) end)
    if ok then return result end
    return nil
end

local function rewardAssetType(asset)
    local kind = assetInfoCall("GetAssetType", asset)
    if kind ~= nil then return kind end
    if type(Information.Units) == "table" and Information.Units[asset] then return "Unit" end
    if type(Information.Items) == "table" and Information.Items[asset] then return "Item" end
    return nil
end

local function isExperience(asset, display)
    local names = { exp = true, xp = true, experience = true, playerexp = true, playerxp = true, playerexperience = true, unitexp = true, unitxp = true, unitexperience = true }
    local function normalize(text) return tostring(text or ""):lower():gsub("[%s_%-]", "") end
    return names[normalize(asset)] == true or names[normalize(display)] == true
end

local function ownedRewardAmount(asset, shiny, knownKind)
    local kind = knownKind or rewardAssetType(asset)
    local key = knownKind == "Unit" and "UnitData" or assetInfoCall("GetAssetInventoryKey", asset)
    if type(key) ~= "string" or key == "" then key = kind == "Unit" and "UnitData" or (kind == "Item" and "ItemData" or nil) end
    if not key then return nil end
    local inventory = statePath(currentPlayerData(), key)
    if type(inventory) ~= "table" then return nil end
    local stackable = assetInfoCall("IsAssetStackable", asset)
    if stackable == nil then stackable = kind == "Item" end
    if stackable then
        local entry = stateValue(inventory[asset])
        if entry == nil then return 0 end
        if type(entry) == "number" then return entry end
        return tonumber(statePath(entry, "Amount") or statePath(entry, "Quantity") or statePath(entry, "Count"))
    end
    local count = 0
    for _, entry in pairs(inventory) do
        entry = stateValue(entry)
        local entryAsset = statePath(entry, "Asset") or statePath(entry, "UnitData", "Asset")
        local entryShiny = statePath(entry, "Shiny") == true or statePath(entry, "IsShiny") == true or statePath(entry, "UnitData", "Shiny") == true
        if entryAsset == asset and (kind ~= "Unit" or entryShiny == shiny) then count += 1 end
    end
    return count
end

local function shortRewardName(text)
    text = tostring(text or "Unknown"):gsub("[\r\n]", " ")
    if #text <= 180 then return text end
    local finish = 177
    while finish > 0 and (text:byte(finish + 1) or 0) >= 128 and (text:byte(finish + 1) or 0) < 192 do finish -= 1 end
    return text:sub(1, finish) .. "..."
end

local function spoilerPlayerIdentity()
    local function escape(text)
        return shortRewardName(text):gsub("\\", "\\\\"):gsub("|", "\\|")
    end
    return "||" .. escape(LocalPlayer.DisplayName or LocalPlayer.Name) .. "(@" .. escape(LocalPlayer.Name) .. ")||"
end

local function collectRewardLines(result)
    local summary = { Rewards = {}, Units = {}, Experience = {}, HasUnits = false, HasShinyUnits = false }
    local entries, order = {}, {}
    local rewards = statePath(result, "Rewards") or statePath(result, "RewardData") or statePath(result, "Drops") or {}
    for key, reward in pairs(type(rewards) == "table" and rewards or {}) do
        reward = stateValue(reward)
        local asset, amount, shiny
        if type(reward) == "table" then
            asset = statePath(reward, "Asset") or statePath(reward, "Item") or statePath(reward, "Name") or statePath(reward, "DisplayName") or key
            amount = tonumber(statePath(reward, "Amount") or statePath(reward, "Quantity") or statePath(reward, "Count") or 1)
            local data = statePath(reward, "Data") or {}
            shiny = statePath(reward, "Shiny") == true or statePath(reward, "IsShiny") == true or statePath(data, "Shiny") == true or statePath(data, "IsShiny") == true
        elseif type(reward) == "number" or type(reward) == "string" then
            asset, amount, shiny = key, tonumber(reward), false
        end
        if asset ~= nil and amount and amount > 0 and amount < math.huge then
            local identity = tostring(asset) .. "|" .. tostring(shiny == true)
            if not entries[identity] then
                local display = displayNameForAsset(asset)
                if type(display) ~= "string" or display == "" then display = tostring(asset) end
                entries[identity] = { Asset = asset, Display = display, Amount = 0, Shiny = shiny == true }
                table.insert(order, entries[identity])
            end
            entries[identity].Amount += amount
        end
    end
    table.sort(order, function(a, b)
        local rank = { Gem = 1, Gold = 2 }
        local ar, br = rank[a.Asset] or 3, rank[b.Asset] or 3
        if ar ~= br then return ar < br end
        if a.Display ~= b.Display then return a.Display < b.Display end
        return tostring(a.Shiny) < tostring(b.Shiny)
    end)
    for _, entry in ipairs(order) do
        local exp = isExperience(entry.Asset, entry.Display)
        local unit = not exp and rewardAssetType(entry.Asset) == "Unit"
        local line = "+" .. formatAmount(entry.Amount) .. " " .. (entry.Shiny and "✨ " or "") .. shortRewardName(entry.Display)
        if not exp then line ..= " [" .. formatAmount(ownedRewardAmount(entry.Asset, entry.Shiny)) .. "]" end
        table.insert(exp and summary.Experience or (unit and summary.Units or summary.Rewards), line)
        if unit then summary.HasUnits = true if entry.Shiny then summary.HasShinyUnits = true end end
    end
    return summary
end

local function unitMention(hasUnits, hasShinyUnits, everyAcquisition)
    local allowed = { parse = {}, users = {} }
    if not hasUnits or (not everyAcquisition and value(FEATURE.OnlyMentionShiny, false) == true and not hasShinyUnits) then return nil, allowed end
    local configured = value(FEATURE.MentionId, nil)
    -- Missing legacy data is not consent to ping everyone; explicit blank still is.
    if configured == nil then return nil, allowed end
    local text = tostring(configured)
    if text:match("^%s*$") then
        allowed.parse = { "everyone" }
        return "@everyone", allowed
    end
    local id = text:match("^%s*(%d+)%s*$") or text:match("^%s*<@!?(%d+)>%s*$")
    if not id then return nil, allowed end
    allowed.users = { id }
    return "<@" .. id .. ">", allowed
end

local function addRewardFields(fields, summary)
    local remaining = 3600
    for _, group in ipairs({ { "Units obtained", summary.Units }, { "Rewards", summary.Rewards }, { "Experience", summary.Experience } }) do
        local name, lines = group[1], group[2]
        local chunk, size, part, omitted = {}, 0, 1, 0
        local function flush()
            if #chunk == 0 then return end
            table.insert(fields, { name = part == 1 and name or (name .. " (continued)"), value = table.concat(chunk, "\n"), inline = false })
            chunk, size, part = {}, 0, part + 1
        end
        for _, line in ipairs(lines) do
            if #line + 1 > remaining then omitted += 1 else
                if size + #line + 1 > 900 then flush() end
                table.insert(chunk, line)
                size += #line + 1
                remaining -= #line + 1
            end
        end
        flush()
        if omitted > 0 then table.insert(fields, { name = name .. " summary", value = tostring(omitted) .. " additional rewards omitted from this message.", inline = false }) end
    end
    if #summary.Units + #summary.Rewards + #summary.Experience == 0 then table.insert(fields, { name = "Rewards", value = "No rewards reported.", inline = false }) end
end

function Controller:SendWebhook(payload, purpose)
    if self.Stopping then return false, "runtime is stopping", true, "cancelled" end
    local url = tostring(value(FEATURE.WebhookUrl, "") or "")
    if url == "" or url == "[REDACTED_CURRENT_VALUE]" then return false, "webhook URL is empty", false end
    local send = requestFunction()
    if type(send) ~= "function" then return false, "HTTP request function is unavailable", false end
    local body = HttpService:JSONEncode(payload)
    local lastFailure, lastRetryable
    for attempt = 1, Config.WebhookAttempts do
        if self.Stopping then return false, "runtime is stopping", true, "cancelled" end
        local ok, response = pcall(send, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        local status = ok and type(response) == "table" and tonumber(response.StatusCode or response.Status or response.status_code) or 0
        local transportFailure = not ok or type(status) ~= "number" or status ~= status or status < 100 or status > 599 or status % 1 ~= 0
        if transportFailure then status = 0 end
        if ok and status >= 200 and status < 300 then
            self.LastWebhook = { Purpose = purpose, Status = status, At = os.time(), Url = redact(url) }
            pushLog("success", "webhook sent", purpose)
            return true, status, false
        end
        lastFailure = transportFailure and "transport error" or ("HTTP " .. tostring(status))
        local retryable = transportFailure or status == 408 or status == 429 or status >= 500
        lastRetryable = retryable
        if not retryable then break end
        if transportFailure and attempt >= math.min(2, Config.WebhookAttempts) then break end
        if attempt < Config.WebhookAttempts then
            local headers = ok and type(response) == "table" and response.Headers
            local retryAfter = type(headers) == "table" and tonumber(headers["Retry-After"] or headers["retry-after"])
            task.wait(math.clamp(retryAfter or 2 ^ (attempt - 1), 0.5, 10))
        end
    end
    self.LastWebhook = { Purpose = purpose, Error = lastFailure, At = os.time(), Url = redact(url) }
    return false, lastFailure, lastRetryable == true
end

