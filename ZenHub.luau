local function pushLog(level, message, data)
    table.insert(Controller.Logs, {
        Time = os.time(),
        Level = level,
        Message = message,
        Data = data,
    })
    while #Controller.Logs > Config.MaxLogEntries do table.remove(Controller.Logs, 1) end
    print("[AE Macro]", level, message, data or "")
end

local function stateValue(value)
    if type(value) == "table" then
        local rawValue = rawget(value, "_EXTREMELY_DANGEROUS_usedAsValue")
        if rawValue ~= nil then return rawValue end
    end
    local ok, peeked = pcall(Fusion.peek, value)
    if ok then return peeked end
    return value
end

local function statePath(root, ...)
    local current = stateValue(root)
    for index = 1, select("#", ...) do
        if type(current) ~= "table" then return nil end
        current = stateValue(current[select(index, ...)])
    end
    return stateValue(current)
end

local function uiState()
    local state = Environment.AnimeExpeditionsUIState
    return type(state) == "table" and type(state.Values) == "table" and state.Values or {}
end

local function value(id, fallback)
    local current = uiState()[id]
    if current ~= nil then return current end
    return fallback
end

local function ensureFolder(path)
    if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(path) then
        makefolder(path)
    end
end

local function macroPath(folder, name)
    return folder .. "/" .. name .. ".json"
end

local function safeMacroName(name)
    local result = tostring(name or ""):gsub("%.json$", ""):gsub("[^%w%-%_ ]", "_")
    result = result:gsub("^%s+", ""):gsub("%s+$", "")
    return result:sub(1, 80)
end

local function basename(path)
    local name = tostring(path):match("([^/\\]+)$") or tostring(path)
    return name:gsub("%.json$", "")
end

local function sortedMacroActions(decoded)
    local source = type(decoded.Actions) == "table" and decoded.Actions or decoded
    local indexed = {}
    for key, action in pairs(type(source) == "table" and source or {}) do
        if type(action) == "table" and type(action.Type) == "string" then
            table.insert(indexed, { Order = tonumber(key) or math.huge, Action = action })
        end
    end
    table.sort(indexed, function(a, b)
        if a.Order ~= b.Order then return a.Order < b.Order end
        return tostring(a.Action.Time or "") < tostring(b.Action.Time or "")
    end)
    local actions = {}
    for _, entry in ipairs(indexed) do table.insert(actions, entry.Action) end
    return actions
end

local function readMacroFile(path)
    if not ownsMacroAccount() then return nil, "macro account is no longer active" end
    if type(isfile) ~= "function" or type(readfile) ~= "function" or not isfile(path) then
        return nil, "macro file not found"
    end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(decoded) ~= "table" then return nil, "invalid macro JSON: " .. tostring(decoded) end
    if decoded.UserId ~= MACRO_USER_ID then return nil, "macro account mismatch" end
    local actions = sortedMacroActions(decoded)
    if #actions == 0 then return nil, "macro has no actions" end
    return {
        Version = tonumber(decoded.Version) or 1,
        Name = decoded.Name or basename(path),
        Context = type(decoded.Context) == "table" and decoded.Context or nil,
        InvalidContext = decoded.Context ~= nil and type(decoded.Context) ~= "table",
        Actions = actions,
        Path = path,
        Legacy = type(decoded.Actions) ~= "table",
    }
end

local function listMacroNames()
    if not ownsMacroAccount() or not OWN_MACRO_FOLDER then return {} end
    local seen = {}
    local names = {}
    for _, folder in ipairs({ OWN_MACRO_FOLDER }) do
        if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(folder) then
            local ok, files = pcall(listfiles, folder)
            if ok then
                for _, path in ipairs(files) do
                    if tostring(path):lower():sub(-5) == ".json" then
                        local name = basename(path)
                        if not seen[name] then
                            seen[name] = true
                            table.insert(names, name)
                        end
                    end
                end
            end
        end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    return names
end

local function findMacroPath(name)
    if not ownsMacroAccount() or not OWN_MACRO_FOLDER then return nil end
    local safeName = safeMacroName(name)
    if safeName == "" then return nil end
    for _, folder in ipairs({ OWN_MACRO_FOLDER }) do
        local path = macroPath(folder, safeName)
        if type(isfile) == "function" and isfile(path) then return path end
    end
    return nil
end

local function writeOwnMacro(name, data)
    assert(ownsMacroAccount() and OWN_MACRO_FOLDER, "macro account is no longer active")
    assert(type(writefile) == "function", "writefile is unavailable")
    name = safeMacroName(name)
    assert(name ~= "", "macro name is empty")
    ensureFolder("AnimeExpeditionsClone")
    ensureFolder(OWN_MACRO_FOLDER)
    local path = macroPath(OWN_MACRO_FOLDER, name)
    data.UserId = MACRO_USER_ID
    writefile(path, HttpService:JSONEncode(data))
    return path
end

local function displayNameForAsset(asset)
    if type(asset) ~= "string" then return nil end
