 local portal=s.Helicopter
 if not hasPortal then
  if h.EntryDeadline then
   if now>=h.EntryDeadline then return self:_attention(h,"entry-or-transfer-timeout")end
   return true,"waiting-for-entry-transfer"
  end
  if h.PortalId then return self:_attention(h,"helicopter-disappeared-without-entry")end
