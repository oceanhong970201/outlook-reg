for _, id in ipairs({ FEATURE, DELAY }) do
    Controller.PreviousHandlers[id] = handlers[id]
    local callback = function()
        if not current() then return end
        if id == DELAY and Controller.Pending then Controller.Generation += 1 Controller.Pending = false end
        Controller:Sync()
    end
    Controller.Handlers[id], handlers[id] = callback, callback
end
Controller:Sync()
return Controller
