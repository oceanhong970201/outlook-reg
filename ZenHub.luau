local SETTINGS_UI_NATIVE_CONTEXT = [=================================================[-- Call with the already-created GUI. Merely building this context performs no
-- network-setting changes, teleport request, or executor queue operation.
return function(Module,E,Gui,SoftFocus,preview)
    local Players=game:GetService("Players")
    local player=Players.LocalPlayer
    local account=tostring(player.UserId)
    local session=account.."|"..tostring(game.PlaceId).."|"..tostring(game.JobId)
    local Http=game:GetService("HttpService")
    -- Pin the wrapper/library strings to this successfully created GUI owner.
    -- A later script's getgenv export cannot replace this owner's queued code.
    local approvedSource=E.__AnimeExpeditionsGuiSource
    local approvedLibrary=E.__AnimeExpeditionsLibrarySource
    local function current()
        return preview~=true and Gui.Alive and E.__AnimeExpeditionsGuiController==Gui
            and Players.LocalPlayer==player and account.."|"..tostring(game.PlaceId).."|"..tostring(game.JobId)==session
    end
    local keys={}
    for _,name in ipairs(Module.KeyNames)do keys[name]=Enum.KeyCode[name]end
    local queue=type(queue_on_teleport)=="function"and queue_on_teleport
        or type(queueonteleport)=="function"and queueonteleport or nil
    if type(queue)~="function"and type(syn)=="table"then queue=syn.queue_on_teleport end
    local defaults=table.clone(SoftFocus.Palette)
    return {
        Environment=E,Gui=Gui,Library=Gui.Library,Window=Gui.Window,DefaultPalette=defaults,KeyCodes=keys,
        AccountId=account,SessionKey=session,UniverseId=game.GameId,IsCurrent=current,
        Clock=os.clock,Delay=task.delay,
        GetValue=function(id)return Gui:GetValue(id)end,
        SetValue=function(id,value)return Gui:SetValue(id,value)end,
        ReadApprovedSource=function()return approvedSource end,
        ReadApprovedLibrary=function()return approvedLibrary end,
        QueueOnTeleport=type(queue)=="function"and queue or nil,
        TeleportSignal=player.OnTeleport,TeleportStarted=Enum.TeleportState.Started,TeleportFailed=Enum.TeleportState.Failed,
        ReadFile=type(readfile)=="function"and readfile or nil,
        WriteFile=type(writefile)=="function"and writefile or nil,
        IsFile=type(isfile)=="function"and isfile or nil,
        MakeFolder=type(makefolder)=="function"and type(isfolder)=="function"and function(path)if not isfolder(path)then makefolder(path)end end or nil,
        Encode=function(value)return Http:JSONEncode(value)end,
        Decode=function(value)return Http:JSONDecode(value)end,
        ColorFromHex=function(value)return Color3.fromRGB(tonumber(value:sub(1,2),16),tonumber(value:sub(3,4),16),tonumber(value:sub(5,6),16))end,
        ApplyPalette=function(palette)
            for role,color in pairs(palette)do if SoftFocus.Palette[role]~=nil then SoftFocus.Palette[role]=color end end
            SoftFocus.Configure(Gui.Library)
            for _,view in pairs(Gui.PriorityEditors or{})do
                if type(view.ApplyTheme)=="function"and not view.Destroyed then view:ApplyTheme(SoftFocus.Palette)end
            end
            Gui.Library:UpdateColorsUsingRegistry()
        end,
        PositionMobile=function(button)
            button.AnchorPoint=Vector2.new(0,1)
            button.Position=UDim2.new(0,12,1,-20)
        end,
        ReadNetworkHealth=function()
            if not current()or not game:IsLoaded()then return{Ready=false}end
            local ok,receive=pcall(function()return game:GetService("Stats").DataReceiveKbps end)
            if not ok or type(receive)~="number"or receive~=receive or math.abs(receive)==math.huge or receive<0 then return{Ready=false}end
            local pingOk,ping=pcall(function()return player:GetNetworkPing()end)
            return{Ready=true,SessionKey=session,ReceiveKbps=receive,PingSeconds=pingOk and ping or nil}
        end,
        Rejoin=function()
            if not current()or Gui:GetValue(Module.IDS.PingFreeze)~=true then return false,"disabled"end
            local recovery=E.__AnimeExpeditionsAutoRejoin
            local ticket=E.__AnimeExpeditionsAutoRejoinTicket
            if type(ticket)~="table"or ticket.Session~=session then
                ticket={Session=session,Attempts=0}E.__AnimeExpeditionsAutoRejoinTicket=ticket
            end
            if (tonumber(ticket.Attempts)or 0)>=1 or recovery and recovery.Pending then return false,"another rejoin is pending"end
            -- Shared with the existing Auto Rejoin runtime, whose source is not
            -- modified: a later kick signal must not submit a second teleport.
            ticket.Attempts=(tonumber(ticket.Attempts)or 0)+1 ticket.LastState="ping-freeze-requesting"
            local ok,err=pcall(function()game:GetService("TeleportService"):Teleport(game.PlaceId,player)end)
            ticket.LastState=ok and "requested"or "failed"
            if not ok then error(err,0)end
            return true
        end,
    }
end
