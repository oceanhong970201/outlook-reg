if type(retained)=="table" and type(retained.Tick)=="function" and oldBossRuntime.Account==BossRuntime.Account and oldBossRuntime.ScopeVersion==BossRuntime.ScopeVersion then
    -- Preserve ambiguous in-flight requests across GUI reload; never replace them with a fresh ledger.
    BossRuntime.Core=retained BossRuntime.Core.Adapter=BossRuntime.Adapter BossRuntime.Core:Resume()
else BossRuntime.Core=BossRushCore.new(BossRuntime.Adapter) end
Environment[BOSS_KEY]=BossRuntime
local function observeGateNavigation()
    local cfg=BossRuntime:ReadConfig()
    local function wait(reason) return {Allowed=false,Reason=reason} end
    if not BossRuntime:IsCurrent() or not cfg.AutoEnter then return wait(cfg.PauseReason or "auto-move-disabled") end
    if bossMacroBusy() then return wait("macro-action-in-flight") end
    if BossRuntime.Core:GetStatus().Pending then return wait("native-transition-pending") end
    local o=BossRuntime.Adapter:ReadObservation()
    local phase=BossRuntime:ReadMacroContext()
    if phase and phase.Phase=="Gates" and phase.PlacementReady then return wait("already-inside-gate") end
    if o.Mode~="BossRush" or not o.InGame then return wait("not-boss-rush") end
    if o.Phase~="GateReady" or o.Active~=true or o.TransitionBlockedByPrompt or o.AmbiguousPrompt
        or o.Prompt or o.GateVotePrompt or o.StartPromptId then return wait("gate-transition-not-ready") end
    if type(o.CompletedGates)~="number" or o.CompletedGates>=cfg.TargetGates then return wait("target-reached-or-count-unknown") end
    for _,record in pairs(BossRuntime.Adapter.Ledger.Records) do
        if record.ScopeKey==o.ScopeKey and record.RoundKey==o.RoundKey and record.Domain=="transition"
            and (record.Status=="reserved" or record.Status=="unknown") then return wait("native-transition-pending") end
    end
    local chosen=o.AvailableGates[1]
    local current=BossRuntime.Navigator and BossRuntime.Navigator.Current
    if current then
        for _,gate in ipairs(o.AvailableGates) do if gate.Id==current.Snapshot.GateId then chosen=gate break end end
    end
    local ref=chosen and BossRuntime.Adapter.GateReferences[chosen.Id]
    if not ref then return wait("no-native-gate") end
    local character=LocalPlayer.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health<=0 or humanoid.Sit or humanoid.PlatformStand then return wait("character-not-walkable") end
    local radius=ref.Prompt.MaxActivationDistance
    if type(radius)~="number" or radius~=radius or radius<1 or radius>100 then return wait("invalid-native-prompt-range") end
    return {Allowed=true, Key=o.ScopeKey.."|"..o.RoundKey.."|"..o.StageKey.."|"..chosen.Id,
        GateId=chosen.Id,Actor=ref.Actor,Prompt=ref.Prompt,Root=root,Humanoid=humanoid,
        Position=root.Position,Goal=ref.Actor:GetPivot().Position,Range=radius-0.75,MovementMode=cfg.MovementMode}
end
BossRuntime.Navigator=GateNavigator.new({
    Observe=observeGateNavigation, Clock=os.clock,
    Distance=function(a,b) return (a-b).Magnitude end,
    Teleport=function(s)
        local fresh=observeGateNavigation()
        if not fresh.Allowed or fresh.MovementMode~="Teleport" or fresh.Key~=s.Key or fresh.Actor~=s.Actor
            or fresh.Prompt~=s.Prompt or fresh.Root~=s.Root or (fresh.Goal-s.Goal).Magnitude>1 then return false end
        local flat=Vector3.new(fresh.Position.X-fresh.Goal.X,0,fresh.Position.Z-fresh.Goal.Z)
        local direction=flat.Magnitude>0.1 and flat.Unit or Vector3.new(0,0,1)
        local offset=math.min(6,math.max(1,fresh.Range-4))
        local position=fresh.Goal+direction*offset+Vector3.new(0,3,0)
        fresh.Root.CFrame=CFrame.new(position)*fresh.Root.CFrame.Rotation
        return true
    end,
    Plan=function(s)
        local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,WaypointSpacing=4})
        local flat=Vector3.new(s.Position.X-s.Goal.X,0,s.Position.Z-s.Goal.Z)
        local direction=flat.Magnitude>0.1 and flat.Unit or Vector3.new(0,0,1)
        local approach=s.Goal+direction*math.min(5,math.max(1,s.Range-4))+Vector3.new(0,2,0)
        path:ComputeAsync(s.Position,approach)
        if path.Status~=Enum.PathStatus.Success then return nil,"No walkable native path to Gate" end
        local points={}
        for _,point in ipairs(path:GetWaypoints()) do points[#points+1]={Position=point.Position,Jump=point.Action==Enum.PathWaypointAction.Jump} end
        return points
    end,
    Move=function(s,point,plan)
        -- Pathfinding yields. Revalidate the exact current Gate, its native
        -- prompt, account, Macro activity and user switch immediately before moving.
        local fresh=observeGateNavigation()
        if not fresh.Allowed or fresh.MovementMode~="Walk" or fresh.Key~=s.Key or fresh.Actor~=s.Actor or fresh.Prompt~=s.Prompt
            or fresh.Root~=s.Root or fresh.Humanoid~=s.Humanoid or (fresh.Goal-s.Goal).Magnitude>1 then return false end
        if (fresh.Position-fresh.Goal).Magnitude<=fresh.Range then return false end
        if point.Jump then fresh.Humanoid.Jump=true end
        fresh.Humanoid:MoveTo(point.Position)
        plan.MovedRoot,plan.MovedHumanoid=fresh.Root,fresh.Humanoid
        return true
    end,
    Cancel=function(plan)
        local root,humanoid=plan.MovedRoot,plan.MovedHumanoid
        -- Do not cancel a MoveTo subsequently owned by Macro/manual code.
        if root and humanoid and root.Parent and humanoid.Parent and plan.LastGoal
            and (humanoid.WalkToPoint-plan.LastGoal).Magnitude<0.1 then humanoid:MoveTo(root.Position) end
    end,
})

function BossRuntime:ReadMacroContext()
    if not self:IsCurrent() or type(self.Adapter.ReadMacroContext)~="function" then return nil end
    return self.Adapter:ReadMacroContext()
end
function BossRuntime:ValidateBossMacroPlacements(macro)
    if not self:IsCurrent() then return false,"Boss runtime owner changed" end
    return self.Adapter:ValidateBossMacroPlacements(macro)
end
function BossRuntime:GetStatus()
    local status=self.Core:GetStatus()
    status.IntegrationState,status.IntegrationReason=self.State,self.Reason
    status.Navigation=self.Navigator:GetStatus()
    return status
end
function BossRuntime:UpdateLabel()
    local gui=Environment.__AnimeExpeditionsGuiController
    local label=gui and gui.Controls and gui.Controls["AE-BOSSRUSH-STATUS"]
    local cfg,o=self:ReadConfig(),self.Observation or {}
    local text="Boss Rush: "..tostring(self.State).."\nCards: "..(cfg.AutoCards and "on" or "off").." • Gates: "..(cfg.AutoGates and "on" or "off").." • Target: "..cfg.TargetGates
    if o.GateVotePrompt and o.GateVotePrompt.CompletedGates~=nil then text..="\nCleared: "..tostring(o.GateVotePrompt.CompletedGates) end
    if self.Reason then text..="\n"..tostring(self.Reason) end
    local navigation=self.Navigator:GetStatus()
    text..="\nAuto move: "..(cfg.AutoEnter and "on" or "off").." • "..tostring(navigation.State)
    if cfg.AutoEnter and navigation.Reason then text..="\n"..tostring(navigation.Reason) end
    if label and type(label.SetText)=="function" and text~=self.LastLabel then pcall(label.SetText,label,text) self.LastLabel=text end
end
function BossRuntime:Tick()
    if not self:IsCurrent() then self.Navigator:Cancel("owner-changed") return false end
    self.Navigator:Step()
    local ok,obs=pcall(self.Adapter.ReadObservation,self.Adapter)
    if not ok or type(obs)~="table" then self.State,self.Reason="waiting-observation",ok and "native observation missing" or tostring(obs) self:UpdateLabel() return false end
    obs.MacroBusy=bossMacroBusy()
    local cfg=self:ReadConfig()
    obs.Manual=cfg.Manual
    self.Observation=obs
    local status=self.Core:Tick(obs,self:ReadConfig())
    self.State,self.Reason=status.State,cfg.PauseReason or status.Reason
    self:UpdateLabel()
    return status.Intent~=nil
end
function BossRuntime:Idle()
    self.Navigator:Cancel("not-boss-rush")
    self.Observation=nil
    local cfg=self:ReadConfig()
    self.State,self.Reason=(cfg.AutoCards or cfg.AutoGates) and "waiting-bossrush" or "disabled",nil
    self:UpdateLabel()
end
function BossRuntime:Stop(reason)
    self.Navigator:Stop(reason)
    self.Running=false
    self.Core:Stop(reason)
end



local function openPrompt(replica, kind)
    local data = replica.Data
    local parameters = type(data) == "table" and data.Parameters
    if type(parameters) ~= "table" or data.Result ~= nil then return false end
    if type(data.Responses) == "table" and data.Responses[LocalPlayer] ~= nil then return false end
    if parameters.EndTime and parameters.EndTime <= workspace:GetServerTimeNow() then return false end
    return type(parameters[kind]) == "table" and #parameters[kind] > 0
end
function Controller:Submit(key, id, callback, confirmed, maxAttempts, onConfirmed)
    local pending = self.Pending[key]
    if pending and pending.Confirmed then return false, "confirmed" end
    if pending and confirmed() then
        pending.Confirmed = true
        if pending.OnConfirmed then pending.OnConfirmed() pending.OnConfirmed = nil end
        self.Confirmations += 1
        self.Status = "confirmed"
        return false, "confirmed"
    end
    if not self.Running or not value(id, false) then return false, "disabled" end
    local record = self.Attempts[key] or { Count = 0, At = -math.huge }
    if record.Count >= (maxAttempts or Config.MaxAttempts) then self.Status = "retry-exhausted" return false, "retry limit" end
    if os.clock() - record.At < Config.RetrySeconds then return false, "cooldown" end
    self.Attempts[key] = record
    record.Count += 1 record.At = os.clock()
    self.LastAction = key
    if Config.DryRun then self.Status = "dry-run" return true end
    local generation = self.Generation
    native(callback)
    if not self.Running or self.Generation ~= generation then return false, "cancelled" end
    self.Pending[key] = { Confirm = confirmed, FeatureId = id, OnConfirmed = onConfirmed }
    self.Status = "submitted-unconfirmed"
    return true
end
function Controller:ObservePending()
    self.CompletedOrder = self.CompletedOrder or {}
    for _, pending in pairs(self.Pending) do
        if not pending.Confirmed and pending.Confirm() then
            pending.Confirmed = true self.Confirmations += 1
            if pending.OnConfirmed then pending.OnConfirmed() pending.OnConfirmed = nil end
            pending.Confirm = function() return true end
            table.insert(self.CompletedOrder, _)
        end
    end
    while #self.CompletedOrder > 256 do local key = table.remove(self.CompletedOrder, 1) self.Pending[key] = nil self.Attempts[key] = nil end
    local cards = ReplicaClient.Test().TokenReplicas.CardSelectionPrompt or {}
    for replica in pairs(self.RerollState) do if not cards[replica] then self.RerollState[replica] = nil end end
end
local function cardDetails(card)
    local id
    if type(card) == "table" then id = card.Upgrade or card.Stat else id = card end
    local base = ((Information.GameUpgradesInfo or {}).Cards or {})[id] or {}
    local details = table.clone(base)
    if type(card) == "table" then for k, v in pairs(card) do details[k] = v end end
    return id, details
end
local function stackFor(id)
    return tonumber(field(field(gameState(), "Cards"), id) and field(field(field(gameState(), "Cards"), id), "Stack")) or 0
end
function Controller:SelectCards(cards)
    local anvil = false
    for _, card in ipairs(cards) do local _, info = cardDetails(card) if info.CardStyle == "Anvil" then anvil = true break end end
    if not value(anvil and FEATURE.Anvil or FEATURE.Upgrade, false) then return nil, "disabled" end
    local ranks = rankList(value(anvil and FEATURE.AnvilPriority or FEATURE.SimplePriority, {}))
    local setRanks, bracket = {}, "simple"
    if not anvil and value(FEATURE.UpgradeMode, "Simple") == "Advanced" then
        setRanks = rankList(value(FEATURE.SetPriority, {}))
        local completed = {}
        for id, info in pairs((Information.GameUpgradesInfo or {}).Cards or {}) do
            if stackFor(id) > 0 then completed[normalize(info.Name or id)] = true completed[tostring(id)] = true end
        end
        local pending = false
        for name in pairs(setRanks) do if not completed[name] then pending = true else setRanks[name] = nil end end
        bracket = pending and "sets" or "general"
        ranks = rankList(value(FEATURE.GeneralPriority, {}))
    end
    local choices = {}
    for index, card in ipairs(cards) do
        local id, info = cardDetails(card)
        local name = normalize(info.Name or id)
        local capId = CAP_FEATURES[name]
        local cap = tonumber(capId and value(capId, 0)) or 0
        local count = anvil and (self.AnvilSelections[id] or 0) or stackFor(id)
        local eligible = id ~= nil and (cap <= 0 or count < cap)
        local priority = ranks[name] or ranks[tostring(id)] or 0
        if bracket == "sets" and (setRanks[name] or setRanks[tostring(id)]) then
            eligible = stackFor(id) == 0
            priority = 100000 + (setRanks[name] or setRanks[tostring(id)])
        elseif bracket == "sets" and stackFor(id) > 0 then
            -- Completed set cards are ignored until all configured set cards complete.
            local configured = rankList(value(FEATURE.SetPriority, {}))
            if configured[name] or configured[tostring(id)] then eligible = false end
        end
        if eligible then table.insert(choices, { Index = index, Priority = priority, Id = id }) end
    end
    table.sort(choices, function(a, b) return a.Priority == b.Priority and a.Index < b.Index or a.Priority > b.Priority end)
    return choices, anvil and FEATURE.Anvil or FEATURE.Upgrade, bracket
end
function Controller:ProcessCards()
    self.PromptPending = false
    if not inExpedition() then return false end
    local replicas = ReplicaClient.Test().TokenReplicas.CardSelectionPrompt or {}
    for replica in pairs(replicas) do
        if openPrompt(replica, "Cards") then
            local parameters = replica.Data.Parameters
            local choices, id, bracket = self:SelectCards(parameters.Cards)
            if choices then self.PromptPending = true end
            local amount = math.max(1, math.floor(tonumber(parameters.SelectionAmount) or 1))
            if choices and #choices >= amount then
                local signature = serial(parameters.Cards)
                local used = tonumber((replica.Data.RerollsUsed or {})[LocalPlayer]) or 0
                local remaining = (tonumber(parameters.RerollAmount) or 0) - used
                local previous = self.RerollState[replica]
                if previous and previous.Signature ~= signature then
                    previous.SaveRemaining = choices[1].Priority <= previous.BestPriority
                    previous.Signature = signature
                end
                if id == FEATURE.Upgrade and value(FEATURE.Reroll, false) and value(FEATURE.UpgradeMode, "Simple") == "Advanced"
                    and remaining > 0 and #parameters.Cards > 1 and amount == 1 and not (previous and previous.SaveRemaining) then
                    local protected = choices[1].Index
                    local lowest = choices[#choices].Index
                    for index in ipairs(parameters.Cards) do
                        local found = false for _, choice in ipairs(choices) do if choice.Index == index then found = true end end
                        if not found then lowest = index break end
                    end
                    if lowest ~= protected then
                        self.RerollState[replica] = { Signature = signature, BestPriority = choices[1].Priority }
                        return self:Submit("reroll:" .. tostring(replica.Id or replica) .. ":" .. tostring(used), FEATURE.Reroll,
                            function() replica:FireServer("Reroll", lowest) end,
                            function() return not replicas[replica] or serial(replica.Data.Parameters.Cards) ~= signature end)
                    end
                end
                local selected = {}
                for i = 1, amount do selected[i] = choices[i].Index end
                self.CardBracket = bracket
                local key = "cards:" .. tostring(replica.Id or replica) .. ":" .. signature
                return self:Submit(key, id, function() replica:FireServer("Response", selected) end,
                    function() return not replicas[replica] or not openPrompt(replica, "Cards") end, nil,
                    function()
                        -- Count only an acknowledged local response, never a timed-out/disappeared prompt.
                        local response = (replica.Data.Responses or {})[LocalPlayer]
                        if id == FEATURE.Anvil and type(response) == "table" then
                            for _, index in ipairs(response) do
                                local stat = parameters.Cards[index] and parameters.Cards[index].Stat
                                if stat then self.AnvilSelections[stat] = (self.AnvilSelections[stat] or 0) + 1 end
                            end
                        end
                    end)
            end
        end
    end
    return false
end
function Controller:ProcessPortalReward()
    if not value(FEATURE.PortalReward, false) then return false end
    local joiner = Environment.__AnimeExpeditionsJoinerV1
    if type(joiner) ~= "table" or type(joiner.PortalAccepted) ~= "function" then return false end
    local replicas = ReplicaClient.Test().TokenReplicas.PortalSelectionPrompt or {}
    for replica in pairs(replicas) do
        if openPrompt(replica, "Portals") then
            local parameters, choices = replica.Data.Parameters, {}
            for index, portal in ipairs(parameters.Portals) do
                local accepted, tier = joiner:PortalAccepted(portal)
                if accepted then table.insert(choices, { Index = index, Tier = tier }) end
            end
            table.sort(choices, function(a, b) return a.Tier == b.Tier and a.Index < b.Index or a.Tier > b.Tier end)
            local amount = math.max(1, math.floor(tonumber(parameters.SelectionAmount) or 1))
            if #choices >= amount then
                local selected = {} for i = 1, amount do selected[i] = choices[i].Index end
                return self:Submit("portal-reward:" .. tostring(replica.Id or replica), FEATURE.PortalReward,
                    function() replica:FireServer("Response", selected) end,
                    function() return not replicas[replica] or not openPrompt(replica, "Portals") end)
            end
        end
    end
    return false
end
function Controller:ProcessOrbs()
    if not inExpedition() or not value(FEATURE.Orbs, false) then return false end
    local drops = field(gameState(), "RewardPickups") or {}
    local ids = {} for id in pairs(drops) do table.insert(ids, id) end
    table.sort(ids, function(a, b) return tostring(a) < tostring(b) end)
    for _, id in ipairs(ids) do
        if field(drops[id], "DropType") == "ExpeditionOrb" then
            local done = self:Submit("orb:" .. tostring(id), FEATURE.Orbs,
                function() Nodes.SEND_GAME_REQUEST:FireSelf(nil, "CollectPickup", id) end,
                function() return field(field(gameState(), "RewardPickups"), id) == nil end)
            if done then return true end
        end
    end
    return false
end
function Controller:ProcessEncounter(featureId, unitFilter, stay)
    featureId = featureId or FEATURE.SkipEncounter
    self.EncounterPending = false
    if not inExpedition() or not value(featureId, false) then return false end
    local state = gameState()
    if field(state, "Status") ~= "Encounter" or field(state, "Active") ~= true then return false end
    self.EncounterPending = true
    local replicas = ReplicaClient.Test().TokenReplicas.NPCData or {}
    for replica in pairs(replicas) do
        local data = replica.Data
        if type(data) == "table" and type(data.ExtraData) == "table" and data.ExtraData.Source == "Expeditions" then
            local dialogue = data.Dialogue
            if typeof(dialogue) == "Instance" and dialogue:IsA("ModuleScript") then dialogue = require(dialogue) end
            for _, choice in ipairs(type(dialogue) == "table" and (not unitFilter or dialogue.Unit == unitFilter) and dialogue.Choices or {}) do
                if normalize(choice.Choice):lower():match("^speak") and type(choice.RequestNode) == "string" and (choice.RequestArgs == nil or type(choice.RequestArgs) == "table") then
                    local key = "speak:" .. tostring(replica.Id or replica) .. ":" .. tostring(field(state, "TotalNodes"))
                    local previous = self.Pending[key]
                    if previous and previous.Confirmed then
                        if stay then return false end
                        return self:Transition("Continue", featureId, "spoke-to-encounter")
                    end
                    local acknowledged = false
                    return self:Submit(key, featureId, function()
                        local request = Nodes[choice.RequestNode]:Request(table.unpack(choice.RequestArgs or {}))
                        request:Timeout(5)
                        local reply = request:Wait()
                        acknowledged = reply ~= nil and reply ~= false
                        if not acknowledged then self.LastError = "Speak request returned no acknowledgement; will not continue" end
                    end, function() return acknowledged end, 1)
                end
            end
        end
    end
    self.LastError = "waiting for an Expedition NPC with a native Speak request"
    return false
end
function Controller:ProcessToyCapsule()
    self.ToyPending = false
    if not inExpedition() or not value(FEATURE.ToyFarm, false) then return false end
    self.ToyPending = true
    if not self.TrunksDefinition then
        local module = ReplicatedStorage.Shared.Information.Expeditions.Encounters:FindFirstChild("Trunks")
        if not module then self.LastError = "waiting for native The Drink encounter definition" return false end
        self.TrunksDefinition = require(module)
    end
    local state = gameState()
    local map = field(field(state, "Parameters"), "MapName")
    if not table.find(self.TrunksDefinition.SpawnMaps or {}, map) then self.LastError = "Toy Capsule farm waits for The Drink's native SpawnMaps" return false end
    local amount = tonumber(field(field(field(playerData(), "ItemData"), "TrunksEVOItem"), "Amount")) or 0
    if self.ToyLastAmount == nil then self.ToyLastAmount = amount end
    if amount > self.ToyLastAmount then self.ToyObtained += amount - self.ToyLastAmount self.ToyRestarts = 0 self.ToyReceived = true end
    self.ToyLastAmount = amount
    local function restart(reason)
        if self.ToyRestarts >= Config.MaxToyRestarts then self.LastError = "Toy Capsule reroll limit reached; toggle off/on to retry" return false end
        local submitted = self:Transition("Restart", FEATURE.ToyFarm, reason)
        if submitted and not Config.DryRun then self.ToyRestarts += 1 end
        return submitted
    end
    if self.ToyReceived then return restart("toy-received") end
    local current = field(state, "CurrentNode")
    if type(current) ~= "table" or not current.X then self.LastError = "waiting for first Expedition node" return false end
    local status = field(state, "Status")
    if current.X == 1 and status == "Checkpoint" then
        local nodes = field(state, "GridNodes") or {}
        local lookup = Information.Expeditions:BuildNodeLookup(nodes)
        local target
        for _, node in ipairs(current.Targets or {}) do if node.Node == "Encounter" then target = node break end end
        if not target then return restart("toy-first-node-not-encounter") end
        local path = { Information.Expeditions:GetNodeIndex(lookup, current), Information.Expeditions:GetNodeIndex(lookup, target) }
        if not path[1] or not path[2] then self.LastError = "waiting for encounter node lookup" return false end
        if serial(field(state, "NodeQueue") or {}) ~= serial(path) then
            return self:Submit("toy-route:" .. tostring(self.RoundSerial or 0), FEATURE.ToyFarm,
                function() Actions.Expedition_SetNodeQueue(path) end,
                function() return serial(field(gameState(), "NodeQueue") or {}) == serial(path) end)
        end
        return self:Transition("Continue", FEATURE.ToyFarm, "toy-first-node")
    end
    if status == "Travel" then return false end
    if current.X > 2 or (current.X == 2 and status ~= "Encounter") then return restart("toy-first-node-not-drink") end
    if current.X == 2 and status == "Encounter" then
        local foundOther = false
        for replica in pairs(ReplicaClient.Test().TokenReplicas.NPCData or {}) do
            local data = replica.Data
            if (data.ExtraData or {}).Source == "Expeditions" then
                local dialogue = data.Dialogue
                if typeof(dialogue) == "Instance" and dialogue:IsA("ModuleScript") then dialogue = require(dialogue) end
                if type(dialogue) == "table" and dialogue.Unit then
                    if dialogue.Unit == self.TrunksDefinition.Unit then
                        return self:ProcessEncounter(FEATURE.ToyFarm, self.TrunksDefinition.Unit, true)
                    end
                    foundOther = true
                end
            end
        end
        if foundOther then return restart("toy-other-encounter") end
        self.LastError = "waiting for first encounter's native NPC identity"
    end
    return false
end
function Controller:ChooseTomeUnit(trait, parameters)
    local candidates, blank = {}, {}
    local priority = rankList(value(FEATURE.TomePriority, {}))
    for _, unit in ipairs(unitEntries()) do
        local allowed = not ((parameters.SelectionBlacklist or {})[unit.Id])
        if parameters.GameUnitID == unit.Id and not parameters.SelfSelectionAllowed then allowed = false end
        if parameters.RestrictRange then
            local origin
            for _, originUnit in ipairs(unitEntries()) do if originUnit.Id == parameters.GameUnitID then origin = originUnit end end
            if not origin or not origin.CFrame or not unit.CFrame then allowed = false
            else
                local a, b = origin.CFrame.Position, unit.CFrame.Position
                if Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude > (tonumber(field(origin.CurrentStats, "Range")) or 0) then allowed = false end
            end
        end
        if allowed then
            if trait == "Investment" then
                if unit.IsFarm and unit.Trait ~= "Investment" then table.insert(candidates, unit) end
            elseif not unit.IsFarm then
                if not unit.Trait or unit.Trait == "" or unit.Trait == "None" then table.insert(blank, unit)
                elseif (priority[trait] or 0) > (priority[unit.Trait] or 0) then table.insert(candidates, unit) end
            end
        end
    end
    if trait ~= "Investment" and #blank > 0 then candidates = blank end
    table.sort(candidates, function(a, b)
        local av, bv = trait == "Investment" and a.Farm or a.DPS, trait == "Investment" and b.Farm or b.DPS
        return av == bv and a.Id < b.Id or av > bv
    end)
    return candidates[1]
end
function Controller:CancelOwnedTome()
    local pending = self.PendingTome
    if pending and pending.InputReplica then pcall(function() native(function() pending.InputReplica:FireServer("Cancel") end) end) end
    self.PendingTome = nil
end
function Controller:ProcessHotbar()
    self.HotbarPending = false
    if not inExpedition() then self:CancelOwnedTome() return false end
    local token = ReplicaClient.Test().TokenReplicas
    local slots = field(Dependencies.HotbarState, "Slots") or {}
    self.HotbarEpochs = self.HotbarEpochs or {}
    self.HotbarSignatures = self.HotbarSignatures or {}
    local observed = {}
    for rawIndex, slotState in pairs(slots) do
        local index, slot = tostring(rawIndex), peek(slotState)
        local data = field(slot, "Data") or {}
        local signature = serial({ Asset = field(slot, "Asset") or field(data, "Asset"), Id = field(slot, "ID"), Amount = field(data, "Amount"), Trait = field(data, "Trait") })
        observed[index] = true
        if self.HotbarSignatures[index] ~= signature then self.HotbarEpochs[index] = (self.HotbarEpochs[index] or 0) + 1 end
        self.HotbarSignatures[index] = signature
    end
    for index in pairs(self.HotbarSignatures) do
        if not observed[index] then self.HotbarSignatures[index] = nil self.HotbarEpochs[index] = (self.HotbarEpochs[index] or 0) + 1 end
    end
    if self.PendingTome then
        self.HotbarPending = true
        if not value(FEATURE.Tome, false) then self:CancelOwnedTome() return false end
        local pending = self.PendingTome
        local inputs = {}
        for replica in pairs(token.AbilityInput or {}) do
            if not pending.Preexisting[replica] and replica.Data.InputType == "UnitSelection" then table.insert(inputs, replica) end
        end
        if #inputs > 1 then self.LastError = "multiple unit-selection inputs arrived; refusing ambiguous Tome target" return false end
        if #inputs == 0 then
            if os.clock() - pending.At > 10 then self.LastError = "waiting for Tome unit-selection input" end
            return false
        end
        local input = inputs[1] pending.InputReplica = input
        local unit = self:ChooseTomeUnit(pending.Trait, input.Data)
        if not unit then self.LastError = "no eligible Tome unit for current trait priority/input constraints" return false end
        local key = "tome-target:" .. tostring(input.Id or input)
        return self:Submit(key, FEATURE.Tome, function() input:FireServer("Response", unit.Id) end,
            function()
                for _, latest in ipairs(unitEntries()) do if latest.Id == unit.Id then return latest.Trait == pending.Trait end end
                return false
            end, 1, function() self.PendingTome = nil end)
    end
    local ids = {} for index in pairs(slots) do table.insert(ids, tostring(index)) end table.sort(ids)
    for _, index in ipairs(ids) do
        local slot = peek(slots[index])
        local data = field(slot, "Data") or {}
        local asset = field(slot, "Asset") or field(data, "Asset")
        local id
        if asset == "ExpeditionStatAnvil" and value(FEATURE.Anvil, false) then
            -- Do not open another prompt while one is already pending.
            local open = false for replica in pairs(token.CardSelectionPrompt or {}) do if openPrompt(replica, "Cards") then open = true break end end
            if not open then id = FEATURE.Anvil end
        elseif asset == "ExpeditionRepair" and value(FEATURE.Repair, false) then
            local health = tonumber(field(Shared.GameStates, "BaseHealth"))
            local maximum = tonumber(field(Shared.GameStates, "MaxBaseHealth"))
            if health and maximum and maximum > 0 and health / maximum * 100 <= (tonumber(value(FEATURE.RepairPercent, 50)) or 50) then id = FEATURE.Repair end
        elseif asset == "ExpeditionTome" and value(FEATURE.Tome, false) and type(field(data, "Trait")) == "string" then
            if next(token.AbilityInput or {}) == nil and self:ChooseTomeUnit(field(data, "Trait"), {}) then id = FEATURE.Tome end
        end
        if id and field(slot, "Disabled") ~= true and (tonumber(field(data, "Amount")) or 1) > 0 then
            local replica = Nodes.GET_HOTBAR_REPLICA:InvokeSelf()
            if not replica then return false end
            local beforeId, beforeAmount = field(slot, "ID"), tonumber(field(data, "Amount"))
            local key = "hotbar:" .. tostring(replica.Id or replica) .. ":" .. index .. ":" .. tostring(self.HotbarEpochs[index]) .. ":" .. tostring(beforeId) .. ":" .. tostring(beforeAmount) .. ":" .. tostring(asset)
            self.HotbarPending = true
            return self:Submit(key, id, function()
                if id == FEATURE.Tome then
                    local preexisting = {} for input in pairs(token.AbilityInput or {}) do preexisting[input] = true end
                    self.PendingTome = { Trait = field(data, "Trait"), Preexisting = preexisting, At = os.clock() }
                end
                replica:FireServer("SelectSlot", tonumber(index))
            end, function()
                local latest = field(field(Dependencies.HotbarState, "Slots"), index)
                return latest == nil or field(latest, "ID") ~= beforeId or (field(latest, "Asset") or field(field(latest, "Data"), "Asset")) ~= asset
                    or (beforeAmount ~= nil and (tonumber(field(field(latest, "Data"), "Amount")) or 0) < beforeAmount)
            end, 1)
        end
    end
    return false
end
local ROLE_IDS = {
    Lane = { { "DPS", FEATURE.LaneDPS }, { "Farm", FEATURE.LaneFarm }, { "Support", FEATURE.LaneSupport } },
    Payload = { { "Back", FEATURE.PayloadBack }, { "Front", FEATURE.PayloadFront }, { "Middle", FEATURE.PayloadMiddle } },
}
local function expeditionMode()
    local status = field(gameState(), "Status")
    return (status == "Defense" or status == "Elite") and "Lane" or "Payload"
end
local function positionContext(mode)
    local map = field(field(gameState(), "Parameters"), "MapName")
    if type(map) ~= "string" then return nil end
    local layout = mode == "Lane" and serial(field(Dependencies.MapState, "ActivePathGroup") or {}) or "payload"
    return map, layout
end
local function positions()
    local ui = Environment.AnimeExpeditionsUIState
    if type(ui) ~= "table" or type(ui.Values) ~= "table" then return {} end
    if type(ui.Values.__ExpeditionPositions) ~= "table" then ui.Values.__ExpeditionPositions = {} end
    return ui.Values.__ExpeditionPositions
end
function Controller:PositionAnchor(mode)
    local map = workspace:FindFirstChild("Map")
    local payload = map and map:FindFirstChild("PayloadModel")
    if mode == "Payload" and payload then return payload:GetPivot() end
    local effects = Nodes.GET_GAMEMODE_EFFECT_CLASS:InvokeSelf()
    local effect = effects and effects:GetEffect("Expedition")
    if effect and effect.LastNodeSection and effect.LastNodeSection.Parent then return effect.LastNodeSection:GetPivot() end
    return map and map:GetPivot()
end
function Controller:SavePosition(mode, role)
    if not inExpedition() then self.LastError = "position setup requires an Expedition" return false end
    role = normalize(role):gsub("^.-:%s*", ""):gsub(" Position$", "")
    local valid = false for _, entry in ipairs(ROLE_IDS[mode] or {}) do if entry[1] == role then valid = true end end
    if not valid then return false, "unknown position role" end
    if mode == "Lane" and expeditionMode() ~= "Lane" then self.LastError = "Lane position setup waits for an active Defense/Elite layout" return false end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local anchor = self:PositionAnchor(mode)
    local map, layout = positionContext(mode)
    if not root or not anchor or not map then self.LastError = "position context is not ready" return false end
    local store = positions() store[map] = store[map] or {} store[map][mode] = store[map][mode] or {}
    store[map][mode][layout] = store[map][mode][layout] or {}
    store[map][mode][layout][role] = { anchor:ToObjectSpace(root.CFrame):GetComponents() }
    self.LastAction = "saved-" .. mode .. "-" .. role self.LastError = nil
    return true
end
function Controller:GetPositionStatus(mode)
    mode = mode or expeditionMode()
    local map, layout = positionContext(mode)
    local saved = map and (((positions()[map] or {})[mode] or {})[layout]) or {}
    return { Map = map, Mode = mode, Layout = layout, Saved = saved or {}, Active = inExpedition() and (mode == "Payload" or expeditionMode() == "Lane") }
end
function Controller:AssignRoles(slots, mode)
    local roles, counts, selected = {}, {}, {}
    for _, entry in ipairs(ROLE_IDS[mode]) do counts[entry[1]] = 0 selected[entry[1]] = selectedSet(value(entry[2], {})) end
    for _, slot in ipairs(slots) do
        local name = normalize(((Information.Assets or {})[slot.Asset] or {}).DisplayName or slot.Asset)
        for _, entry in ipairs(ROLE_IDS[mode]) do
            local role = entry[1]
            if selected[role][slot.Asset] or selected[role][name] then roles[slot.Index] = role counts[role] += 1 break end
        end
    end
    for _, slot in ipairs(slots) do
        if not roles[slot.Index] then
            local best = ROLE_IDS[mode][1][1]
            for _, entry in ipairs(ROLE_IDS[mode]) do if counts[entry[1]] < counts[best] then best = entry[1] end end
            roles[slot.Index] = best counts[best] += 1
        end
    end
    return roles
end
function Controller:FindPlacement(asset, mode, role)
    local anchor = self:PositionAnchor(mode)
    local mapName, layout = positionContext(mode)
    if not anchor or not mapName then return nil end
    local saved = (((positions()[mapName] or {})[mode] or {})[layout] or {})[role]
    local offset = mode == "Lane" and ({ DPS = -6, Support = 0, Farm = 6 }) or ({ Front = -6, Middle = 0, Back = 6 })
    local desired = type(saved) == "table" and #saved == 12 and anchor * CFrame.new(table.unpack(saved)) or anchor * CFrame.new(0, 0, offset[role] or 0)
    local info = (Information.Units or {})[asset] or (Information.Assets or {})[asset] or {}
    local tag = info.PlacementType == "Hill" and "HillPlacement" or "GroundPlacement"
    local size = UnitUtils:GetUnitBoundingBoxSize(asset)
    local candidates = {}
    local map, sections = workspace:FindFirstChild("Map"), workspace:FindFirstChild("ExpeditionSections")
    for _, part in ipairs(CollectionService:GetTagged(tag)) do
        if part:IsA("BasePart") and ((map and part:IsDescendantOf(map)) or (sections and part:IsDescendantOf(sections))) then
            local localPoint = part.CFrame:PointToObjectSpace(desired.Position)
            local maxX, maxZ = math.max(0, (part.Size.X - size.X) / 2), math.max(0, (part.Size.Z - size.Z) / 2)
            for dx = -1, 1 do for dz = -1, 1 do
                local x = math.clamp(localPoint.X + dx * (size.X + 1), -maxX, maxX)
                local z = math.clamp(localPoint.Z + dz * (size.Z + 1), -maxZ, maxZ)
                local cf = part.CFrame * CFrame.new(x, part.Size.Y / 2 + size.Y / 2, z)
                local distance = (cf.Position - desired.Position).Magnitude
                if distance <= 120 then table.insert(candidates, { CFrame = cf, Distance = distance }) end
            end end
        end
    end
    table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
    for index = 1, math.min(#candidates, 72) do
        local cf = candidates[index].CFrame
        if Actions.IsPlacementAllowed(asset, cf) then return cf end
    end
    self.LastError = "waiting for a valid " .. mode .. " " .. role .. " placement surface"
    return nil
end
local function gamePlayerAction(action, ...)
    local replica = Nodes.GET_GAME_PLAYER_REPLICA:InvokeSelf()
    if not replica then error("game player replica unavailable", 0) end
    local macro = Environment.__AnimeExpeditionsMacro
    local previous = type(macro) == "table" and macro.Replaying
    if type(macro) == "table" then macro.Replaying = true end
    local result = table.pack(pcall(replica.FireServer, replica, action, ...))
    if type(macro) == "table" then macro.Replaying = previous end
    if not result[1] then error(result[2], 0) end
end
function Controller:SelectUpgrade(units, yen)
    local eligible = {}
    for _, unit in ipairs(units) do
        local info = (Information.Units or {})[unit.Asset] or {}
        local upgrades = info.UpgradeInfo or {}
        local maximum = unit.MaxUpgrade or #upgrades
        local nextStats = field(unit.Data, "NextStats") or upgrades[unit.Upgrade + 1] or upgrades[tostring(unit.Upgrade + 1)] or {}
        local cost = tonumber(field(nextStats, "Cost"))
        if unit.Upgrade < maximum and field(unit.Data, "Unupgradeable") ~= true and cost and yen >= cost then table.insert(eligible, unit) end
    end
    table.sort(eligible, function(a, b)
        if value(FEATURE.FarmFirst, false) and a.IsFarm ~= b.IsFarm then return a.IsFarm end
        if a.Upgrade ~= b.Upgrade then return a.Upgrade < b.Upgrade end
        return a.Id < b.Id
    end)
    return eligible[1]
end
-- A completed placement is not a permanent ban on filling that slot again.
-- Advance only after a confirmed population member disappears from both native
-- replica collections. Missing tables, wrapper replacement, elapsed time and
-- unresolved placement requests never grant a fresh attempt.
function Controller:PlacementRequestIdentity(slot, before)
    local round = tostring(self.RoundSerial or 0)
    if self.PlacementCycleRound ~= round then
        self.PlacementCycleRound, self.PlacementCycles = round, {}
    end
    local base = "place:" .. round .. ":" .. slot.Index .. ":" .. before
    local cycle = self.PlacementCycles[base]
    if not cycle then
        cycle = { Epoch = 0, Key = base .. ":epoch:0" }
        self.PlacementCycles[base] = cycle
    end
    local confirmed = cycle.ConfirmedUnits
    if confirmed and (cycle.ConfirmedCount or 0) > before then
        local models, units = peek(Dependencies.GameUnitModels), peek(Dependencies.GameUnits)
        if type(models) == "table" and type(units) == "table" then
            local byId = {}
            for id, model in pairs(models) do byId[tostring(id)] = peek(model) end
            for id, model in pairs(confirmed) do
                if byId[id] == nil and peek(units[model]) == nil then
                    cycle.Epoch += 1
                    cycle.Key = base .. ":epoch:" .. cycle.Epoch
                    cycle.ConfirmedUnits, cycle.ConfirmedCount = nil, nil
                    break
                end
            end
        end
    end
    local key = cycle.Key
    return key, function()
        if cycle.Key ~= key then return end
        local population, count = {}, 0
        for _, unit in ipairs(unitEntries()) do
            if unit.Asset == slot.Asset then population[unit.Id] = unit.Model count += 1 end
        end
        if count > before then
            cycle.ConfirmedUnits, cycle.ConfirmedCount = population, count
        end
    end
end

function Controller:ProcessAutoPlay()
    self.AutoPlayPending = false
    if not inExpedition() or not value(FEATURE.AutoPlay, false) or field(gameState(), "Active") ~= true then return false end
    local status = field(gameState(), "Status")
    if status == "Encounter" then return false end
    local mode = expeditionMode()
    local map, layout = positionContext(mode)
    if not map then return false end
    local contextKey = map .. ":" .. mode .. ":" .. layout .. ":" .. tostring(field(gameState(), "TotalNodes"))
    local slots = {}
    for index, slotState in pairs(field(Dependencies.HotbarState, "Slots") or {}) do
        local slot = peek(slotState)
        local unitData = field(slot, "Data") or field(field(playerData(), "UnitData"), field(slot, "ID")) or {}
        local asset = field(slot, "Asset") or field(unitData, "Asset")
        local info = (Information.Assets or {})[asset] or {}
        if asset and (field(slot, "AssetType") == "Unit" or info.Type == "Unit") then
            table.insert(slots, { Index = tonumber(index), Asset = asset, Data = slot, UnitData = unitData })
        end
    end
    table.sort(slots, function(a, b) return a.Index < b.Index end)
    local roles, units = self:AssignRoles(slots, mode), unitEntries()
    local roleByAsset = {} for _, slot in ipairs(slots) do roleByAsset[slot.Asset] = roles[slot.Index] end
    local priority = value(mode == "Lane" and FEATURE.LanePriority or FEATURE.PayloadPriority)
    for _, unit in ipairs(units) do
        if type(priority) == "string" and field(unit.Data, "TargetPriority") ~= priority then
            local allowed = Actions.GetAllowedUnitTargeting(unit.CurrentStats) or {}
            if table.find(allowed, priority) then
                self.AutoPlayPending = true
                return self:Submit("target:" .. unit.Id .. ":" .. priority, FEATURE.AutoPlay,
                    function() gamePlayerAction("ChangeGameUnitPriority", unit.Id, priority) end,
                    function() return currentUnitField(unit.Id, "TargetPriority") == priority end, 1)
            end
        end
    end
    self.RelocationContexts = self.RelocationContexts or {}
    for _, unit in ipairs(units) do
        if self.RelocationContexts[unit.Id] ~= contextKey and roleByAsset[unit.Asset] and unit.CFrame then
            local cf = self:FindPlacement(unit.Asset, mode, roleByAsset[unit.Asset])
            if cf and (unit.CFrame.Position - cf.Position).Magnitude > 4 then
                self.AutoPlayPending = true
                return self:Submit("relocate:" .. unit.Id .. ":" .. contextKey, FEATURE.AutoPlay,
                    function() gamePlayerAction("RelocateUnit", unit.Id, cf, false) end,
                    function() local latest = currentUnitField(unit.Id, "CFrame") return latest and (latest.Position - cf.Position).Magnitude < 2 end,
                    1, function() self.RelocationContexts[unit.Id] = contextKey end)
            elseif cf then self.RelocationContexts[unit.Id] = contextKey
            else self.AutoPlayPending = true return false end
        end
    end
    local yen = tonumber(field(Dependencies.GamePlayerState, "Yen")) or 0
    local counts = {} for _, unit in ipairs(units) do counts[unit.Asset] = (counts[unit.Asset] or 0) + 1 end
    local cap = tonumber(field(Shared.GameStates, "TotalPlacementCap")) or tonumber((Information.Expeditions or {}).DefaultTotalPlacementCap) or 8
    if #units < cap and field(Dependencies.HotbarState, "PlacementAllowed") ~= false and not (mode == "Lane" and value(FEATURE.PayloadOnly, false)) then
        for _, slot in ipairs(slots) do
            local info = (Information.Units or {})[slot.Asset] or {}
            local limit = tonumber(field(slot.UnitData, "MaxPlacements")) or tonumber(info.PlacementLimit) or 1
            local cost = tonumber(field(slot.Data, "PlacementCost"))
            if (counts[slot.Asset] or 0) < limit and cost and cost <= yen and field(slot.Data, "Disabled") ~= true then
                local cf = self:FindPlacement(slot.Asset, mode, roles[slot.Index])
                if cf then
                    local before = counts[slot.Asset] or 0
                    local placementKey, onPlaced = self:PlacementRequestIdentity(slot, before)
                    self.AutoPlayPending = true
                    return self:Submit(placementKey, FEATURE.AutoPlay,
                        function() gamePlayerAction("PlaceGameUnit", slot.Index, cf) end,
                        function() local count = 0 for _, entry in ipairs(unitEntries()) do if entry.Asset == slot.Asset then count += 1 end end return count > before end, 1, onPlaced)
                end
            end
        end
    end
    local upgrade = self:SelectUpgrade(units, yen)
    if upgrade then
        self.AutoPlayPending = true
        return self:Submit("upgrade:" .. upgrade.Id .. ":" .. upgrade.Upgrade, FEATURE.AutoPlay,
            function() gamePlayerAction("UpgradeGameUnit", upgrade.Id, 1) end,
            function() return (tonumber(currentUnitField(upgrade.Id, "Upgrade")) or 0) > upgrade.Upgrade end, 1)
    end
    return false
end
local function assetName(id) return normalize(((Information.Assets or {})[id] or {}).DisplayName or id) end
function Controller:ProcessShop()
    self.ShopPending = false
    if not inExpedition() or not (value(FEATURE.Shop, false) or value(FEATURE.Hire, false)) then return false end
    local state = gameState()
    local total = tonumber(field(state, "TotalNodes")) or 0
    if total <= 0 or field(state, "Status") ~= "Checkpoint" or field(state, "Active") ~= true then return false end
    local shopData = field(Dependencies.ShopData, "CheckpointShop")
    local shops = field(shopData, "Shops")
    if type(shops) ~= "table" then self.LastError = "waiting for the checkpoint shop replica" self.ShopPending = true return false end
    local selected = selectedSet(value(FEATURE.ShopItems, {}))
    local selectedUnits = selectedSet(value(FEATURE.HireUnits, {}))
    local yen = tonumber(field(Dependencies.GamePlayerState, "Yen")) or 0
    local candidates = {}
    for shopKey, shopState in pairs(shops) do
      local shop = peek(shopState)
      local history = field(field(field(shopData, "PurchaseHistory"), LocalPlayer), shopKey) or {}
      for index, offerState in ipairs(field(shop, "Items") or {}) do
        local offer = peek(offerState)
        if type(offer) == "table" then
            local asset = field(offer, "Name")
            local currency = field(offer, "Currency") or field(shop, "Currency")
            local price = tonumber(field(offer, "Price"))
            local discount = tonumber(field(offer, "Discount")) or 0
            local purchased = tonumber(field(history, tostring(index))) or 0
            local stock = tonumber(field(offer, "Stock")) or math.huge
            local amount = tonumber(field(offer, "Amount")) or 1
            local info = (Information.Assets or {})[asset] or {}
            local isUnit = info.Type == "Unit"
            local feature = isUnit and FEATURE.Hire or FEATURE.Shop
            local accepted = isUnit and selectedUnits or selected
            local display = assetName(asset)
            if asset == "ExpeditionTome" and type(field(field(offer, "Data"), "Trait")) == "string" then display = field(field(offer, "Data"), "Trait") .. " Tome" end
            local owned = tonumber(field(field(field(playerData(), "ItemData"), asset), "Amount")) or 0
            local limit = tonumber(info.InventoryLimit) or math.huge
            if value(feature, false) and (accepted[asset] or accepted[display]) and price and currency == "Yen"
                and price - discount <= yen and stock > purchased and owned + amount <= limit then
                table.insert(candidates, { Index = index, Price = math.max(0, price - discount), Purchased = purchased, ShopKey = shopKey, Feature = feature })
            end
        end
      end
    end
    table.sort(candidates, function(a, b) return a.Price == b.Price and a.Index < b.Index or a.Price > b.Price end)
    local candidate = candidates[1]
    if not candidate then return false end
    self.ShopPending = true
    local key = "shop:" .. tostring(self.RoundSerial or 0) .. ":" .. total .. ":" .. tostring(candidate.ShopKey) .. ":" .. candidate.Index .. ":" .. candidate.Purchased
    return self:Submit(key, candidate.Feature, function() Actions.ShopPurchaseItem("CheckpointShop", candidate.ShopKey, candidate.Index) end,
        function()
            local latest = field(field(field(field(Dependencies.ShopData, "CheckpointShop"), "PurchaseHistory"), LocalPlayer), candidate.ShopKey)
            return (tonumber(field(latest, tostring(candidate.Index))) or 0) > candidate.Purchased
        end, 1)
end
function Controller:BestRoute(state)
    local nodes, current = field(state, "GridNodes"), field(state, "CurrentNode")
    if type(nodes) ~= "table" or type(current) ~= "table" then return nil, "node graph not available" end
    local lookup = Information.Expeditions:BuildNodeLookup(nodes)
    local first = Information.Expeditions:GetNodeIndex(lookup, current)
    if not first then return nil, "current node is not in graph" end
    local priority = value(FEATURE.RewardPriority, {})
    local normalized = {} for _, name in ipairs(type(priority) == "table" and priority or {}) do table.insert(normalized, normalize(name)) end
    local memo, visiting = {}, {}
    local function better(a, b)
        if not b then return true end
        for _, name in ipairs(normalized) do
            local av, bv = a.Rewards[name] or 0, b.Rewards[name] or 0
            if av ~= bv then return av > bv end
        end
        return table.concat(a.Path, ",") < table.concat(b.Path, ",")
    end
    local function visit(index)
        if memo[index] ~= nil then return memo[index] or nil end
        if visiting[index] then return nil end
        local node = nodes[index]
        if type(node) ~= "table" or not tonumber(node.X) or node.X > 10 then return nil end
        visiting[index] = true
        local best
        if node.X == 10 then best = { Path = {}, Rewards = {} } else
            for _, target in ipairs(node.Targets or {}) do
                local targetIndex = Information.Expeditions:GetNodeIndex(lookup, target)
                if targetIndex and tonumber(target.X) and target.X > node.X then
                    local option = visit(targetIndex)
                    if option and better(option, best) then best = option end
                end
            end
        end
        visiting[index] = nil
        if not best then memo[index] = false return nil end
        local result = { Path = { index }, Rewards = table.clone(best.Rewards) }
        for _, child in ipairs(best.Path) do table.insert(result.Path, child) end
        for _, reward in ipairs(node.Rewards or {}) do
            local amount = tonumber(reward.Amount)
            if not amount then memo[index] = false return nil end
            local name = assetName(reward.Asset)
            result.Rewards[name] = (result.Rewards[name] or 0) + amount
        end
        memo[index] = result
        return result
    end
    local route = visit(first)
    if not route then return nil, "no complete valid route through node 10" end
    return route
end
function Controller:ProcessRoute()
