function Adapter:_finish(record, reason, callback)
    if record.Status == "confirmed" then return end
    record.Status, record.Reason = "confirmed", reason
    disconnect(record.Connection) record.Connection = nil
    if callback then callback({ Status = "confirmed", Reason = reason }) end
end
function Adapter:_checkAcknowledgement(record, callback)
    local r = record.Replica
    local d = r and r.Data
    if type(d) ~= "table" then return false end
    if type(d.Responses) == "table" and d.Responses[self.Player] ~= nil then
        self:_finish(record, "native-player-response-observed", callback) return true
    end
    if d.Result ~= nil then
        self:_finish(record, "native-prompt-result-observed", callback) return true
    end
    return false -- disappearing prompts or elapsed time alone are not an ACK
end
function Adapter:_watch(record, callback)
    if type(record.Replica.OnChange) == "function" then
        local ok, connection = pcall(record.Replica.OnChange, record.Replica, function()
            self:_checkAcknowledgement(record, callback)
        end)
        if ok then record.Connection = connection end
    end
end
function Adapter:_prune()
    local done = {}
    for token, record in pairs(self.Ledger.Records) do
        if record.Status == "confirmed" or record.Status == "rejected" or record.Status == "superseded" then done[#done+1] = { token, record.Created or 0 } end
    end
    table.sort(done, function(a,b) return a[2] < b[2] end)
    for i = 1, math.max(0, #done - 128) do self.Ledger.Records[done[i][1]] = nil end
end

-- Fresh, read-only Boss Rush Macro contract. Does not start/vote/enter/move.
-- Gate identity comes from MapData.SpawnPartName and the current replicated map,
-- not from Wave (which is 0 both outside and before an entered Gate starts).
function Adapter:ReadMacroContext()
    local out = { PlacementReady = false, GateEntryReady = false, Reason = "bossrush-context-unavailable" }
    if not self:_current() then out.Reason = "bossrush-owner-changed" return out end
    local replica = self:_game()
    local d = replica and replica.Data
    local p = type(d) == "table" and d.Parameters
    if type(p) ~= "table" or p.Gamemode ~= "BossRush" or type(p.MapName) ~= "string" then
        out.Reason = "not-bossrush" return out
    end
    if not primitiveId(replica.Id) or not finiteInteger(d.GameIncrement, 0, 1e12) then
        out.Reason = "bossrush-run-identity-missing" return out
    end
    local total, remaining, index = d.TotalGateCount, d.ActiveGateCount, d.GateIndex
    if not finiteInteger(total, 1, 6) or not finiteInteger(remaining, 0, total)
        or not finiteInteger(index, 0, total) or index ~= total - remaining then
        out.Reason = "bossrush-gate-counts-disagree" return out
    end
    out.Gamemode, out.MapName, out.Phase = "BossRush", p.MapName, "Gates"
    out.RunId = tostring(self.Player.UserId) .. ":" .. tostring(self.Game.PlaceId) .. ":"
        .. tostring(self.Game.JobId) .. ":" .. tostring(replica.Id) .. ":" .. tostring(d.GameIncrement)
    out.GateIndex, out.CompletedGates = index, index
    out.Wave, out.GameTime = d.Wave, d.GameTime
    local character = self.Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        out.Reason = "bossrush-character-not-ready" return out
    end
    local mapId = character:GetAttribute("InMap")
    local nodes = self.Ctx.Nodes
    local playerNode, mapNode = nodes.GET_GAME_PLAYER_REPLICA, nodes.GET_MAP_REPLICA
    local playerReplica = playerNode and playerNode:InvokeSelf()
    if not playerReplica or type(playerReplica.Data) ~= "table"
        or tostring(playerReplica.Data.GameID) ~= tostring(replica.Id) or not primitiveId(mapId) then
        out.Reason = "bossrush-player-membership-unconfirmed" return out
    end
    local mapReplica = mapNode and mapNode:InvokeSelf(mapId)
    local md = mapReplica and mapReplica.Data
    if type(md) ~= "table" or tostring(md.MapID) ~= tostring(mapId)
        or type(md.Parameters) ~= "table" or md.Parameters.Gamemode ~= "BossRush"
        or md.Parameters.MapName ~= p.MapName then
        out.Reason = "bossrush-map-membership-unconfirmed" return out
    end
    local map = md.Map
    if not map or not map:IsDescendantOf(self.Workspace) then
        out.Reason = "bossrush-map-not-replicated" return out
    end
    out.MapId = tostring(md.MapID)
    -- Native Gate Ground can be an empty placeholder: its actual floor parts
    -- are reparented to Map.Ground. Ignore zero-sized boxes and use the native
    -- Gate Environment geometry instead of that stale placeholder pivot.
    local function insideRegion(region)
        if not region then return false end
        for _, name in ipairs({ "Ground", "Environment" }) do
            local model = region:FindFirstChild(name)
            if model and model:IsA("Model") then
                local ok, cf, size = pcall(model.GetBoundingBox, model)
                if ok and cf and size and size.X > 0 and size.Y > 0 and size.Z > 0 then
                    local position = cf:PointToObjectSpace(root.Position)
                    if math.abs(position.X) <= size.X / 2 + 6 and math.abs(position.Z) <= size.Z / 2 + 6
                        and position.Y >= -size.Y / 2 - 6 and position.Y <= size.Y / 2 + 30 then return true end
                end
            end
        end
        return false
    end
    local gate = map:FindFirstChild("Gate")
    local spawn = map:FindFirstChild("GateSpawnPart")
    local mainSpawn = map:FindFirstChild("SpawnPart")
    -- Completed Gates leave Wave/GameTime at their previous values. Only the
    -- native map membership and main-area position authorize the next entry.
    -- Map.Ground may include reparented Gate floors, so do not use its union box.
    if md.SpawnPartName == "SpawnPart" and not gate and not spawn and mainSpawn and mainSpawn:IsA("BasePart")
        and remaining > 0 and d.Active == true and d.CurrentGameState == "InProgress" and d.Result == nil then
        local inMain = (root.Position - mainSpawn.Position).Magnitude <= 20
        local environment = map:FindFirstChild("Environment")
        if not inMain and environment and environment:IsA("Model") then
            local ok, cf, size = pcall(environment.GetBoundingBox, environment)
            if ok and cf and size and size.X > 0 and size.Y > 0 and size.Z > 0 then
                local position = cf:PointToObjectSpace(root.Position)
                inMain = math.abs(position.X) <= size.X / 2 + 6 and math.abs(position.Z) <= size.Z / 2 + 6
                    and position.Y >= -size.Y / 2 - 6 and position.Y <= size.Y / 2 + 30
            end
        end
        out.GateEntryReady = inMain
    end
    if md.SpawnPartName == "GateSpawnPart" and gate and spawn and spawn:IsA("BasePart") then
        -- A server transport landing beside the verified GateSpawnPart is also
        -- authoritative, including while the Gate environment is streaming.
        local nearSpawn = (root.Position - spawn.Position).Magnitude <= 20
        if not nearSpawn and not insideRegion(gate) then out.Reason = "bossrush-outside-gate-region" return out end
        out.GateId = out.RunId .. ":gate:" .. tostring(index)
        out.Reason = "bossrush-native-gate-ready"
    elseif md.SpawnPartName == "SpawnPart" then
        -- A trapped Crimson Captain exists before the first Gate as Boss C1.
        -- ModelName alone, no prompts, or an elapsed timer is NOT boss evidence.
        local min = type(p.Settings) == "table" and p.Settings.MinGatesBeforeBoss or 2
        if not finiteInteger(min, 1, total) then min = 2 end
        local hasGates = false
        for _, actor in ipairs(self.Collection:GetTagged("Interactable")) do
            if actor.Name == "CreatedGate" and actor:IsDescendantOf(map) then hasGates = true break end
        end
        if index < min or gate or hasGates or map:FindFirstChild("BossTrapModel") then
            out.Reason = "bossrush-waiting-gate-entry" return out
        end
        local bossModel = type(p.Settings) == "table" and p.Settings.BossModelName
        local bossConfirmed = false
        for enemy in pairs(self:_tokens().GameSpawnedEnemy or {}) do
            local ed = enemy.Data
            if type(ed) == "table" and ed.ModelName == bossModel
                and type(bossModel) == "string" and tostring(ed.MapID) == tostring(md.MapID)
                and (ed.GameID == nil or tostring(ed.GameID) == tostring(replica.Id))
                and ed.Finished ~= true and type(ed.Health) == "number" and ed.Health > 0 then
                if ed.Type == "Boss 6" then bossConfirmed = true break end
                -- Live native transition keeps Type Boss C1 and the same enemy
                -- replica. Release attaches GameID and changes Speed 0 -> 1.25.
                -- ModelName alone still cannot distinguish the trapped boss.
                if ed.Type == "Boss C1" and primitiveId(enemy.Id) and ed.GameID ~= nil
                    and tostring(ed.GameID) == tostring(replica.Id) then
                    local proof = self.ReleasedBossProof
                    local sameRelease = type(proof) == "table" and proof.RunId == out.RunId
                        and proof.Enemy == enemy and proof.EnemyId == enemy.Id
                        and proof.MapId == tostring(md.MapID) and proof.Model == bossModel
                        and proof.GameId == tostring(replica.Id)
                    local released = type(ed.Speed) == "number" and ed.Speed == ed.Speed
                        and ed.Speed > 0 and ed.Speed < math.huge
                    if released then
                        self.ReleasedBossProof = { RunId = out.RunId, Enemy = enemy, EnemyId = enemy.Id,
                            MapId = tostring(md.MapID), Model = bossModel, GameId = tostring(replica.Id) }
                    end
                    -- Freeze/slow effects can make a confirmed boss's Speed 0.
                    -- Keep that same native release identity, not a broad flag.
                    if released or sameRelease then bossConfirmed = true break end
                end
            end
        end
        if not bossConfirmed then out.Reason = "boss-phase-unconfirmed" return out end
        -- Boss admission requires either the declared Boss 6 type or the
        -- observed same-run native Boss C1 release proof above.
        out.Phase = "Boss"
        if not insideRegion(map) then out.Reason = "bossrush-outside-boss-region" return out end
        out.Reason = "bossrush-native-boss-ready"
    else
        out.Reason = "bossrush-map-transition" return out
    end
    if d.Active ~= true or d.CurrentGameState ~= "InProgress" or d.Result ~= nil then
        out.Reason = "bossrush-game-not-active" return out
    end
    out.PlacementReady = true
    return out
end


-- Used only to recover files mislabelled by the old Gate/Boss detector.
-- Coordinates remain server-validated by the normal placement path.
function Adapter:ValidateBossMacroPlacements(macro)
    local function finite(value)return type(value)=="number"and value==value and math.abs(value)<math.huge end
    local phase=self:ReadMacroContext()
    if phase.Phase~="Boss" or phase.PlacementReady~=true then return false,"Boss phase is not confirmed" end
    local character=self.Player.Character
    local mapId=character and character:GetAttribute("InMap")
    local node=self.Ctx.Nodes.GET_MAP_REPLICA
    local replica=node and node:InvokeSelf(mapId)
    local md=replica and replica.Data
    local map=md and md.Map
    if not map or not map:IsDescendantOf(self.Workspace) or tostring(md.MapID)~=phase.MapId
        or md.SpawnPartName~="SpawnPart" or map:FindFirstChild("Gate") or map:FindFirstChild("GateSpawnPart") then
        return false,"Boss map changed"
    end
    local environment=map:FindFirstChild("Environment")
    if not environment or not environment:IsA("Model") then return false,"Main Boss geometry unavailable" end
    local ok,cf,size=pcall(environment.GetBoundingBox,environment)
    if not ok or not cf or not size or not finite(size.X)or not finite(size.Y)or not finite(size.Z)
        or size.X<=0 or size.Y<=0 or size.Z<=0 then return false,"Main Boss geometry empty" end
    if type(macro)~="table" or type(macro.Actions)~="table" then return false,"Missing Macro actions" end
    local placements=0
    for _,action in ipairs(macro.Actions)do
        if type(action)~="table"then return false,"Malformed Macro action"end
        if action.Type=="PlaceUnit" then
            local raw=action.Pos or action.CFrame
            local xyz
            if typeof(raw)=="CFrame" then xyz=raw.Position
            else
                local numbers={}
                if type(raw)=="table" then
                    local components=raw.Components or raw
                    if type(components)~="table"then return false,"Malformed placement components"end
                    for i=1,#components do
                        local value=tonumber(components[i])
                        if not finite(value)then return false,"Invalid placement coordinates"end
                        numbers[i]=value
                    end
                elseif type(raw)=="string" then
                    if raw:match("^%s*,")or raw:match(",%s*$")or raw:match(",%s*,")then return false,"Empty placement component"end
                    for token in raw:gmatch("[^,]+")do
                        local value=tonumber(token)
                        if not finite(value)then return false,"Invalid placement coordinates"end
                        numbers[#numbers+1]=value
                    end
                end
                if #numbers~=3 and #numbers~=12 then return false,"Malformed placement coordinates" end
                for i=1,#numbers do
                    local value=numbers[i]
                    if type(value)~="number"or value~=value or math.abs(value)==math.huge then return false,"Invalid placement coordinates" end
                end
                xyz=Vector3.new(numbers[1],numbers[2],numbers[3])
            end
            if not finite(xyz.X)or not finite(xyz.Y)or not finite(xyz.Z)then return false,"Invalid placement coordinates" end
            local position=cf:PointToObjectSpace(xyz)
            if not finite(position.X)or not finite(position.Y)or not finite(position.Z)then return false,"Invalid placement geometry"end
            if math.abs(position.X)>size.X/2+6 or math.abs(position.Z)>size.Z/2+6
                or position.Y < -size.Y/2-6 or position.Y > size.Y/2+30 then return false,"Recorded placement is outside the main Boss area" end
            placements+=1
        end
    end
    if placements==0 then return false,"No Boss placement evidence" end
    local fresh=self:ReadMacroContext()
    if fresh.Phase~="Boss"or fresh.PlacementReady~=true or fresh.RunId~=phase.RunId or fresh.MapId~=phase.MapId then
        return false,"Boss scene changed during validation"
    end
    return true,"Legacy placements match the main Boss area"
end

function Adapter:ReadObservation()
    local replica = self:_game()
    local d = replica and replica.Data or {}
    local parameters = type(d.Parameters) == "table" and d.Parameters or {}
    local mode = parameters.Gamemode
    local scope = tostring(self.Player.UserId) .. ":" .. tostring(self.Game.PlaceId) .. ":" .. tostring(self.Game.JobId)
    local round = replica and primitiveId(replica.Id) and finiteInteger(d.GameIncrement, 0, 1e12)
        and (tostring(replica.Id) .. ":" .. tostring(d.GameIncrement)) or nil
    local total, remaining, index = d.TotalGateCount, d.ActiveGateCount, d.GateIndex
    local completed
    -- Two independent native counters must agree. Entry alone was observed not to
    -- decrement ActiveGateCount; missing/disagreeing counters must never trigger Boss.
    if finiteInteger(total, 1, 6) and finiteInteger(remaining, 0, total)
        and finiteInteger(index, 0, total) and index == total - remaining then completed = index end
    local o = { ScopeKey = scope, RoundKey = round, InGame = replica ~= nil, Mode = mode,
        MapId = parameters.MapName, StageKey = round and (round .. ":gate:" .. tostring(index)) or nil,
        Active = d.Active, CompletedGates = completed, TotalGates = total, RemainingGates = remaining,
        Phase = "Observe", MacroBusy = self.Ctx.MacroBusy and self.Ctx.MacroBusy() or false,
        AvailableGates = {}, ConfirmedOperations = {}, RejectedOperations = {},
        ResolvedPromptIds = {}, ResolvedGateVoteIds = {} }
    self.References, self.GateReferences = {}, {}
    for token, record in pairs(self.Ledger.Records) do
        if record.ScopeKey == scope and record.RoundKey == round then
            self:_checkAcknowledgement(record)
            if record.Status == "confirmed" then o.ConfirmedOperations[#o.ConfirmedOperations + 1] = token end
            if record.Status == "rejected" then o.RejectedOperations[#o.RejectedOperations + 1] = token end
        end
    end
    if mode ~= "BossRush" or type(parameters.MapName) ~= "string" then self.Last = o return o end
    local tokens = self:_tokens()
    local catalog = (self.Ctx.Information.GameUpgradesInfo or {}).Cards or {}
    local cardCandidates, voteCandidates, startCandidates = {}, {}, {}
    local eligibleCardCount = 0
    o.TransitionBlockedByPrompt = false
    for r in pairs(tokens.CardSelectionPrompt or {}) do
        if self:_unresolvedForPlayer(r) then o.TransitionBlockedByPrompt = true end
        if self:_eligible(r) then
            eligibleCardCount += 1
            local p, cards = r.Data.Parameters, {}
            local signature = cardSignature(p)
            local valid = signature ~= nil and finiteInteger(p.SelectionAmount, 1, 60)
            for i, card in ipairs(type(p.Cards) == "table" and p.Cards or {}) do
                local id = cardId(card)
                local def = type(id) == "string" and catalog[id]
                if type(def) ~= "table" or not id:match("^BossRush") or type(def.Element) ~= "string" then valid = false break end
                cards[#cards + 1] = { Id = id, Element = def.Element,
                    Kind = id:match("^BossRush" .. def.Element .. "(.+)$"), Index = i, Eligible = true }
            end
            if valid and #cards >= p.SelectionAmount then
                local id = "card:" .. tostring(r.Id) .. ":" .. signature
                local prompt = { Id = id, Cards = cards, SelectionAmount = p.SelectionAmount, Resolved = false }
                cardCandidates[#cardCandidates+1] = prompt
                self.References[id] = { Replica = r, Signature = signature, Type = "card" }
            end
        end
    end
