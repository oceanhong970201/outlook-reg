    if self.LastError == self.PathCooldownError then self.LastError = nil end
    self.PathCooldownError, self.PathCooldownUntil = nil, nil
    self:CancelNavigation(reason)
    self:DisconnectSignals()
    self.SuspendedReason, self.State = reason, reason
end
function Controller:SyncMovementMode()
    local mode = movementMode()
    if self.MovementMode == mode then return mode end
    self.MovementMode = mode
    self.Generation += 1
    self:CancelNavigation("movement-mode-changed")
    self.PathPlans, self.PathRetryAt, self.NextPathAt = {}, {}, nil
    if self.LastError == self.PathCooldownError then self.LastError = nil end
    self.PathCooldownError, self.PathCooldownUntil = nil, nil
    self.State = enabled() and "movement-mode-changed" or "disabled"
    -- Pending, Attempted and carry/progress remain native-authority state.
    return mode
end
function Controller:ConnectSignals()
    if self.SignalsConnected then return end
    self.SignalsConnected = true
    local function connect(name, callback)
        local node = Nodes[name]
        if node and type(node.Connect) == "function" then
            table.insert(self.Connections, node:Connect(function(...)
                if current() and enabled() and not self.SuspendedReason then callback(...) end
            end))
        end
    end
    connect("LOST_SHIPMENT_SPAWN_CRATE", function(position)
        self.LastSpawnPosition = position
        self.SpawnSeenGeneration = self.Generation
        self:CancelNavigation("new-crate")
    end)
    connect("LOST_SHIPMENT_CRATE_PICKED_UP", function() self.Carrying = true self:CancelNavigation("crate-picked-up") end)
    connect("LOST_SHIPMENT_CLEANUP", function()
        self.Carrying, self.Crate = false, nil
        self:CancelNavigation("native-cleanup")
        if self.Pending and self.Pending.Kind ~= "return" then self.Pending.Cancelled = true end
    end)
end
function Controller:ReadWorld()
    local playerData, session = peek(Dependencies.PlayerData), peek(Dependencies.SessionData)
    local info = type(Information.Events) == "table" and Information.Events.LostShipmentEvent or nil
    if type(playerData) ~= "table" or type(session) ~= "table" or type(info) ~= "table" then return false, "waiting-data" end
    local active = field(session, "LostShipmentActive")
    -- LostShipmentNPC.GetQuestState uses QuestData, not this optional session flag.
    -- Preserve an absent flag as nil; native Intro + the replicated NPC may still start a quest.
    self.Window = math.floor(os.time() / math.max(60, tonumber(info.CrateInterval or info.SpawnInterval) or 7200))
    self.Progress = math.max(0, tonumber(field(playerData, "TrackCounter", "LostShipmentEvent", "Count")) or 0)
    self.MaxProgress = math.max(1, tonumber(info.CrateAmountPer) or 3)
    self.NativeActive = active
    local quest = field(playerData, "QuestData", "LostShipmentEvent", "Quests", "LostShipment")
    self.QuestActive = type(quest) == "table" and field(quest, "Claimed") ~= true
    self.Npc = nil
    local getter = Nodes.NPC_GET_REPLICAS
    local ok, replicas = pcall(function() return identity(function() return getter:InvokeSelf() end) end)
    local folder = workspace:FindFirstChild("NPCS")
    if ok and type(replicas) == "table" and folder then
        for replica in pairs(replicas) do
            local data = replica.Data or {}
            if field(data, "ExtraData", "Source") == "LostShipment" then
                for _, model in ipairs(folder:GetChildren()) do
                    if model:IsA("Model") and model.Parent == folder and tostring(model:GetAttribute("NPCReplicaId")) == tostring(replica.Id) then
                        self.Npc = { Model = model, Replica = replica, Position = model:GetPivot().Position, Range = tonumber(model:GetAttribute("MaxActivationDistance") or data.MaxActivationDistance) or 10 }
                        local dialogue = data.Dialogue
                        if type(dialogue) == "table" and type(dialogue.Choices) == "table" and dialogue.Choices[1] and dialogue.Choices[1].Choice == "Here you go!" then
                            self.Carrying = true
                        elseif typeof(dialogue) == "Instance" and dialogue:IsA("ModuleScript") and dialogue.Name == "LostShipmentNPC" then
                            -- Native CrateHandler restores this dialogue on cleanup; reconcile missed signals after toggle-off/reload.
                            self.Carrying, self.CarryToken = false, nil
                        end
                        break
                    end
                end
            end
            if self.Npc then break end
        end
    end
    -- Carrying is owned by CrateHandler's pickup/cleanup signals and ReturnDialogue.
    -- LostShipmentActive is not the native carry state and may be absent or stale.
    self.Crate, self.CrateAmbiguous = nil, false
    local crateCandidates = {}
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local misc = assets and assets:FindFirstChild("Misc")
    local template = misc and misc:FindFirstChild("Crate")
    if template then
        for _, model in ipairs(workspace:GetChildren()) do
            if model:IsA("Model") and model.Parent == workspace and model.Name == template.Name then
                local part = model.PrimaryPart
                local prompt = part and part:FindFirstChildOfClass("ProximityPrompt")
                if part and prompt and part:HasTag("Interactable") and part:GetAttribute("ActionText") == "Pick Up" and part:GetAttribute("MaxActivationDistance") == 16 then
                    if not self.ModelTokens[model] then
                        self.SpawnSerial += 1
                        self.ModelTokens[model] = tostring(self.Window) .. ":" .. tostring(self.SpawnSerial) .. ":" .. pointKey(part.Position)
                    end
                    table.insert(crateCandidates, { Model = model, Prompt = prompt, Position = part.Position, Range = math.min(16, tonumber(prompt.MaxActivationDistance) or 16), Token = self.ModelTokens[model] })
                end
            end
        end
    end
    if #crateCandidates == 1 then self.Crate = crateCandidates[1]
    elseif #crateCandidates > 1 then
        local matches = {}
        if self.SpawnSeenGeneration == self.Generation and typeof(self.LastSpawnPosition) == "CFrame" then
            for _, candidate in ipairs(crateCandidates) do
                if (candidate.Position - self.LastSpawnPosition.Position).Magnitude <= 1e-3 then table.insert(matches, candidate) end
            end
        end
        if #matches == 1 then self.Crate = matches[1] else self.CrateAmbiguous = true end
    end
    return true
end
function Controller:ObservePending()
    local pending = self.Pending
    if not pending then return false end
    local confirmed = pending.Kind == "start" and (self.NativeActive or self.QuestActive or self.Crate ~= nil)
        or pending.Kind == "pickup" and self.Carrying == true
    if pending.Kind == "return" and self.Window == pending.Window and self.Progress > pending.BeforeProgress then
        self.ConfirmedReturns += 1
        self.LastConfirmation = { Before = pending.BeforeProgress, After = self.Progress, At = os.time() }
        self.Carrying, self.CarryToken = false, nil
        confirmed = true
    end
    if confirmed then self.Pending = nil self.LastError = nil self.State = pending.Kind .. "-confirmed" return true end
    if self.Window ~= pending.Window or self.Progress < pending.BeforeProgress then
        self.Pending = nil self.LastError = "Unconfirmed operation expired with native progress window" self.State = "window-changed" return true
    end
    if pending.Cancelled or os.clock() - pending.StartedAt >= Config.ConfirmationSeconds then
        pending.Unconfirmed = true
        self.State = "unconfirmed"
        self.LastError = pending.Kind .. " was attempted but native progress was not confirmed; no automatic retry"
    else self.State = pending.Kind .. "-pending" end
    return true
end
function Controller:Attempt(kind, key, callback)
    if self.Attempted[key] then self.State = "attempt-already-recorded" return false, self.State end
    local context, reason = self:Gate()
    if not context or context.Character ~= self.LastCharacter then self:Suspend(reason or "character-changed") return false, self.State end
    if Config.DryRun then self.State = "dry-run" self.LastAction = { Kind = kind, DryRun = true } return false, self.State end
    self.Attempted[key] = true
    self.Pending = { Kind = kind, Key = key, StartedAt = os.clock(), BeforeProgress = self.Progress, Window = self.Window }
    if kind == "start" then self.StartAttempts += 1 elseif kind == "pickup" then self.PickupAttempts += 1 self.CarryToken = key else self.ReturnAttempts += 1 end
    self.LastAction = { Kind = kind, At = os.time() }
    local generation = self.Generation
    local ok, result = pcall(function() return identity(callback) end)
    if not ok then self.LastError = tostring(result) end
    if not current() or not enabled() or generation ~= self.Generation then return false, "cancelled after dispatch; outcome unconfirmed" end
    self.State = kind .. "-pending"
    return true, self.State
end
function Controller:GroundClearance(context)
    local function finite(value) return type(value) == "number" and value == value and value > -math.huge and value < math.huge end
    local size, hipHeight = context.Root.Size, context.Humanoid.HipHeight
    if size ~= nil and (typeof(size) ~= "Vector3" or not finite(size.Y) or size.Y <= 0) then return nil end
    if hipHeight ~= nil and (not finite(hipHeight) or hipHeight < 0) then return nil end
    if size == nil or hipHeight == nil or context.Humanoid.RigType == nil then return 3 end
    local clearance = hipHeight + size.Y / 2
    if clearance > PATH_AGENT_HEIGHT then return nil end
    if context.Humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = context.Character:FindFirstChild("Left Leg")
        if not leg then return 3 end
        if not leg:IsA("BasePart") then return nil end
        local legSize = leg.Size
        if legSize == nil then return 3 end
        if typeof(legSize) ~= "Vector3" or not finite(legSize.Y) or legSize.Y <= 0 then return nil end
        clearance += legSize.Y
    elseif context.Humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        return nil
    end
    -- A root-to-foot offset larger than the planner's whole agent height is not trustworthy.
    if not finite(clearance) or clearance <= 0 or clearance > PATH_AGENT_HEIGHT then return nil end
    return clearance
end
function Controller:WaypointReached(context, waypoint, isFinal, target)
    local rootPosition = context.Root.Position
    if isFinal then return (rootPosition - target.Position).Magnitude <= target.Range end
    local clearance = self:GroundClearance(context)
    if not clearance then return false end
    local delta = rootPosition - waypoint.Position
    return Vector3.new(delta.X, 0, delta.Z).Magnitude <= 3 and math.abs(delta.Y - clearance) <= 3
end
local function finiteVector(position)
    if typeof(position) ~= "Vector3" then return false end
    for _, number in ipairs({ position.X, position.Y, position.Z }) do
        if number ~= number or number <= -math.huge or number >= math.huge then return false end
    end
    return true
end
function Controller:TeleportTargetValid(target, key)
    if type(peek(Dependencies.PlayerData)) ~= "table" or type(peek(Dependencies.SessionData)) ~= "table"
        or type(Information.Events) ~= "table" or type(Information.Events.LostShipmentEvent) ~= "table" then return false end
    if type(target) ~= "table" or not target.Model or not target.Model:IsDescendantOf(workspace) or not finiteVector(target.Position)
        or type(target.Range) ~= "number" or target.Range ~= target.Range or target.Range <= 0 or target.Range >= math.huge then return false end
    local position
    if key:sub(1, 7) == "pickup:" then
        local quest = field(Dependencies.PlayerData, "QuestData", "LostShipmentEvent", "Quests", "LostShipment")
        local active = field(Dependencies.SessionData, "LostShipmentActive") or (type(quest) == "table" and field(quest, "Claimed") ~= true)
        if not active or self.Carrying or self.Crate ~= target or target.Model.Parent ~= workspace
            or not target.Prompt or not target.Prompt.Enabled or target.Prompt.Parent ~= target.Model.PrimaryPart then return false end
        local part = target.Model.PrimaryPart
        if not part or not part:HasTag("Interactable") or part:GetAttribute("ActionText") ~= "Pick Up" or part:GetAttribute("MaxActivationDistance") ~= 16 then return false end
        position = target.Model.PrimaryPart and target.Model.PrimaryPart.Position
    else
        if self.Npc ~= target or target.Model.Parent ~= workspace:FindFirstChild("NPCS")
            or not target.Replica or field(target.Replica.Data, "ExtraData", "Source") ~= "LostShipment"
            or tostring(target.Model:GetAttribute("NPCReplicaId")) ~= tostring(target.Replica.Id) then return false end
        position = target.Model:GetPivot().Position
    end
    return finiteVector(position) and (position - target.Position).Magnitude <= 0.01
end
function Controller:TeleportApproach(target, key, context)
    if not self:TeleportTargetValid(target, key) then self:CancelNavigation("target-changed") self.State = "target-changed" return false end
    local live, reason = self:Gate()
    if not live or live.Character ~= context.Character or live.Root ~= context.Root or live.Humanoid ~= context.Humanoid then
        self:Suspend(reason or "character-changed") return false
    end
    if (live.Root.Position - target.Position).Magnitude <= target.Range then self:CancelNavigation("in-range") return true end
    if Config.DryRun then self.State = "dry-run" return false end
    self:CancelNavigation("teleport-approach")
    local navigation = { Key = key, Model = target.Model, Character = context.Character, Root = context.Root, Humanoid = context.Humanoid, Generation = self.Generation }
    self.Navigation = navigation
    local function valid()
        self:SyncMovementMode()
        local latest = self:Gate()
        return self.Navigation == navigation and self.MovementMode == "Teleport" and navigation.Generation == self.Generation
            and not Config.DryRun and latest and latest.Character == context.Character and latest.Root == context.Root
            and latest.Humanoid == context.Humanoid and self:TeleportTargetValid(target, key)
    end
    local delta = context.Root.Position - target.Position
    local horizontal = Vector3.new(delta.X, 0, delta.Z)
    local direction = horizontal.Magnitude > 0.01 and horizontal.Unit or Vector3.new(1, 0, 0)
    local bank = target.Position + direction * math.max(2, target.Range * 0.6)
    local params = RaycastParams.new()
    params.FilterType, params.FilterDescendantsInstances, params.IgnoreWater = Enum.RaycastFilterType.Exclude, { context.Character, target.Model }, true
    local hit = workspace:Raycast(bank + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), params)
    if not valid() then self:CancelNavigation("late-teleport-cancelled") return false end
    local clearance = self:GroundClearance(context)
    if not hit or not finiteVector(hit.Position) or not finiteVector(hit.Normal) or hit.Normal.Y < 0.5 or not clearance then
        self:CancelNavigation("no-walkable-ground") self.State = "no-walkable-ground" return false
    end
    local destination = hit.Position + Vector3.new(0, clearance, 0)
    if (destination - target.Position).Magnitude > target.Range then self:CancelNavigation("teleport-out-of-range") self.State = "teleport-out-of-range" return false end
    local moved = false
    identity(function()
        if not valid() then return end
        -- Translate the model's existing pivot so root offset and facing are preserved.
        context.Character:PivotTo(context.Character:GetPivot() + (destination - context.Root.Position))
        moved = true
    end)
    self:CancelNavigation(moved and "teleported" or "late-teleport-cancelled")
    self.State = moved and "teleported" or "movement-cancelled"
    -- A teleport is movement only: the next native world read must revalidate interaction range.
    return false
end
function Controller:Approach(target, key, context)
    if self:SyncMovementMode() == "Teleport" then return self:TeleportApproach(target, key, context) end
    if (context.Root.Position - target.Position).Magnitude <= target.Range then self:CancelNavigation("in-range") return true end
    if Config.DryRun then self.State = "dry-run" return false end
    local navigation = self.Navigation
    if navigation and (navigation.Key ~= key or navigation.Model ~= target.Model) then self:CancelNavigation("target-changed") navigation = nil end
    if navigation then
        local live = self:Gate()
        if not live or navigation.Generation ~= self.Generation or live.Character ~= navigation.Character or live.Root ~= navigation.Root or live.Humanoid ~= navigation.Humanoid or not target.Model.Parent then self:CancelNavigation("context-changed") self.State = "waiting-character" return false end
        if navigation.Blocked then self:CancelNavigation("path-blocked") self.NextPathAt = os.clock() + 1 self.State = "path-blocked" return false end
        while navigation.Index <= #navigation.Waypoints and self:WaypointReached(context, navigation.Waypoints[navigation.Index], navigation.Index == #navigation.Waypoints, target) do
            navigation.Index += 1 navigation.MovingIndex = nil
        end
        if navigation.Index > #navigation.Waypoints then self:CancelNavigation("path-ended-out-of-range") self.PathPlans[key] = Config.MaxPathPlans self.State = "path-out-of-range" return false end
        if navigation.MovingIndex == navigation.Index then
            if os.clock() - navigation.StartedAt > Config.WaypointTimeoutSeconds then self:CancelNavigation("waypoint-timeout") self.NextPathAt = os.clock() + 1 self.State = "waypoint-timeout" else self.State = "moving" end
            return false
        end
        local waypoint = navigation.Waypoints[navigation.Index]
        identity(function()
            if waypoint.Action == Enum.PathWaypointAction.Jump then context.Humanoid.Jump = true end
            context.Humanoid:MoveTo(waypoint.Position)
        end)
        navigation.MovementOwned = true
        navigation.MovingIndex, navigation.StartedAt = navigation.Index, os.clock()
        self.State = "moving"
        return false
    end
    if (self.PathPlans[key] or 0) >= Config.MaxPathPlans then
        local now = os.clock()
        local retryAt = self.PathRetryAt[key]
        if not retryAt then
            retryAt = now + Config.PathRetryCooldownSeconds
            self.PathRetryAt[key] = retryAt
            self.LastPathFailure = { Reason = self.State, NavigationReason = self.LastNavigationReason, Error = self.LastError, At = os.time(), Key = key }
        end
        if now < retryAt then
            self.State, self.PathCooldownUntil = "path-cooldown", retryAt
            self.PathCooldownError = string.format("Navigation %s; retrying a bounded path batch in %ds", tostring(self.LastPathFailure.Reason), math.ceil(retryAt - now))
            self.LastError = self.PathCooldownError
            return false
        end
        -- Only movement planning receives a new budget; native request identities remain untouched.
        self.PathPlans[key], self.PathRetryAt[key] = 0, nil
        if self.LastError == self.PathCooldownError then self.LastError = nil end
        self.PathCooldownError, self.PathCooldownUntil = nil, nil
    end
    if os.clock() < (self.NextPathAt or 0) then self.State = "waiting-path" return false end
    self.PathPlans[key] = (self.PathPlans[key] or 0) + 1
    local delta = context.Root.Position - target.Position
    local horizontal = Vector3.new(delta.X, 0, delta.Z)
    local direction = horizontal.Magnitude > 0.01 and horizontal.Unit or Vector3.new(1, 0, 0)
    local bank = target.Position + direction * math.max(2, target.Range * 0.6)
    local params = RaycastParams.new()
    params.FilterType, params.FilterDescendantsInstances, params.IgnoreWater = Enum.RaycastFilterType.Exclude, { context.Character, target.Model }, true
    local hit = workspace:Raycast(bank + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), params)
    if not hit or hit.Normal.Y < 0.5 then self.State = "no-walkable-ground" self.NextPathAt = os.clock() + 1 return false end
    local path = game:GetService("PathfindingService"):CreatePath({ AgentRadius = 2, AgentHeight = PATH_AGENT_HEIGHT, AgentCanJump = true, WaypointSpacing = 6 })
    navigation = { Key = key, Model = target.Model, Character = context.Character, Root = context.Root, Humanoid = context.Humanoid, Generation = self.Generation, Path = path, Index = 1 }
    self.Navigation = navigation
    local ok, failure = pcall(function() identity(function() path:ComputeAsync(context.Root.Position, hit.Position + Vector3.new(0, 2, 0)) end) end)
    self:SyncMovementMode()
    local live = self:Gate()
    if self.Navigation ~= navigation or self.MovementMode ~= "Pathfinding" or not live or navigation.Generation ~= self.Generation or live.Character ~= navigation.Character or live.Root ~= navigation.Root or live.Humanoid ~= navigation.Humanoid or not target.Model.Parent then
        if self.Navigation == navigation then self:CancelNavigation("late-path-cancelled")
        elseif not navigation.PathReleased then pcall(function() path:Destroy() end) navigation.PathReleased = true end
        return false
    end
    if not ok or path.Status ~= Enum.PathStatus.Success then
        self:CancelNavigation("path-unavailable") self.NextPathAt = os.clock() + 1 self.State = "path-unavailable"
        if not ok then self.LastError = tostring(failure) end
        return false
    end
    navigation.Waypoints = path:GetWaypoints()
    if #navigation.Waypoints == 0 then self:CancelNavigation("empty-path") self.State = "path-unavailable" return false end
    navigation.BlockedConnection = path.Blocked:Connect(function(index)
        if self.Navigation == navigation and index >= navigation.Index then navigation.Blocked = true end
    end)
    return self:Approach(target, key, context)
end
function Controller:CancelNavigation(reason)
    local navigation = self.Navigation
    self.Navigation = nil
    self.LastNavigationReason = reason
    if not navigation then return end
    if navigation.BlockedConnection then pcall(function() navigation.BlockedConnection:Disconnect() end) end
    if navigation.Path and not navigation.PathReleased then pcall(function() navigation.Path:Destroy() end) navigation.PathReleased = true end
    if navigation.MovementOwned and navigation.Root.Parent == navigation.Character and navigation.Humanoid.Parent == navigation.Character then
        pcall(function() identity(function() navigation.Humanoid:MoveTo(navigation.Root.Position) end) end)
    end
end
function Controller:ExportState()
    return { OwnerKey = self.OwnerKey, Attempted = self.Attempted, StartAttempts = self.StartAttempts, PickupAttempts = self.PickupAttempts,
        ReturnAttempts = self.ReturnAttempts, ConfirmedReturns = self.ConfirmedReturns, SpawnSerial = self.SpawnSerial, Progress = self.Progress, Pending = self.Pending, Carrying = self.Carrying, CarryToken = self.CarryToken, ModelTokens = self.ModelTokens }
end
function Controller:_RunOnce()
    self:SyncMovementMode()
    local context, reason = self:Gate()
    if not context then self:Suspend(reason) return false, self.State end
    if self.LastCharacter and self.LastCharacter ~= context.Character then self.LastCharacter = context.Character self:Suspend("character-changed") return false, self.State end
    self.LastCharacter = context.Character
    self.SuspendedReason = nil
    self:ConnectSignals()
    local ready, failure = self:ReadWorld()
    if not ready then self:CancelNavigation(failure) self.State = failure return false, failure end
    if self:ObservePending() then return false, self.State end
    if self.Progress >= self.MaxProgress and not self.Carrying then self:CancelNavigation("complete") self.State = "complete" return false, self.State end
    local prefix = tostring(self.Window) .. ":" .. tostring(self.Progress)
    if self.CrateAmbiguous and not self.Carrying and (self.NativeActive or self.QuestActive) then self:CancelNavigation("ambiguous-crates") self.State = "ambiguous-crates" return false, self.State end
    if self.Carrying then
        if not self.Npc then self:CancelNavigation("waiting-npc") self.State = "waiting-npc" return false, self.State end
        local key = "return:" .. (self.CarryToken or prefix)
        if not self:Approach(self.Npc, key, context) then return false, self.State end
        local node = Nodes.LOST_SHIPMENT_RETURN_CRATE
        if not node or type(node.Request) ~= "function" then self.State = "return-unavailable" return false, self.State end
        return self:Attempt("return", key, function() local request = node:Request() request:Timeout(5) return request:Wait() end)
    end
    if self.Crate and (self.NativeActive or self.QuestActive) then
        local crate = self.Crate
        if not crate.Prompt.Enabled then self:CancelNavigation("prompt-disabled") self.State = "prompt-disabled" return false, self.State end
        local key = "pickup:" .. prefix .. ":" .. crate.Token
        if not self:Approach(crate, key, context) then return false, self.State end
        if type(fireproximityprompt) ~= "function" then self.State = "native-prompt-unavailable" return false, self.State end
        return self:Attempt("pickup", key, function() fireproximityprompt(crate.Prompt) end)
    end
    if self.NativeActive or self.QuestActive then self:CancelNavigation("no-crate") self.State = "waiting-crate" return false, self.State end
    if not self.Npc then self:CancelNavigation("waiting-npc") self.State = "waiting-npc" return false, self.State end
    local start = rawget(Actions, "RequestEventReplica")
    if type(start) ~= "function" then self.State = "start-unavailable" return false, self.State end
    local key = "start:" .. prefix
    if not self:Approach(self.Npc, key, context) then return false, self.State end
    return self:Attempt("start", key, function()
        local scope = {}
        local results = table.pack(pcall(start, scope, "LostShipmentEvent", "StartQuest"))
        cleanupScope(scope)
        if not results[1] then error(results[2], 0) end
        return table.unpack(results, 2, results.n)
    end)
end
function Controller:RunOnce()
    if not current() then return false, "stopped" end
    if self.Busy then return false, "busy" end
    self.Busy, self.ActiveOperations = true, self.ActiveOperations + 1
    self.OperationThread = coroutine.running()
    local result = table.pack(xpcall(function() return self:_RunOnce() end, debug.traceback))
    self.ActiveOperations = math.max(0, self.ActiveOperations - 1)
    self.Busy = self.ActiveOperations > 0
    self.OperationThread = nil
    if not self.Running then self.State = "stopped" if Environment[KEY] == self then Environment[KEY] = nil end end
    if not result[1] then self.LastError = tostring(result[2]) self.State = "error" self:CancelNavigation("error") return false, self.LastError end
    return table.unpack(result, 2, result.n)
end
function Controller:GetStatus()
    return { Running = self.Running, Enabled = enabled(), State = self.State, MovementMode = movementMode(), Busy = self.Busy, Progress = self.Progress, MaxProgress = self.MaxProgress,
        StartAttempts = self.StartAttempts, PickupAttempts = self.PickupAttempts, ReturnAttempts = self.ReturnAttempts, ConfirmedReturns = self.ConfirmedReturns,
