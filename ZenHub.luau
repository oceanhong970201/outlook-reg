local MonsterClashNative = assert(loadstring([====================================================[-- Native Monster Clash seam. ReadState/new never dispatch game actions.
-- Source: ClientMapEffects.Gamemodes.KaijuEvent and ReplicateRift (2026-10-11).
-- Envy uses GameState.SessionTime. Helicopter flight uses server epoch time.
local Module = {}
local Adapter = {}
Adapter.__index = Adapter

local function finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
local function id(v) return type(v)=="string" and v~="" or finite(v) end
local function sameId(a,b) return id(a) and id(b) and tostring(a)==tostring(b) end
local function invoke(node,...)
    if not node or type(node.InvokeSelf)~="function" then return nil end
    local ok,result=pcall(node.InvokeSelf,node,...)
    return ok and result or nil
end
local function member(list,player)
    if type(list)~="table" then return false end
    -- Native ReplicateRift uses table.find on the Players array.
    return table.find(list,player)~=nil
end
local function empty(reason)
    return {InGame=false,InLobby=false,Victory=false,Host=false,Recording=false,
        DisableJoiners=false,MacroActiveOperation=false,Reason=reason}
end
local function response(status,sent,reason)
    return {Status=status,Sent=sent,Retryable=false,Reason=reason}
end
local function normalizedWarning(value)
    if type(value)~="string"then return nil end
    return value:gsub("<.->",""):gsub("[!.,:;%-]+"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$",""):lower()
end
local function incomingText(value)
    local s=normalizedWarning(value)
    return s=="helicopter incoming" or s=="enter the helicopter once it arrives"
        or s=="helicopter incoming enter the helicopter once it arrives"
end

function Module.new(context)
    assert(type(context)=="table","Monster Clash native context required")
    local g=context.Game or game
    local nodes,replicas=context.Nodes,context.ReplicaClient
    if not nodes or not replicas then
        local rs=g:GetService("ReplicatedStorage")
        nodes=nodes or require(rs:WaitForChild("Nodes"))
        replicas=replicas or require(rs:WaitForChild("Shared"):WaitForChild("ReplicaClient"))
    end
    local self=setmetatable({Ctx=context,Game=g,Workspace=context.Workspace or g:GetService("Workspace"),
        Player=context.Player or g:GetService("Players").LocalPlayer,Nodes=nodes,ReplicaClient=replicas,
        Environment=context.Environment or {},Gui=context.Gui,Stopped=false,SentTokens={},SentOrder={},
        SubmittedEncounters={},EncounterOrder={},Refs={},Connections={}},Adapter)
    local scope=tostring(self.Player.UserId)..":"..tostring(g.PlaceId)..":"..tostring(g.JobId)
    local all=context.Preview~=true and self.Environment.__AnimeExpeditionsMonsterNativeEvidence or nil
    if type(all)~="table"then
        all={}
        if context.Preview~=true then self.Environment.__AnimeExpeditionsMonsterNativeEvidence=all end
    end
    local evidence=all[scope]
    if type(evidence)~="table"then evidence={Serial=0,Warnings={},WarningOrder={},Models={},ModelOrder={}}all[scope]=evidence end
    evidence.ModelOrder=type(evidence.ModelOrder)=="table"and evidence.ModelOrder or{}
    self.Evidence=evidence
    local function connect(name,callback)
        if context.Preview==true then return end
        local node=nodes[name]
        if node and type(node.Connect)=="function"then
            local ok,c=pcall(node.Connect,node,function(...)
                if self:_current()then pcall(callback,...)end
            end)
            if ok and c then self.Connections[#self.Connections+1]=c end
        end
    end
    connect("PORTAL_SETUP_DISPLAY",function(model,replica)
        if typeof(model)~="Instance" or not model:IsA("Model")or type(replica)~="table"
            or type(replica.Data)~="table"or replica.Data.RiftName~="KaijuEventRift"then return end
        local s=self:ReadState()
        if s.InGame~=true then return end
        if not evidence.Models[replica]then evidence.ModelOrder[#evidence.ModelOrder+1]=replica end
        evidence.Models[replica]={Model=model,ScopeKey=s.ScopeKey,GameKey=s.GameKey,MapKey=s.MapKey,
            Map=self.Refs.Map,Game=self.Refs.Game}
        if #evidence.ModelOrder>24 then evidence.Models[table.remove(evidence.ModelOrder,1)]=nil end
    end)
    local function captureIncoming(message)
            if not incomingText(message)then return end
            local s=self:ReadState()
            if s.InGame~=true or not(s.ActiveBattle or s.Victory)then return end
            local now=self.Ctx.Clock and self.Ctx.Clock()or os.clock()
            if not finite(now)then return end
            local key=s.GameKey.."|"..s.RunKey.."|"..s.MapKey
            if evidence.Warnings[key]then return end -- duplicates never refresh TTL
            evidence.Serial=(tonumber(evidence.Serial)or 0)+1
            local d=self.Refs.Game.Data
            local hint={Id=s.ScopeKey..":incoming:"..tostring(evidence.Serial),At=now,ScopeKey=s.ScopeKey,
                GameKey=s.GameKey,MapKey=s.MapKey,RunKey=s.RunKey,Increment=d.GameIncrement,
                ActiveAtReceipt=s.ActiveBattle==true,SeenVictory=s.Victory==true}
            evidence.Warnings[key]=hint evidence.WarningOrder[#evidence.WarningOrder+1]=key evidence.Incoming=hint
            if #evidence.WarningOrder>24 then evidence.Warnings[table.remove(evidence.WarningOrder,1)]=nil end
    end
    for _,name in ipairs({"CLIENT_WARN","CLIENT_MESSAGE","CLIENT_NOTIFICATION"})do
        connect(name,captureIncoming)
    end
    -- The large red native banner is not a CLIENT_WARN toast. Its source
    -- MountGameWarning passes SEND_GAME_WARNING's Text/SubText table directly
    -- to GameWarning. Label/Title and generic tables do not authenticate it.
    connect("SEND_GAME_WARNING",function(payload)
        if type(payload)~="table" or normalizedWarning(payload.Text)~="helicopter incoming"then return end
        if payload.SubText~=nil and normalizedWarning(payload.SubText)~="enter the helicopter once it arrives"then return end
        captureIncoming(payload.Text)
    end)
    return self
end

function Adapter:_incoming(out,d)
    local hint=self.Evidence.Incoming
    if type(hint)~="table"or hint.Invalid then return end
    if hint.ScopeKey~=out.ScopeKey or hint.GameKey~=out.GameKey or hint.MapKey~=out.MapKey then hint.Invalid=true return end
    if d.GameIncrement~=hint.Increment then
        if hint.ActiveAtReceipt and not hint.Carried and d.GameIncrement==hint.Increment+1 and out.Victory then
            hint.Carried=true hint.Increment=d.GameIncrement hint.RunKey=out.RunKey hint.SeenVictory=true
            self.Evidence.Warnings[out.GameKey.."|"..out.RunKey.."|"..out.MapKey]=hint
        else hint.Invalid=true return end
    end
    if out.Victory then hint.SeenVictory=true end
    if out.ActiveBattle and hint.SeenVictory then hint.Invalid=true return end
    local now=self.Ctx.Clock and self.Ctx.Clock()or os.clock()
    if finite(now)and finite(hint.At)and now>=hint.At then
        -- Keep expired hint identity/age visible: reloads must not renew it.
        out.Incoming={Id=hint.Id,Detected=true,AgeSeconds=now-hint.At}
    end
end

function Adapter:_portalBelongs(r,g,mapReplica,out)
    local d=r.Data
    if d.GameID~=nil and not sameId(d.GameID,g.Id)then return false end
    if d.MapID~=nil and not sameId(d.MapID,mapReplica.Data.MapID)then return false end
    if r.Parent==g or r.Parent==mapReplica then return true end
    if r.Parent~=nil then return false end -- explicit foreign parent is never rescued
    local proof=self.Evidence.Models[r]
    if type(proof)~="table"or proof.ScopeKey~=out.ScopeKey or proof.GameKey~=out.GameKey or proof.MapKey~=out.MapKey
        or proof.Game~=g or proof.Map~=mapReplica or not proof.Model or not proof.Model:IsDescendantOf(self.Workspace)
        or typeof(d.SpawnCFrame)~="CFrame"then return false end
    local map=mapReplica.Data.Map
    local spawn,count=nil,0
    for _,child in ipairs(map:GetChildren())do
        if child.Name=="RiftSpawnPart"then count+=1 spawn=child end
    end
    if count~=1 or not spawn:IsA("BasePart")then return false end
    local a,b=d.SpawnCFrame.Position,spawn.Position
    if not finite(a.X)or not finite(a.Y)or not finite(a.Z)or not finite(b.X)or not finite(b.Y)or not finite(b.Z)then return false end
    -- Six studs is a bounded geometry tolerance, not a bypass or server radius.
    return (a-b).Magnitude<=6
end

function Adapter:_value(key,fallback)
    local gui=self.Gui
    if gui and type(gui.GetValue)=="function" then
        local ok,v=pcall(gui.GetValue,gui,key)
        if ok and v~=nil then return v end
    end
    local values=gui and gui.State and gui.State.Values
    if type(values)=="table" and values[key]~=nil then return values[key] end
    return fallback
end

function Adapter:_current()
    if self.Stopped or self.Ctx.Preview==true then return false end
    if type(self.Ctx.IsCurrent)=="function" then
        local ok,current=pcall(self.Ctx.IsCurrent)
        if not ok or current~=true then return false end
    end
    return not (self.Gui and self.Gui.Destroyed==true)
end

function Adapter:_config()
    if type(self.Ctx.ReadConfig)=="function" then
        local ok,cfg=pcall(self.Ctx.ReadConfig)
        if ok and type(cfg)=="table" then return cfg end
        return {}
    end
    return {AutoFake=self:_value("AE-MONSTER-AUTO-FAKE",false)==true,
        AutoHelicopter=self:_value("AE-MONSTER-AUTO-HELICOPTER",false)==true}
end

function Adapter:_read()
    local out=empty("native-context-unavailable")
    self.Refs={}
    if not self:_current() then out.Reason="native-owner-stopped" return out end
    local macro=self.Environment.__AnimeExpeditionsMacro
    out.Recording=self:_value("NUI-0506",false)==true or type(macro)=="table" and macro.Recording==true
    out.MacroActiveOperation=type(macro)=="table" and (tonumber(macro.ActiveOperations)or 0)>0
    out.DisableJoiners=self:_value("NUI-0069",false)==true
    local g=invoke(self.Nodes.GET_GAME_REPLICA)
    if not g or type(g.Data)~="table" then out.InLobby=true out.Reason="not-in-game" return out end
    local d,p=g.Data,g.Data.Parameters
    if type(p)~="table" then return out end
    out.Mode=p.Gamemode
    if p.Gamemode~="KaijuEvent" or p.MapName~="KaijuEvent" then out.Reason="not-monster-clash" return out end
    if not id(g.Id) or not finite(d.GameIncrement) or d.GameIncrement%1~=0 or d.GameIncrement<0 then
        out.Reason="native-run-identity-unconfirmed" return out
    end
    local player=self.Player
    local character=player and player.Character
    local mapId=character and character:GetAttribute("InMap")
    local playerReplica=invoke(self.Nodes.GET_GAME_PLAYER_REPLICA)
    if not id(mapId) or not playerReplica or type(playerReplica.Data)~="table"
        or not sameId(playerReplica.Data.GameID,g.Id) then out.Reason="native-player-membership-unconfirmed" return out end
    local mapReplica=invoke(self.Nodes.GET_MAP_REPLICA,mapId)
    local md=mapReplica and mapReplica.Data
    if type(md)~="table" or not sameId(md.MapID,mapId) or type(md.Parameters)~="table"
        or md.Parameters.Gamemode~=p.Gamemode or md.Parameters.MapName~=p.MapName
        or not md.Map or not md.Map:IsDescendantOf(self.Workspace) then
        out.Reason="native-map-membership-unconfirmed" return out
    end
    out.ScopeKey=tostring(player.UserId)..":"..tostring(self.Game.PlaceId)..":"..tostring(self.Game.JobId)
    out.GameKey=tostring(g.Id)
    out.RunKey=out.GameKey..":"..tostring(d.GameIncrement)
    out.MapKey=tostring(md.MapID)
    out.InGame=true
    -- Positive battle proof clears a stale prior-result hold even when the
    -- native counter advanced before its old terminal display was cleared.
    out.ActiveBattle=d.Active==true and d.CurrentGameState=="InProgress"
    out.Host=d.Host==player
    out.Victory=d.CurrentGameState=="Win" or d.CurrentGameState=="Victory"
    out.Reason="observing-native-monster-clash"
    local ok,test=pcall(self.ReplicaClient.Test)
    local tokens=ok and type(test)=="table" and test.TokenReplicas
    if type(tokens)~="table" then out.Reason="native-replica-index-unavailable" return out end
    local refs={Game=g,Map=mapReplica}
    self.Refs=refs
    self:_incoming(out,d)
    local envy=type(d.KaijuHUD)=="table" and d.KaijuHUD.Envy
    if type(envy)=="table" and finite(envy.StartedAt) then
        local fake={Id=out.RunKey..":Envy:"..tostring(envy.StartedAt),Ready=false,Acknowledged=envy.Status=="Found",
            Terminal=envy.Status=="Found" or envy.Status=="Escaped",Reason="envy-not-hidden"}
        out.Fake=fake
        if envy.Status=="Found" then fake.Reason="native-envy-found"
        elseif envy.Status=="Escaped" then fake.Reason="native-envy-escaped"
        elseif envy.Status=="Hidden" then
            if not finite(d.SessionTime) or not finite(envy.EndsAt) or envy.EndsAt<envy.StartedAt then
                fake.Reason="envy-native-clock-unconfirmed"
            elseif d.SessionTime>=envy.EndsAt then fake.Terminal=true fake.Reason="envy-window-expired"
            elseif d.Active~=true or d.CurrentGameState~="InProgress" then fake.Reason="envy-game-not-active"
            else
                local count,found=0,nil
                for r in pairs(tokens.GameUnit or {}) do
                    local ud=r.Data
                    if type(ud)=="table" and type(ud.Attributes)=="table" and ud.Attributes.EnvyMimic
                        and r.Parent==g and sameId(ud.GameID,g.Id) and sameId(ud.MapID,md.MapID) then
                        count+=1 found=r
                    end
                end
                if count==1 then refs.Fake=found fake.Ready=true fake.Reason="native-envy-mimic-confirmed"
                else fake.Reason=count==0 and "native-envy-mimic-not-replicated" or "native-envy-mimic-ambiguous" end
            end
        end
    end
    local candidates={}
    for r in pairs(tokens.RiftPortal or {}) do
        local rd=r.Data
        if type(rd)=="table" and rd.RiftName=="KaijuEventRift" then
            -- Scope before ambiguity: another game's helicopter must not block
            -- this game's single portal or create an unrelated transition hold.
