    local bossScope=tostring(LocalPlayer.UserId)..":"..tostring(game.PlaceId)..":"..tostring(game.JobId)
    local bossLedgers=Environment.__AnimeExpeditionsBossRushJoinLedgers
    local bossPending=bossLedgers and bossLedgers[bossScope] and bossLedgers[bossScope].Pending
    if value(FEATURE.BossRushAutoJoin,false)==true or bossRushAutoJoinRuntime or bossPending then
        local bossBlocked,bossStatus=getBossRushAutoJoinRuntime():Observe()
        self.FeatureStates[FEATURE.BossRushAutoJoin]=bossStatus
        if bossStatus.Status=="left-lobby-other-mode" then self.PendingSubmission=nil end
        if bossBlocked then
            self.Status="waiting-bossrush-join"
            self.LastReason=bossStatus.Reason
            self.NextAttemptAt=now+Config.PollSeconds
            return false,bossStatus.Reason
        end
    end
    self:ObserveBossResult()
    if self.PendingOperation then
        local _, currentBoss = bossData()
        if fingerprint(currentBoss) ~= self.PendingOperation.Before then
            self.Confirmations += 1 self.PendingOperation = nil
        end
    end
    if self.PendingSubmission and (currentSession.Matchmaking or currentSession.MatchmakingFound or not isInLobby()) then
        self.Confirmations += 1
        self.LastConfirmation = { Time = os.time(), Plan = self.PendingSubmission, State = isInLobby() and "matchmaking-active" or "left-lobby" }
        self.PendingSubmission = nil
    end
    if value(FEATURE.Disable, false) then self:CancelOwnedMatchmaking() end
    if not currentSession.Matchmaking and not currentSession.MatchmakingFound then
        self.OwnsMatchmaking = false
    end

    if not self:RefreshLobbyState(now) then
        self.Status = "not-in-lobby"
        self.NextAttemptAt = now + Config.PollSeconds
        return false, "not in lobby"
    end

    local lobbyCooldown = math.max(0, tonumber(value(FEATURE.Cooldown, 0)) or 0)
    if not force and now - self.LobbySince < lobbyCooldown then
        self.Status = "cooldown"
        self.NextAttemptAt = self.LobbySince + lobbyCooldown
        return false, "joiner cooldown"
    end

    self.Busy = true
    self.Attempts += 1
    local plan, reason = self:Evaluate()
    self.LastPlan = plan
    if not plan then
        self.Busy = false
        self.Status = "idle"
        self.LastReason = reason
        self.NextAttemptAt = os.clock() + Config.PollSeconds
        return false, reason
    end

    if Config.DryRun then
        self.Busy = false
        self.Status = "dry-run"
        self.NextAttemptAt = os.clock() + Config.SubmissionCooldownSeconds
