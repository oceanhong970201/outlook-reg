function Controller:IsLoopAlive()
    return self.Running and self.LoopAlive and self.Worker ~= nil
end

function Controller:Wake()
    self.NextAttemptAt = 0

    if not self:IsLoopAlive() and Config.Enabled and Config.LoopEnabled then
        return self:StartLoop()
    end

    return true, "scheduled immediately"
end

function Controller:StartLoop()
    if self.ActiveOperations > 0 then return false, "previous operation is still stopping" end
    if self:IsLoopAlive() then
        return false, "already running"
    end

    if not Config.Enabled or not Config.LoopEnabled then
        self.Running = false
        self.LoopAlive = false
        self.Status = "disabled"
        return false, "disabled"
    end

    self.Running = true
    self.Stopping = false
    self.LoopGeneration += 1
    local generation = self.LoopGeneration
    self.LoopAlive = true
    if self.NextAttemptAt > os.time() then
        if getServerProgress().IsVictory then
            self.Status, self.RetryStatus = "waiting-reset", "already-won"
        else
            self.Status = "scheduled"
        end
    else
        self.Status = "loop-starting"
    end

    self.Worker = task.spawn(function()
        while self.Running and self.LoopGeneration == generation do
            local now = os.time()

            if now >= self.NextAttemptAt and not self.Busy then
                self.LoopIterations += 1
                self.LastLoopAt = now

                local ok, runOk, runResult = xpcall(function()
                    return self:RunOnce(false)
                end, debug.traceback)

                if not self.Running or self.LoopGeneration ~= generation then break end
                if ok then
                    self.LastLoopResult = {
                        Success = runOk,
                        Result = runResult,
                    }
                else
                    self.Busy = false
                    self.Status = "loop-error"
                    self.LastError = tostring(runOk)
                    self.LastLoopResult = {
                        Success = false,
                        Result = self.LastError,
                    }
