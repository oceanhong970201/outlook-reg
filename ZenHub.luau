            self.LoopAlive = false
            self.Worker = nil
        end
    end)

    pushLog("info", "automatic loop started", EventId)
    return true, generation
end

function Controller:Stop(reason)
    self.Running = false
    self.Stopping = true
    self.OperationGeneration += 1
    if self.ActiveOperations == 0 then self.Busy = false end
    self.LoopAlive = false
    self.LoopGeneration += 1
    self.Status = "stopped"
    self.StopReason = reason or "manual"
    pushLog("info", "automation stopped", self.StopReason)
    return true
