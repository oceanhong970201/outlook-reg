    if isLegacyDefault then
        table.sort(configured, function(a, b)
            local aScore = priorityScore(a)
            local bScore = priorityScore(b)
            if aScore and bScore and aScore ~= bScore then return aScore > bScore end
            if aScore ~= nil and bScore == nil then return true end
            if aScore == nil and bScore ~= nil then return false end
            return tostring(a) < tostring(b)
        end)
        state.Values[FEATURE.Priority] = configured
        local gui = Environment.__AnimeExpeditionsGuiController
        if type(gui) == "table" and type(gui.SetValue) == "function" then
            pcall(function() gui:SetValue(FEATURE.Priority, configured) end)
        end
    end
    state.Values.__JoinerPriorityVersion = 1
end

local function priorityOrder()
    local configured = value(FEATURE.Priority, DEFAULT_PRIORITY)
    local result = {}
    for _, label in ipairs(type(configured) == "table" and configured or {}) do
        local name = cleanPriorityName(label)
        if name ~= "" and not table.find(result, name) then table.insert(result, name) end
    end
    for _, name in ipairs(DEFAULT_PRIORITY) do
        if not table.find(result, name) then table.insert(result, name) end
    end
    return result
end

local function resolveMapName(gamemode, displayName)
    if type(displayName) ~= "string" or displayName == "" then return nil end
    for _, mapName in ipairs(Information.Maps:GetOrderedMaps(gamemode) or {}) do
        if mapName == displayName or Information.Maps:GetMapDisplayName(mapName) == displayName then
            return mapName
        end
    end
    return nil
end

local function sanitizeQueueData(queueData)
    local ok, sanitized = pcall(function()
        return Information.Maps:SanitizeQueueData(queueData)
    end)
    if not ok then return nil, "queue sanitization failed: " .. tostring(sanitized) end
    if type(sanitized) ~= "table" then return nil, "queue sanitization returned no payload" end
    return sanitized
end

local function buildStoryQueue()
    local selectedMap = value(FEATURE.StoryMap, "School Grounds")
    local mapName = resolveMapName("Story", selectedMap)
    if not mapName then return nil, "story map was not resolved" end
    local selectedAct = value(FEATURE.StoryAct, "Act 1")
    local gamemode = "Story"
    if selectedAct == "Infinite" or selectedAct == "Mastery" then gamemode = selectedAct end
    local actName = gamemode == "Story" and selectedAct or "Act 1"
    return sanitizeQueueData({
        Gamemode = gamemode,
        MapName = mapName,
        ActName = actName,
        Difficulty = value(FEATURE.StoryDifficulty, "Normal"),
    })
end

local BossRushAutoJoinModule = (function()
-- Boss Rush lobby-to-match join only. No unit, Macro, card, gate or matchmaking
-- operations. All native calls are supplied by the existing Joiner controller.
local Module = {}
local Join = {}
Join.__index = Join
local MODE_FIELDS = { Config=true, RequiredLevel=true, MaxPlayers=true, MapLocked=true,
    ClientCanCreateQueue=true, MatchmakingEnabled=true, NextAllowed=true, QueueDurationBeforeDestroy=true }
local MAP_FIELDS = { MapType=true, PreviewInfo=true, ProgressionIndex=true, EnemyTypes=true,
    Difficulties=true, AssetBuffs=true, Waves=true }
local QUEUE_FIELDS = { Gamemode=true, MapName=true, ActName=true, Difficulty=true }
local CONFIG_FIELDS = { MapName=true, ActName=true, Difficulty=true }
local function whole(value, minimum, maximum)
    return type(value)=="number" and value==value and value%1==0 and value>=minimum and value<=maximum
end
local function nonempty(value) return type(value)=="string" and value~="" end
local function knownFields(data, allowed)
    if type(data)~="table" then return false,"missing native table" end
    for key in pairs(data) do if not allowed[key] then return false,"unverified native field: "..tostring(key) end end
    return true
end
local function sameQueue(a,b)
    if type(a)~="table" or type(b)~="table" then return false end
    for key in pairs(QUEUE_FIELDS) do if a[key]~=b[key] then return false end end
    for key in pairs(a) do if not QUEUE_FIELDS[key] then return false end end
    return true
end
function Module.new(context)
    assert(type(context)=="table" and type(context.Read)=="function" and type(context.Ledger)=="table","BossRush join context required")
    return setmetatable({ Ctx=context, Ledger=context.Ledger, Status="idle", Reason=nil },Join)
end
function Join:_status(status,reason)
    self.Status,self.Reason=status,reason
    return { Status=status,Reason=reason,Pending=self.Ledger.Pending~=nil,
        NativeStage=self.Ledger.Pending and self.Ledger.Pending.Stage or nil }
end
function Join:Build()
    local s=self.Ctx.Read()
    if s.InGame~=false then return nil,"Boss Rush requires a confirmed lobby state" end
    if s.SessionReady~=true then return nil,"native session state is not ready" end
    if s.Matchmaking or s.MatchmakingFound then return nil,"another matchmaking request is active" end
    if s.PartyKnown~=true then return nil,"native Party replica getter unavailable" end
    local mode=s.Mode
    local known,reason=knownFields(mode,MODE_FIELDS)
    if not known then return nil,"Boss Rush mode schema: "..reason end
    if mode.ClientCanCreateQueue~=true or mode.MapLocked~=true then return nil,"native Boss Rush queue capability changed" end
    if not whole(mode.RequiredLevel,0,100000) or not whole(s.Level,0,1000000) or s.Level<mode.RequiredLevel then
        return nil,"Boss Rush level requirement is missing or not met"
    end
    if not whole(mode.MaxPlayers,1,4) then return nil,"Boss Rush player limit is unverified" end
    local config=mode.Config
    known,reason=knownFields(config,CONFIG_FIELDS)
    if not known then return nil,"Boss Rush native Config: "..reason end
    if not nonempty(config.MapName) or not nonempty(config.ActName) or not nonempty(config.Difficulty) then return nil,"native Boss Rush entry parameters are incomplete" end
    local maps=self.Ctx.GetMaps()
    if type(maps)~="table" then return nil,"Boss Rush native map registry unavailable" end
    local mapCount=0 for _ in pairs(maps) do mapCount+=1 end
    if mapCount~=1 or maps[1]~=config.MapName then return nil,"Boss Rush native map selection is missing or ambiguous; no implicit first-map choice" end
    local map=self.Ctx.GetMapDefinition(config.MapName)
    known,reason=knownFields(map,MAP_FIELDS)
    if not known then return nil,"Boss Rush map schema: "..reason end
    if map.MapType~="BossRush" or type(map.Difficulties)~="table" or not table.find(map.Difficulties,config.Difficulty) then
        return nil,"Boss Rush map type or difficulty is unverified"
    end
    if s.Party then
        local p=s.Party.Data
        if type(p)~="table" or p.Type~="Party" or p.Leader~=s.Player then return nil,"local player is not the confirmed native party leader" end
        if type(p.Players)~="table" or not table.find(p.Players,s.Player) or #p.Players>mode.MaxPlayers then return nil,"native party membership/player limit invalid" end
        if p.StartDisabled==true or p.StartDisabled~=nil and type(p.StartDisabled)~="boolean" then return nil,"native party start is disabled or unknown" end
    end
    local queue={Gamemode="BossRush",MapName=config.MapName,ActName=config.ActName,Difficulty=config.Difficulty}
    local sanitized,why=self.Ctx.Sanitize(table.clone(queue))
    if not sameQueue(sanitized,queue) then return nil,"Boss Rush sanitizer changed mode/map/act/difficulty or introduced unverified cost/fields: "..tostring(why or "") end
    local set,start=self.Ctx.Actions()
    if type(set)~="function" or type(start)~="function" then return nil,"registered PartySetQueueData/PartyStartGame actor unavailable" end
    return queue
end
function Join:Observe()
    local s=self.Ctx.Read()
    local p=self.Ledger.Pending
    if s.InGame==true then
        self.Ledger.SeenInGame=true
        if p and type(s.GameParameters)=="table" and nonempty(s.GameParameters.Gamemode) then
            local expected=s.GameParameters.Gamemode=="BossRush" and s.GameParameters.MapName==p.Queue.MapName
            self.Ledger.Pending=nil
            return false,self:_status(expected and "confirmed-boss-rush" or "left-lobby-other-mode",expected and "native BossRush game parameters observed" or "entry was not confirmed as the requested BossRush map")
        end
    elseif s.InGame==false and self.Ledger.SeenInGame then
        self.Ledger.SeenInGame=false self.Ledger.Pending=nil
        return false,self:_status("lobby-ready","returned from a confirmed game context")
    end
    if p and not p.Started and (p.Owner~=self.Ctx.Owner or p.OperationFinished) and s.InGame==false and s.PartyKnown then
        if s.Party and sameQueue(s.Party.Data and s.Party.Data.QueueData,p.Queue) or not s.Party and p.SetReturned then
            self.Ledger.Pending=nil
            return false,self:_status("selection-only-recovered","old owner stopped before native StartGame; queue selection was observed")
        end
    end
    if self.Ledger.Pending then return true,self:_status("waiting-native-join","one BossRush request is unresolved; no other Joiner may replace its selector") end
    return false,self:_status("idle",nil)
end
function Join:Submit(plan,generation)
    if self.Ledger.Pending then error("Boss Rush native join is already pending; observe instead of resubmitting",0) end
    self.Ctx.AssertCurrentPlan(plan,generation)
    local queue,reason=self:Build()
    if not queue or not sameQueue(queue,plan.QueueData) then error(reason or "Boss Rush plan changed",0) end
    local set,start=self.Ctx.Actions()
    local pending={Queue=table.clone(queue),Owner=self.Ctx.Owner,Stage="selecting",Started=false,SetInvoked=false,SetReturned=false}
    self.Ledger.Pending=pending -- reservation before native selection can yield
    local function validate()
        self.Ctx.AssertCurrentPlan(plan,generation)
        local latest,why=self:Build()
        if not latest or not sameQueue(latest,queue) then error(why or "Boss Rush queue changed before native start",0) end
        local nextSet,nextStart=self.Ctx.Actions()
        if nextSet~=set or nextStart~=start then error("Boss Rush native actors changed",0) end
    end
    local ok,failure=pcall(function()
        validate()
        pending.SetInvoked=true
        set(table.clone(queue))
        pending.SetReturned=true pending.Stage="waiting-queue-ack"
        local deadline=self.Ctx.Clock()+self.Ctx.AckTimeout
        repeat
            validate()
            local s=self.Ctx.Read()
            if s.PartyKnown and (not s.Party or sameQueue(s.Party.Data and s.Party.Data.QueueData,queue)) then break end
            if self.Ctx.Clock()>=deadline then error("Boss Rush PartyData.QueueData was not acknowledged; StartGame blocked",0) end
            self.Ctx.Sleep(0.1)
        until false
        self.Ctx.Sleep(self.Ctx.SettleSeconds)
        validate()
        local s=self.Ctx.Read()
        if not s.PartyKnown or s.Party and not sameQueue(s.Party.Data and s.Party.Data.QueueData,queue) then error("native party selector changed before BossRush StartGame",0) end
        pending.Started=true pending.Stage="start-sent-unknown"
        start(table.clone(queue))
    end)
    pending.OperationFinished=true
    if not ok then
        pending.Error=tostring(failure)
        if not pending.SetInvoked then self.Ledger.Pending=nil end
        self:_status("waiting-native-join",pending.Error)
        error(failure,0)
    end
    self:_status("submitted","waiting for native BossRush game parameters, not merely action return")
    return "bossrush-solo-submitted"
end
return Module

end)()
