function Controller:SaveState()
    if not alive() then return updateSaveStatus(false, "GUI is not active") end
    return updateSaveStatus(saveStateNow())
end

local function scheduleSave()
    if PREVIEW_ONLY then return end
    Controller.SaveGeneration += 1
    local generation = Controller.SaveGeneration
    task.delay(0.4, function()
        if alive() and generation == Controller.SaveGeneration then updateSaveStatus(saveStateNow()) end
    end)
end

local function cloneArray(values)
    local result = {}
    for index, value in ipairs(type(values) == "table" and values or {}) do result[index] = value end
    return result
end

local function selectionArray(values, allowedValues)
    local result = {}
    local allowed = {}
    for _, value in ipairs(allowedValues) do allowed[value] = true end
    if type(values) == "table" then
        if #values > 0 then
            for _, value in ipairs(values) do
                if allowed[value] then table.insert(result, value) end
            end
        else
            for _, value in ipairs(allowedValues) do
                if values[value] == true then table.insert(result, value) end
            end
        end
    end
    return result
end

local function normalizedPriorityOrder(values, allowedValues)
    local result, seen = {}, {}
    for _, value in ipairs(selectionArray(values, allowedValues)) do
        if not seen[value] then
            seen[value] = true
            table.insert(result, value)
        end
    end
    for _, value in ipairs(allowedValues) do
        if not seen[value] then
            seen[value] = true
            table.insert(result, value)
        end
    end
    return result
end

local function dispatch(control, value)
    if Controller.ApplyingSettings then return end
    if control.key == "NUI-0054" and Controller.UpdatingTrainingUnits then return end
    if control.key == "NUI-0054" then Controller.TrainingDropdownSignature = nil end
    if control.type == "dropdown" and control.multi then
        value = selectionArray(value, control.options)
        if control.key == "NUI-0054" and Controller.TrainingOptionIds then
            local canonical = {}
            for _, label in ipairs(value) do
                local id = Controller.TrainingOptionIds[label]
                if id then canonical[id] = true end
            end
            value = canonical
        end
    elseif control.type == "priority-list" then
        value = normalizedPriorityOrder(value, control.options)
    end
    if control.transient then
        Controller.TransientValues = Controller.TransientValues or {}
        Controller.TransientValues[control.key] = value
    elseif control.sensitive then
        Secrets[control.key] = value
        if control.key == WEBHOOK_URL_KEY or control.key == WEBHOOK_MENTION_KEY then saveWebhookSecretNow() end
    else
        State.Values[control.key] = value
        State.ChangedAt = os.time()
        scheduleSave()
    end
    if PREVIEW_ONLY then return end
    local function invoke(callback)
        if type(callback) == "function" then
            task.spawn(function()
                if not alive() then return end
                local ok, failure = pcall(callback, value, control, Controller)
                if not ok then warn("[Anime Expeditions GUI]", control.key, failure) end
            end)
        end
    end
    local handlers = Environment.AnimeExpeditionsFeatureHandlers
    invoke(type(handlers) == "table" and handlers[control.key] or nil)
    invoke(Controller.Bindings[control.key])
end

function Controller:Bind(key, callback, applyNow)
    if PREVIEW_ONLY then return false, "UI preview does not bind gameplay handlers" end
    assert(type(key) == "string" and type(callback) == "function", "Bind expects key and callback")
    self.Bindings[key] = callback
    if applyNow ~= false and State.Values[key] ~= nil then
        task.spawn(function()
            if not alive() or self.Bindings[key] ~= callback then return end
            local ok, failure = pcall(callback, State.Values[key], self.ControlSpecs[key], self)
            if not ok then warn("[Anime Expeditions GUI]", key, failure) end
        end)
    end
    return callback
end

function Controller:GetValue(key)
    if self.ControlSpecs[key] and self.ControlSpecs[key].transient then return self.TransientValues and self.TransientValues[key] end
    if SensitiveKeys[key] then return Secrets[key] end
    return State.Values[key]
end

function Controller:SetValue(key, value)
    local control = self.Controls[key]
    if control and type(control.SetValue) == "function" then
        control:SetValue(value)
    else
        if SensitiveKeys[key] then
            Secrets[key] = value
            if key == WEBHOOK_URL_KEY or key == WEBHOOK_MENTION_KEY then saveWebhookSecretNow() end
        else
            State.Values[key] = value
            scheduleSave()
        end
    end
end

-- SETTINGS_TRANSACTION_BEGIN
-- Atomic config application: validate/stage controls without dispatch, persist,
-- then swap all values together and notify handlers. No Macro files are touched.
function Controller:ApplySettingsTransaction(changes,expectedBefore,account,phase)
    local function copy(value)
        if type(value)~="table"then return value end
        local out={}for key,child in pairs(value)do out[key]=copy(child)end return out
    end
    local function equal(a,b)
        if type(a)~=type(b)then return false end;if type(a)~="table"then return a==b end
        for key,value in pairs(a)do if not equal(value,b[key])then return false end end
        for key in pairs(b)do if a[key]==nil then return false end end return true
    end
    if PREVIEW_ONLY or not alive()or not accountOwnsState()or account~=CONFIG_USER_ID or self.ApplyingSettings then return false,"Settings owner changed"end
    local macro=Environment.__AnimeExpeditionsMacro
    if macro and macro.Recording or State.Values["NUI-0506"]==true then return false,"Recording is active"end
    local oldValues=State.Values
    local nextValues=copy(oldValues)
    local function savedValues(values)
        local saved={}
        for key,value in pairs(values)do
            local spec=self.ControlSpecs[key]
            if not SensitiveKeys[key]and not(spec and spec.transient)then saved[key]=copy(value)end
        end
        return saved
    end
    for _,change in ipairs(changes)do
        local spec=self.ControlSpecs[change.Key]
        if not spec or spec.sensitive or spec.transient or spec.portable==false or SensitiveKeys[change.Key]
            or not equal(oldValues[change.Key],change.Before)or not equal(oldValues[change.Key],expectedBefore[change.Key])then return false,"Settings changed after preview"end
        nextValues[change.Key]=change.Unset and nil or copy(change.Value)
    end
    local staged={}
    local function show(change,value)
        local control=self.Controls[change.Key]
        local spec=self.ControlSpecs[change.Key]
        if not control or type(control.SetValue)~="function"then error("Setting control unavailable: "..change.Key)end
        if spec.type=="dropdown"and spec.dynamicOptions and type(value)=="string"and type(control.SetValues)=="function"
            and not table.find(spec.options or{},value)then
            local options=copy(spec.options or{})options[#options+1]=value control:SetValues(options)
        end
        control:SetValue(copy(value))
    end
    self.ApplyingSettings=true
    local ok,err=pcall(function()
        for _,change in ipairs(changes)do staged[#staged+1]=change;show(change,nextValues[change.Key])end
        if not accountOwnsState()or not alive()then error("Settings owner changed")end
        local saved,why=writeAccountRecord(CONFIG_PATH,{Values=savedValues(nextValues),Version=State.Version,UserId=CONFIG_USER_ID},validSettings)
        if not saved then error(why or "Settings save failed")end
        if not accountOwnsState()or not alive()then
            local restored,accepted=pcall(writeAccountRecord,CONFIG_PATH,{Values=savedValues(oldValues),Version=State.Version,UserId=CONFIG_USER_ID},validSettings)
            self.SettingsSaveUncertain=not restored or accepted~=true
            error("Settings owner changed before commit")
        end
    end)
    if not ok then
        for i=#staged,1,-1 do pcall(show,staged[i],oldValues[staged[i].Key])end
        self.ApplyingSettings=false
        return false,"Settings could not be saved; previous values retained"
    end
    State.Values=nextValues State.ChangedAt=os.time()
    self.ApplyingSettings=false
    if phase~="rollback"then
        for _,change in ipairs(changes)do
            local spec=self.ControlSpecs[change.Key]
            local handlers=Environment.AnimeExpeditionsFeatureHandlers
            local sent={}
            for _,callback in pairs({type(handlers)=="table"and handlers[change.Key]or false,self.Bindings[change.Key]or false})do
                if type(callback)=="function"and not sent[callback]then
                    sent[callback]=true
                    task.spawn(function()
                        if not alive()or not accountOwnsState()then return end
                        local worked=pcall(callback,State.Values[change.Key],spec,self)
                        if not worked then warn("[Zen Hub Settings] A setting handler could not refresh: "..change.Key)end
                    end)
                end
            end
        end
    end
    return true
end

-- SETTINGS_TRANSACTION_END

-- Training stores canonical unit IDs while Obsidian selects full display labels.
-- Programmatic refresh must not queue stale OnChanged callbacks over a bulk edit.
function Controller:UpdateTrainingUnits(options, labelToId, selectedIds)
    local spec, control = self.ControlSpecs["NUI-0054"], self.Controls["NUI-0054"]
    if not spec or not control or type(control.SetValues) ~= "function" or type(control.SetValue) ~= "function" then return false end
    local ids, selectedLabels, accepted = {}, {}, {}
    for _, label in ipairs(options) do
        local id = labelToId[label]
        if id and selectedIds[id] then selectedLabels[label] = true accepted[id] = true end
    end
    for id in pairs(accepted) do table.insert(ids, id) end
    table.sort(ids)
    local signature = table.concat(options, "\0") .. "\1" .. table.concat(ids, "\0")
    local oldOptions, oldMap = spec.options, self.TrainingOptionIds
    local oldValue = State.Values["NUI-0054"]
    self.TrainingOptionIds = labelToId
    spec.options = cloneArray(options)
    if self.TrainingDropdownSignature == signature then State.Values["NUI-0054"] = accepted return true end
    self.UpdatingTrainingUnits = true
    local ok, failure = pcall(function()
        control:SetValues(options)
        control:SetValue(selectedLabels)
    end)
    if not ok then
        self.TrainingOptionIds, spec.options = oldMap, oldOptions
        pcall(function()
            local oldLabels = {}
            for _, label in ipairs(oldOptions) do
                local id = oldMap and oldMap[label] or label:match("^([^\r\n]+)")
                if type(oldValue) == "table" and (oldValue[id] == true or oldValue[label] == true or table.find(oldValue, id) or table.find(oldValue, label)) then oldLabels[label] = true end
            end
            control:SetValues(oldOptions)
            control:SetValue(oldLabels)
        end)
        self.UpdatingTrainingUnits = false
        self.TrainingDropdownError = tostring(failure)
        return false
    end
    self.UpdatingTrainingUnits = false
    State.Values["NUI-0054"] = accepted
    self.TrainingDropdownError = nil
    self.TrainingDropdownSignature = signature
    State.ChangedAt = os.time()
    scheduleSave()
    return true
end

local function stopOwnedPresentation()
    for _, view in pairs(Controller.PriorityEditors or {}) do
        if type(view.Destroy) == "function" then pcall(function() view:Destroy() end) end
    end
    Controller.PriorityEditors = {}
    if Controller.SoftFocus then pcall(function() Controller.SoftFocus:Destroy() end) end
end

function Controller:Destroy(reason)
    if not self.Alive then return end
    self.Alive = false
    self.DestroyReason = reason or "manual"
    stopOwnedPresentation()
    for _, field in ipairs({ "MonsterClash", "Settings", "StreamerMode", "PutOut", "DmcaSearch", "TidalSiege", "AutoRejoin", "LostShipment", "Utilities", "Lobby", "Expedition" }) do
        local runtime = self[field]
        self[field] = nil
        if type(runtime) == "table" and type(runtime.Stop) == "function" then pcall(function() runtime:Stop(self.DestroyReason) end) end
    end
    stopOwnedMacro(self.DestroyReason)
    stopOwnedGameWebhook(self.DestroyReason)
    stopOwnedJoiner(self.DestroyReason)
    saveStateNow()
    if self.Library and type(self.Library.Unload) == "function" then
        pcall(function() self.Library:Unload() end)
    end
    if Environment.__AnimeExpeditionsGuiController == self then
        Environment.__AnimeExpeditionsGuiController = nil
    end
    if PREVIEW_ONLY and RootEnvironment.__AnimeExpeditionsPreviewController == self then
        RootEnvironment.__AnimeExpeditionsPreviewController = nil
    end
end

