    for number = 6, 68 do if number ~= 37 and number ~= 58 then table.insert(featureIds, string.format("NUI-%04d", number)) end end
    for _, id in ipairs(featureIds) do
            self:Mark(id, "configured", "Bound to lobby worker; no automation enabled by binding")
            local previous = handlers[id]
            local installed = function(current)
                if Environment[KEY] ~= self then return end
                if type(previous) == "function" then pcall(previous, current) end
                if current ~= nil and id ~= "NUI-0006" and id ~= "NUI-0054" and id ~= "NUI-0055" and id ~= "NUI-0056" and id ~= "AE-TRAINING-IGNORE-FULL" then values()[id] = current end
