  -- A known actor's landing/entry/rejection timeout remains terminal.
  local appearanceOnly=not h.PortalId and(h.Reason=="appearance-wait-expired"or h.Reason=="incoming-helicopter-unresolved-timeout")
  if appearanceOnly and(hasPortal or h.Reason=="appearance-wait-expired"and incomingPending)then h.Done=nil;h.Reason=nil;h.NeedsAttention=nil
  elseif h.ProofObserved then return self:_attention(h,h.Reason)
