function Controller:NavigateToFishingWater(character, humanoid, root)
    if self:PauseNewFishingForConch() then return false end
    local existing = self.FishingNavigation
    if existing then
        if existing.Character ~= character or existing.Humanoid ~= humanoid or existing.Root ~= root then self:CancelFishingNavigation("character-replaced")
        elseif Config.DryRun then self:CancelFishingNavigation("dry-run")
        else return self:StepFishingNavigation(existing) end
    end
    if os.clock() < (self.NextFishingNavigationAt or 0) then
        self:Mark("NUI-0015", "waiting-path", "Navigation retry backoff")
        return false
    end
    local tagged = game:GetService("CollectionService"):GetTagged("Water")
    local waterParts = {}
    for _, part in ipairs(tagged) do
        if part:IsA("BasePart") and part:IsDescendantOf(workspace) then table.insert(waterParts, part) end
    end
    self.NextFishingNavigationAt = os.clock() + Config.FishingNavigationRetrySeconds
    if #waterParts == 0 then
        self:Mark("NUI-0015", "waiting-water", "No native tagged Water volume is currently loaded")
        return false
    end
    local exclusions = { character }
    for _, part in ipairs(waterParts) do table.insert(exclusions, part) end
    local raycast = RaycastParams.new()
    raycast.FilterType, raycast.FilterDescendantsInstances, raycast.IgnoreWater = Enum.RaycastFilterType.Exclude, exclusions, true
    local candidates = {}
    for _, water in ipairs(waterParts) do
        local relative, half = water.CFrame:PointToObjectSpace(root.Position), water.Size * 0.5
        local x, z = math.clamp(relative.X, -half.X, half.X), math.clamp(relative.Z, -half.Z, half.Z)
        -- Four oriented perimeter approaches allow native pathfinding to pick another bank
        -- when the closest side is obstructed. The six-stud offset is within ItemUtils' 20-stud range.
        for _, point in ipairs({ Vector3.new(-half.X - 6, half.Y, z), Vector3.new(half.X + 6, half.Y, z), Vector3.new(x, half.Y, -half.Z - 6), Vector3.new(x, half.Y, half.Z + 6) }) do
            local bank = water.CFrame:PointToWorldSpace(point)
            local hit = workspace:Raycast(bank + Vector3.new(0, 32, 0), Vector3.new(0, -96, 0), raycast)
            if hit and hit.Normal.Y >= 0.6 and hit.Instance and hit.Instance.CanCollide ~= false and not hit.Instance:HasTag("Water") then
                local height = Config.FishingNavigationMode == "Walk" and 2 or (humanoid.HipHeight + root.Size.Y * 0.5 + 0.1)
                local goal = hit.Position + Vector3.new(0, height, 0)
                -- Reject surfaces too far above/below the actual water surface to satisfy native proximity.
                if math.abs(goal.Y - bank.Y) <= 16 then table.insert(candidates, { Water = water, Goal = goal, Distance = (goal - root.Position).Magnitude }) end
            end
        end
    end
    if Config.FishingNavigationMode == "Teleport" then
        return self:TeleportToFishingWater(character, humanoid, root, candidates)
    end
    table.sort(candidates, function(a, b) return a.Distance < b.Distance end)
    if #candidates == 0 then self:Mark("NUI-0015", "waiting-path", "No walkable grounded shoreline for the loaded Water tags") return false end
    if Config.DryRun then
        self:Mark("NUI-0015", "dry-run", "Would pathfind to grounded tagged-Water shoreline at " .. tostring(candidates[1].Goal))
        return true
    end
    local generation = (self.FishingNavigationGeneration or 0) + 1
    self.FishingNavigationGeneration = generation
    for index = 1, math.min(#candidates, 8) do
        if not self:OwnsFishingNavigation(character, generation) then return false end
        local candidate = candidates[index]
        local nativePath = game:GetService("PathfindingService"):CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
        local navigation = { Character = character, Humanoid = humanoid, Root = root, Water = candidate.Water, Path = nativePath, Generation = generation, Index = 1, OwnsMovement = false }
        self.FishingNavigation = navigation
        local ok, failure = pcall(function() identity(function() nativePath:ComputeAsync(root.Position, candidate.Goal) end) end)
        -- ComputeAsync yields. Toggle-off, Stop, reload and respawn must win over late path results.
        if not self:OwnsFishingNavigation(character, generation) or self.FishingNavigation ~= navigation then
            if self.FishingNavigation == navigation then self:CancelFishingNavigation("path-computation-cancelled") else pcall(function() nativePath:Destroy() end) end
            return false
        end
        if ok and nativePath.Status == Enum.PathStatus.Success then
            navigation.Waypoints = nativePath:GetWaypoints()
            if #navigation.Waypoints > 0 then
                navigation.BlockedConnection = nativePath.Blocked:Connect(function(blockedIndex)
                    if self.FishingNavigation == navigation and blockedIndex >= navigation.Index then navigation.Blocked = true end
                end)
                return self:StepFishingNavigation(navigation)
            end
        elseif not ok then self.LastError = tostring(failure) end
        self.FishingNavigation = nil
        nativePath:Destroy()
    end
    self:Mark("NUI-0015", "waiting-path", "Native pathfinding found no reachable shoreline; no movement or cast issued")
    return false
end
function Controller:IsTidalConchHold()
