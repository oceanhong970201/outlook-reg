        state = {}
        Environment[stateKey] = state
    end
    if state.Pending then self.AntiAfkState = "in-flight" return false, "in-flight" end
    local now = os.clock()
    if type(state.NextAt) == "number" and now < state.NextAt then
        self.AntiAfkState = "throttled"
        return false, "throttled"
    end
    local pulse = { Owner = self, StartedAt = now }
    state.Pending, state.NextAt = pulse, now + 30
    self.AntiAfkState = "in-flight"
    local function eligible()
        return current() and values()["AE-ANTI-AFK"] ~= false
            and Environment[stateKey] == state and state.Pending == pulse
    end
