    if self.Issued or not self.Running or Config.Enabled == false or Environment[KEY] ~= self then return false end
    local action = nativeAction(actionName)
    if not action then self:Mark(id, "unavailable", "Native action not registered: " .. actionName) return false end
    local fingerprint = tostring(Config.DryRun) .. ":" .. signature(before)
    if self.Pending[key] == fingerprint then self:Mark(id, "waiting-replica", "No repeat until the observed input state changes: " .. actionName) return false end
    self.Pending[key] = fingerprint
    self.Issued = true
    local args = table.pack(...)
    local ok, result = pcall(function()
        if Config.DryRun then return "dry-run" end
        return identity(function() return action(table.unpack(args, 1, args.n)) end)
    end)
    self.ActionCount += 1
    local event = { Feature = id, Action = actionName, Args = args, Ok = ok, DryRun = Config.DryRun, Result = tostring(result) }
    table.insert(self.ActionLog, event)
    if #self.ActionLog > 100 then table.remove(self.ActionLog, 1) end
    self.LastAction = event
    if not ok then self.LastError = tostring(result) self:Mark(id, "error", tostring(result))
    elseif result == false then self:Mark(id, "rejected", "Native action returned false; no blind retry")
    else self:Mark(id, Config.DryRun and "dry-run" or "dispatched", "Awaiting replica confirmation: " .. actionName) end
    return ok and result ~= false
end
function Controller:NodeRequest(id, key, before, nodeName, ...)
    local node = rawget(Nodes, nodeName)
    -- ClientFishingHandler resolves this exact registered node through Nodes.__index.
    -- rawget alone reports nil even though FISH_EQUIP:Request() is available natively.
    if not node and nodeName == "FISH_EQUIP" then node = Nodes.FISH_EQUIP end
    if not node or type(node.Request) ~= "function" then self:Mark(id, "unavailable", "Native request node missing: " .. nodeName) return false end
    -- Private adapter is not installed in the game Actions table.
    local args = table.pack(...)
    if self.Issued or not self.Running or Config.Enabled == false then return false end
    local fingerprint = tostring(Config.DryRun) .. ":" .. signature(before)
    if self.Pending[key] == fingerprint then self:Mark(id, "waiting-replica", nodeName) return false end
    self.Pending[key] = fingerprint
    self.Issued = true
    local ok, result = pcall(function()
        if Config.DryRun then return "dry-run" end
        return identity(function() local request = node:Request(table.unpack(args, 1, args.n)) request:Timeout(10) return request:Wait() end)
    end)
    self.ActionCount += 1
    self.LastAction = { Feature = id, Action = nodeName, Args = args, Ok = ok, Result = tostring(result), DryRun = Config.DryRun }
    table.insert(self.ActionLog, self.LastAction)
    if #self.ActionLog > 100 then table.remove(self.ActionLog, 1) end
    self:Mark(id, ok and (Config.DryRun and "dry-run" or "dispatched") or "error", tostring(result))
    if not ok then self.LastError = tostring(result) end
    return ok and result ~= false
end

-- MONSTER_CLAIM_BEGIN
-- Four native mission tabs share three categories. Never claim Hunt or spend currency.
local MONSTER_CLAIM_ID = "AE-MONSTER-CLAIM"
local MONSTER_CLAIM_STATUS = "AE-MONSTER-CLAIM-STATUS"
local MONSTER_CATEGORIES = { "KaijuEvent", "KaijuEvent_Daily", "KaijuEvent_Weekly" }
local MONSTER_CATEGORY_SET = { KaijuEvent = true, KaijuEvent_Daily = true, KaijuEvent_Weekly = true }
local monsterPlayer = Players.LocalPlayer
local monsterGui = Environment.__AnimeExpeditionsGuiController
local monsterScope = tostring(monsterPlayer and monsterPlayer.UserId) .. ":" .. tostring(game.JobId)
Environment.__AnimeExpeditionsMonsterClaimLedgers = Environment.__AnimeExpeditionsMonsterClaimLedgers or {}
local monsterLedgers = Environment.__AnimeExpeditionsMonsterClaimLedgers
monsterLedgers[monsterScope] = monsterLedgers[monsterScope] or { Pending = {}, NextAt = 0, Submitted = 0, Observed = 0 }
local monsterLedger = monsterLedgers[monsterScope]
local function monsterCurrent()
    return Controller.Running and Config.Enabled ~= false and Environment[KEY] == Controller
        and Players.LocalPlayer == monsterPlayer and monsterPlayer ~= nil
        and tostring(monsterPlayer.UserId) .. ":" .. tostring(game.JobId) == monsterScope
        and Environment.__AnimeExpeditionsGuiController == monsterGui
        and (type(monsterGui) ~= "table" or monsterGui.Alive ~= false)
end
local function monsterEnabled()
    return value(MONSTER_CLAIM_ID, false) == true or value("NUI-0009", false) == true
end
local function monsterTime()
    local now = workspace:GetServerTimeNow()
    if type(now) == "number" and now == now and now >= 0 and now < math.huge then return now end
    return nil
end
local function monsterCycle(category, categoryData, categoryInfo, now)
    if type(categoryData) ~= "table" or type(categoryInfo) ~= "table" then return nil end
    local version = path(categoryData, "Version")
    if type(version) ~= "string" or version == "" then return nil end
    local reset = path(categoryData, "ResetKey")
    if category ~= "KaijuEvent" then
        local period = path(categoryInfo, "ResetTime")
        if type(period) ~= "number" or period <= 0 or period ~= period or period == math.huge or not now then return nil end
        if type(reset) ~= "number" or reset ~= reset or reset == math.huge or reset < now - now % period or reset > now then return nil end
    end
    return version .. ":" .. tostring(reset)
end
local function monsterQuest(category, quest, now)
    local categoryInfo = path(Dependencies.Quests, "Categories", category)
    local categoryData = path(Dependencies.QuestData, category)
    local info = path(Dependencies.Quests, "Quests", category, quest)
    local row = path(categoryData, "Quests", quest)
    if type(categoryInfo) ~= "table" or type(info) ~= "table" or type(row) ~= "table" then return nil end
    local cycle = monsterCycle(category, categoryData, categoryInfo, now)
    if not cycle then return nil end
    local eligible = path(categoryInfo, "ClaimAllowed") ~= false and path(info, "ClaimAllowed") ~= false
        and path(info, "Claimable") ~= false and path(info, "ServerControlled") ~= true
        and path(row, "Claimable") ~= false and path(row, "Completed") == true and path(row, "Claimed") ~= true
    for _, prior in pairs(path(info, "Prerequisites") or {}) do
        if path(categoryData, "Quests", peek(prior), "Claimed") ~= true then eligible = false end
    end
    return { Category = category, Quest = quest, Info = info, Data = row, Cycle = cycle, Eligible = eligible,
        Completed = path(row, "Completed"), Claimed = path(row, "Claimed"), Repeatable = path(info, "Repeatable") == true }
end
local function monsterReconcile(now)
    for key, pending in pairs(monsterLedger.Pending) do
        local current = monsterQuest(pending.Category, pending.Quest, now)
        if current and (current.Cycle ~= pending.Cycle or current.Claimed == true or current.Completed == false) then
            monsterLedger.Pending[key] = nil
            -- Count only a same-cycle claimed/reset observation, not rewards inferred from a nil return.
            if current.Cycle == pending.Cycle and (current.Claimed == true or (pending.Repeatable and current.Completed == false)) then
                monsterLedger.Observed += 1
            end
        end
    end
end
local function monsterStatus(code, detail)
    Controller:Mark(MONSTER_CLAIM_ID, code, detail)
    local pendingCount = 0
    for _ in pairs(monsterLedger.Pending) do pendingCount += 1 end
    local text = "Monster Clash Claims: " .. code .. "\nRepeatable / Event / Daily / Weekly"
        .. "\nSubmitted: " .. tostring(monsterLedger.Submitted) .. " • Claimed/reset observed: " .. tostring(monsterLedger.Observed)
        .. " • Pending: " .. tostring(pendingCount) .. "\n" .. detail
    local label = type(monsterGui) == "table" and monsterGui.Controls and monsterGui.Controls[MONSTER_CLAIM_STATUS]
    if label and type(label.SetText) == "function" and Controller.MonsterClaimLabel ~= text then
        pcall(label.SetText, label, text) Controller.MonsterClaimLabel = text
    end
end
function Controller:MonsterClaims()
    if not monsterCurrent() then return end
    local now = monsterTime()
    if not now then monsterStatus("waiting-data", "Native server time unavailable") return end
    monsterReconcile(now)
    if not monsterEnabled() then monsterStatus("disabled", "Enable this switch or Auto Claim Event Rewards") return end
    if path(Dependencies.EventData, "KaijuEvent", "Active") ~= true then monsterStatus("waiting-event", "Monster Clash is not active or its replica is unavailable") return end
    if self.Issued then monsterStatus("waiting-worker", "Another native operation owns this tick") return end
    if now < monsterLedger.NextAt then monsterStatus("cooldown", "Spacing claims; waiting for native state") return end
    local chosen, chosenKey
    for _, category in ipairs(MONSTER_CATEGORIES) do
        local quests = path(Dependencies.QuestData, category, "Quests")
        for _, quest in ipairs(sorted(quests)) do
            local row = monsterQuest(category, quest, now)
            local key = "quest:" .. category .. ":" .. quest
            -- Carry an unresolved pre-upgrade generic claim into the narrow journal.
            if row and self.Pending[key] ~= nil then
                local legacy = self.Pending[key]
                if type(legacy) == "string" and legacy:sub(1, 5) == "true:" then self.Pending[key] = nil
                elseif row.Claimed == true or row.Completed == false then self.Pending[key] = nil
                elseif not monsterLedger.Pending[key] then
                    monsterLedger.Pending[key] = { Category = category, Quest = quest, Cycle = row.Cycle, Repeatable = row.Repeatable, Migrated = true }
                    self.Pending[key] = nil
                end
            end
            if row and row.Eligible and not monsterLedger.Pending[key] then chosen, chosenKey = row, key break end
        end
        if chosen then break end
    end
    if not chosen then monsterStatus("waiting", "No completed unclaimed missions; unresolved requests are not resent") return end
    local action = nativeAction("ClaimQuest")
    if type(action) ~= "function" then monsterStatus("unavailable", "Native ClaimQuest action is not registered") return end
    if Config.DryRun then
        monsterLedger.NextAt = now + 1
        monsterStatus("dry-run", "Would claim " .. chosen.Category .. "/" .. chosen.Quest .. "; no request sent")
        return
    end
    local generation, invoked = self.LoopGeneration, false
    local ok, result = pcall(function()
        return identity(function()
            local freshNow = monsterTime()
            local fresh = freshNow and monsterQuest(chosen.Category, chosen.Quest, freshNow)
            if not monsterCurrent() or self.LoopGeneration ~= generation or not monsterEnabled() or Config.DryRun then return false end
            if self.Issued or path(Dependencies.EventData, "KaijuEvent", "Active") ~= true then return false end
            if not fresh or not fresh.Eligible or fresh.Cycle ~= chosen.Cycle or monsterLedger.Pending[chosenKey] then return false end
            if nativeAction("ClaimQuest") ~= action then return false end
            monsterLedger.Pending[chosenKey] = { Category = chosen.Category, Quest = chosen.Quest, Cycle = chosen.Cycle, Repeatable = chosen.Repeatable }
            monsterLedger.NextAt = freshNow + 1
            self.Issued, invoked = true, true
            monsterLedger.Submitted += 1
            return action(chosen.Category, chosen.Quest)
        end)
    end)
    if not invoked then
        if monsterCurrent() then monsterStatus(ok and "revoked" or "error", ok and "Claim conditions changed before submission" or tostring(result)) end
        return
    end
    self.ActionCount += 1
    local entry = { Feature = value(MONSTER_CLAIM_ID, false) == true and MONSTER_CLAIM_ID or "NUI-0009",
        Action = "ClaimQuest", Args = table.pack(chosen.Category, chosen.Quest), Ok = ok, DryRun = false, Result = tostring(result) }
    table.insert(self.ActionLog, entry)
    if #self.ActionLog > 100 then table.remove(self.ActionLog, 1) end
    self.LastAction = entry
    if not ok then self.LastError = tostring(result) end
    if monsterCurrent() then
        monsterStatus(ok and result ~= false and "submitted" or "outcome-unknown", "Waiting for native claimed/reset state; no blind retry")
    end
end
-- MONSTER_CLAIM_END

-- MountBattlepassMenu + Processors.Battlepass; reward states use string level keys.
function Controller:Claims()
    self:MonsterClaims()
    if self:Enabled("NUI-0007") then
        self:Mark("NUI-0007", "waiting", "No claimable loaded Battlepass")
        for season, raw in pairs(path(data(), "BattlepassData") or {}) do
            local pass, available = peek(raw), false
            if path(Dependencies.BattlepassData, season, "BattlepassInfo") then
                local level = tonumber(path(pass, "Level")) or 0
                for track, claims in pairs(path(pass, "Claimed") or {}) do
                    if track ~= "Premium" or path(pass, "Premium") == true then
                        for i = 1, level do if not path(claims, tostring(i)) then available = true break end end
                    end
                end
                if available then self:Dispatch("NUI-0007", "pass:" .. season, pass, "ClaimAllBattlepassRewards", season) end
            end
        end
    end
    local calendarEnabled = self:Enabled("NUI-0008")
    local eventEnabled = self:Enabled("NUI-0009")
    for calendar, raw in pairs(path(data(), "CalendarData") or {}) do
        local id = calendar == "DailyRewards" and "NUI-0008" or "NUI-0009"
        if (id == "NUI-0008" and calendarEnabled) or (id == "NUI-0009" and eventEnabled) then
            self:Mark(id, "waiting", "No available calendar reward")
            for day, claimed in pairs(path(raw, "Rewards") or {}) do
                if peek(claimed) == false and tonumber(day) then self:Dispatch(id, "calendar:" .. calendar .. ":" .. day, raw, "ClaimCalendarReward", calendar, tonumber(day)) end
            end
        end
    end
    if self:Enabled("NUI-0010") then
        self:Mark("NUI-0010", "waiting", "No claimable index entry")
        for _, category in pairs(path(data(), "Index") or {}) do
            for _, entry in pairs(peek(category) or {}) do
                if path(entry, "Claimed") == false then self:Dispatch("NUI-0010", "index", path(data(), "Index"), "IndexClaimAllRewards") end
            end
        end
    end
    if self:Enabled("NUI-0011") then
        local info, level = path(Information, "LevelMilestones"), tonumber(path(data(), "Level")) or 0
        local interval = tonumber(path(info, "MilestoneEvery"))
        local count = tonumber(path(info, "MaxMilestoneCount"))
        self:Mark("NUI-0011", "waiting", "No eligible level milestone")
        if interval and count and interval > 0 then
            for i = 1, count do
                local required = i * interval
                if level >= required and not path(data(), "LevelMilestones", "Claimed", "Level" .. required) then
                    self:Dispatch("NUI-0011", "level:" .. required, path(data(), "LevelMilestones"), "ClaimLevelMilestone", required)
                end
            end
        else self:Mark("NUI-0011", "unavailable", "Native LevelMilestones schema unavailable") end
    end
    local questEnabled, boardEnabled = self:Enabled("NUI-0012"), self:Enabled("NUI-0013")
    local eventCategories = {}
    for eventId in pairs(peek(Dependencies.EventData) or {}) do
        eventCategories[eventId] = true
        for _, category in pairs(path(Information, "Events", eventId, "QuestCategories") or {}) do eventCategories[tostring(peek(category))] = true end
    end
    for category, categoryData in pairs(peek(Dependencies.QuestData) or path(data(), "QuestData") or {}) do
        local eventCategory = eventCategories[category] == true
        local isBoard = category == "Expedition_Weekly"
        local id = isBoard and "NUI-0013" or (eventCategory and "NUI-0009" or "NUI-0012")
        if not MONSTER_CATEGORY_SET[category] and ((isBoard and boardEnabled) or (eventCategory and eventEnabled) or (not isBoard and not eventCategory and questEnabled)) then
            local allowed = path(Dependencies.Quests, "Categories", category, "ClaimAllowed") ~= false
            self:Mark(id, "waiting", "No completed unclaimed quest with satisfied prerequisites")
            for quest, questData in pairs(path(categoryData, "Quests") or {}) do
                local info = path(Dependencies.Quests, "Quests", category, quest)
                local eligible = allowed and info ~= nil and path(questData, "Completed") == true and path(questData, "Claimed") ~= true
                for _, prior in pairs(path(info, "Prerequisites") or {}) do
                    if path(categoryData, "Quests", peek(prior), "Claimed") ~= true then eligible = false end
                end
                if eligible then self:Dispatch(id, "quest:" .. category .. ":" .. quest, questData, "ClaimQuest", category, quest) end
            end
        end
    end
    if boardEnabled then
        local board = path(data(), "ExpeditionData", "Buildings", "QuestBoard")
        local info = path(Information, "Expeditions", "Milestones")
        local count = tonumber(path(info, "MilestoneMaxLevel"))
        local current = tonumber(path(board, "Milestone")) or 0
        local resetOkay = false
        if info and type(info.GetResetKey) == "function" then
            resetOkay = (tonumber(path(board, "LastResetKey")) or 0) >= info:GetResetKey(os.time())
        end
        if count and resetOkay then
            for i = 1, math.min(current, count) do
                if not path(board, "ClaimedMilestones", "Milestone" .. i) then self:Dispatch("NUI-0013", "board:" .. i, board, "ExpeditionBuilding_ClaimMilestoneReward", i) end
            end
        end
    end
    if self:Enabled("NUI-0014") then
        local info = path(Information, "Assets", "SummerCapsule") or path(Information, "Items", "SummerCapsule")
        if info and path(info, "SubType") == "Lootbox" and path(info, "QuickOpenAllowed") == true and not path(info, "DirectOpenDisabled") then
            if itemCount("SummerCapsule") > 0 then self:Dispatch("NUI-0014", "capsule:SummerCapsule", itemCount("SummerCapsule"), "QuickOpenLootbox", "SummerCapsule", false)
            else self:Mark("NUI-0014", "waiting", "No owned Summer Capsule") end
        else self:Mark("NUI-0014", "unavailable", "Verified Summer Capsule quick-open asset not loaded") end
    end
end

local function finiteNumber(input)
    local result = tonumber(peek(input))
    if not result or result ~= result or math.abs(result) == math.huge then return nil end
    return result
end
local function batchSize(id, fallback)
    local requested = finiteNumber(value(id, fallback))
    if not requested then return nil end
    return math.clamp(math.floor(requested), 1, 100)
end
local function batchAssetInfo(asset)
    local info = path(Dependencies.Assets, asset) or path(Information, "Assets", asset) or path(Information, "Items", asset) or path(Information, "Units", asset) or path(Information, "Equipment", asset)
    local kind = path(info, "Type")
    if not kind then
        if path(Information, "Items", asset) then kind = "Item"
        elseif path(Information, "Units", asset) then kind = "Unit"
        elseif path(Information, "Equipment", asset) then kind = "Equipment" end
    end
    return info, kind
end
local function batchOwned(asset)
    local _, kind = batchAssetInfo(asset)
    local typeInfo = path(Information, "AssetTypes", kind)
    local dataKey = path(typeInfo, "DataKey") or ({ Item = "ItemData", Unit = "UnitData", Equipment = "EquipmentData" })[kind]
    if not dataKey then return nil, "Asset inventory schema unavailable" end
    local inventory = peek(Dependencies[dataKey]) or path(data(), dataKey)
    if type(inventory) ~= "table" then return nil, "Asset inventory replica unavailable" end
    local stackable = path(typeInfo, "Stackable")
    if stackable == nil then stackable = kind == "Item" end
    if stackable then
        local row = peek(inventory[asset])
        if row == nil then return 0 end
        local count = finiteNumber(path(row, "Amount"))
        return count and math.max(0, count) or nil, count == nil and "Asset amount unavailable" or nil
    end
    local total = 0
    for id, raw in pairs(inventory) do
        if id == asset or path(raw, "Asset") == asset then
            local count = path(raw, "Amount") == nil and 1 or finiteNumber(path(raw, "Amount"))
            if not count or count < 0 then return nil, "Asset amount unavailable" end
            total += count
        end
    end
    return total
end
function Controller:AffordableBatch(costs, requested)
    local count = finiteNumber(requested)
    if not count or type(peek(costs)) ~= "table" or next(peek(costs)) == nil then return 0, "Invalid batch cost schema" end
    count = math.clamp(math.floor(count), 1, 100)
    local totals, balances = {}, {}
    for _, row in pairs(peek(costs)) do
        local asset, amount = path(row, "Asset"), finiteNumber(path(row, "Amount"))
        if type(asset) ~= "string" or asset == "" or not amount or amount < 0 then return 0, "Invalid batch cost" end
        local _, kind = batchAssetInfo(asset)
        if kind == "Unit" or kind == "Equipment" or path(Information, "Units", asset) or path(Information, "Equipment", asset) then return 0, "UUID unit/equipment costs are not supported" end
        totals[asset] = (totals[asset] or 0) + amount
        if not finiteNumber(totals[asset]) then return 0, "Invalid aggregated cost" end
    end
    for asset, cost in pairs(totals) do
        local owned, failure = batchOwned(asset)
        if owned == nil then return 0, failure end
        balances[asset] = owned
        if cost > 0 then count = math.min(count, math.floor(owned / cost)) end
    end
    return math.max(0, count), nil, { Costs = totals, Balances = balances }
end
function Controller:ShopBatchQuantity(shopData, shopKey, shop, item, shopId)
    if type(peek(Dependencies.PlayerData)) ~= "table" then return 0, nil, "Player purchase-history replica unavailable" end
    local requested = batchSize("AE-SHOP-BATCH-SIZE", Config.ShopBatchSize)
    if not requested then return 0, nil, "Invalid shop batch size" end
    -- The inspected native ShopItem processor supports scalar Currency/Price only.
    -- Do not reinterpret unverified recipe-style cost arrays as this shop protocol.
    if path(item, "Cost") ~= nil or path(item, "Costs") ~= nil then return 0, nil, "Unsupported shop cost-array schema" end
    local asset, currency = path(item, "Name"), path(item, "Currency") or path(shop, "Currency")
    local price = finiteNumber(path(item, "Price"))
    local discount = path(item, "Discount") == nil and 0 or finiteNumber(path(item, "Discount"))
    if type(currency) ~= "string" or not price or not discount or price - discount < 0 then return 0, nil, "Native scalar price/currency unavailable" end
    price -= discount
    local quantity, failure, budget = self:AffordableBatch({ { Asset = currency, Amount = price } }, requested)
    if failure then return 0, nil, failure end
    local boughtRaw = path(data(), "ShopData", "PurchaseHistory", shopId, shopKey, asset)
    local bought = boughtRaw == nil and 0 or finiteNumber(boughtRaw)
    if not bought or bought < 0 then return 0, nil, "Purchase history unavailable" end
    local reset = path(shopData, "ResetKeys", shopKey)
    if path(item, "Restocks") == true and reset ~= path(data(), "ShopData", "ResetKeys", shopId, shopKey) then bought = 0 end
    -- Nil Stock is explicitly unlimited in native ShopItem, but the transmitted batch always stays finite.
    local stockRaw = path(item, "Stock")
    local stock = stockRaw == nil and math.huge or finiteNumber(stockRaw)
    if stockRaw == math.huge then stock = math.huge end
    if stock == nil then return 0, nil, "Stock unavailable" end
    quantity = math.min(quantity, math.max(0, math.floor(stock - bought)))
    local info, kind = batchAssetInfo(asset)
    local owned, ownedFailure = batchOwned(asset)
    if owned == nil then return 0, nil, ownedFailure end
    local granted = path(item, "Amount") == nil and 1 or finiteNumber(path(item, "Amount"))
    if not granted or granted < 1 or granted % 1 ~= 0 then return 0, nil, "Invalid native item grant amount" end
    local limitRaw = path(info, "InventoryLimit")
    local limit = limitRaw == nil and math.huge or finiteNumber(limitRaw)
    if limitRaw == math.huge then limit = math.huge end
    if not limit then return 0, nil, "Inventory limit unavailable" end
    quantity = math.min(quantity, math.max(0, math.floor((limit - owned) / granted)))
    local typeLimitRaw = path(Information, "AssetTypes", kind, "InventoryLimit", "Limit")
    local used, expanded
    if typeLimitRaw ~= nil then
        local typeLimit = finiteNumber(typeLimitRaw)
        local expansionRaw = path(data(), "InventoryExpansions", kind)
        expanded = expansionRaw == nil and 0 or finiteNumber(expansionRaw)
        used = finiteNumber(path(Shared.InventorySizes, kind))
        if not typeLimit or not expanded or expanded < 0 or not used or used < 0 then return 0, nil, "Inventory-type capacity unavailable" end
        quantity = math.min(quantity, math.max(0, math.floor((typeLimit + expanded - used) / granted)))
    end
    -- Retain the old native-input fingerprint shape across the quantity upgrade.
    -- A slider change alone is not acknowledgement of an already dispatched buy.
    local before = { Reset = reset, Bought = bought, Balance = budget.Balances[currency], Owned = owned, Item = item }
    return math.max(0, math.floor(quantity)), before
end

function Controller:FuelBatchQuantity(info, building)
    local requested = batchSize("AE-FUEL-BATCH-SIZE", Config.FuelBatchSize)
    local fuel, maximum = finiteNumber(path(building, "Fuel")), finiteNumber(path(info, "MaxFuel"))
    local asset = path(info, "FuelItem")
    if not requested or not fuel or fuel < 0 or not maximum or maximum <= 0 or type(asset) ~= "string" then return 0, nil, "Native fuel schema or batch size unavailable" end
    -- Native AddFuelPrompt measures Fuel and MaxFuel in FuelItem counts.
    -- SecondsPerFuel is display/runtime duration only; it is not a capacity conversion.
    if path(info, "FuelUnit") ~= nil and path(info, "FuelUnit") ~= 1 then return 0, nil, "Unverified FuelUnit conversion" end
    local quantity, failure, budget = self:AffordableBatch({ { Asset = asset, Amount = 1 } }, requested)
    if failure then return 0, nil, failure end
    quantity = math.min(quantity, math.max(0, math.floor(maximum - fuel)))
    return math.max(0, math.floor(quantity)), { Fuel = fuel, Owned = budget.Balances[asset] }
end

-- ShopPrompt uses DataKey, ShopKey, numeric item index, quantity; never asset name as index.
function Controller:Shops()
    local specs = { { "NUI-0016", "NUI-0017", "ExpeditionShop" }, { "NUI-0018", "NUI-0019", "GoldShop" }, { "NUI-0020", "NUI-0021", "RaidShop" }, { "NUI-0022", "NUI-0023", "EventShop" } }
    if self:Enabled("NUI-0024") then
        self:Mark("NUI-0024", "waiting-event", "No loaded shop replica matches the native Wandering Trader descriptor")
        local info = path(Information, "Events", "WanderingTrader")
        local expectedName, expectedKey = path(info, "DisplayName"), path(info, "DataKey")
        for shopId, raw in pairs(peek(Dependencies.ShopData) or {}) do
            local nativeKey = path(raw, "DataKey")
            local matches = expectedKey ~= nil and nativeKey == expectedKey
            for _, shop in pairs(path(raw, "Shops") or {}) do
                if expectedName and path(shop, "Name") == expectedName then matches = true end
            end
            -- Use only a real replicated DataKey; never manufacture one from the UI label.
            if matches and nativeKey == shopId and path(raw, "Shops") then table.insert(specs, { "NUI-0024", "NUI-0025", nativeKey }) end
        end
    end
    for _, spec in ipairs(specs) do
        local id, selectId, shopId = table.unpack(spec)
        if self:Enabled(id) then
            local shopData = path(Dependencies.ShopData, shopId)
            local shops = path(shopData, "Shops")
            self:Mark(id, "waiting", "No selected affordable in-stock item")
            if not shops then self:Mark(id, "unavailable", "Shop replica not loaded: " .. shopId) else
                for shopKey, raw in pairs(shops) do
                    local shop = peek(raw)
                    for index, rawItem in pairs(path(shop, "Items") or {}) do
                        local item = peek(rawItem)
                        local asset = path(item, "Name")
                        if asset and tonumber(index) and selected(value(selectId, {}), asset) then
                            local quantity, before, failure = self:ShopBatchQuantity(shopData, shopKey, shop, item, shopId)
                            if failure then self:Mark(id, "unavailable", failure)
                            elseif quantity >= 1 then
                                if shopId == "ExpeditionShop" then
                                    self:Dispatch(id, shopId .. ":" .. shopKey .. ":" .. index, before, "ExpeditionShopPurchaseItem", shopKey, tonumber(index), quantity)
                                else self:Dispatch(id, shopId .. ":" .. shopKey .. ":" .. index, before, "ShopPurchaseItem", shopId, shopKey, tonumber(index), quantity) end
                            end
                        end
                    end
                end
            end
        end
    end
end

function Controller:Summons()
    for _, spec in ipairs({ { "Mini", "NUI-0026", "NUI-0027", "NUI-0028", "NUI-0029", "NUI-0030" }, { "Standard", "NUI-0031", "NUI-0032", "NUI-0033", "NUI-0034", "NUI-0035" } }) do
        local bannerId, id, teleportId, unselectId, sellId, targetsId = table.unpack(spec)
        local targets = set(value(targetsId, {}))
        if value(unselectId, false) == true then
            local changed = false
            for unitId, unit in pairs(peek(Dependencies.UnitData) or {}) do
                local asset = path(unit, "Asset")
                if not self.SeenUnits[unitId] and asset and selected(targets, asset) then
                    targets[tostring(asset)], targets[display(asset)] = nil, nil
                    changed = true
                end
            end
            if changed then self:SetValue(targetsId, targets) self:Mark(unselectId, "updated", "Removed newly acquired selected unit") end
        end
        if self:Enabled(teleportId) then
            local banner = path(Dependencies.BannerData, bannerId)
            local info = path(banner, "BannerInfo")
            local cost, currency = tonumber(path(info, "Cost")), path(info, "Currency") or "Gem"
            local available = false
            for _, pool in pairs(path(banner, "CurrentPool") or {}) do
                for _, entry in pairs(peek(pool) or {}) do
                    local asset = path(entry, "Asset")
                    if asset and selected(targets, asset) then available = true end
                end
            end
            if peek(Shared.IsInGame) == true and available and cost and cost > 0 and itemCount(currency) >= cost * 50 then
                self:Dispatch(teleportId, "banner-return:" .. bannerId, { Game = game.JobId, Targets = targets, Pool = path(banner, "CurrentPool") }, "GameReplica.Lobby")
            else self:Mark(teleportId, "waiting", "Requires match, featured target, and currency for at least 50 summons") end
        end
        if self:Enabled(id) then
            local banner = path(Dependencies.BannerData, bannerId)
            local info, pool = path(banner, "BannerInfo"), path(banner, "CurrentPool")
            self:Mark(id, "waiting", "No selected unit currently in this banner")
            if peek(Shared.IsInGame) == true then self:Mark(id, "waiting", "Summon is lobby-only")
            elseif type(info) ~= "table" or type(pool) ~= "table" then self:Mark(id, "unavailable", "Banner replica not loaded: " .. bannerId)
            else
                local targetAvailable = false
                for _, rarityPool in pairs(pool) do
                    for _, entry in pairs(peek(rarityPool) or {}) do
                        local asset = path(entry, "Asset")
                        if asset and selected(targets, asset) then targetAvailable = true end
                    end
                end
                if targetAvailable then
                    -- Native auto-sell setting keys use RareShiny, while UI labels use Shiny Rare.
                    local desired = set(value(sellId, {}))
                    local settings = path(data(), "Settings", "AutoSell", bannerId) or {}
                    local settingsReady = type(path(info, "Rates")) == "table"
                    for rarity in pairs(path(info, "Rates") or {}) do
                        if rarity ~= "Secret" then
                            for _, shiny in ipairs({ false, true }) do
                                local label = (shiny and "Shiny " or "") .. rarity
                                local settingKey = rarity .. (shiny and "Shiny" or "")
                                local enabled = desired[label] == true
                                if (path(settings, settingKey) == true) ~= enabled then
                                    settingsReady = false
                                    self:Dispatch(sellId, "autosell:" .. bannerId .. ":" .. settingKey, { path(settings, settingKey), enabled }, "ToggleAutoSell", bannerId, rarity, shiny, enabled)
                                end
                            end
                        end
                    end
                    local cost = tonumber(path(info, "Cost"))
                    local currency = path(info, "Currency") or "Gem"
                    -- OriginalCost is conservative when native discount boosts apply.
                    -- A suppressed/rejected setting request is not an ACK. Never
                    -- summon under stale native auto-sell settings.
                    if not settingsReady then self:Mark(id, "waiting-autosell", "Waiting for every requested native AutoSell setting to match")
                    elseif cost and cost > 0 and itemCount(currency) >= cost then
                        self:Dispatch(id, "summon:" .. bannerId, { Balance = itemCount(currency), Units = peek(Dependencies.UnitData), Pool = pool }, "Summon", bannerId, 1)
                    else self:Mark(id, "waiting", "Insufficient currency for a single summon") end
                end
            end
        end
    end
    for id in pairs(peek(Dependencies.UnitData) or {}) do self.SeenUnits[id] = true end
end

function Controller:Buildings()
    local buildings = path(data(), "ExpeditionData", "Buildings") or {}
    for _, spec in ipairs({ { "NUI-0038", "NUI-0039", "ExpeditionBuilding_Construct" }, { "NUI-0040", "NUI-0041", "ExpeditionBuilding_Upgrade" } }) do
        local id, selectId, action = table.unpack(spec)
        if self:Enabled(id) then
            self:Mark(id, "waiting", "No selected building meets native prerequisites/cost")
            if peek(Shared.IsInGame) ~= true then
                for label in pairs(set(value(selectId, {}))) do
                    local building = BUILDINGS[label] or (path(Information, "Expeditions", "Buildings", label) and label)
                    if building then
                        local owned = path(buildings, building)
                        local level = tonumber(path(owned, "Upgrade")) or 0
                        local nextUpgrade = path(Information, "Expeditions", "BuildingUpgrades", building, level + 1)
                        local eligible = (id == "NUI-0038" and owned == nil) or (id == "NUI-0040" and owned ~= nil)
                        for required, upgrade in pairs(path(nextUpgrade, "RequiredBuildings") or {}) do
                            if (tonumber(path(buildings, required, "Upgrade")) or 0) < (tonumber(peek(upgrade)) or math.huge) then eligible = false end
                        end
                        if eligible and nextUpgrade and costMet(path(nextUpgrade, "Cost")) then self:Dispatch(id, action .. ":" .. building, { Level = level, Items = peek(Dependencies.ItemData) }, action, building) end
                    end
                end
            else self:Mark(id, "waiting", "Construction/upgrade requires lobby") end
        end
    end
    for _, spec in ipairs({ { "GoldMine", "NUI-0042", "NUI-0043", "NUI-0044" }, { "ResourceDrill", "NUI-0046", "NUI-0047", "NUI-0050" } }) do
        local building, fuelId, collectId, returnId = table.unpack(spec)
        local owned = path(buildings, building)
        local info = path(Information, "Expeditions", "Buildings", building)
        local fuel = tonumber(path(owned, "Fuel"))
        if self:Enabled(fuelId) then
            if peek(Shared.IsInGame) == true then self:Mark(fuelId, "waiting", "Fuel must be added from lobby")
            else
                local quantity, before, failure = self:FuelBatchQuantity(info, owned)
                if failure then self:Mark(fuelId, "unavailable", failure)
                elseif quantity >= 1 then self:Dispatch(fuelId, "fuel:" .. building, before, "ExpeditionBuilding_AddFuel", building, quantity)
                else self:Mark(fuelId, "waiting", "Fuel full, less than one item of capacity, or inventory has no fuel") end
            end
        end
        if self:Enabled(collectId) then
            local rewards = path(owned, "Rewards")
            if type(rewards) == "table" and next(rewards) then self:Dispatch(collectId, "collect:" .. building, rewards, "ExpeditionBuilding_ClaimRewards", building)
            else self:Mark(collectId, "waiting", "No building rewards") end
        end
        if self:Enabled(returnId) then
            if owned and fuel == 0 and peek(Shared.IsInGame) == true then self:Dispatch(returnId, "return-fuel:" .. building, { Game = game.JobId, Fuel = fuel }, "GameReplica.Lobby")
            else self:Mark(returnId, "waiting", "Return only in-game with an existing empty-fuel building") end
        end
    end
    if self:Enabled("NUI-0045") then
        local tree = path(Information, "Expeditions", "Buildings", "ResearchLab", "Tree")
        local level = tonumber(path(buildings, "ResearchLab", "Upgrade")) or 0
        local owned = path(data(), "ExpeditionData", "Upgrades") or {}
        self:Mark("NUI-0045", "waiting", "No affordable unlockable research node")
        if level <= 0 or not tree or type(tree.CanUnlock) ~= "function" or type(tree.GetNextUpgradeKey) ~= "function" then
            self:Mark("NUI-0045", "unavailable", "Research Lab/tree methods not loaded")
        elseif peek(Shared.IsInGame) ~= true then
            for _, key in ipairs(sorted(path(tree, "UpgradeInfo") or {})) do
                local base = path(tree, "BaseNameMap", key) or key
                local nextKey = tree:GetNextUpgradeKey(owned, base)
                local info = nextKey and path(tree, "UpgradeInfo", nextKey)
                if info and tree:CanUnlock(owned, nextKey, level) and costMet(path(info, "Requirements")) then
                    self:Dispatch("NUI-0045", "research:" .. nextKey, { Upgrades = owned, Items = peek(Dependencies.ItemData) }, "ExpeditionUnlockUpgrade", nextKey)
                end
            end
        end
    end
end

function Controller:GeodesAndCrafting()
    local limitsReached = true
    for _, spec in ipairs(SPRITES) do
        local limit = math.max(0, tonumber(value(spec[3], spec[4])) or spec[4])
        if itemCount(spec[1]) < limit then limitsReached = false end
        self:Mark(spec[3], "configured", "Current count " .. itemCount(spec[1]) .. "; limit " .. limit)
    end
    if self:Enabled("NUI-0048") then
        if value("NUI-0049", false) == true and limitsReached then self:Mark("NUI-0048", "waiting", "All sprite limits reached")
        else
            self:Mark("NUI-0048", "waiting", "No owned ExpeditionGeode")
            for asset, raw in pairs(peek(Dependencies.ItemData) or path(data(), "ItemData") or {}) do
                if tostring(asset):find("ExpeditionGeode", 1, true) and (tonumber(path(raw, "Amount")) or 0) > 0 then
                    self:NodeRequest("NUI-0048", "geode:" .. asset, raw, "RESOURCEDRILL_OPEN_GEODE", asset, false)
                end
            end
        end
    end
    if self:Enabled("NUI-0060") then
        self:Mark("NUI-0060", "waiting", "No selected sprite recipe can be crafted below its limit")
        local chosen = set(value("NUI-0061", {}))
        for _, spec in ipairs(SPRITES) do
            local asset, label, limitId, fallback = table.unpack(spec)
            local current = itemCount(asset)
            local limit = math.max(0, tonumber(value(limitId, fallback)) or fallback)
            if chosen[asset] or chosen[label] or chosen[display(asset)] then
                for index, raw in pairs(path(Dependencies.Crafting, "Recipes", "Crafting", asset) or {}) do
                    local amount = tonumber(path(raw, "Amount"))
                    if tonumber(index) and amount and amount > 0 and current + amount <= limit and costMet(path(raw, "Requirements")) then
                        self:Dispatch("NUI-0060", "craft:" .. asset, { Owned = current, Items = peek(Dependencies.ItemData) }, "CraftRecipe", asset, tonumber(index), 1)
                    end
                end
            end
        end
    end
end

local function isZ(unit)
    for _, stats in pairs(path(unit, "StatPotential") or {}) do if path(stats, "Potential") == "Z" then return true end end
    return false
end

function Controller:NotifyTraining(message, kind)
    if not self.Running or Environment[KEY] ~= self then return false end
    local entry = { Time = os.time(), Title = "Training Grounds", Description = message, Kind = kind }
    local gui = Environment.__AnimeExpeditionsGuiController
    local library = type(gui) == "table" and gui.Library or nil
    if type(library) == "table" and type(library.Notify) == "function" then
        entry.Shown = pcall(function() library:Notify({ Title = entry.Title, Description = message, Time = 5, Icon = "bell" }) end)
    else
        entry.Shown = pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = entry.Title, Text = message, Duration = 5 }) end)
    end
    table.insert(self.NotificationLog, entry)
    while #self.NotificationLog > 50 do table.remove(self.NotificationLog, 1) end
    return entry.Shown
end

function Controller:ResolveTrainingSelection(selection)
    local chosen = set(selection == nil and value("NUI-0054", {}) or selection)
    local units, result = peek(Dependencies.UnitData), {}
    if type(units) ~= "table" or type(peek(Dependencies.PlayerData)) ~= "table" then return chosen end
    for key in pairs(chosen) do
        local id = units[key] and key or key:match("^([^\r\n]+)")
        if id and units[id] then result[tostring(id)] = true end
    end
    -- Preserve explicit legacy asset/name selections, but never infer identity
    -- from the decorative rich-text body of a composite option.
    for uuid, unit in pairs(units) do
        if chosen[tostring(path(unit, "Asset"))] or chosen[display(path(unit, "Asset"))] then result[tostring(uuid)] = true end
    end
    return result
end

function Controller:RefreshTrainingUnits(selection)
    local units = peek(Dependencies.UnitData)
    if type(units) ~= "table" or type(peek(Dependencies.PlayerData)) ~= "table" then
        self:Mark("NUI-0054", "waiting-data", "Inventory is not ready; saved selection retained")
        return set(selection == nil and value("NUI-0054", {}) or selection), false
    end
    local ids = self:ResolveTrainingSelection(selection)
    local gui = Environment.__AnimeExpeditionsGuiController
    if type(gui) == "table" and type(gui.UpdateTrainingUnits) == "function" then
        local spec = gui.ControlSpecs and gui.ControlSpecs["NUI-0054"]
        local control = gui.Controls and gui.Controls["NUI-0054"]
        local existing = control and control.Values or (spec and spec.options) or {}
        local labels = {}
        for _, option in ipairs(existing) do
            local id = type(option) == "string" and option:match("^([^\r\n]+)") or nil
            if id and units[id] and not labels[id] then labels[id] = option end
        end
        local options, labelToId = {}, {}
        for _, uuid in ipairs(sorted(units)) do
            local id, unit = tostring(uuid), units[uuid]
            local asset = path(unit, "Asset")
            local label = labels[id] or (id .. "\n" .. display(asset) .. " [" .. tostring(path(Information, "Units", asset, "Rarity") or "Unit") .. "]")
            table.insert(options, label) labelToId[label] = id
        end
        if not gui:UpdateTrainingUnits(options, labelToId, ids) then
            self:Mark("NUI-0054", "selection-error", "Training dropdown rejected its refresh")
            return self:ResolveTrainingSelection(value("NUI-0054", {})), false
        end
    else
        self:SetValue("NUI-0054", ids)
    end
    return self:ResolveTrainingSelection(value("NUI-0054", ids)), true
end

function Controller:EffectiveTrainingWorthiness(uuid, unit)
    local building = path(data(), "ExpeditionData", "Buildings", "TrainingGrounds")
    local training = path(building, "Units") or {}
    local maximum = tonumber(path(Information, "StatPotential", "MaxWorthiness"))
    local worth = tonumber(path(unit, "Worthiness")) or 0
    local started = tonumber(path(training, uuid))
    if not maximum or maximum <= 0 or maximum ~= maximum or maximum == math.huge then return worth, nil end
    if started then
        local info = path(Information, "Expeditions", "Buildings", "TrainingGrounds")
        local upgrade = path(Information, "Expeditions", "BuildingUpgrades", "TrainingGrounds", path(building, "Upgrade"))
        local interval, cap = tonumber(path(info, "TimePerTick")), tonumber(path(info, "MaxTime"))
        local rate, perRoll = tonumber(path(upgrade, "WorthinessRate")), tonumber(path(Information, "StatPotential", "WorthinessPerRoll"))
        if interval and interval > 0 and cap and rate and perRoll then
            worth = math.clamp(worth, 0, maximum) + math.floor(math.clamp(workspace:GetServerTimeNow() - started, 0, cap) / interval) * rate / 100 * perRoll
        end
    end
    return math.clamp(worth, 0, maximum), maximum
end

function Controller:BulkSelect(rarity)
    if not self.Running or Environment[KEY] ~= self then return {} end
    local result = self:ResolveTrainingSelection()
    local before = #sorted(result)
    for uuid, unit in pairs(peek(Dependencies.UnitData) or {}) do
        local asset, trait = path(unit, "Asset"), path(unit, "Trait")
        if path(Information, "Units", asset, "Rarity") == rarity and (trait == nil or trait == "" or trait == "None") then result[tostring(uuid)] = true end
    end
    local accepted, ok = self:RefreshTrainingUnits(result)
    local count = #sorted(accepted)
    self:NotifyTraining(ok and ("Selected " .. count .. " units (+" .. math.max(0, count - before) .. " " .. rarity .. ")") or "Could not update training selection", "selection")
    return accepted
end

function Controller:IgnoreFullWorthiness()
    if not self.Running or Environment[KEY] ~= self then return {}, 0 end
    local selected, removed = self:ResolveTrainingSelection(), 0
    local units = peek(Dependencies.UnitData) or {}
    local maximum = tonumber(path(Information, "StatPotential", "MaxWorthiness"))
    if not maximum or maximum <= 0 or maximum ~= maximum or maximum == math.huge then self:NotifyTraining("Worthiness limit unavailable; selection unchanged", "selection-error") return selected, 0 end
    for uuid in pairs(selected) do
        local worth = self:EffectiveTrainingWorthiness(uuid, units[uuid])
        if worth >= maximum then selected[uuid] = nil removed += 1 end
    end
    local accepted, ok = self:RefreshTrainingUnits(selected)
    self:NotifyTraining(ok and ("Ignored " .. removed .. " full-worthiness units • Selected " .. #sorted(accepted) .. " units") or "Could not update training selection", "ignore-full")
    return accepted, removed
end

function Controller:CheckTrainingAssignments()
    if not self.Running or Environment[KEY] ~= self then return end
    local training = path(data(), "ExpeditionData", "Buildings", "TrainingGrounds", "Units")
    if type(training) ~= "table" then return end
    for uuid, pending in pairs(self.TrainingPending) do
        local stamp = path(training, uuid)
        if type(stamp) == "number" and stamp == stamp and stamp >= 0 and stamp < math.huge then
            self:NotifyTraining("Assigned " .. pending.Name .. " to Training Grounds", "assignment-confirmed")
            self.TrainingPending[uuid] = nil
        elseif not pending.TimeoutNotified and os.clock() - pending.StartedAt >= Config.TrainingAckTimeoutSeconds then
            pending.TimeoutNotified = true
            self:NotifyTraining("Assignment not confirmed for " .. pending.Name .. "; no automatic retry", "assignment-unconfirmed")
        end
    end
end

function Controller:Training()
    local selectedUnits = self:RefreshTrainingUnits()
    self:CheckTrainingAssignments()
    local trainEnabled = self:Enabled("NUI-0051")
    local returnEnabled = self:Enabled("NUI-0053")
    if not trainEnabled and not returnEnabled then return end
    local building = path(data(), "ExpeditionData", "Buildings", "TrainingGrounds")
    local upgrade = path(Information, "Expeditions", "BuildingUpgrades", "TrainingGrounds", path(building, "Upgrade"))
    local maxUnits = tonumber(path(upgrade, "MaxUnits"))
    local training = path(building, "Units")
    local maxWorth = tonumber(path(Information, "StatPotential", "MaxWorthiness"))
    if not building or not maxUnits or type(training) ~= "table" or not maxWorth then self:Mark("NUI-0051", "unavailable", "TrainingGrounds schema/building unavailable") return end
    self:Mark("NUI-0051", "waiting", "No eligible selected unit or free training slot")
    local occupied = {}
    for uuid in pairs(training) do occupied[tostring(uuid)] = true end
    for uuid in pairs(self.TrainingPending) do occupied[tostring(uuid)] = true end
    local count = #sorted(occupied)
    local fullSelected, replacementWaiting = false, false
    local now = workspace:GetServerTimeNow()
    local info = path(Information, "Expeditions", "Buildings", "TrainingGrounds")
    for uuid, unit in pairs(peek(Dependencies.UnitData) or {}) do
        local worth = tonumber(path(unit, "Worthiness")) or 0
        local started = tonumber(path(training, uuid))
        if started then
            local interval = tonumber(path(info, "TimePerTick"))
            local cap = tonumber(path(info, "MaxTime"))
            local rate = tonumber(path(upgrade, "WorthinessRate"))
            local perRoll = tonumber(path(Information, "StatPotential", "WorthinessPerRoll"))
            if interval and interval > 0 and cap and rate and perRoll then
                local elapsed = math.clamp(now - started, 0, cap)
                worth = math.min(maxWorth, math.clamp(worth, 0, maxWorth) + math.floor(elapsed / interval) * rate / 100 * perRoll)
            end
        end
        local chosen = selectedUnits[tostring(uuid)]
        local ignored = value("NUI-0052", false) == true and isZ(unit)
        if chosen and not ignored and started and worth >= maxWorth then fullSelected = true end
        if chosen and not ignored and not started and worth < maxWorth then replacementWaiting = true end
        if trainEnabled and peek(Shared.IsInGame) ~= true and path(training, uuid) and (worth >= maxWorth or ignored) then self:Dispatch("NUI-0051", "training-remove:" .. uuid, { Unit = unit, Training = path(training, uuid) }, "ExpeditionBuilding_RemoveUnit", uuid)
        elseif trainEnabled and chosen and not ignored and worth < maxWorth and path(training, uuid) == nil and not self.TrainingPending[tostring(uuid)] and count < maxUnits and peek(Shared.IsInGame) ~= true then
            local beforeCount = self.ActionCount
            local sent = self:Dispatch("NUI-0051", "training-add:" .. uuid, { Unit = unit, Training = training }, "ExpeditionBuilding_SendUnit", uuid)
            if self.ActionCount > beforeCount then
                local name = display(path(unit, "Asset"))
                if Config.DryRun then self:NotifyTraining("Dry run: would assign " .. name .. " to Training Grounds", "assignment-dry-run")
                elseif sent or (self.LastAction and self.LastAction.Ok == false) then
                    self.TrainingPending[tostring(uuid)] = { Name = name, StartedAt = os.clock() }
                    self:NotifyTraining(sent and ("Assigning " .. name .. " to Training Grounds; awaiting confirmation") or ("Assignment outcome unknown for " .. name .. "; awaiting confirmation"), "assignment-pending")
                    self:CheckTrainingAssignments()
                else self:NotifyTraining("Could not assign " .. name .. " to Training Grounds", "assignment-error") end
            end
        end
    end
    if returnEnabled then
        local result = path(Dependencies.SessionData, "GameResults")
        if fullSelected and replacementWaiting and result and peek(Shared.IsInGame) == true then self:Dispatch("NUI-0053", "training-return", { Game = game.JobId, Training = training, Result = result }, "GameReplica.Lobby")
        else self:Mark("NUI-0053", "waiting", "Requires finished match, full trainee, and an eligible selected replacement") end
    end
end
local NativeRedeemModule = (function()
-- Bounded Auto Redeem worker. Uses only current native catalog plus an explicit,
-- maintained supplemental list. No web search, scheduler, or guessed code spray.
local Module = {}
local Worker = {}
Worker.__index = Worker
local function canonical(code)
    if type(code) ~= "string" then return nil end
    local result = code:match("^%s*(.-)%s*$")
    if result == "" or #result > 120 then return nil end
    return result:lower()
end
local function finite(value) return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge end
local function copy(input)
    if type(input) ~= "table" then return input end
    local output = {} for k, v in pairs(input) do output[k] = copy(v) end return output
end
local function claimedSet(claimed)
    local set = {}
    for code, value in pairs(claimed) do
        local key = canonical(code)
        if key and value == true then set[key] = true end
    end
    return set
end
function Module.new(context)
    assert(type(context) == "table" and type(context.Read) == "function" and type(context.IsCurrent) == "function", "Redeem context required")
    assert(type(context.Ledger) == "table", "Account-scoped Redeem ledger required")
    context.Ledger.Records = context.Ledger.Records or {}
    context.Ledger.NextAt = context.Ledger.NextAt or 0
    return setmetatable({ Ctx = context, Ledger = context.Ledger, Generation = context.Generation, Status = {}, Busy = false }, Worker)
end
function Worker:_mark(code, detail, counts)
    self.Status = { Code = code, Detail = detail, Counts = counts or {}, Pending = self.Ledger.Pending and self.Ledger.Pending.Code or nil }
    if self.Ctx.IsCurrent() and type(self.Ctx.Mark) == "function" then self.Ctx.Mark(code, detail, copy(self.Status)) end
    return copy(self.Status)
end
function Worker:GetStatus() return copy(self.Status) end
function Worker:_reconcile(snapshot)
    if type(snapshot.Claimed) ~= "table" then return end
    local claimed = claimedSet(snapshot.Claimed)
    for key, record in pairs(self.Ledger.Records) do
        if claimed[key] then record.Status = "claimed" end
    end
    local pending = self.Ledger.Pending
    if pending and claimed[pending.Key] then
        pending.Status = "claimed"
        self.Ledger.Pending = nil
    end
end
function Worker:_candidates(snapshot, ignoreAttempt)
    local counts = { Native = 0, Supplemental = 0, Claimed = 0, Expired = 0, Future = 0, LevelBlocked = 0,
        Invalid = 0, InvalidWindow = 0, Attempted = 0, Eligible = 0 }
    local seen, candidates = {}, {}
    local claimed = claimedSet(snapshot.Claimed)
    local function consider(code, definition, source)
        local key = canonical(code)
        if not key then counts.Invalid += 1 return end
        if seen[key] then return end
        seen[key] = true
        if source == "native" then counts.Native += 1 else counts.Supplemental += 1 end
        if claimed[key] then counts.Claimed += 1 return end
        if self.Ledger.Records[key] and key ~= ignoreAttempt then counts.Attempted += 1 return end
        if source == "native" then
            if type(definition) ~= "table" or type(definition.Rewards) ~= "table" then counts.Invalid += 1 return end
            local starts, ends, level = definition.ActiveFrom, definition.ActiveUntil, definition.LevelRequirement
            if starts ~= nil and not finite(starts) or ends ~= nil and not finite(ends)
                or level ~= nil and (not finite(level) or level < 0 or level % 1 ~= 0) then counts.Invalid += 1 return end
            if starts and ends and ends <= starts then counts.InvalidWindow += 1 return end
            if starts and snapshot.Now < starts then counts.Future += 1 return end
            if ends and snapshot.Now >= ends then counts.Expired += 1 return end
            if level and snapshot.Level < level then counts.LevelBlocked += 1 return end
        end
        -- Supplemental eligibility is explicitly server-validated; no level or
        -- expiry metadata is invented. Native definitions always take priority.
        candidates[#candidates + 1] = { Key = key, Code = code:match("^%s*(.-)%s*$"), Source = source }
        counts.Eligible += 1
    end
    local keys = {}
    for code in pairs(snapshot.Catalog) do keys[#keys + 1] = code end
    table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
    for _, code in ipairs(keys) do consider(code, snapshot.Catalog[code], "native") end
    for _, entry in ipairs(self.Ctx.Supplemental or {}) do
        if type(entry) == "table" and entry.Source == "user-confirmed" and canonical(entry.Code) and not seen[canonical(entry.Code)] then
            consider(entry.Code, entry, "supplemental:user-confirmed")
        end
    end
    return candidates, counts
end
function Worker:_validSnapshot(snapshot)
    if type(snapshot) ~= "table" or snapshot.Account ~= self.Ctx.Account then return false, "account-changed" end
    if type(snapshot.Catalog) ~= "table" then return false, "catalog-unavailable" end
    if type(snapshot.Claimed) ~= "table" then return false, "claimed-state-unavailable" end
    if not finite(snapshot.Level) or snapshot.Level < 0 or snapshot.Level % 1 ~= 0 then return false, "level-unavailable" end
    if not finite(snapshot.Now) or not finite(snapshot.Clock) then return false, "clock-unavailable" end
    return true
end
function Worker:_run()
    if not self.Ctx.IsCurrent() then return self:_mark("stopped", "Lobby generation no longer owns Auto Redeem") end
    local snapshot = self.Ctx.Read()
    if snapshot.Account ~= self.Ctx.Account then return self:_mark("account-changed", "Do not reuse another account's redemption state") end
    self:_reconcile(snapshot)
    if not snapshot.Enabled then return self:_mark("disabled", "Auto Redeem is off; any sent request remains reserved") end
    local valid, failure = self:_validSnapshot(snapshot)
    if not valid then return self:_mark(failure, "Waiting for complete native code/player state") end
    local candidates, counts = self:_candidates(snapshot)
    local pending = self.Ledger.Pending
    if pending then return self:_mark("waiting-claimed-confirmation", pending.Code .. ": sent outcome is not yet confirmed by ClaimedCodes; no resend", counts) end
    if #candidates == 0 then
        local reason = counts.Native + counts.Supplemental == 0 and "empty-catalog" or "no-eligible-codes"
        return self:_mark(reason, string.format("Native %d; supplement %d; claimed %d; expired %d; future %d; level blocked %d; invalid/window %d/%d; already attempted %d",
            counts.Native, counts.Supplemental, counts.Claimed, counts.Expired, counts.Future, counts.LevelBlocked, counts.Invalid, counts.InvalidWindow, counts.Attempted), counts)
    end
    if snapshot.Clock < self.Ledger.NextAt then return self:_mark("cooldown", "One code at a time; native request interval has not elapsed", counts) end
    if snapshot.Issued then return self:_mark("waiting-lobby-action", "Another Lobby action owns this tick", counts) end
    local selected = candidates[1]
    if snapshot.DryRun then return self:_mark("dry-run", "Would redeem " .. selected.Code .. " from " .. selected.Source, counts) end
    local action = self.Ctx.ResolveActor()
    if type(action) ~= "function" then return self:_mark("native-action-unavailable", "Registered RedeemCode actor unavailable", counts) end
    if not self.Ctx.IsCurrent() then return self:_mark("stopped", "Owner changed during actor lookup") end
    local function permitted()
        if not self.Ctx.IsCurrent() then return false end
        local latest = self.Ctx.Read()
        if not latest.Enabled or latest.DryRun or latest.Issued or not self:_validSnapshot(latest) then return false end
        if claimedSet(latest.Claimed)[selected.Key] then return false end
        -- Re-evaluate current native time/level/definition without the reservation
        -- temporarily making this very code appear already attempted.
        local eligible = self:_candidates(latest, selected.Key)
        for _, entry in ipairs(eligible) do if entry.Key == selected.Key and entry.Source == selected.Source then return true end end
        return false
    end
    if not permitted() then return self:_mark("revoked-before-send", "Code, owner, toggle, or native eligibility changed", counts) end
    local record = { Key = selected.Key, Code = selected.Code, Source = selected.Source,
        Status = "unknown", Generation = self.Generation, SentAt = snapshot.Now }
    self.Ledger.Records[selected.Key], self.Ledger.Pending = record, record
    local interval = tonumber(self.Ctx.IntervalSeconds)
    if not finite(interval) or interval < 1 or interval > 30 then interval = 1 end
    self.Ledger.NextAt = snapshot.Clock + interval
    local callOK, sent, nativeOK, result = pcall(self.Ctx.Send, action, selected.Code, permitted)
    if not self.Ctx.IsCurrent() then return self:_mark("stopped", "Owner changed; pending request preserved for native reconciliation") end
    if not callOK then
        record.Error = tostring(sent)
        return self:_mark("outcome-unknown", selected.Code .. ": sender error; no blind retry", counts)
    end
    if sent ~= true then
        self.Ledger.Pending, self.Ledger.Records[selected.Key] = nil, nil
        return self:_mark("revoked-before-send", "Native invocation did not occur", counts)
    end
    if nativeOK ~= true then
        record.Error = tostring(result)
        return self:_mark("outcome-unknown", selected.Code .. ": native error; no blind retry", counts)
    end
    self:_reconcile(self.Ctx.Read())
    if record.Status == "claimed" then return self:_mark("claimed", selected.Code .. ": confirmed in native ClaimedCodes", counts) end
    if result == false then
        record.Status = "rejected" self.Ledger.Pending = nil
        return self:_mark("rejected", selected.Code .. ": native actor rejected; this code will not be repeated", counts)
    end
    return self:_mark("waiting-claimed-confirmation", selected.Code .. ": native request sent; true/nil is not proof of claim", counts)
end
function Worker:Tick()
    if self.Busy then return copy(self.Status) end
    self.Busy = true
    local ok, result = pcall(self._run, self)
    self.Busy = false
    if not ok then return self:_mark(self.Ledger.Pending and "outcome-unknown" or "error", tostring(result)) end
    return result
end
return Module

end)()

function Controller:Redeem()
    local player = Players.LocalPlayer
    if not player or type(player.UserId) ~= "number" then self:Mark("NUI-0057", "player-unavailable", "Native account is not ready") return end
    local account = tostring(player.UserId)
    local generation = self.LoopGeneration
    if not self.RedeemRuntime or self.RedeemRuntime.Generation ~= generation then
        Environment.__AnimeExpeditionsRedeemCodeLedgers = Environment.__AnimeExpeditionsRedeemCodeLedgers or {}
        local ledgers = Environment.__AnimeExpeditionsRedeemCodeLedgers
        ledgers[account] = ledgers[account] or { Records = {}, NextAt = 0 }
        self.RedeemRuntime = NativeRedeemModule.new({
            Account = account, Generation = generation, Ledger = ledgers[account],
            IntervalSeconds = math.clamp(tonumber(Config.RedeemCodeIntervalSeconds) or 1, 1, 30),
            -- User reported manual Bossrush succeeds; PV45002's client Codes
            -- catalog omits it. One bounded native validation, not expired-code spray.
            Supplemental = { { Code = "Bossrush", Source = "user-confirmed" } },
            IsCurrent = function()
                return self.Running and Config.Enabled ~= false and Environment[KEY] == self
                    and self.LoopGeneration == generation and Players.LocalPlayer ~= nil and tostring(Players.LocalPlayer.UserId) == account
            end,
            Read = function()
                return { Account = tostring(Players.LocalPlayer.UserId), Enabled = value("NUI-0057", false) == true,
                    Catalog = path(Information, "Codes", "Codes"), Claimed = path(data(), "ClaimedCodes"),
                    Level = path(data(), "Level"), Now = workspace:GetServerTimeNow(), Clock = os.clock(),
                    Issued = self.Issued, DryRun = Config.DryRun == true }
            end,
            ResolveActor = function() return nativeAction("RedeemCode") end,
            Mark = function(code, detail, status)
                self:Mark("NUI-0057", code, detail)
                self.FeatureStatus["NUI-0057"].Counts = status.Counts
                self.FeatureStatus["NUI-0057"].PendingCode = status.Pending
            end,
            Send = function(action, code, permitted)
                local sent = false
                local ok, result = pcall(function()
                    return identity(function()
                        if not permitted() then return nil end
                        sent = true self.Issued = true
                        return action(code)
                    end)
                end)
                if sent and Environment[KEY] == self and self.LoopGeneration == generation then
                    self.ActionCount += 1
                    local event = { Feature = "NUI-0057", Action = "RedeemCode", Args = { code, n = 1 },
                        Ok = ok, DryRun = false, Result = tostring(result) }
                    table.insert(self.ActionLog, event)
                    if #self.ActionLog > 100 then table.remove(self.ActionLog, 1) end
                    self.LastAction = event
                    if not ok then self.LastError = tostring(result) end
                end
                return sent, ok, result
            end,
        })
    end
    return self.RedeemRuntime:Tick()
end
function Controller:OpenUI(label)
    -- Exact REGISTER_MENU identifiers from the corresponding Mount* native scripts.
    local menus = {
        Achievements = "Achievements", Areas = "Areas", Battlepass = "Battlepass", Codes = "Codes", Crafting = "Crafting",
        Evolve = "Evolve", Guild = "Guild", Index = "Index", ["Item Inventory"] = "ItemInventory", ["Join Friend"] = "JoinFriend",
        ["Level Milestones"] = "LevelMilestones", ["Lobby Music"] = "LobbyMusic", Play = "Play", Quests = "Quests", Settings = "Settings", Shop = "Shop",
        ["Shiny Normalizer"] = "ShinyNormalizer", ["Shiny Transfer"] = "ShinyTransfer", ["Stat Reroll"] = "StatReroll", ["Stat Transfer"] = "StatTransfer",
        ["Trait Reroll"] = "TraitReroll", ["Unit Ascension"] = "UnitAscension", ["Unit Inventory"] = "UnitInventory", ["Update Log"] = "UpdateLog", ["Wiki Tools"] = "WikiTools",
    }
    local shops = { ["Gold Shop"] = "GoldShop", ["Raid Shop"] = "RaidShop", ["Event Shop"] = "EventShop", ["Expedition Shop"] = "ExpeditionShop" }
    self.Pending["open-ui"] = nil
    if label == "Profile" then return self:Dispatch("NUI-0059", "open-ui", label, "Profile.View", Players.LocalPlayer.Name) end
    if label == "Events" then return self:Dispatch("NUI-0059", "open-ui", label, "ViewEvents") end
    if label == "Event Calendar" then
        for _, calendar in ipairs(sorted(path(data(), "CalendarData") or {})) do
            if calendar ~= "DailyRewards" then return self:Dispatch("NUI-0059", "open-ui", calendar, "Calendar.Prompt", calendar) end
        end
        self:Mark("NUI-0059", "waiting-event", "No event calendar is currently replicated")
        return false
    end
    if menus[label] then return self:Dispatch("NUI-0059", "open-ui", label, "ToggleMenu", menus[label], true) end
    if shops[label] then
        if not path(Dependencies.ShopData, shops[label]) then self:Mark("NUI-0059", "unavailable", "Shop not loaded: " .. shops[label]) return false end
        return self:Dispatch("NUI-0059", "open-ui", label, "ViewShop", { DataKey = shops[label] })
    end
    if label == "Summon Banner" then return self:Dispatch("NUI-0059", "open-ui", label, "ViewSummonBanner", "Standard") end
    self:Mark("NUI-0059", "unavailable", "No verified native menu mapping for: " .. tostring(label))
    return false
end
-- Input mode is retained only as an explicit legacy option. Remote mode submits the
-- exact FISHING_RESULT(true) protocol used by ClientFishingHandler's SkipMinigame branch.
function Controller:IsFishingGameReady()
    -- A populated GameState (or the text "InProgress") can still be the pre-start
    -- event screen. Only the native Active flag confirms that its game has begun.
    return peek(Shared.IsInGame) ~= true or path(Dependencies.GameState, "Active") == true
end
function Controller:RestoreFishingPrompt(restorePending)
    local connection, native, request = self.FishingPromptConnection, self.FishingPromptNative, self.FishingPromptRequest
    self.FishingPromptConnection, self.FishingPromptNative, self.FishingPromptRequest = nil, nil, nil
    if connection then pcall(function() connection:Disconnect() end) end
    if restorePending and request and not self.FishingResultIssued and type(native) == "function" and path(Dependencies.SessionData, "FishingState", "Stage") == "Reeling" then
        -- Auto was turned off before the round ended: give control back to the native UI.
        local ok, failure = pcall(function() identity(function() native(request.Parameters, request.OnResult) end) end)
        if not ok then self.LastError = tostring(failure) end
    end
end
function Controller:SyncFishingPrompt()
    local active = self.Running and Config.Enabled ~= false and Config.DryRun ~= true and Config.FishingMinigameMode == "Remote"
        and Environment[KEY] == self and value("NUI-0015", false) == true and self:IsFishingGameReady() and (not Config.FishingLobbyOnly or peek(Shared.IsInGame) ~= true)
    if not active then self:RestoreFishingPrompt(true) return false end
    if self.FishingPromptConnection then return true end
    local node = Nodes.FISHING_START_MINIGAME
    local callbacks = node and rawget(node, "_signalCallbacks")
    local native = type(callbacks) == "table" and callbacks[#callbacks]
    if type(native) ~= "function" or type(node.Connect) ~= "function" then return false end
    self.FishingPromptNative = native
    -- Nodes.InvokeSelf uses its last Connect callback; Disconnect restores the exact
    -- original callback. Do not edit node metatables, other listeners or server state.
    self.FishingPromptConnection = node:Connect(function(parameters, onResult)
        if self.Running and Config.Enabled ~= false and Config.DryRun ~= true and Config.FishingMinigameMode == "Remote"
            and Environment[KEY] == self and value("NUI-0015", false) == true and self:IsFishingGameReady() and (not Config.FishingLobbyOnly or peek(Shared.IsInGame) ~= true) then
            if not self.FishingPromptRequest then
                self.FishingPromptRound = (self.FishingPromptRound or 0) + 1
                self.FishingPromptRequest = { Parameters = parameters, OnResult = onResult }
                self.Pending["fishing-result"] = nil
            end
            -- The worker waits for the replicated Reeling stage before sending once.
            -- No local prompt is mounted, so it cannot later report a stale failure.
            self.FishingPromptsSkipped = (self.FishingPromptsSkipped or 0) + 1
            return
        end
        return native(parameters, onResult)
    end)
    return true
end
function Controller:CompleteFishingMinigame(state)
    if self.FishingPromptRequest then self.FishingPromptRequest.SawReeling = true end
    if path(state, "Parameters", "SkipMinigame") == true then
        self:Mark("NUI-0015", "waiting-result", "Native rod already submits its SkipMinigame result")
        return false
    end
    self.FishingReelingAt = self.FishingReelingAt or os.clock()
    if not Config.DryRun and os.clock() - self.FishingReelingAt < Config.FishingResultDelaySeconds then
        self:Mark("NUI-0015", "waiting-result-delay", "Waiting briefly before reporting the native fishing result")
        return false
    end
    if self.FishingHeld then self:SetFishingInput(false) end
    local existingPrompt = self:FindFishingControls()
    if existingPrompt then self.FishingOldPrompt = existingPrompt end
    local issued = self:Dispatch("NUI-0015", "fishing-result", { Equipped = path(state, "EquippedRodId"), Round = self.FishingPromptRound or 0 }, "Fishing.Result", true)
    if issued then
        self.FishingResultsSent = (self.FishingResultsSent or 0) + 1
        self.FishingResultIssued = true
    end
    if self.FishingResultIssued then self:Mark("NUI-0015", Config.DryRun and "dry-run" or "waiting-result", "Result sent once; waiting for native Success/Fail and reward confirmation") end
    return issued
end
function Controller:SetFishingInput(held)
    if held and (not self.Running or Config.Enabled == false or Environment[KEY] ~= self) then return false end
    if self.FishingHeld == held then return true end
    local action = nativeAction("FishInputInputAction")
    if not action then self:Mark("NUI-0015", "waiting", "Native fishing input action not registered yet") return false end
    if not Config.DryRun then identity(function() action(held) end) end
    self.FishingHeld = held
    return true
end
function Controller:FindFishingControls()
    local playerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, fish in ipairs(playerGui:GetDescendants()) do
        if fish.Name == "Fish" and fish:IsA("GuiObject") and fish.Visible and fish.Parent and fish.Position.Y.Scale == 0.5 then
            for _, bar in ipairs(fish.Parent:GetChildren()) do
                if bar ~= fish and bar:IsA("GuiObject") and bar.Visible and bar.Size.X.Scale > 0 and bar.Size.X.Scale < 1 and bar.Size.Y.Scale == 1 and bar.AnchorPoint.X == 0.5 and bar.Position.Y.Scale == 0 then return fish, bar end
            end
        end
    end
    return nil
end
-- Pick grounded banks of the actual native Water tags, never hard-coded coordinates.
-- Teleport is the GUI default; explicitly configured Walk retains the older path follower.
function Controller:CancelFishingNavigation(reason)
    self.FishingNavigationGeneration = (self.FishingNavigationGeneration or 0) + 1
    local navigation = self.FishingNavigation
    self.FishingNavigation = nil
    if not navigation then return false end
    if navigation.BlockedConnection then navigation.BlockedConnection:Disconnect() end
    if navigation.Path then pcall(function() navigation.Path:Destroy() end) end
    if navigation.OwnsMovement and navigation.Humanoid.Parent and navigation.Root.Parent then
        local ok, failure = pcall(function()
            identity(function() navigation.Humanoid:MoveTo(navigation.Root.Position) end)
        end)
        if not ok then self.LastError = tostring(failure) end
    end
    self.LastFishingNavigationReason = reason or "cancelled"
    return true
end
function Controller:OwnsFishingNavigation(character, generation)
    local humanoid = character and character:FindFirstChild("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not humanoid.Parent or humanoid.Health <= 0 or not root or not root.Parent then return false end
    local navigation = self.FishingNavigation
    if navigation and (navigation.Character ~= character or navigation.Humanoid ~= humanoid or navigation.Root ~= root) then return false end
    return self.Running and Config.Enabled ~= false and Config.DryRun ~= true
        and Environment[KEY] == self and value("NUI-0015", false) == true
        and not self:IsTidalConchHold()
        and Players.LocalPlayer.Character == character
        and self.FishingNavigationGeneration == generation
end
function Controller:StepFishingNavigation(navigation)
    if not self:OwnsFishingNavigation(navigation.Character, navigation.Generation) then
        self:CancelFishingNavigation("context-changed")
        return false
    end
    local water = navigation.Water
    if not water.Parent or not water:IsDescendantOf(workspace) or not game:GetService("CollectionService"):HasTag(water, "Water") then
        self:CancelFishingNavigation("water-removed")
        self.NextFishingNavigationAt = os.clock() + Config.FishingNavigationRetrySeconds
        self:Mark("NUI-0015", "waiting-water", "The selected tagged Water volume disappeared")
        return false
    end
    if navigation.Mode == "Teleport" then
        if os.clock() - navigation.TeleportedAt >= Config.FishingNavigationRetrySeconds then
            self:CancelFishingNavigation("teleport-proximity-timeout")
            self.FishingSpot = nil
            self.NextFishingNavigationAt = os.clock() + Config.FishingNavigationRetrySeconds
            self:Mark("NUI-0015", "waiting-water", "Arrival was not confirmed by native water proximity; retry paused")
            return false
        end
        self:Mark("NUI-0015", "teleporting-water", "At a random shoreline; waiting for native water proximity")
        return true
    end
    if navigation.Blocked then
        self:CancelFishingNavigation("path-blocked")
        self.NextFishingNavigationAt = os.clock() + Config.FishingNavigationRetrySeconds
        self:Mark("NUI-0015", "waiting-path", "Native path became blocked; waiting before replanning")
        return false
    end
    local waypoints, root = navigation.Waypoints, navigation.Root
    while navigation.Index <= #waypoints and (root.Position - waypoints[navigation.Index].Position).Magnitude <= 3 do
        navigation.Index += 1
        navigation.MovingToIndex = nil
    end
    if navigation.Index > #waypoints then
        self:CancelFishingNavigation("shoreline-reached")
        self.NextFishingNavigationAt = os.clock() + 1
        self:Mark("NUI-0015", "waiting-water", "Reached shoreline path; waiting for native proximity and water raycast")
        return false
    end
    if navigation.MovingToIndex == navigation.Index then
        if os.clock() - navigation.WaypointStartedAt > Config.FishingWaypointTimeoutSeconds then
            self:CancelFishingNavigation("waypoint-timeout")
            self.NextFishingNavigationAt = os.clock() + Config.FishingNavigationRetrySeconds
            self:Mark("NUI-0015", "waiting-path", "Waypoint timed out; owned movement stopped before retry")
            return false
        end
        self:Mark("NUI-0015", "navigating-water", "Following native path waypoint " .. navigation.Index .. "/" .. #waypoints)
        return true
    end
    local waypoint = waypoints[navigation.Index]
    if not self:OwnsFishingNavigation(navigation.Character, navigation.Generation) then return false end
    identity(function()
        if waypoint.Action == Enum.PathWaypointAction.Jump then navigation.Humanoid.Jump = true end
        navigation.Humanoid:MoveTo(waypoint.Position)
    end)
    navigation.OwnsMovement = true
    navigation.MovingToIndex, navigation.WaypointStartedAt = navigation.Index, os.clock()
    self.FishingNavigationMoves = (self.FishingNavigationMoves or 0) + 1
    self:Mark("NUI-0015", "navigating-water", "Moving along a native path to tagged Water")
    return true
end
function Controller:TeleportToFishingWater(character, humanoid, root, candidates)
    local module = ReplicatedStorage.Shared:FindFirstChild("ItemUtils")
    local head = character:FindFirstChild("Head")
    if not module or not head then return false end
    local utils = require(module)
    if type(utils.IsPositionNearWater) ~= "function" or type(utils.RaycastToWater) ~= "function" then
        self:Mark("NUI-0015", "unavailable", "Native fishing position validation unavailable")
        return false
    end
    -- Shuffle instead of always choosing the nearest bank. Validate BEFORE moving.
    for i = #candidates, 2, -1 do
        local j = math.random(i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end
    local generation = (self.FishingNavigationGeneration or 0) + 1
    self.FishingNavigationGeneration = generation
    for _, candidate in ipairs(candidates) do
        local water, goal = candidate.Water, candidate.Goal
        if water.Parent and water:IsDescendantOf(workspace) and game:GetService("CollectionService"):HasTag(water, "Water") then
            local relative, half = water.CFrame:PointToObjectSpace(goal), water.Size * 0.5
            local insetX, insetZ = math.min(2, half.X * 0.5), math.min(2, half.Z * 0.5)
            local aim = water.CFrame:PointToWorldSpace(Vector3.new(
                math.clamp(relative.X, -half.X + insetX, half.X - insetX), half.Y - 0.2,
                math.clamp(relative.Z, -half.Z + insetZ, half.Z - insetZ)))
            local hit = utils:IsPositionNearWater(goal, 20) and utils:RaycastToWater(goal + (head.Position - root.Position), aim)
            if hit then
                if Config.DryRun then
                    self:Mark("NUI-0015", "dry-run", "Would teleport to validated random fishing bank at " .. tostring(goal))
                    return true
                end
                if not self:OwnsFishingNavigation(character, generation) or character:FindFirstChild("HumanoidRootPart") ~= root or character:FindFirstChild("Humanoid") ~= humanoid then return false end
                local navigation = { Mode = "Teleport", Character = character, Humanoid = humanoid, Root = root, Water = water, Goal = goal, Aim = aim, Generation = generation, TeleportedAt = os.clock() }
                self.FishingNavigation = navigation
                local ok, failure = pcall(function()
                    identity(function()
                        character:PivotTo(CFrame.lookAt(goal, Vector3.new(aim.X, goal.Y, aim.Z)))
                        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                    end)
                end)
                if not ok then
                    self:CancelFishingNavigation("teleport-failed")
                    self.LastError = tostring(failure)
                    self:Mark("NUI-0015", "error", tostring(failure))
