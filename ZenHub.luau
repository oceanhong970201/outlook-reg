function Controller:Evaluate()
    self.LastReason = nil
    if value(FEATURE.Disable, false) then return nil, "auto joiners are disabled" end
    if not isInLobby() then return nil, "not in lobby" end
    local sessionData = getSessionData()
    if sessionData.Matchmaking or sessionData.MatchmakingFound then return nil, "matchmaking is already active" end
    local partyData = Fusion.peek(Dependencies.PartyData)
    if type(partyData) == "table" and partyData.Leader and partyData.Leader ~= LocalPlayer then
        return nil, "local player is not party leader"
    end

    -- Farming owns joiner focus, even while its native event is unavailable.
    -- The plan's farm toggle also lets the existing in-flight guards cancel it.
    local tidalFarm = value(FEATURE.TidalShinyFarm, false) == true
    local order = tidalFarm and { "Tidal Siege Joiner" } or priorityOrder()
    for _, name in ipairs(order) do
        local joiner = JOINERS[name]
        local toggle = tidalFarm and FEATURE.TidalShinyFarm or (joiner and joiner.Toggle)
        if joiner and value(toggle, false) then
            local queueData, reason, operation, bossKey = joiner.Build()
            if queueData or operation then
                return {
                    Name = name,
                    Toggle = toggle,
                    QueueData = queueData,
                    Matchmaking = joiner.Matchmaking and value(joiner.Matchmaking, false) == true or false,
                    TeamSlot = not operation and value(FEATURE.TeamEquipper, false) and math.clamp(math.floor(tonumber(value(TEAM_FEATURE[name], 0)) or 0), 0, 8) or 0,
                    Operation = operation, BossKey = bossKey,
                }
            end
            self.LastReason = reason
        end
    end
    return nil, self.LastReason or "no enabled joiner is currently eligible"
end

local function assertCurrentPlan(plan, generation)
    if not Controller.Running or Controller.LoopGeneration ~= generation then
        error("join submission cancelled", 0)
    end
    if value(FEATURE.Disable, false) or not value(plan.Toggle, false) or not isInLobby() then
        error("join plan is no longer enabled", 0)
    end
    local sessionData = getSessionData()
    if sessionData.Matchmaking or sessionData.MatchmakingFound then
        error("another matchmaking request became active", 0)
    end
    local partyData = Fusion.peek(Dependencies.PartyData)
    if type(partyData) == "table" and partyData.Leader and partyData.Leader ~= LocalPlayer then
        error("local player is no longer party leader", 0)
    end
    local current = Controller:Evaluate()
    if not current or fingerprint(current) ~= fingerprint(plan) then
        error("join plan configuration changed", 0)
    end
end

local function equipTeam(plan, generation)
    if plan.TeamSlot == 0 then return end
    local team = (getPlayerData().TeamData or {})[tostring(plan.TeamSlot)]
    if type(team) ~= "table" or type(team.Units) ~= "table" or next(team.Units) == nil then
        error("selected team slot has no saved units", 0)
    end
    local expected = fingerprint(team.Units)
    if fingerprint(getPlayerData().HotbarData or {}) == expected then return end
    -- Native UnitTeams prompt: false loads units without moving saved equipment.
    Actions.LoadUnitTeam(plan.TeamSlot, false)
    local deadline = os.clock() + Config.TeamConfirmSeconds
    repeat
        assertCurrentPlan(plan, generation)
        if fingerprint(getPlayerData().HotbarData or {}) == expected then return end
        task.wait(0.1)
    until os.clock() >= deadline
    error("team load was not confirmed by HotbarData; queue was not started", 0)
end

getBossRushAutoJoinRuntime = function()
    local scope=tostring(LocalPlayer.UserId)..":"..tostring(game.PlaceId)..":"..tostring(game.JobId)
    if bossRushAutoJoinRuntime and bossRushAutoJoinScope==scope then return bossRushAutoJoinRuntime end
    local Nodes=require(ReplicatedStorage:WaitForChild("Nodes"))
    Environment.__AnimeExpeditionsBossRushJoinLedgers=Environment.__AnimeExpeditionsBossRushJoinLedgers or {}
    local ledgers=Environment.__AnimeExpeditionsBossRushJoinLedgers
    ledgers[scope]=ledgers[scope] or {}
    bossRushAutoJoinScope=scope
    bossRushAutoJoinRuntime=BossRushAutoJoinModule.new({
        Owner=Controller,Ledger=ledgers[scope],Clock=os.clock,Sleep=task.wait,
        AckTimeout=Config.TeamConfirmSeconds,SettleSeconds=Config.QueueSettleSeconds,
        Read=function()
            local session=Fusion.peek(Dependencies.SessionData)
            local node=Nodes.PARTY_GET_CURRENT_REPLICA
            local ok,party=pcall(function()if node and type(node.InvokeSelf)=="function" then return node:InvokeSelf() end error("native party getter unavailable")end)
            if ok and party~=nil and type(party)~="table" then ok=false end
            local state=Fusion.peek(Dependencies.GameState)
            return { InGame=Fusion.peek(Shared.IsInGame),Player=LocalPlayer,Level=getPlayerData().Level,
                PartyKnown=ok,Party=ok and party or nil,SessionReady=type(session)=="table",
                Matchmaking=type(session)=="table" and session.Matchmaking,
                MatchmakingFound=type(session)=="table" and session.MatchmakingFound,
                Mode=(Information.Gamemodes or {}).BossRush,
                GameParameters=type(state)=="table" and Fusion.peek(state.Parameters) or nil }
        end,
        GetMaps=function()return Information.Maps:GetOrderedMaps("BossRush")end,
        GetMapDefinition=function(name)
            local root=ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Information"):FindFirstChild("Maps")
            local folder=root and root:FindFirstChild("BossRush")
            local child=folder and folder:FindFirstChild(name)
            if not child or not child:IsA("ModuleScript") then return nil end
            return require(child)
        end,
        Sanitize=sanitizeQueueData,
        Actions=function()return rawget(Actions,"PartySetQueueData"),rawget(Actions,"PartyStartGame")end,
        AssertCurrentPlan=function(plan,generation)
            if Environment[STATE_KEY]~=Controller or Players.LocalPlayer~=LocalPlayer then error("Boss Rush Joiner owner/account changed",0)end
            assertCurrentPlan(plan,generation)
        end,
    })
    return bossRushAutoJoinRuntime
end

