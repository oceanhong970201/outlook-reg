function Controller:PrepareReloadState(timeoutSeconds)
    self.Running = false
    self.Stopping = true
    self.LoopGeneration += 1
    local deadline = os.clock() + math.max(1, tonumber(timeoutSeconds) or 15)
    while self.ActiveOperations > 0 and os.clock() < deadline do task.wait(0.05) end
    if self.ActiveOperations > 0 then return nil, "game/webhook operation did not quiesce" end
    return self:ExportReloadState()
end

function Controller:Start()
    if self.LoopAlive then return false, "already running" end
    self.Stopping = false
    self.Running = Config.Enabled
    if not self.Running then self.Status = "disabled" return false, "disabled" end
    self.LoopGeneration += 1
    local generation = self.LoopGeneration
    self.LoopAlive = true
    local summonNode = Nodes.CLIENT_SUMMON_MODEL_LOADED
    if summonNode and type(summonNode.Connect) == "function" then
        local ok, connection = pcall(function()
            return summonNode:Connect(function(replica, model)
                self.ActiveOperations += 1
                local handled, failure = xpcall(function() return self:HandleSummon(replica, model) end, debug.traceback)
                self.ActiveOperations = math.max(0, self.ActiveOperations - 1)
                if not handled then self.LastError = tostring(failure) end
            end)
        end)
        if ok and connection then table.insert(self.Connections, connection) end
    end
    task.spawn(function()
        while self.Running and self.LoopGeneration == generation do
            local ok, failure = xpcall(function() self:RunOnce() end, debug.traceback)
            if not ok then self.Busy = false self.LastError = tostring(failure) self.Status = "loop-error" pushLog("error", "loop", failure) end
            task.wait(Config.PollSeconds)
        end
        if self.LoopGeneration == generation then self.LoopAlive = false end
    end)
    return true, generation
end

function Controller:Stop(reason)
    self.Running = false
    self.Stopping = true
    self.LoopGeneration += 1
    self:UnbindGui()
    self:ClearHitAttackBinding("Stopped")
    self:RestorePausedAnimations()
    local deadline = os.clock() + 15
    while self.ActiveOperations > 0 and os.clock() < deadline do task.wait(0.05) end
    self.LoopAlive = false
    local quiesced = self.ActiveOperations == 0
    if value(FEATURE.AutoSkip, false) ~= true then releaseAutoSkipSetting() end
    local ownedSettingNames = {}
    for settingName in pairs(self.OriginalSettings) do table.insert(ownedSettingNames, settingName) end
    for _, settingName in ipairs(ownedSettingNames) do restoreOwnedSetting(settingName) end
    for _, connection in ipairs(self.Connections) do pcall(function() connection:Disconnect() end) end
    table.clear(self.Connections)
    if self.RenderingOwned then
        pcall(function() RunService:Set3dRenderingEnabled(true) end)
        self.RenderingOwned = false
    end
    if self.LightingSnapshot then
        pcall(function()
            Lighting.GlobalShadows = self.LightingSnapshot.GlobalShadows
            Lighting.Brightness = self.LightingSnapshot.Brightness
            Lighting.FogEnd = self.LightingSnapshot.FogEnd
        end)
        self.LightingSnapshot = nil
    end
    restoreVisuals("Boost")
    restoreMeshFidelity()
    restoreVisuals("Enemies")
    restoreVisuals("Map")
    self.Status = quiesced and "stopped" or "stop-timeout"
    if not quiesced then self.LastError = "game/webhook operation did not quiesce" end
    self.StopReason = reason or "manual"
    if Environment[STATE_KEY] == self then Environment[STATE_KEY] = nil end
    return quiesced, self.LastError
end

Controller:BindGui()
Controller:Start()
return Controller
