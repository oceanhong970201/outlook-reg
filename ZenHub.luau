local BossRushNative = assert(loadstring([========================[-- Boss Rush cards / native Gate prompts only. No unit, purchase or Macro actions.
-- Protocol sources: MountCardSelectionPrompt, MountNotifications, VoteWindow,
-- ClientInteractableHandler. See BOSS_RUSH_20260926/native/S2-* and 19-mount-cards.
local Module = {}
local Adapter = {}
Adapter.__index = Adapter

local function finiteInteger(n, low, high)
    return type(n) == "number" and n == n and n % 1 == 0 and n >= low and n <= high
end
local function text(s)
    if type(s) ~= "string" then return "" end
    return s:gsub("<.->", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", ""):lower()
end
local function primitiveId(v) return (type(v) == "string" and v ~= "") or type(v) == "number" end
local function containsPlayer(list, player)
    if type(list) ~= "table" then return false end
    if list[player] == true then return true end
    for _, p in pairs(list) do if p == player then return true end end
    return false
end
local function disconnect(c)
    if c and type(c.Disconnect) == "function" then pcall(c.Disconnect, c) end
end
local function cardId(card)
    if type(card) == "string" then return card end
    if type(card) == "table" then return card.Upgrade or card.Stat or card.Id end
    return nil
end
local function cardSignature(p)
    if type(p) ~= "table" or type(p.Cards) ~= "table" then return nil end
    local parts = { tostring(p.SelectionAmount), tostring(p.EndTime) }
    for i, card in ipairs(p.Cards) do
        local id = cardId(card)
        if type(id) ~= "string" then return nil end
        parts[#parts + 1] = tostring(i) .. "=" .. id
    end
    return table.concat(parts, "|")
end
local function voteSignature(p)
    return table.concat({ text(p.Title), text(p.AcceptText), text(p.DeclineText),
        tostring(p.DisableDecline), tostring(p.EndTime) }, "|")
end
local function choiceValue(p, label)
    if text(p.AcceptText) == label then return true, true end
    if p.DisableDecline ~= true and text(p.DeclineText) == label then return false, true end
    return nil, false
end
local function isGateVote(p)
    return text(p.Title) == "skip & fight boss?"
        and select(2, choiceValue(p, "continue"))
        and select(2, choiceValue(p, "fight boss"))
end
local function isStartVote(p)
    return text(p.Title) == "start game?" and select(2, choiceValue(p, "start game"))
end

function Module.new(ctx)
    assert(type(ctx) == "table" and type(ctx.ReadConfig) == "function", "native adapter context required")
    local env = ctx.Environment or ctx.Env
    assert(type(env) == "table", "native adapter environment required")
    local player = ctx.LocalPlayer
    assert(player and type(player.UserId) == "number", "native player identity required")
    local world = ctx.Game or game
    local ws = ctx.Workspace or workspace
    env.__AnimeExpeditionsBossRushPromptLedgers = env.__AnimeExpeditionsBossRushPromptLedgers or {}
    local ledgers = env.__AnimeExpeditionsBossRushPromptLedgers
    local account = tostring(player.UserId)
    ledgers[account] = ledgers[account] or { Records = {}, GateIds = setmetatable({}, { __mode = "k" }), Serial = 0 }
    return setmetatable({ Ctx = ctx, Player = player, Game = world, Workspace = ws,
        Ledger = ledgers[account], References = {}, GateReferences = {},
        Collection = ctx.CollectionService or world:GetService("CollectionService"),
        FirePrompt = ctx.FirePrompt or fireproximityprompt,
